        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragment de màniga de reduïdes dimensions. En teixit llavorat de color rosa fosc i negre amb decoració floral i geomètrica. Inclou ullets a l’extrem superior i ribet en cinta de seda vermella al puny. Folre de tafetà de lli o cotó. \nAquesta màniga s’unia a la cisa del cos amb cintes o cordons que passaven pels ullets."@ca ;
        crmsci:O8_observed  <http://data.silknow.org/object/9eac24a8-4f6b-3014-8ffa-6854620fa32b> .

