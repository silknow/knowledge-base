<http://data.silknow.org/object/3034c080-d26d-3567-8423-905b64bc636d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "La peça duu representat l’escut de la ciutat de Barcelona, entre garlandes i putti, amb dues carteles amb les paraules “Barcino” i “Pia Faventia”, dos dels noms amb que els romans anomenaven a l’actual ciutat de Barcelona. Una figura femenina asseguda sobre un gran gerro, deixa veure al seu darrera la representació de la catedral de la ciutat i d’un vaixell, amb cintes ondulants i elements florals al seu voltant."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/3034c080-d26d-3567-8423-905b64bc636d> .

