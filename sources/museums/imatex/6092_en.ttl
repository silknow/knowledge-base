<http://data.silknow.org/object/2ae3a955-d329-3b2e-bf17-d078f55f5eb6/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Sanefes dels textos relatius a Alà o a l'Alcorà : \"Allah no hay otro Dios que Allah, Mohammad es el enviado de Allah\". Corán CVIII : \"Yo te he dado el Kanther (afluent del Paradis). Dirige tus plegarias a tu Se~nor y sacrificale victimas. Tu enemigo sera como hombre sin descendencia\". Alcorà CVII : \"Allah es uno. Es Allah a quien todos se dirigen para sus necesidades\". \"El que no ha sido engendrado ni mantenido hijos. No hay nadie que pueda igualarle\"."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/2ae3a955-d329-3b2e-bf17-d078f55f5eb6> .

