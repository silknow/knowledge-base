<http://data.silknow.org/object/ffcb160d-76e6-388a-9773-465a73304452/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Retrat del Papa Lleó XIII en medalló oval, rodejat de fulles i lliris blancs.\nA la part superior central hi ha el seu escut, i a la part inferior una cartela amb el seu nom.\nRodegen el retrat quatre medallons amb la representació de la tiara papal.\nInscripcions: A la part superior: \" LUMEN IN CAELO\". A la part inferior central: \"S.S. LEON XIII\". A la part Inferior: \" Hommage de l'institut technique Roubaisien\"."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ffcb160d-76e6-388a-9773-465a73304452> .

