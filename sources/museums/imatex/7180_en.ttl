<http://data.silknow.org/object/42c36d1a-5a07-3c95-b934-54e638dc7886>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Teixit d'estil bizarre."@en , "Peça similar però no idèntica a CDMT núm 04474, 004475 i 16883\nPresenta mateix disseny però invertit en quant disposició així com petites variacions en el conjunt dels motius.\n\nDescripció tècnica a partir de les peces del Covent de San Lorenzo del Escorial, núm. 10050177 i 10051222 (dossier \"Jornades sobre sederies bizarreµ, Madrid, setembre 2000) :\n- denominació : Domàs gros de Tours à liage repris, amb treball de trama liseré i trama espolinada\n- construcció interna : fons de setí de 8 e.3, decoració en gros de Tours de 2 fils. Treball de les trames en efecte liseré i espolinat sobre el fons setí, lligades en sarja de 3, S, per 1 de cada 6 fils de l'ordit.\n- ordit : organzina, S. densitat : 120 fils/cm\n- trama : trama de fons : fil de seda; trama decoració: fil d'or entorxat sobre fil doble de seda groga, S + fil d'or arrissat + sedes en diferents colors; proporció 2/1 i densitat : 17-15 passades/cm\n- ample de peça : 55,5 cm comptant els dos voravius\n- total de fils d'ordit : 6672\n- núm. de mallons : 840\n- altres mides : alt de la fulla de decoració : 14 cm; distancia de fulla a fulla 11,5 cm; distancia de trompeta a trompeta : 34 cm\n- conserva un voraviu."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2ab70aaf-36f2-3b81-a443-e55204312472> , <http://data.silknow.org/image/7a11a1e9-fdfd-32d0-a650-eebeb82027e1> ;
        ecrm:P3_has_note               "Peça similar però no idèntica a CDMT núm 04474, 004475 i 16883\nPresenta mateix disseny però invertit en quant disposició així com petites variacions en el conjunt dels motius.\n\nDescripció tècnica a partir de les peces del Covent de San Lorenzo del Escorial, núm. 10050177 i 10051222 (dossier \"Jornades sobre sederies bizarreµ, Madrid, setembre 2000) :\n- denominació : Domàs gros de Tours à liage repris, amb treball de trama liseré i trama espolinada\n- construcció interna : fons de setí de 8 e.3, decoració en gros de Tours de 2 fils. Treball de les trames en efecte liseré i espolinat sobre el fons setí, lligades en sarja de 3, S, per 1 de cada 6 fils de l'ordit.\n- ordit : organzina, S. densitat : 120 fils/cm\n- trama : trama de fons : fil de seda; trama decoració: fil d'or entorxat sobre fil doble de seda groga, S + fil d'or arrissat + sedes en diferents colors; proporció 2/1 i densitat : 17-15 passades/cm\n- ample de peça : 55,5 cm comptant els dos voravius\n- total de fils d'ordit : 6672\n- núm. de mallons : 840\n- altres mides : alt de la fulla de decoració : 14 cm; distancia de fulla a fulla 11,5 cm; distancia de trompeta a trompeta : 34 cm\n- conserva un voraviu."@en , "Teixit d'estil bizarre."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/42c36d1a-5a07-3c95-b934-54e638dc7886/dimension/1> , <http://data.silknow.org/object/42c36d1a-5a07-3c95-b934-54e638dc7886/dimension/2> ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/vocabulary/844> , <http://data.silknow.org/image/ba59d55b-2ea5-3c9c-ba7b-b9e8baa1a3c5> , <http://data.silknow.org/vocabulary/743> ;
        dc:identifier                  "6302" .

