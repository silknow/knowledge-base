<http://data.silknow.org/object/7795f478-3524-365f-a539-e299f80aa26a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Teixit jacquard rectangular commemoratiu de l'Exposició Universal celebrada a Paris l'any 1900, on s'ha representat l'edifici de \"Le Chateau d'Eau\" emmarcat per una garlanda de llorer.·A la part interior, retrats en marc oval independents, de E. Loubet, i Nicolàs II, identificats per inscripcions i acompanyats de les respectives banderes francesa i russa.·Contè les següents inscripcions:·A la part superior: \" GLORIE AU XXme SIÈCLE / PAX\"·A la part inferior: \"1900\", \"SOUVENIR de L'EXPOSITION\", \"SOCIÈTÈ des MÉCANIQUES\", \"J. VERDOL\", \"LYON\"."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/7795f478-3524-365f-a539-e299f80aa26a> .

<http://data.silknow.org/object/7795f478-3524-365f-a539-e299f80aa26a>
