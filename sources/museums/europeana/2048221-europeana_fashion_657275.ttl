<http://data.silknow.org/object/04859c8a-2baa-3222-bc25-13a4ead98b72/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Een heupdoek gemaakt van geweven katoen. De doek is gedeeltelijk doorweven met zijde. De doek bestaat uit twee banen die in de lengte aan elkaar zijn genaaid. De doek is geheel versierd met brede en smalle strepen in de lengte in helle en doffe kleuren met onregelmatige geïkatte vlekken. Dit type is voor mannen bestemd."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/04859c8a-2baa-3222-bc25-13a4ead98b72> .

