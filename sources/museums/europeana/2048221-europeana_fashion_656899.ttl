<http://data.silknow.org/object/9583df50-9459-3c9b-a0c2-c7d984be385c/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Een kokerdoek gemaakt van geweven zijde. De doek bestaat uit twee banen, die in de lengte aan elkaar zijn genaaid en vervolgens in de breedte aan elkaar zijn gezet. De doek bestaat uit een blauw veld met gouden stervormen en een rood veld dat versierd is met rechte witte strepen en gouden bloemfiguren daartussen. Naast dit gedeelte gouden achtbladige bloemen op een rood veld."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9583df50-9459-3c9b-a0c2-c7d984be385c> .

