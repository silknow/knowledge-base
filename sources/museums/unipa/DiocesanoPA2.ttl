<http://data.silknow.org/object/c98fdab3-cb8b-3810-b29f-195fa69480b1/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "1 trama, di fondo, seta, 2 capi, S, colore verde \nScalinatura: 2 trame \nRiduzione: 28 trame al cm"@it ;
