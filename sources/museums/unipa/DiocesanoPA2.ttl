<http://data.silknow.org/object/c98fdab3-cb8b-3810-b29f-195fa69480b1/observation/5>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/iconographical-observation> ;
        ecrm:P3_has_note    "impaginazione a rete di maglie esagonali, composte, sui lati obliqui, da spighe di grano stilizzate, mentre nei lati di tangenza da pigne e corone gigliate. Entro ogni maglia sono racchiusi alternatamente un mazzo con iris fra due melagrane e foglie, e un mazzo di elementi fitomorfi stilizzati tra cui si riconoscono elementi gigliati"@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/c98fdab3-cb8b-3810-b29f-195fa69480b1> .

