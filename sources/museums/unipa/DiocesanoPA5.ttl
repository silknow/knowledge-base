<http://data.silknow.org/object/d2ba47bd-16e4-3723-bffc-6f243a0dac78/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "fondo in raso da 5 diffalcamento 2, faccia ordito, prodotto da tutti i fili di fondo e da tutte le trame di fondo. Opera in raso da 5 diffalcamento 3, faccia trama, prodotto da tutti i fili di fondo e da tutte le trame di fondo, e per effetto di un ordito a disposizione che crea bande verticale policrome, unitamente a trame broccate, legate al dritto in diagonale 4 lega 1 direzione S, da fili di ordito prelevati dal fondo"@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/d2ba47bd-16e4-3723-bffc-6f243a0dac78> .

