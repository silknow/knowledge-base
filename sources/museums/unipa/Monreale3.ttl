        ecrm:P129_is_about  <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/2> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/4> , <http://data.silknow.org/object/61480d6a-eaff-397f-b7b7-02dbd0337f9c> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/6> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/7> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/category/1> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/3> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/1> , <http://data.silknow.org/production/99c8fd3b-78d5-3108-b8ec-cdb29a07459d> , <http://data.silknow.org/image/81fbc623-f0e5-3c07-8e4b-d5ab5326fc8c> , <http://data.silknow.org/assessment/8de003ed-6299-314c-8921-3bf4fe6ae7ba> , <http://data.silknow.org/object/5e7015dd-5280-3b9d-bd02-6ae07186a506/observation/5> ;
