<http://data.silknow.org/object/c3b8ba11-0de3-3eff-9476-7033fd182888/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "5 trame; I di fondo, seta, 3 capi, S, colore celeste; II broccata, seta, 2 capi, S, nei colori: verde, giallo, marrone, violetto, tortora, rosa, ruggine; III broccata, argento filato avvolto su anima in seta, 2 capi, S, colore bianco; IV broccata, argento filato frisé, avvolto su anima in seta ondata, 2 capi, S, colore bianco; V argento lamellare. Scalinatura: 1 passata. Riduzione: 24 passate al cm. Proporzione: 1/1."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/c3b8ba11-0de3-3eff-9476-7033fd182888> .

