<http://data.silknow.org/object/c3b8ba11-0de3-3eff-9476-7033fd182888/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "fondo in taffetas prodotto da tutti i fili di fondo e da tutte le trame di fondo. Opera creata da effetti liseré della trama di fondo, che slegando in alcune porzioni del tessuto, produce minuti disegni di controfondo, e da trame broccate, legate al dritto in diagonale 3 lega 1 direzione Z, da fili di ordito prelevati dal fondo."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/c3b8ba11-0de3-3eff-9476-7033fd182888> .

