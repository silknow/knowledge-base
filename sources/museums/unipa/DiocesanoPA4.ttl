<http://data.silknow.org/object/84a628ee-895b-3245-b7eb-a0a459c7f8a5/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "fondo in raso da 5 diffalcamento 2, faccia ordito, prodotto da tutti fili di fondo e da tutte le trame di fondo. Opera in raso da 5 diffalcamento 3, faccia trama e definita da trame broccate legate al dritto in diagonale 4 lega 1 direzione S, da fili di ordito prelevati dal fondo"@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/84a628ee-895b-3245-b7eb-a0a459c7f8a5> .

