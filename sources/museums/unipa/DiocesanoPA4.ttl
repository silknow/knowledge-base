        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/iconographical-observation> ;
        ecrm:P3_has_note    "motivo ad impostazione verticale, dato da una serie di elementi, naturalistici e fantastici, a cui si intrecciano garofani, campanule ed altre varietà di fiorì, che si succedono in direzioni oblique e contrapposte"@it ;
