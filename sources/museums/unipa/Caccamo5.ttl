<http://data.silknow.org/object/7e4081b1-13f4-334d-a45e-a1a3834a57a8/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "fondo in raso da 8, diffalca mento 3, faccia ordito prodotto da tutti i fili e da tutte le trame di fondo. Disegno descritto da 2 trame broccate metalliche di diversa tipologia, slegate sul dritto e sul rovescio."@it ;
