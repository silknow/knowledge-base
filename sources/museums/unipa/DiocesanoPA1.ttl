<http://data.silknow.org/object/3c19d1a9-5a9b-31c4-a49b-d8080e05a6a2/observation/5>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/iconographical-observation> ;
        ecrm:P3_has_note    "Motivo a sviluppo verticale ed impostazione speculare, simile da entrambe le facce del parato. Il disegno non è interamente leggibile ed è caratterizzato da grandi infiorescenze stilizzate che si susseguono lungo un asse centrale, inquadrate da una probabile cornice a girali"@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/3c19d1a9-5a9b-31c4-a49b-d8080e05a6a2> .

