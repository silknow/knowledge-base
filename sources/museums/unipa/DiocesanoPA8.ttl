        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "trame; I di fondo, seta, X capi, S, colore rosaceo; II broccata, argento filato avvolto su anima in seta, 2 capi, S,colore bianco, doppia; III broccata, argento filato fries avvolto su anima in seta ondata, 2 capi, S, colore bianco; IV broccata, argento lamellare; V broccata, seta, 2 capi, S,colore rosa salmone;Scalinature: 1 passata; Riduzione: 21 passate al cm; Proporzione 1/1"@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/d18bc72f-635b-3fbe-8138-667580ed8dc5> .

