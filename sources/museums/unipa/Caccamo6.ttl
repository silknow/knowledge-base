<http://data.silknow.org/object/309bf08c-a123-3529-a361-a96b1a10033e/observation/5>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/iconographical-observation> ;
        ecrm:P3_has_note    "motivo a sviluppo ondulante verticale. Variegate tipologie floreali, sorrette da esili steli, affiancate da sottili tralci fogliati, si intercalano a composizioni astratte dal profilo polilobato, disponendosi in assetto obliquo e contrapposto per direzione, lungo assi verticali."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/309bf08c-a123-3529-a361-a96b1a10033e> .

