        ecrm:P108_has_produced  <http://data.silknow.org/object/bfa0cb31-5686-3271-8ecc-425487eb6dbd> ;
        ecrm:P126_employed      "Satin liseré à deux chemins suivis.\nTrame:  viscose\n\nDamas gros de Tours, fond satin par 2 coups (brun noir puis orange), 2 lats de liseré (brun, orange) à liage repris en satin trame.\nFond changeant : 2 passées par côtes, et liage gros de Tours par 2 fils, soit le natté classique du damas gros de Tours mais ici par 2 coups soit 4 coups de trame par côte.\nDessin satin gris, limité.\nCf. analyse technique JP Leclercq, 2001."@fr ;
        ecrm:P3_has_note        "Jean Fressinet, 1925, Brunet, Meunié et Cie, Paris" ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1925> ;
