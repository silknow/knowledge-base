<http://data.silknow.org/object/34d5b176-89de-3fee-8e85-d31f84037b5f>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Infinite Variety" , "June 17 - September 18, 2005" , "This crazy quilt was a collaborative project. No attempt was made to limit what the contributors used or how they composed their individual square units. The end result is an expressionist explosion of color and texture, created from 33 separate blocks.  \nThe Women's Relief Corps was an auxiliary to the organization of the Grand Army of the Republic, serving veterans and descendants of veterans who fought during the American Civil War as members of the North's armies." ;
        ecrm:P129_is_about  <http://data.silknow.org/object/04a53dad-bce4-38b8-af8f-d480a0696384> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "June 17 - September 18, 2005" , "Infinite Variety" , "This crazy quilt was a collaborative project. No attempt was made to limit what the contributors used or how they composed their individual square units. The end result is an expressionist explosion of color and texture, created from 33 separate blocks.  \nThe Women's Relief Corps was an auxiliary to the organization of the Grand Army of the Republic, serving veterans and descendants of veterans who fought during the American Civil War as members of the North's armies." ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/infinite-variety> .

