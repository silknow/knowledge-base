<http://data.silknow.org/object/b01e820a-7308-379a-9c65-81a63f768ad1>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "February 17 - May 28, 2006" , "Several fragments of one cover have been sewn together to form this piece. The diagonal bands of open work were created by drawing together groups of threads in the ground fabric and holding them in place with a single stitch of white silk. The drawnwork in this piece and the adjacent cover may indicate an earlier date of manufacture or a regional design variation." , "Legacy of the Silk Road" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/5bd0c933-7b56-3b4e-b25e-4975cd6350e7> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "Several fragments of one cover have been sewn together to form this piece. The diagonal bands of open work were created by drawing together groups of threads in the ground fabric and holding them in place with a single stitch of white silk. The drawnwork in this piece and the adjacent cover may indicate an earlier date of manufacture or a regional design variation." , "February 17 - May 28, 2006" , "Legacy of the Silk Road" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/legacy-silk-road> .

