<http://data.silknow.org/object/1d26ed3d-c119-3f9c-8695-cf5828fd604e>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Turn Left at the Camel" , "“The silk shop at the top of the stairs on the second floor of the Turquoise Department Store” in Tashkent… a favorite store of the Operation Mercy volunteers, it had no other name. This textile was purchased here. The stock included a range of styles. This predominantly blue textile has a traditional design (ram’s horns, Hand of Fatima motif, and medallions) in new color combination." , "October 20, 2006 - February 11, 2007" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/bfa38531-4e24-3083-9f87-23ebbb21f406> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "October 20, 2006 - February 11, 2007" , "Turn Left at the Camel" , "“The silk shop at the top of the stairs on the second floor of the Turquoise Department Store” in Tashkent… a favorite store of the Operation Mercy volunteers, it had no other name. This textile was purchased here. The stock included a range of styles. This predominantly blue textile has a traditional design (ram’s horns, Hand of Fatima motif, and medallions) in new color combination." ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/turn-left-camel> .

