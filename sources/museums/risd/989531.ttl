        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "This towel is bordered in roses in full bloom, bud, profile, and full face. Roses were a common motif in Turkish and European embroideries of the 18th century. At about that time, Turkish needleworkers adopted the careful shading of colors seen in European woven silks." , "Ottoman Turkish Interior Textiles from the Aldrich Collection" , "January 22 - July 17, 2016" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/39fed07f-1cd4-3feb-b022-d5378981efe7> ;
