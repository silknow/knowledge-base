<http://data.silknow.org/object/34d5b176-89de-3fee-8e85-d31f84037b5f>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Infinite Variety" , "June 17 - September 18, 2005" , "This quilt artist has explored optical color mixing in both the overall composition of opposed light and dark diagonals and in the makeup of the individual cells, in which she mixes solid colored and checked fabrics. The glowing silk fabrics make the play of light across the surface of the quilt a compelling part of the design." ;
        ecrm:P129_is_about  <http://data.silknow.org/object/566b7cbf-11dc-3f3b-ad0b-7fa5f9206de7> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "June 17 - September 18, 2005" , "Infinite Variety" , "This quilt artist has explored optical color mixing in both the overall composition of opposed light and dark diagonals and in the makeup of the individual cells, in which she mixes solid colored and checked fabrics. The glowing silk fabrics make the play of light across the surface of the quilt a compelling part of the design." ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/infinite-variety> .

