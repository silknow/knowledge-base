<http://data.silknow.org/object/657dd844-8d67-34ea-8c64-0d61f0653122>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Asia in Black and White" , "Reiko Sudo's black silk doublecloth plays with transparency, light, and structure. In order to insert the iridescent feathers into the pockets woven into the cloth, the weaver must stop the loom before the pockets are closed across the top. This slow hand process contrasts with the rapid, automated weaving technology." , "December 31, 1999 - March 19, 2000" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/f238656c-6e3a-32e8-8375-fb13096f314b> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "Asia in Black and White" , "Reiko Sudo's black silk doublecloth plays with transparency, light, and structure. In order to insert the iridescent feathers into the pockets woven into the cloth, the weaver must stop the loom before the pockets are closed across the top. This slow hand process contrasts with the rapid, automated weaving technology." , "December 31, 1999 - March 19, 2000" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/asia-black-and-white> .

