<http://data.silknow.org/object/b01e820a-7308-379a-9c65-81a63f768ad1>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "February 17 - May 28, 2006" , "Embroideries of this type have only recently begun to be studied and researched. It is currently thought that they were made during the 17th and 18th centuries in the\nAzerbaijani regions of the southern Caucasus and northwestern Iran.  \nThe colors used are similar to 17th and 18th-century Turkish embroideries, while the patterns are common to many aspects of Islamic art, including some types of Persian rugs." , "Legacy of the Silk Road" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/86755bb3-7e4d-34fb-ba22-311aea043fbe> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "Embroideries of this type have only recently begun to be studied and researched. It is currently thought that they were made during the 17th and 18th centuries in the\nAzerbaijani regions of the southern Caucasus and northwestern Iran.  \nThe colors used are similar to 17th and 18th-century Turkish embroideries, while the patterns are common to many aspects of Islamic art, including some types of Persian rugs." , "February 17 - May 28, 2006" , "Legacy of the Silk Road" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/legacy-silk-road> .

