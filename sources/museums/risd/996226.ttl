<http://data.silknow.org/object/1d26ed3d-c119-3f9c-8695-cf5828fd604e>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Turn Left at the Camel" , "October 20, 2006 - February 11, 2007" , "The father and son dyer/weaver team whose work is seen here came to Bukhara for the Silk & Spice Festival from the town of Andijan, in the Fergana Valley in eastern Uzbekistan. In addition to their solid color and iridescent silk textiles, they have also experimented with new patterning for their ikat-dyed fabrics." ;
        ecrm:P129_is_about  <http://data.silknow.org/object/bf700911-0c53-39a1-8202-8ad64778118b> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "The father and son dyer/weaver team whose work is seen here came to Bukhara for the Silk & Spice Festival from the town of Andijan, in the Fergana Valley in eastern Uzbekistan. In addition to their solid color and iridescent silk textiles, they have also experimented with new patterning for their ikat-dyed fabrics." , "October 20, 2006 - February 11, 2007" , "Turn Left at the Camel" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/turn-left-camel> .

