<http://data.silknow.org/object/bd69c070-0ae8-3814-869b-2089a228a372>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "June 11 - October 31, 2004" , "Minangkabau weavers devoted their skill and time to producing ceremonial textiles of vivid silk and metallic gold or silver yarns. Variations in the motifs, layout, and colors indicate not only which village the wearer is from, but also marital status, social standing, and number of children." , "In the Spirit of Miss Lucy" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/90b45676-188d-3f4f-9de0-a7a71d8bb5c6> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "Minangkabau weavers devoted their skill and time to producing ceremonial textiles of vivid silk and metallic gold or silver yarns. Variations in the motifs, layout, and colors indicate not only which village the wearer is from, but also marital status, social standing, and number of children." , "In the Spirit of Miss Lucy" , "June 11 - October 31, 2004" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/spirit-miss-lucy> .

