        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Turn Left at the Camel" , "“The silk shop at the top of the stairs on the second floor of the Turquoise Department Store” in Tashkent… a favorite store of the Operation Mercy volunteers, it had no other name. This textile was purchased here. The stock included a range of styles. This satin-weave length is both traditionally patterned and colored." , "October 20, 2006 - February 11, 2007" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/ea250fb4-19ff-3029-a776-c5a293eff5b5> ;
        ecrm:P2_has_type    "Exhibition" ;
