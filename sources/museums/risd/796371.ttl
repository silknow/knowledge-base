<http://data.silknow.org/object/b01e820a-7308-379a-9c65-81a63f768ad1>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "February 17 - May 28, 2006" , "Legacy of the Silk Road" , "The layout of this piece indicates that it was made in the Nurata region of Uzbekistan. Although it shares with other suzanis the bold, rounded floral motifs and characteristic Bukhara couching stitch, the foliate arrangements reaching inward from the corners distinguish this type as a Nurata creation and reference the Indo-Persian influence of flowering buta (a basic paisley element). Note also the inked guidelines, likely drawn by a professional designer, now visible in some areas of the cotton." ;
        ecrm:P129_is_about  <http://data.silknow.org/object/3fcb0a20-0528-3e4d-a6c4-46913e281c58> ;
        ecrm:P2_has_type    "Exhibition" ;
        ecrm:P3_has_note    "February 17 - May 28, 2006" , "The layout of this piece indicates that it was made in the Nurata region of Uzbekistan. Although it shares with other suzanis the bold, rounded floral motifs and characteristic Bukhara couching stitch, the foliate arrangements reaching inward from the corners distinguish this type as a Nurata creation and reference the Indo-Persian influence of flowering buta (a basic paisley element). Note also the inked guidelines, likely drawn by a professional designer, now visible in some areas of the cotton." , "Legacy of the Silk Road" ;
        schema:contentUrl   <https://risdmuseum.org/exhibitions-events/exhibitions/legacy-silk-road> .

