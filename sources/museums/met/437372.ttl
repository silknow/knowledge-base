<http://data.silknow.org/image/cda93299-d233-3a73-9d83-adc94c7741a5>
        a                  ecrm:E38_Image ;
        schema:contentUrl  <https://silknow.org/silknow/media/met-museum/437372_1.jpg> , <https://collectionapi.metmuseum.org/api/collection/v1/iiif/437372/802572/restricted> .

<http://data.silknow.org/object/758fb0c6-e2f8-39c5-8328-29fb8488bb41/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Raphael painted this altarpiece around 1504/5 for the Franciscan convent of Sant’ Antonio in Perugia. It hung in a part of the church reserved for the nuns, who may have insisted on its conservative details, such as the elaborately clothed Christ Child. By contrast, the weighty male saints look to the future—the recent works by Leonardo da Vinci and Fra Bartolomeo that Raphael had just begun to study in Florence. The nuns sold their altarpiece in 1678, and in the early twentieth century its purchase by J. Pierpont Morgan received clamorous press coverage. For more information about this painting, including a reconstruction of the altarpiece, visit metmuseum.org."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/758fb0c6-e2f8-39c5-8328-29fb8488bb41> .

<http://data.silknow.org/object/758fb0c6-e2f8-39c5-8328-29fb8488bb41>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Raphael painted this altarpiece around 1504/5 for the Franciscan convent of Sant’ Antonio in Perugia. It hung in a part of the church reserved for the nuns, who may have insisted on its conservative details, such as the elaborately clothed Christ Child. By contrast, the weighty male saints look to the future—the recent works by Leonardo da Vinci and Fra Bartolomeo that Raphael had just begun to study in Florence. The nuns sold their altarpiece in 1678, and in the early twentieth century its purchase by J. Pierpont Morgan received clamorous press coverage. For more information about this painting, including a reconstruction of the altarpiece, visit metmuseum.org."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e3315f22-cc29-3d32-bc0d-c18760188824> , <http://data.silknow.org/image/d1603058-9489-36a8-8687-2c173974916e> , <http://data.silknow.org/image/cda93299-d233-3a73-9d83-adc94c7741a5> , <http://data.silknow.org/image/3224f444-9aa8-33f8-bdca-59cd62be5b56> , <http://data.silknow.org/image/307532dd-b6df-32e4-b64a-68385c3d982d> , <http://data.silknow.org/image/02f68b2d-35a9-3bf6-908e-ee1cd1663b2d> , <http://data.silknow.org/image/57def950-4a55-3330-9191-49576768386f> , <http://data.silknow.org/image/a9a774b2-c7e1-391e-9977-7fdaa1154cf6> , <http://data.silknow.org/image/0275b0eb-e04e-39c4-9251-a027d0c5a71a> , <http://data.silknow.org/image/e10db2c1-733a-3e33-8ee1-fc0e111f5682> , <http://data.silknow.org/image/9ea1bbff-4ec5-3856-af4b-37dae653a3f0> , <http://data.silknow.org/image/40d04c18-6a4b-34bd-8e7f-fcff77cf862e> ;
        ecrm:P3_has_note               "Raphael painted this altarpiece around 1504/5 for the Franciscan convent of Sant’ Antonio in Perugia. It hung in a part of the church reserved for the nuns, who may have insisted on its conservative details, such as the elaborately clothed Christ Child. By contrast, the weighty male saints look to the future—the recent works by Leonardo da Vinci and Fra Bartolomeo that Raphael had just begun to study in Florence. The nuns sold their altarpiece in 1678, and in the early twentieth century its purchase by J. Pierpont Morgan received clamorous press coverage. For more information about this painting, including a reconstruction of the altarpiece, visit metmuseum.org."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/758fb0c6-e2f8-39c5-8328-29fb8488bb41/dimension/1> , <http://data.silknow.org/object/758fb0c6-e2f8-39c5-8328-29fb8488bb41/dimension/2> ;
