        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This embroidered panel and MMA 64.101.1348 were probably the two ends of a decorative table carpet. The practice of covering tables with precious textiles began in Europe in the thirteenth century, when some imported pile carpets from the Middle East were considered too fine to be walked upon.The motifs of the Seasons and the Planets refer to the passage of time."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/22b5deb6-8773-3a90-aaf4-2be5c1e8f7b7> , <http://data.silknow.org/image/ec80fa28-c16f-36e8-99d3-b8b71cc60d75> , <http://data.silknow.org/image/d7505b63-ed9b-37be-abf8-0aee01257e2d> , <http://data.silknow.org/image/4a6ad0a7-3c24-3d37-b263-c667cd0d404b> , <http://data.silknow.org/image/d77d8b48-aba7-3260-b21d-ed688fbf1465> , <http://data.silknow.org/image/ae35a4bf-7f56-35e4-a2e0-681b6d3ed911> , <http://data.silknow.org/image/7b89a383-0973-3418-87dc-fd620f003550> , <http://data.silknow.org/image/618804ed-9705-33ed-99b6-a6b24e3fda77> , <http://data.silknow.org/image/9900415f-5c3d-3c5b-ad12-21568539ab68> ;
        ecrm:P3_has_note               "This embroidered panel and MMA 64.101.1348 were probably the two ends of a decorative table carpet. The practice of covering tables with precious textiles began in Europe in the thirteenth century, when some imported pile carpets from the Middle East were considered too fine to be walked upon.The motifs of the Seasons and the Planets refer to the passage of time."@en ;
