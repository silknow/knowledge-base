<http://data.silknow.org/object/a41abffb-3280-3a47-afc0-419e797857ba>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This is a rare surviving example of 18th century painted silk upholstery panels that were designed to be removable, presumably for the seasonal change of show covers which was a French tradition. The additional marking of the reverse connects these covers to the practice of marking furniture frames, no doubt the numbers on these covers corresponded to the frames on which they were used."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/dcdcccc0-8cf6-30d4-92fe-5ca5968368a5> , <http://data.silknow.org/image/e3d308dd-d090-3cb4-a46a-f382f4d8e066> , <http://data.silknow.org/image/12d8625a-13a2-3c53-bf36-cdd0429cced3> , <http://data.silknow.org/image/26acd8b7-ed48-3cb2-a86f-398768238f0a> ;
        ecrm:P3_has_note               "This is a rare surviving example of 18th century painted silk upholstery panels that were designed to be removable, presumably for the seasonal change of show covers which was a French tradition. The additional marking of the reverse connects these covers to the practice of marking furniture frames, no doubt the numbers on these covers corresponded to the frames on which they were used."@en ;
        dc:identifier                  "2014.710.1, .2" ;
