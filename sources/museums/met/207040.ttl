        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "William Beckford purchased this ewer from the London antiques dealer Edward Baldock in 1819. Modern connoisseurship permits the attribution of the ewer to the Prague workshop of Ferdinand Eusebio Miseroni (active 1656–84), but by reason of the technology employed in the working of the gold, the setting of the diamonds, and the assembling of the parts, the mounts cannot have been made very long before Baldock sold the ewer to Beckford."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/68c305f7-1d1f-30e9-8a45-f4511c0214ca> .

