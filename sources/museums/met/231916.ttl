<http://data.silknow.org/object/45e635b6-b02b-35c7-bfec-9ad2062b72fb/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This settee and its mate (58.75.21) were made for the room in 1769 by Mayhew and Ince. The covers en suite with the tapestries were designed at the Gobelins by Maurice Jacques and Louis Tessier. The 1769 invoice indicates that the settees were meant to be placed on either side of the fireplace."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/45e635b6-b02b-35c7-bfec-9ad2062b72fb> .

