<http://data.silknow.org/object/9f1c5a06-7a1d-3e38-8f3b-f42d7ac2b146>
        a                   ecrm:E89_Propositional_Object ;
        ecrm:P129_is_about  <http://data.silknow.org/object/3842c984-7b01-3d2b-8f89-7f1c10773952> ;
