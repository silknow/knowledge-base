        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record 236138" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/80bd79f0-3104-301c-9e51-9022ed0d82eb> , <http://data.silknow.org/object/80bd79f0-3104-301c-9e51-9022ed0d82eb/category/1> , <http://data.silknow.org/event/a8d00d60-568b-37ad-a409-03e0d11d5e35> , <http://data.silknow.org/production/cf17e21d-0794-30df-9760-d95e93606f66> , <http://data.silknow.org/object/80bd79f0-3104-301c-9e51-9022ed0d82eb/observation/1> , <http://data.silknow.org/object/c4627033-9cc9-3c22-88b0-927f1314f849> , <http://data.silknow.org/object/5e15d231-d18a-32ea-a3b0-3d6ce1f85235> , <http://data.silknow.org/event/149a1b54-474d-34bb-ab47-8d77e36ed540> , <http://data.silknow.org/image/45a66a1d-f8f5-33f8-a6cd-e2bf8f4c2267> , <http://data.silknow.org/object/5cd7f88d-9aca-3bc6-8c28-27535faf55b3> , <http://data.silknow.org/object/99915a9b-9d36-364d-8f01-fc776a55e988> , <http://data.silknow.org/collection/ec0f9a6f-7b69-31c4-80a6-c0a9cde663a5> , <http://data.silknow.org/object/68305d43-1dcd-337f-8a1c-5fa2a33ed4e3> ;
