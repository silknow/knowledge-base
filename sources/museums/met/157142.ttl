<http://data.silknow.org/object/7fbbf7ad-d810-3ed3-8675-dbca9687a884>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This dress and bodice (2009.300.2329) are particularly miniature examples of garments for liturgical effigies. They were created for figures of the Virgin and Child as indicated by the letters on the front and were presumably shown together as they match in every detail. Beautifully constructed, their fine detailing includes applied metallic cord at the hem and piping at neck and waist."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6ec8a585-eba9-3a41-a5aa-1e76529a8d74> , <http://data.silknow.org/image/ba666c42-693b-366c-8841-4a2e2382f992> ;
        ecrm:P3_has_note               "This dress and bodice (2009.300.2329) are particularly miniature examples of garments for liturgical effigies. They were created for figures of the Virgin and Child as indicated by the letters on the front and were presumably shown together as they match in every detail. Beautifully constructed, their fine detailing includes applied metallic cord at the hem and piping at neck and waist."@en ;
        dc:identifier                  "2009.300.2329" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://www.metmuseum.org/art/collection/search/157142> .

