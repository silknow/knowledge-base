        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Colorful silk embroidery complements the bleached ground of this gauze-weave linen textile. To produce such a fine, yet robust, buratto cloth, the warp and weft threads are highly twisted and plied, which creates a mesh-like surface that is well suited to receive embroidery. The cloth was woven in a narrow band and both selvages are preserved."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9cfcd3f2-ab15-314a-a087-68f99198f979> .

