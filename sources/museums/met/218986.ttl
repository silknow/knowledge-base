<http://data.silknow.org/object/135a376c-84be-3be4-b3df-0e1cadbaf0aa/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Venetian gros point lace was prized for its refined beauty long after its heyday. This maniple repurposes seventeenth-century needle lace, which has been cut up and reassembled into a new shape. This is part of the set 10.186.1, .2, .3, .5 that comprises a chasuble, maniple, stole, and chalice veil."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/135a376c-84be-3be4-b3df-0e1cadbaf0aa> .

