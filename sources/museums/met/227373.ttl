<http://data.silknow.org/object/9a4ded5c-25ca-3d55-9cab-98bcdc72a3be/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Panels such as this—with its extraordinary patterns in long repeats—were called \"bizarre\" by the Danish scholar Slomann, who believed they were made in India. Most scholars consider them an exotic phase in the history of European silk weaving."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9a4ded5c-25ca-3d55-9cab-98bcdc72a3be> .

