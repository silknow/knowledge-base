        a                         ecrm:E39_Actor , ecrm:E40_Legal_Body ;
        rdfs:label                "Petit Palais, musée des Beaux-arts de la Ville de Paris" ;
        ecrm:P1_is_identified_by  "Petit Palais, musée des Beaux-arts de la Ville de Paris" .

<http://data.silknow.org/object/34da6203-8fdf-3f1d-a23a-ff3000252acf>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "La troisième pièce de la tenture de l'histoire de saint Gervais et saint Protais représente la décollation de saint Protais. Devant les murs crénelés d'une ville, au pied d'une colonnade, une statue sur piédestal de Jupiter accompagné de son aigle sépare deux groupes de personnages ; sur la gauche, un bourreau demi-nu debout élève la tête du saint devant quelques spectateurs tandis qu'un autre, assis, retient sur le billot le corps décapité. Au premier plan, un vieillard agenouillé désigne du doigt un ange et une renommée brandissant dans les airs la palme et la couronne du martyre. Sur la droite, au pied d'un magistrat en toge dominant un grand vase, se tiennent plusieurs soldats - quelques-uns à cheval - dont l'un au premier plan empoigne un personnage assis à côté d'une femme tenant son enfant. Les bordures inférieure et supérieure, à larges rinceaux d'acanthe peuplés d'angelots, s'organisent autour d'un cartouche rectangulaire à cuirs. Les bordures latérales sont ornées d'arabesques encadrant des niches à cul-de-four en coquilles dans lesquelles se dressent des statues des deux martyrs."@fr ;
        rdfs:label                     "Décollation de saint Protais"@fr ;
        ecrm:P102_has_title            "Décollation de saint Protais"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/bc2ca9f8-2d7b-32c2-a69d-5f658b20c141> ;
        ecrm:P3_has_note               "La troisième pièce de la tenture de l'histoire de saint Gervais et saint Protais représente la décollation de saint Protais. Devant les murs crénelés d'une ville, au pied d'une colonnade, une statue sur piédestal de Jupiter accompagné de son aigle sépare deux groupes de personnages ; sur la gauche, un bourreau demi-nu debout élève la tête du saint devant quelques spectateurs tandis qu'un autre, assis, retient sur le billot le corps décapité. Au premier plan, un vieillard agenouillé désigne du doigt un ange et une renommée brandissant dans les airs la palme et la couronne du martyre. Sur la droite, au pied d'un magistrat en toge dominant un grand vase, se tiennent plusieurs soldats - quelques-uns à cheval - dont l'un au premier plan empoigne un personnage assis à côté d'une femme tenant son enfant. Les bordures inférieure et supérieure, à larges rinceaux d'acanthe peuplés d'angelots, s'organisent autour d'un cartouche rectangulaire à cuirs. Les bordures latérales sont ornées d'arabesques encadrant des niches à cul-de-four en coquilles dans lesquelles se dressent des statues des deux martyrs."@fr ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/34da6203-8fdf-3f1d-a23a-ff3000252acf/dimension/2> , <http://data.silknow.org/object/34da6203-8fdf-3f1d-a23a-ff3000252acf/dimension/1> ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/vocabulary/771> , <http://data.silknow.org/image/b8518c0b-a68d-3661-b856-120edfe1d9f7> , <http://data.silknow.org/image/b4cbb5dd-1a3b-3a53-9f3a-d318cc85024a> , <http://data.silknow.org/image/e8717bd3-730d-3547-8e94-427bb34e8e40> , <http://data.silknow.org/image/ce9b1fa6-af77-31c7-bd0a-f515824ccd5f> , <http://data.silknow.org/image/2fa2f1ca-3227-3ecf-9e4c-209b39aa0905> , <http://data.silknow.org/image/d2af03df-3116-3e22-9d62-926edbad59d1> , <http://data.silknow.org/image/d5db3abf-96e1-31d6-8437-b0335e409a6d> , <http://data.silknow.org/image/56e6510f-afa0-3814-80d0-8bf0d5479b76> , <http://data.silknow.org/image/c490b99f-92f9-3d4a-9c7d-0cf53142ed37> , <http://data.silknow.org/image/886a341a-3133-3078-adb3-e86be9fa947b> , <http://data.silknow.org/image/872b7e2d-e79e-3b25-8a8a-58401e89d06b> , <http://data.silknow.org/image/009abd51-6ef9-3f42-8793-41b9271ae503> , <http://data.silknow.org/image/75b7c2b2-4d2c-3df9-a393-759d9f06dbae> ;
        dc:identifier                  "PPO3529" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://parismuseescollections.paris.fr/node/225824> .

