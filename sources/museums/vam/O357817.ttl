<http://data.silknow.org/object/6a94ce51-9dc6-3570-b04c-d710170fd4f4>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Sampler length of white cotton with inset panels of net and muslin worked with a variety of plain sewing techniques of hemming, patchwork, darning, decoratrive hemming, drawn thread work, button-holing, gusset-making and eyelet-holes.\n\nTwo panels show decorative stitches, one of whitework filling stitches and the other of decorative designs in darning stitch and red silk on white muslin. In the centre is a panel of net on which is worked in applied muslin with 'LEONIE LAMBIN, 1846'."@en , "Sampler length of cotton with inset panels of net, possibly made in France or Belgium, 1846"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/8f10ad0a-baf1-39ec-9c8f-bf132123922d> , <http://data.silknow.org/image/9238c0b1-93a2-389f-85f3-caa0c928aed5> ;
        ecrm:P3_has_note               "Sampler length of cotton with inset panels of net, possibly made in France or Belgium, 1846"@en , "Sampler length of white cotton with inset panels of net and muslin worked with a variety of plain sewing techniques of hemming, patchwork, darning, decoratrive hemming, drawn thread work, button-holing, gusset-making and eyelet-holes.\n\nTwo panels show decorative stitches, one of whitework filling stitches and the other of decorative designs in darning stitch and red silk on white muslin. In the centre is a panel of net on which is worked in applied muslin with 'LEONIE LAMBIN, 1846'."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6a94ce51-9dc6-3570-b04c-d710170fd4f4/dimension/1> , <http://data.silknow.org/object/6a94ce51-9dc6-3570-b04c-d710170fd4f4/dimension/2> ;
