<http://data.silknow.org/object/06a77f37-6f3e-30b0-ac7f-0a042298512c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Hanging from a Buddhist temple, silk woven with human hair, Japan, Edo period, 1770-1820"@en , "This hanging from a Japanese Buddhist temple has been woven with human hair. According to information received with the object, in the Meiwa era (1764-1771) there was a deluge in the village of Takawaka, in Etchu Province. Those that survived the flood believed they had been saved by Sakyamuni, the historical Buddha. In gratitude they wove this hanging depicting Sakyamuni and presented it to the local temple."@en , "Temple hanging woven with image of Sakyamuni, the historical Buddha."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/4d074601-ae84-3714-afa8-f6a79093e143> ;
        ecrm:P3_has_note               "Hanging from a Buddhist temple, silk woven with human hair, Japan, Edo period, 1770-1820"@en , "Temple hanging woven with image of Sakyamuni, the historical Buddha."@en , "This hanging from a Japanese Buddhist temple has been woven with human hair. According to information received with the object, in the Meiwa era (1764-1771) there was a deluge in the village of Takawaka, in Etchu Province. Those that survived the flood believed they had been saved by Sakyamuni, the historical Buddha. In gratitude they wove this hanging depicting Sakyamuni and presented it to the local temple."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/06a77f37-6f3e-30b0-ac7f-0a042298512c/dimension/2> , <http://data.silknow.org/object/06a77f37-6f3e-30b0-ac7f-0a042298512c/dimension/1> ;
        dc:identifier                  "T.98-1927" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O93526> .

<http://data.silknow.org/object/06a77f37-6f3e-30b0-ac7f-0a042298512c/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This hanging from a Japanese Buddhist temple has been woven with human hair. According to information received with the object, in the Meiwa era (1764-1771) there was a deluge in the village of Takawaka, in Etchu Province. Those that survived the flood believed they had been saved by Sakyamuni, the historical Buddha. In gratitude they wove this hanging depicting Sakyamuni and presented it to the local temple."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/06a77f37-6f3e-30b0-ac7f-0a042298512c> .

