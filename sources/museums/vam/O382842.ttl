        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Vertical octagonal <i>verre églomisé</i> painting of the Adoration of the Shepherds, on a gold ground, round a central oval space.  The glass over the painting is cut to fit the shape of the pendant, but the central oval is empty, and the painting it once contained is lost.  The pendant is backed with red silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b5ae4620-2cd6-3b3f-a70b-46de3be271cb> .

