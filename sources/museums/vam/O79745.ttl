<http://data.silknow.org/object/7b1c3ff8-4068-3b72-a0ba-1a2c029f1e3a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Sash of red silk damask. There are three warp bands, excluding the left satin selvedge which measures 0.6 cm. There is a 11.3 cm weft face band and a 5 cm satin band overlaid with rose sprays joined by leaf scrolls. There is a 2.3 cm weft band with a leaf scroll on a slight meander. There are two selvedges."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7b1c3ff8-4068-3b72-a0ba-1a2c029f1e3a> .

