<http://data.silknow.org/object/cc76f54d-7dbf-3cc4-81a8-88a30fedb633>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "brocaded, 1790-1830, Persian"@en , "Woven silk brocaded with silk and metal thread.\nRed ground [faded] which seems to have floss silk weft and a much finer warp. Brocaded with light blue, blue, green and light brown floss silk and with two types of metal thread: [1] silver strip open S-wound on a yellow silk core; [2] silver strip open S-wound on a white silk core.\nThe pattern is a half-drop repeat. One row of fat silver bushes with details in light brown and light blue silk or in blue and light blue silk. One row of thin cypress trees in gold with cone-like segments in the centre brocaded in blue silk. Between each of the cypresses is a pair of 'clouds'."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/1e9590b8-b24e-3d41-810c-262b9ced1382> , <http://data.silknow.org/image/003210a1-9556-3fa9-89ff-216b23c4ae2a> , <http://data.silknow.org/image/50b5e714-174b-356c-ada4-5fd1b8878cc0> , <http://data.silknow.org/image/5946db66-5fa9-325f-b3ee-22f547cbaf57> , <http://data.silknow.org/image/76cfe829-e29c-3324-a846-f56aa53e7300> , <http://data.silknow.org/image/52922214-8e05-3de1-bd34-216da56d52b5> , <http://data.silknow.org/image/f760b844-035c-34ec-b6ea-89c72c2ac008> , <http://data.silknow.org/image/65dab746-b984-3eae-a458-3ad2d3bd66f9> , <http://data.silknow.org/image/3082bb30-8c0f-35f9-a9c1-542028c86864> , <http://data.silknow.org/image/ed616169-6b93-36ce-b0cd-8ed2774b8e1a> ;
        ecrm:P3_has_note               "brocaded, 1790-1830, Persian"@en , "Woven silk brocaded with silk and metal thread.\nRed ground [faded] which seems to have floss silk weft and a much finer warp. Brocaded with light blue, blue, green and light brown floss silk and with two types of metal thread: [1] silver strip open S-wound on a yellow silk core; [2] silver strip open S-wound on a white silk core.\nThe pattern is a half-drop repeat. One row of fat silver bushes with details in light brown and light blue silk or in blue and light blue silk. One row of thin cypress trees in gold with cone-like segments in the centre brocaded in blue silk. Between each of the cypresses is a pair of 'clouds'."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/cc76f54d-7dbf-3cc4-81a8-88a30fedb633/dimension/1> , <http://data.silknow.org/object/cc76f54d-7dbf-3cc4-81a8-88a30fedb633/dimension/2> ;
        dc:identifier                  "555-1903" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O231051> .

