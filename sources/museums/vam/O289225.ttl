        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Furnishing fabric of silk twill satin. On a purple-pink satin ground are rows of repeated pine or cone shapes borrowed from Persian shawls, filled with classical acanthus leaves, flowers and husks. These cones and the tiny cones between them are in white silk, bound in twill with a binding warp of yellow silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/477b28aa-67fd-3acf-ac77-b749058f1925> .

