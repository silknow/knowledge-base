<http://data.silknow.org/object/5a9696cd-fbba-38bc-a94b-93487f62352e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Set of fourteen blackwork panels of embroidered linen with black silk in stem and back stitches, with speckling.\n\nWith four different designs, each composed of two curved and intertwined sprays of fruit and flowers. All are enclosed by a twisted-rope border within straight lines.\n\nMeasurements are between 8 inches to 9 inches by 9 inches. The embroidered areas are approximately 7.625 inches square."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5a9696cd-fbba-38bc-a94b-93487f62352e> .

