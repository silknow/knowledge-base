<http://data.silknow.org/object/cc50293a-3aa7-3cc6-8c40-4a38e1ffbeb3/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects. In Europe in the 17th century samplers provided instruction and practice for girls learning needlework.  Sarah Brignell completed this sampler in 1780 when she was ten years old. Its deep floral border enclosing a religious verse makes it suitable for display."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cc50293a-3aa7-3cc6-8c40-4a38e1ffbeb3> .

