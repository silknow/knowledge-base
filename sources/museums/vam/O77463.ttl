<http://data.silknow.org/object/199ee580-508d-3310-b534-7053d9f2ab94/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nGaming or gambling with cards was a popular 17th-century pastime.  A gentleman or lady who did not participate in games such as 'Quadrille' and 'Basset' would have been considered 'low-bred and hardly fit for conversation' according to  'The Compleat Gamester', published in 1674. Typically, a gaming purse had a flat, circular base with sides gathered on a drawstring. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/199ee580-508d-3310-b534-7053d9f2ab94> .

