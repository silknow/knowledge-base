<http://data.silknow.org/object/199ee580-508d-3310-b534-7053d9f2ab94/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Gaming purse of green silk velvet, lined with white silk taffeta. It has circular base reinforced with pasteboard; the sides pleated and pulled together with drawstrings of narrow copper gilt braid and 2 spherical tassels of silver wire, net and filé and purl. The sides and top edge are couched with copper gilt braid."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/199ee580-508d-3310-b534-7053d9f2ab94> .

