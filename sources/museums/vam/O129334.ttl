<http://data.silknow.org/object/b8f15ecb-a29c-38d3-876c-0d082c0373c7>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dalmatic, green damask, with yellow applique and embroidery, Italian, 16th century."@en , "Dalmatic of green silk damask, with yellow appliqué and embroidery, all decorative except for the letters embroidered in the panels on front and back: AV (Ave Maria) and IHS (Jesus Christ). The damask has a pattern of ogee-shaped compartments outlined by scrolling leafy stems, and issuing form vases decorated with imbrication; the compartments are filled with plants bearing flowers and fruit. Three large red and white tassels still attached to cords at neck."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e4be5c7d-a763-31c8-8bf7-c55408094ff5> , <http://data.silknow.org/image/7c18eb0a-a2b7-3c53-a5f9-1b3bca8d8578> , <http://data.silknow.org/image/be734ea7-8cf1-3795-be3f-03efac061efa> , <http://data.silknow.org/image/c690ebd6-c0e7-3801-b33e-d13aed99e10f> ;
        ecrm:P3_has_note               "Dalmatic, green damask, with yellow applique and embroidery, Italian, 16th century."@en , "Dalmatic of green silk damask, with yellow appliqué and embroidery, all decorative except for the letters embroidered in the panels on front and back: AV (Ave Maria) and IHS (Jesus Christ). The damask has a pattern of ogee-shaped compartments outlined by scrolling leafy stems, and issuing form vases decorated with imbrication; the compartments are filled with plants bearing flowers and fruit. Three large red and white tassels still attached to cords at neck."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/b8f15ecb-a29c-38d3-876c-0d082c0373c7/dimension/3> , <http://data.silknow.org/object/b8f15ecb-a29c-38d3-876c-0d082c0373c7/dimension/1> , <http://data.silknow.org/object/b8f15ecb-a29c-38d3-876c-0d082c0373c7/dimension/2> ;
