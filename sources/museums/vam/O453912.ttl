<http://data.silknow.org/object/61346a8d-b584-3e26-a08c-4ddaa4ce62f7>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Textiles, 4 uncut silk handkerchiefs, Tiruchchirappalli, ca. 1855."@en , "Length of silk, comprising four uncut handkerchiefs of red and white checked silk, with spots of gold-wrapped thread in the centre of each check."@en , "MADRAS HANDKERCHIEFS \n\nSouth Indian handkerchiefs - worn around the neck, the waist, or as a head-coverwere sold around the world. Ikat-dyed handkerchiefs from the south-east coast, known as telia rumals, were sent to the Persian Gulf. Madras-check cottons from south India were a major component of the British trade with West Africa. From Africa, they travelled with the slave trade to the West Indies. More elegant versions were made in silk and metal thread.\n\nLength of telia rumals\nCotton (double ikat weave)\nChirala, Andhra Pradesh, 1994\nV&A: 1S.9-1994\n\nLength of cotton Madras-check handkerchiefs\nMangalore, Karnataka, about 1855\nV&A: 4869 (IS)\n\nLength of silk Madras-check handkerchiefs\nSilk with metal-wrapped thread\nTiruchirappalli (Trichinopoly), Tamil Nadu, about 1855\nV&A: 4915 (IS) [03/10/2015-10/01/2016]"@en , "Intended for use as handkerchiefs when cut."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/36a2e5c5-01e5-3508-9697-5d60201280b2> ;
        ecrm:P3_has_note               "Intended for use as handkerchiefs when cut."@en , "Textiles, 4 uncut silk handkerchiefs, Tiruchchirappalli, ca. 1855."@en , "MADRAS HANDKERCHIEFS \n\nSouth Indian handkerchiefs - worn around the neck, the waist, or as a head-coverwere sold around the world. Ikat-dyed handkerchiefs from the south-east coast, known as telia rumals, were sent to the Persian Gulf. Madras-check cottons from south India were a major component of the British trade with West Africa. From Africa, they travelled with the slave trade to the West Indies. More elegant versions were made in silk and metal thread.\n\nLength of telia rumals\nCotton (double ikat weave)\nChirala, Andhra Pradesh, 1994\nV&A: 1S.9-1994\n\nLength of cotton Madras-check handkerchiefs\nMangalore, Karnataka, about 1855\nV&A: 4869 (IS)\n\nLength of silk Madras-check handkerchiefs\nSilk with metal-wrapped thread\nTiruchirappalli (Trichinopoly), Tamil Nadu, about 1855\nV&A: 4915 (IS) [03/10/2015-10/01/2016]"@en , "Length of silk, comprising four uncut handkerchiefs of red and white checked silk, with spots of gold-wrapped thread in the centre of each check."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/61346a8d-b584-3e26-a08c-4ddaa4ce62f7/dimension/1> , <http://data.silknow.org/object/61346a8d-b584-3e26-a08c-4ddaa4ce62f7/dimension/2> ;
