        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered sampler"@en , "Linen sampler embroidered with silk and linen; English; mid 17th century."@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler, and its decoration incorporates different types of whitework embroidery and needle lace stitches. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e1df03d4-0872-39b4-a9b9-9d424b305401> , <http://data.silknow.org/image/3ea2ebfe-0bbe-3d6e-96e5-2018e15dc7ad> , <http://data.silknow.org/image/6d48ba22-5b48-34cd-8ac1-3107b9d7cde8> , <http://data.silknow.org/image/7d398d7c-1c03-3c93-8ca2-f08026934227> ;
        ecrm:P3_has_note               "Linen sampler embroidered with silk and linen; English; mid 17th century."@en , "Embroidered sampler"@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler, and its decoration incorporates different types of whitework embroidery and needle lace stitches. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en ;
