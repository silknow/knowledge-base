<http://data.silknow.org/object/a6d192a4-1fa6-3746-8d31-6ad11cf3cf4d>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk bonnet, England, ca. 1830"@en , "Pink silk bonnet with a wide brim and soft high crown. The bonnet is gathered onto narrow bands of whalebone inserted in tucks in the brim and around the crown. There is a small neck frill. It is trimmed with matching ribbon which surrounds the crown and forms bonnet strings and there are two bows on the back of the crown. The brim is stiffened with wire."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0015478e-af2a-3fef-aab0-e25c523bfc08> ;
        ecrm:P3_has_note               "Silk bonnet, England, ca. 1830"@en , "Pink silk bonnet with a wide brim and soft high crown. The bonnet is gathered onto narrow bands of whalebone inserted in tucks in the brim and around the crown. There is a small neck frill. It is trimmed with matching ribbon which surrounds the crown and forms bonnet strings and there are two bows on the back of the crown. The brim is stiffened with wire."@en ;
        dc:identifier                  "T.201-1960" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O355029> .

