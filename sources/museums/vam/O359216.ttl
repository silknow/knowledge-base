<http://data.silknow.org/object/047da2b4-c856-34d2-9481-e4e30feb0293>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Parasol with an embroidered silk cover and carved wooden stick, England, ca. 1870"@en , "Parasol with a black silk cover with a palmette type design in black jet beads embroidered with each panel. Lined with white silk. The stick is short and is made from brass metal as are the ribs, tips and the two catches. The finial has an acorn tip and it and the handle, which is club shaped with open work and has a rustic finish, are of carved black stained wood. A black silk double tassel is attached below the finial."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c9a4c03c-8299-3e9e-8f16-54eadd541374> ;
        ecrm:P3_has_note               "Parasol with an embroidered silk cover and carved wooden stick, England, ca. 1870"@en , "Parasol with a black silk cover with a palmette type design in black jet beads embroidered with each panel. Lined with white silk. The stick is short and is made from brass metal as are the ribs, tips and the two catches. The finial has an acorn tip and it and the handle, which is club shaped with open work and has a rustic finish, are of carved black stained wood. A black silk double tassel is attached below the finial."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/047da2b4-c856-34d2-9481-e4e30feb0293/dimension/1> ;
