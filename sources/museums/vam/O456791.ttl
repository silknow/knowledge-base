        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pair of rank badges of silk tapestry (kesi), China, 19th century"@en , "Pair of square mandarin rank badges of woven silk tapestry (kesi) in gold thread and coloured silks.\n\nEach square is woven with a design of a goose, the insignia of a civil official of the fourth rank, and background of water, waves, rocks, clouds and Taoist symbols.\n\nFront square is 12.25 ins x 13 in, back square 12.25 x 12.25 ins."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/864af857-b2db-34f4-85f8-9a83ca821243> , <http://data.silknow.org/image/0f94f9fc-fb21-3af2-ac40-d39aca05f1fe> ;
        ecrm:P3_has_note               "Pair of rank badges of silk tapestry (kesi), China, 19th century"@en , "Pair of square mandarin rank badges of woven silk tapestry (kesi) in gold thread and coloured silks.\n\nEach square is woven with a design of a goose, the insignia of a civil official of the fourth rank, and background of water, waves, rocks, clouds and Taoist symbols.\n\nFront square is 12.25 ins x 13 in, back square 12.25 x 12.25 ins."@en ;
