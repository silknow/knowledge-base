<http://data.silknow.org/object/48aff4d3-9a8c-367d-aec5-a809cdfe0bbe/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Roundel of dark blue silk cut from an Emperor's or Prince's surcoat, formed out of two hemispheric panels. It is embroidered in coloured silk and silver gilt threads in long and short, satin and stem stitches with couched work. It bears a front-facing  five-clawed dragon encircling a flaming jewel, amidst clouds, bats and swastikas with sea waves below. The mountain is one of the twelve imperial symbols.\n\nFrame is a latter-day addition."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/48aff4d3-9a8c-367d-aec5-a809cdfe0bbe> .

<http://data.silknow.org/object/48aff4d3-9a8c-367d-aec5-a809cdfe0bbe/domain/3>
