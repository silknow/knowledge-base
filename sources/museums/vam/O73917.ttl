<http://data.silknow.org/object/472dad05-6473-3749-aecb-668a917c3ebe/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Armchair in carved and gilded limewood, upholstered with modern green silk damask. From a set of seat furniture designed by James Stuart for Spencer House, London. English, 1759."@en ;
