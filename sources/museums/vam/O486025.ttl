<http://data.silknow.org/object/6c8ee0a4-0ac9-3b6b-bfc4-27790f994dfe>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Textile fragment of brocaded silk in silks and gilt paper strips. Pattern in yellow and straw colour on a dark blue ground. Large intersecting squares with wide borders filled with fret work. The squares contain phoenixes or dragons enclosed by scrolled and interlacing ornament, and on a ground filled with diaper or pairs of doves and clouds. At the points of intersection are large compartments of undulating forms, each enclosing a rectangle within which is a cash device with a flower lozenge surrounded by blossom and foliage."@en , "Textile fragment of brocaded silk in silks and gilt paper strips, Japan, first half of 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7fa0731b-ce47-32e6-acc0-d692f143b1e8> ;
        ecrm:P3_has_note               "Textile fragment of brocaded silk in silks and gilt paper strips, Japan, first half of 19th century"@en , "Textile fragment of brocaded silk in silks and gilt paper strips. Pattern in yellow and straw colour on a dark blue ground. Large intersecting squares with wide borders filled with fret work. The squares contain phoenixes or dragons enclosed by scrolled and interlacing ornament, and on a ground filled with diaper or pairs of doves and clouds. At the points of intersection are large compartments of undulating forms, each enclosing a rectangle within which is a cash device with a flower lozenge surrounded by blossom and foliage."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6c8ee0a4-0ac9-3b6b-bfc4-27790f994dfe/dimension/1> , <http://data.silknow.org/object/6c8ee0a4-0ac9-3b6b-bfc4-27790f994dfe/dimension/2> ;
        dc:identifier                  "T.88-1914" ;
