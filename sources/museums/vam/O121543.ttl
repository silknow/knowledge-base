<http://data.silknow.org/object/6f3b3aa1-99fa-307f-a1ff-7213400bc7e1>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Tex, Japan, woven. Kesa (Buddhist priest's mantle)"@en , "This is a kesa, the rectangular garment worn by Japanese Buddhist priests. Kesa are made of a sewn patchwork of cloth, the arrangement of the sections of fabric into columns surrounded by a border serving as a mandala, a symbolic rendering of the universe. The central column represents the Buddha, the two columns either side his attendants, and the four patches at the corners the cardinal directions. The act of sewing the garment is in itself a devotional pursuit."@en , "Buddhist robe (kesa) patterned with scrolling floral stems on a green ground"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/1dbd1879-4da6-375a-8466-88c1e017c47e> ;
        ecrm:P3_has_note               "Tex, Japan, woven. Kesa (Buddhist priest's mantle)"@en , "Buddhist robe (kesa) patterned with scrolling floral stems on a green ground"@en , "This is a kesa, the rectangular garment worn by Japanese Buddhist priests. Kesa are made of a sewn patchwork of cloth, the arrangement of the sections of fabric into columns surrounded by a border serving as a mandala, a symbolic rendering of the universe. The central column represents the Buddha, the two columns either side his attendants, and the four patches at the corners the cardinal directions. The act of sewing the garment is in itself a devotional pursuit."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6f3b3aa1-99fa-307f-a1ff-7213400bc7e1/dimension/2> , <http://data.silknow.org/object/6f3b3aa1-99fa-307f-a1ff-7213400bc7e1/dimension/1> ;
        dc:identifier                  "928-1897" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O121543> .

<http://data.silknow.org/object/6f3b3aa1-99fa-307f-a1ff-7213400bc7e1/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This is a kesa, the rectangular garment worn by Japanese Buddhist priests. Kesa are made of a sewn patchwork of cloth, the arrangement of the sections of fabric into columns surrounded by a border serving as a mandala, a symbolic rendering of the universe. The central column represents the Buddha, the two columns either side his attendants, and the four patches at the corners the cardinal directions. The act of sewing the garment is in itself a devotional pursuit."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6f3b3aa1-99fa-307f-a1ff-7213400bc7e1> .

