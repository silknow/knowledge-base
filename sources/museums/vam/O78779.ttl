<http://data.silknow.org/object/747f135a-0a2e-3e37-8d2e-0cc9151ed8b1/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nTIES<br>\nTies came in a variety of colours and styles and were still known as cravats. Some were tied by hand while others were ready-made into knots. Ready-mades had a cardboard stiffener to keep the knot in place. They were fastened around the neck with a buckle, catch or piece of elastic. [27/03/2003]"@en ;
