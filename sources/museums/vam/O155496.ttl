<http://data.silknow.org/event/f6b0899a-3118-3c3b-a86c-586234fedd3f>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "T.134 to 143-1917 came from Viscountess Olseley whose husband had served with the British forces in China in 1860 and who wrote a book about the campaign and his experiences, in which he comments on the yellow cushions he saw in the Summer Palace and the fact that only members of the imperial family are able to use this colour. The Summer Palace or Yuanmingyuan, located north of Beijing, was destroyed by British and French troops during the Second Opium War in 1860."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/50e4b045-1548-3512-a4c2-645ce927b1c1> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by the Dowager Viscountess Wolseley" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/91126607-68c5-3158-8942-aff38fbc44d0> ;
        ecrm:P3_has_note               "T.134 to 143-1917 came from Viscountess Olseley whose husband had served with the British forces in China in 1860 and who wrote a book about the campaign and his experiences, in which he comments on the yellow cushions he saw in the Summer Palace and the fact that only members of the imperial family are able to use this colour. The Summer Palace or Yuanmingyuan, located north of Beijing, was destroyed by British and French troops during the Second Opium War in 1860."@en .

