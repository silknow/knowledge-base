<http://data.silknow.org/object/3639f7ab-6436-3b8e-9ba6-6ed0687509bd/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress made from saffron yellow silk twill, trimmed with beige crystal bead appliqué at the waist. It has a V-neck and long sleeves with peaked and gathered beads, a low waist with a loose cut front panel, smocked at the neck and waist. The back is fitted with a series of inverted pleats at the centre back with an inverted pleat flanking it at either side.\n\nThe bodice is lined with yellow cotton and the rest with cream calico. The hem is interfaced and the whole dress is machine stitched. There is a tye tape for adjustment at the centre back waist.\n\nThe lining fastens with pearl buttons and the dress fastens over with white metal Nicholls patent dress fasteners and white metal eyes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/3639f7ab-6436-3b8e-9ba6-6ed0687509bd> .

<http://data.silknow.org/object/3639f7ab-6436-3b8e-9ba6-6ed0687509bd>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dress of silk with bead appliqué, England, 1889-1890"@en , "Dress made from saffron yellow silk twill, trimmed with beige crystal bead appliqué at the waist. It has a V-neck and long sleeves with peaked and gathered beads, a low waist with a loose cut front panel, smocked at the neck and waist. The back is fitted with a series of inverted pleats at the centre back with an inverted pleat flanking it at either side.\n\nThe bodice is lined with yellow cotton and the rest with cream calico. The hem is interfaced and the whole dress is machine stitched. There is a tye tape for adjustment at the centre back waist.\n\nThe lining fastens with pearl buttons and the dress fastens over with white metal Nicholls patent dress fasteners and white metal eyes."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/188101f5-5422-321c-accc-deb917d2122f> , <http://data.silknow.org/image/dc86c8d1-8db1-34c4-8cee-bf4221453f0b> , <http://data.silknow.org/image/8d9a9df8-cb2a-3a54-a7bd-79aa3a7d8683> , <http://data.silknow.org/image/a87f4505-0042-397c-8f05-8b44077dce7e> , <http://data.silknow.org/image/b4984b70-6dd1-33dc-a25c-9f0792b19e47> , <http://data.silknow.org/image/1faa73b9-2e5d-338c-9484-5c51dac21808> , <http://data.silknow.org/image/386830f5-b8ed-3a00-abf9-2bf2ef6e1e7a> , <http://data.silknow.org/image/5bd412be-e94b-3ccc-bfa0-337522b286b7> , <http://data.silknow.org/image/00ab2c10-7a3d-3b8b-9f07-9c871c7a71fc> , <http://data.silknow.org/image/8978a4cc-1ecc-3367-b187-ba53899c727c> , <http://data.silknow.org/image/650a9f62-9704-31ea-b81f-6f2e68baa5af> , <http://data.silknow.org/image/bab4100c-a0ae-3915-8a71-893682fe300c> , <http://data.silknow.org/image/5032b695-0872-300b-a93e-81d7471c287e> , <http://data.silknow.org/image/c9e7e819-4893-37dd-9b7e-f6507c4a2abf> , <http://data.silknow.org/image/9f070136-c576-3f2b-babb-0f1807d244f6> ;
        ecrm:P3_has_note               "Dress of silk with bead appliqué, England, 1889-1890"@en , "Dress made from saffron yellow silk twill, trimmed with beige crystal bead appliqué at the waist. It has a V-neck and long sleeves with peaked and gathered beads, a low waist with a loose cut front panel, smocked at the neck and waist. The back is fitted with a series of inverted pleats at the centre back with an inverted pleat flanking it at either side.\n\nThe bodice is lined with yellow cotton and the rest with cream calico. The hem is interfaced and the whole dress is machine stitched. There is a tye tape for adjustment at the centre back waist.\n\nThe lining fastens with pearl buttons and the dress fastens over with white metal Nicholls patent dress fasteners and white metal eyes."@en ;
