<http://data.silknow.org/object/00172c45-cf85-3f8e-b786-f4b5cc321813/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Wool-holder consisting of a spherical container of varnished wood. Made in two halves, the join is disguised by a raised rib round the centre. The upper half has a central hole for the wool to run through and has a loop handle of red silk cord. It is decorated on one side with a transfer print of the West Pier, Brighton."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/00172c45-cf85-3f8e-b786-f4b5cc321813> .

