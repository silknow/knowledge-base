                <https://collections.vam.ac.uk/item/O10808> .

<http://data.silknow.org/object/eb280a0d-9169-3f54-9758-09076bedcdbb/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nA burse was the ceremonial purse in which the Lord Chancellors of England kept the Great Seal, a symbol of the majesty of the law. They were intended to protect the contents from damage. A miniature portrait on display in gallery 57 shows Sir Christopher Hatton (1540-1591), Chancellor to Elizabeth I with a large burse which, from the decoration, may be the one on display. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/eb280a0d-9169-3f54-9758-09076bedcdbb> .

