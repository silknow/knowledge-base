<http://data.silknow.org/object/4d00ee7f-cb6a-3d4f-af1d-421906c9ce23>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dress fabric of silk taffeta, England, ca. 1825-1850"@en , "Dress fabric of orange silk taffeta, striped in the warp with fine black stripes, and shaded with mauve and brown. White band in the weft at intervals of 0.19 inch that form checks with the warp stripe. Probably from the end of a piece as there are three thicker bands at one end woven in white silk twill. The selvedges consists of 0.125 inch slightly more densely woven tabby and one outer cordonnet."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/48c4125f-db00-3bd4-a767-136940abdf59> ;
        ecrm:P3_has_note               "Dress fabric of orange silk taffeta, striped in the warp with fine black stripes, and shaded with mauve and brown. White band in the weft at intervals of 0.19 inch that form checks with the warp stripe. Probably from the end of a piece as there are three thicker bands at one end woven in white silk twill. The selvedges consists of 0.125 inch slightly more densely woven tabby and one outer cordonnet."@en , "Dress fabric of silk taffeta, England, ca. 1825-1850"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4d00ee7f-cb6a-3d4f-af1d-421906c9ce23/dimension/1> , <http://data.silknow.org/object/4d00ee7f-cb6a-3d4f-af1d-421906c9ce23/dimension/2> ;
