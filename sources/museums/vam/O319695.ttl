        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Fabric of brocaded silk with a cream ribbed ground. It has a self-coloured trail of lace brocaded with roses and other flowers in formal design, with coloured silks, silver thread and silver strip. The stems are bright green, some flowers are blue and the roses are in shades of pink and crimson."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/fad6b254-0e73-3a86-b48d-dff9561e9c7e> .

