<http://data.silknow.org/object/b287ad08-704d-396f-956a-dd77dc156166>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Handkerchief of plate-printed silk, England, ca. 1851"@en , "Handkerchief of plate-printed silk. Printed in black on white silk with an interior view of the Crystal Palace. There is a broad border printed in colour with the flags of nations participating and a red outer border. Coats of arms are in the four corners and along the top of the handkerchief are the Royal Arms of England flanked by portraits of Prince Albert on the left and Queen Victoria on the right. There is a signature in the lower left of the Palace."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/1e582223-f86b-3d1d-9efb-dda562c135d3> ;
        ecrm:P3_has_note               "Handkerchief of plate-printed silk. Printed in black on white silk with an interior view of the Crystal Palace. There is a broad border printed in colour with the flags of nations participating and a red outer border. Coats of arms are in the four corners and along the top of the handkerchief are the Royal Arms of England flanked by portraits of Prince Albert on the left and Queen Victoria on the right. There is a signature in the lower left of the Palace."@en , "Handkerchief of plate-printed silk, England, ca. 1851"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/b287ad08-704d-396f-956a-dd77dc156166/dimension/2> , <http://data.silknow.org/object/b287ad08-704d-396f-956a-dd77dc156166/dimension/1> ;
