<http://data.silknow.org/object/84c5f601-d6e0-3ee9-b1de-22aff2af6d13>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk programme produced for a special matinee at the Grand Theatre Fulham, 7 July 1898 featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils."@en , "Cream satin programme with blue typography, printed on one side only for a special matinée at the Grand Theatre Fulham, 7 July 1898 featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils. Featuring a cast list on the left hand side of the programme, with the name of the theatre and Sarah Bernhardt's name within a decorative blue border, and on the right hand side a synopsis of scenery and programme of music, again within a decorative blue border. The cream silk forms its own narrow fringe on the left and right hand edges."@en , "Silk programme produced for a special matinee at the Grand Theatre, Fulham, 7 July 1898, featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e22708a6-f835-34a2-9e22-00daa0edd58e> ;
        ecrm:P3_has_note               "Silk programme produced for a special matinee at the Grand Theatre Fulham, 7 July 1898 featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils."@en , "Silk programme produced for a special matinee at the Grand Theatre, Fulham, 7 July 1898, featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils."@en , "Cream satin programme with blue typography, printed on one side only for a special matinée at the Grand Theatre Fulham, 7 July 1898 featuring Sarah Bernhardt as Marguerite Gautier in <i>La Dame Aux Camelias</i> by Alexandre Dumas, Fils. Featuring a cast list on the left hand side of the programme, with the name of the theatre and Sarah Bernhardt's name within a decorative blue border, and on the right hand side a synopsis of scenery and programme of music, again within a decorative blue border. The cream silk forms its own narrow fringe on the left and right hand edges."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/84c5f601-d6e0-3ee9-b1de-22aff2af6d13/dimension/1> , <http://data.silknow.org/object/84c5f601-d6e0-3ee9-b1de-22aff2af6d13/dimension/3> , <http://data.silknow.org/object/84c5f601-d6e0-3ee9-b1de-22aff2af6d13/dimension/2> ;
