        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Black and white rectangular silk shawl, field with staggered rows of white flowers on black ground, attached side borders with floral meander in brown on white ground. attached end panels with large white butas on black ground. Woven in a weft-faced twill with brown warps and black or white wefts. Fringes at both ends."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/89023c34-aa98-36d5-ba17-6b444a065a8e> .

