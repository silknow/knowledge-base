<http://data.silknow.org/object/9105dc83-28b0-3034-a215-026de593d919>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Fabric of brocaded silk with a pattern of palmettes in ogee-shaped compartments formed by a lattice of plain scrollwork. The palmettes are in yellow with green outlines with a few details in blue or white, the latter nearly all worn away. The ground is red with a figured green floral pattern. The silk has been joined in the centre, selvage to selvage and the central motifs along the edges have not been brocaded."@en , "Fabric of brocaded silk, Turkey, 1500-1549"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d30d5f26-81b5-36c3-b325-5ae7ef04ee47> ;
        ecrm:P3_has_note               "Fabric of brocaded silk, Turkey, 1500-1549"@en , "Fabric of brocaded silk with a pattern of palmettes in ogee-shaped compartments formed by a lattice of plain scrollwork. The palmettes are in yellow with green outlines with a few details in blue or white, the latter nearly all worn away. The ground is red with a figured green floral pattern. The silk has been joined in the centre, selvage to selvage and the central motifs along the edges have not been brocaded."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/9105dc83-28b0-3034-a215-026de593d919/dimension/2> , <http://data.silknow.org/object/9105dc83-28b0-3034-a215-026de593d919/dimension/4> , <http://data.silknow.org/object/9105dc83-28b0-3034-a215-026de593d919/dimension/1> , <http://data.silknow.org/object/9105dc83-28b0-3034-a215-026de593d919/dimension/3> ;
