<http://data.silknow.org/object/54731786-b749-3cec-babe-460a1006c81f>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Men's high-waisted trousers with a centre front fastening covered by front falls fastening at each hip. The legs are short finishing above the ankles. There are no pockets. There are four buttons, for braces, two at the front and two at the back of the waistband. There are eleven buttons altogether. The trousers are made of cream silk with a woven stripe in blue and green. \n\nAt a later date (in 19th century or 20th century) the legs were shortened and the bottom of the left leg was repaired with a matching piece of silk. All these alterations were made with mercerised cotton whereas the trousers have been originally sewn with cream silk."@en , "Men's high-waisted silk trousers 'Incroyable', probably made in England, ca. 1820"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/159f7237-a3c2-3bc5-8a86-e2530153e65e> , <http://data.silknow.org/image/489800cb-546f-3d90-a958-e249cc38f993> ;
        ecrm:P3_has_note               "Men's high-waisted silk trousers 'Incroyable', probably made in England, ca. 1820"@en , "Men's high-waisted trousers with a centre front fastening covered by front falls fastening at each hip. The legs are short finishing above the ankles. There are no pockets. There are four buttons, for braces, two at the front and two at the back of the waistband. There are eleven buttons altogether. The trousers are made of cream silk with a woven stripe in blue and green. \n\nAt a later date (in 19th century or 20th century) the legs were shortened and the bottom of the left leg was repaired with a matching piece of silk. All these alterations were made with mercerised cotton whereas the trousers have been originally sewn with cream silk."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/54731786-b749-3cec-babe-460a1006c81f/dimension/2> , <http://data.silknow.org/object/54731786-b749-3cec-babe-460a1006c81f/dimension/1> , <http://data.silknow.org/object/54731786-b749-3cec-babe-460a1006c81f/dimension/4> , <http://data.silknow.org/object/54731786-b749-3cec-babe-460a1006c81f/dimension/3> ;
