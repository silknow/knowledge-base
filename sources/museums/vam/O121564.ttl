<http://data.silknow.org/object/8eb1faf1-584f-3b69-aaec-18e949d843d5/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This painted silk resembles the wallpapers made in Canton (Guangzhou) for export, suggesting that it might have come from the same workshops that produced export wallpapers. \n\nNeither wallpapers nor painted silk of this sort played a large part in Chinese interiors, while such painted pieces were often found in the furnishing of European homes. \n\nThis painted silk textile might have been used as a bedcover."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8eb1faf1-584f-3b69-aaec-18e949d843d5> .

<http://data.silknow.org/object/8eb1faf1-584f-3b69-aaec-18e949d843d5/domain/3>
