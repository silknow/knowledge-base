<http://data.silknow.org/object/6c81964a-c89c-3d9e-9892-f9808e08ee80>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Woman's surcoat, silk tapestry (<i>kesi</i>), China, Qing dynasty, Qianlong period (1736-1795)."@en , "Woman's surcoat of silk tapestry (<i>kesi</i>). Ornaments on a dark blue plain weave ground; eight large roundels and six small sleeve roundels containing cranes holding peaches of longevity surrounded by cloud bands and the symbols of the eight Daoist Immortals; a deep border of sea, mountains and lotus flowers. The surcoat fastens down the centre front with 5 pairs of loops, a button still remains at the neck; the skirt is split on either side, to the knee; wide loose sleeves. The robe is lined with blue silk."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d7cc2f14-09ca-3780-b5f2-95a1aa5c525b> , <http://data.silknow.org/image/a29a8961-653b-351f-b04c-5d5d572b33df> ;
        ecrm:P3_has_note               "Woman's surcoat, silk tapestry (<i>kesi</i>), China, Qing dynasty, Qianlong period (1736-1795)."@en , "Woman's surcoat of silk tapestry (<i>kesi</i>). Ornaments on a dark blue plain weave ground; eight large roundels and six small sleeve roundels containing cranes holding peaches of longevity surrounded by cloud bands and the symbols of the eight Daoist Immortals; a deep border of sea, mountains and lotus flowers. The surcoat fastens down the centre front with 5 pairs of loops, a button still remains at the neck; the skirt is split on either side, to the knee; wide loose sleeves. The robe is lined with blue silk."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6c81964a-c89c-3d9e-9892-f9808e08ee80/dimension/1> ;
        dc:identifier                  "T.207-1948" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O485654> .

