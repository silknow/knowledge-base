        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Silk embroidery on linen in red and dark green, with long-armed cross, cross, and back stitches. The pattern depicts a columbarium pedestal, spreading out at top and bottom. The body of the design is reserved in the colour of the linen and the background is worked."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/32d23714-b9ac-38e3-b3b6-27e25d736dae> .

