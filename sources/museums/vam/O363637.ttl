<http://data.silknow.org/object/fe6fd41b-94f2-33b2-af68-cdc6cdd44fe7>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Handkerchief of plate-printed silk, engraving by George Vertue, England, 1747"@en , "Handkerchief of plate-printed silk. The Oxford Almanack of 1747 is printed in black on a very fine silk taffeta with a white centre and broad rose-coloured borders. On the top and sides is printed a calendar giving the terms and saints' days, and in the centre is a view of Saint Edmund Hall. Below this is a portrait of Queen Caroline with a university official kneeling before her. On the right is another official pointing to a plan of Saint Edmund Hall which he is holding in his left hand. On the left in the foreground is the inscription 'G. Vertue Sculp.'."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7b96e48e-cc48-3d12-9467-3fec8a76b615> ;
        ecrm:P3_has_note               "Handkerchief of plate-printed silk, engraving by George Vertue, England, 1747"@en , "Handkerchief of plate-printed silk. The Oxford Almanack of 1747 is printed in black on a very fine silk taffeta with a white centre and broad rose-coloured borders. On the top and sides is printed a calendar giving the terms and saints' days, and in the centre is a view of Saint Edmund Hall. Below this is a portrait of Queen Caroline with a university official kneeling before her. On the right is another official pointing to a plan of Saint Edmund Hall which he is holding in his left hand. On the left in the foreground is the inscription 'G. Vertue Sculp.'."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/fe6fd41b-94f2-33b2-af68-cdc6cdd44fe7/dimension/1> , <http://data.silknow.org/object/fe6fd41b-94f2-33b2-af68-cdc6cdd44fe7/dimension/2> ;
