<http://data.silknow.org/object/d17483ac-32c5-3719-9d3f-061fe5f00d08>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Jennifer Wearden, \"Azerbaijan Embroideries, A Synthesis of Contrasts\", <i>Hali</i> 59 (October 1991) pp.102-111: figs.6-6a.\r\nThis embroidery belongs to Group 1 sub group 2 as defined by Jennifer Wearden: this subgroup is characterised by cross stitch in dark, strong colours, with design featuring central medallion with cartouche-like compartments."@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/b75385ec-dc35-3895-ac27-7d3e3bba3093> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Jennifer Wearden, \"Azerbaijan Embroideries, A Synthesis of Contrasts\", <i>Hali</i> 59 (October 1991) pp.102-111: figs.6-6a.\r\nThis embroidery belongs to Group 1 sub group 2 as defined by Jennifer Wearden: this subgroup is characterised by cross stitch in dark, strong colours, with design featuring central medallion with cartouche-like compartments."@en .

