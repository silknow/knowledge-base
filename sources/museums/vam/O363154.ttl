<http://data.silknow.org/object/d06e5239-2a3d-3274-bc3a-dd894ec3e313>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Shawl of woven wool, possibly made in England or Paisley, ca. 1858-1865"@en , "Shawl of woven wool. At each end the deep border contains two 'architectural' features containing cone shapes in arches. Between them is a central motif of a pointed oval with fancy fillings which is repeated at the sides, leaving two plain red 'centres' with cones and fronds. \n\nThe colours are red, pink, pale blue, dark olive-green, dark brown, white, pale yellow and touches of 'orange' formed by a red and yellow weft passed together. \n\nThere are woven end pieces with dyed warp fringe, red, dark red, brown, pink, pale blue, dark-green, black wool, and possibly silk."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3fd94d52-102b-31fd-ae8f-c1819faba06f> , <http://data.silknow.org/image/a501ff19-a1ca-3b78-b523-5899580b041a> , <http://data.silknow.org/image/8c61d5d5-fb45-35ed-b966-b1fd217df91e> , <http://data.silknow.org/image/c91977ff-a63f-385a-af52-629bb6dd4a3e> ;
        ecrm:P3_has_note               "Shawl of woven wool, possibly made in England or Paisley, ca. 1858-1865"@en , "Shawl of woven wool. At each end the deep border contains two 'architectural' features containing cone shapes in arches. Between them is a central motif of a pointed oval with fancy fillings which is repeated at the sides, leaving two plain red 'centres' with cones and fronds. \n\nThe colours are red, pink, pale blue, dark olive-green, dark brown, white, pale yellow and touches of 'orange' formed by a red and yellow weft passed together. \n\nThere are woven end pieces with dyed warp fringe, red, dark red, brown, pink, pale blue, dark-green, black wool, and possibly silk."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/d06e5239-2a3d-3274-bc3a-dd894ec3e313/dimension/4> , <http://data.silknow.org/object/d06e5239-2a3d-3274-bc3a-dd894ec3e313/dimension/3> , <http://data.silknow.org/object/d06e5239-2a3d-3274-bc3a-dd894ec3e313/dimension/1> , <http://data.silknow.org/object/d06e5239-2a3d-3274-bc3a-dd894ec3e313/dimension/2> ;
