<http://data.silknow.org/object/b79736e1-e836-3901-acc7-af2e4d8f80f8/dimension/3>
        a                   ecrm:E54_Dimension ;
        rdfs:comment        "selvedge to selvedge" ;
        rdfs:label          "Width: 17.25 in selvedge to selvedge" ;
        ecrm:P2_has_type    <http://data.silknow.org/dimension/width> ;
