<http://data.silknow.org/object/fc6b91b2-6186-3fa9-865d-33af3d9035fb>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pattern book 'Twilled sarsnetts' containing 270 pages of mounted samples of silk, probably made in Spitalfields, London, ca. 1810-1820"@en , "Pattern book containing 270 pages of mounted silk samples of linings and dress materials. Each page is headed with the type of silk and each sample is numbered. Silks are 'twilled sarsnetts'. Textured patterns - flush, brocaded, canelle, figured, sarsnetts, tabby. Watermarked flyleaf with '1810'."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c2216328-d1e9-3267-bc41-120e5710b6c1> , <http://data.silknow.org/image/0d1eb094-3e81-3299-b06f-94c2cb38ee72> , <http://data.silknow.org/image/9e84145e-e25b-377c-928b-88227babde9f> ;
        ecrm:P3_has_note               "Pattern book 'Twilled sarsnetts' containing 270 pages of mounted samples of silk, probably made in Spitalfields, London, ca. 1810-1820"@en , "Pattern book containing 270 pages of mounted silk samples of linings and dress materials. Each page is headed with the type of silk and each sample is numbered. Silks are 'twilled sarsnetts'. Textured patterns - flush, brocaded, canelle, figured, sarsnetts, tabby. Watermarked flyleaf with '1810'."@en ;
