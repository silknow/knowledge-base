<http://data.silknow.org/object/058bbccb-4f7e-32f6-9e0d-2137735a1e0a>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Fragment of silk tapestry (<i>kesi</i>), woven in coloured silks and gold thread on a red ground. In the middle is a vase filled with peaches and flowers, surrounded by scrolled clouds and flying bats carrying swastika symbols in their mouths. The other symbols in the intervals of the cloud scrolls bound with fillets represent the eight emblems of the Daoist immortals.\nDensity 20x38 threads/sq.cm, cross- sectional width of warp 0.1mm, of weft 0.3mm."@en , "Fragment, silk tapestry (<i>kesi</i>), China, Qing dynasty, probably 18th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/190d8780-c7fa-381d-bfcf-76489a65abd0> , <http://data.silknow.org/image/ae91c6a0-d062-32ca-a118-0a70a44df65f> , <http://data.silknow.org/image/94baabdb-c893-352a-96a7-192c593083fa> , <http://data.silknow.org/image/72869b79-1bc2-3ec5-a6ff-3e73c45e3fb7> , <http://data.silknow.org/image/6016655c-bd1d-3feb-bbe2-39d76b95d3bc> ;
        ecrm:P3_has_note               "Fragment, silk tapestry (<i>kesi</i>), China, Qing dynasty, probably 18th century"@en , "Fragment of silk tapestry (<i>kesi</i>), woven in coloured silks and gold thread on a red ground. In the middle is a vase filled with peaches and flowers, surrounded by scrolled clouds and flying bats carrying swastika symbols in their mouths. The other symbols in the intervals of the cloud scrolls bound with fillets represent the eight emblems of the Daoist immortals.\nDensity 20x38 threads/sq.cm, cross- sectional width of warp 0.1mm, of weft 0.3mm."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/058bbccb-4f7e-32f6-9e0d-2137735a1e0a/dimension/2> , <http://data.silknow.org/object/058bbccb-4f7e-32f6-9e0d-2137735a1e0a/dimension/1> ;
