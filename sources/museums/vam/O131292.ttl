<http://data.silknow.org/event/df3b7fc6-e651-3e37-a743-3f310fcc11a8>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "The donor said that this damask came from a set of bed hangings owned by her ancestor Edward Haistwell, an East India Merchant. Family tradition connected them with a visit by Peter the Great.\n\nThere is an unregistered valance in the collection made of pieced fragments of the same damask, which may have been given at the same time, although the papers relating to the acquisition do not indicate this."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/9dd2d988-4e93-350f-a9a1-53fbb0cf5ee4> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Miss Eleonora Armitage" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/131bd6d6-5af1-3911-a619-80d0b359d8de> ;
        ecrm:P3_has_note               "The donor said that this damask came from a set of bed hangings owned by her ancestor Edward Haistwell, an East India Merchant. Family tradition connected them with a visit by Peter the Great.\n\nThere is an unregistered valance in the collection made of pieced fragments of the same damask, which may have been given at the same time, although the papers relating to the acquisition do not indicate this."@en .
