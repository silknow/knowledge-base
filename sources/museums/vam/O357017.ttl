        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O357017" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/3776dbaf-a2da-358b-889c-8914433cdd79> , <http://data.silknow.org/image/87d017c7-a804-3017-b809-b8568b2cda46> , <http://data.silknow.org/image/4f38c640-a181-3282-b975-4894e145d0ef> , <http://data.silknow.org/image/5a549a90-6c3b-3655-9e2b-0a36b96465ac> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba/domain/2> , <http://data.silknow.org/image/0edfe7a4-d011-3b3f-a33c-fa8853dd9681> , <http://data.silknow.org/image/30bc48d5-1208-3d25-aa8b-046ff55a07ec> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba/observation/2> , <http://data.silknow.org/image/45553695-fe2d-3a37-abad-1dafcfa140e2> , <http://data.silknow.org/image/44fe254f-ac2a-312f-958b-a4307f58b1bd> , <http://data.silknow.org/image/b99f8082-6e85-3c3b-b182-d9353318e232> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba/observation/3> , <http://data.silknow.org/image/a801fb4e-de91-3fcf-8bdb-ca2d9f213602> , <http://data.silknow.org/image/bf1092b5-6a61-3fc2-b3ff-b7116aebe7cb> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba/domain/1> , <http://data.silknow.org/image/846f3918-2ca4-3af8-ab16-cef9f3d199c6> , <http://data.silknow.org/object/9ee24f3a-ba20-39ce-8d5b-7551ea5af8ba/observation/1> , <http://data.silknow.org/image/4dc405d1-21da-3201-80ae-4042d7ee46ad> , <http://data.silknow.org/image/783e9339-cee1-3529-a667-d6f567f58b18> , <http://data.silknow.org/production/981f1287-83f2-3a29-b9b7-68e4a9ab230b> , <http://data.silknow.org/image/3f5a7cd3-cc00-37d1-b75b-cd6f7646e9a5> , <http://data.silknow.org/event/65ad60ec-8da0-3ac5-9abd-74b944b79648> , <http://data.silknow.org/image/93709a4f-9808-3810-b85d-07cbd4d47de7> ;
