<http://data.silknow.org/object/2a6279da-b468-3cc1-8ab5-37f97cf49506/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Engraved black and white portrait of Jenny Lind, printed on cream silk with upper and lower raw edges and selvedges left and right. Jenny Lind is shown standing in the open air between two clumps of grasses and flowers, looking to her right, wearing a crinoline with an off-the-shoulder shawl bodice. She holds a handkerchief in her left hand and has her right hand raised."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/2a6279da-b468-3cc1-8ab5-37f97cf49506> .

<http://data.silknow.org/image/2e4b87c2-7cbf-3ce0-93a4-533a0e5b5fff>
