<http://data.silknow.org/object/dd913a13-4be8-3e5d-ab99-f3948ff43bbe>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Plain weave cotton embroidered with silk in surface darning on the diagonal and running stitch with pulled thread work, faced with bias cut silk. Displayed and analysed under glass.\nRigid arrangement of diamonds, each containing a seated figure.  The central one rests with both hands in his lap.  All the other figures have one hand across the body and the other outstretched. There is considerable variation in detail and exact positioning. The diamonds are formed by bands which are divided into diamonds and triangles and there is a pink diamond where these bands join.  The ground of the large diamonds varies in bands: light blue and beige. The border is divided into diagonal stripes in which a stylized and elongated figure alternates with stylized flowers.  These bands form a V-shaped mid-way along each side.\nThreads: 2S silk: black, white, light blue, light green, pink, light pink, dark red, beige, yellow. \nFacing; light pink silk."@en , "Middle East, Textile; Panel, silk-embroidered cotton, lattice design with seated figures on blue or beige ground, Azerbaijan or NW Iran, 1750-1800"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/1b5cd525-5b33-30aa-a582-ab5575f6f389> , <http://data.silknow.org/image/fc537029-fb5a-3cc3-b3ce-be1dfa3dfcf9> , <http://data.silknow.org/image/41ba2661-c613-32f7-acdf-79f12a7128b3> , <http://data.silknow.org/image/5e185d7c-4506-3ca9-ab64-7fade762ed1a> , <http://data.silknow.org/image/00df4ef4-30de-3656-b3e6-f9e266c0bd9d> ;
        ecrm:P3_has_note               "Middle East, Textile; Panel, silk-embroidered cotton, lattice design with seated figures on blue or beige ground, Azerbaijan or NW Iran, 1750-1800"@en , "Plain weave cotton embroidered with silk in surface darning on the diagonal and running stitch with pulled thread work, faced with bias cut silk. Displayed and analysed under glass.\nRigid arrangement of diamonds, each containing a seated figure.  The central one rests with both hands in his lap.  All the other figures have one hand across the body and the other outstretched. There is considerable variation in detail and exact positioning. The diamonds are formed by bands which are divided into diamonds and triangles and there is a pink diamond where these bands join.  The ground of the large diamonds varies in bands: light blue and beige. The border is divided into diagonal stripes in which a stylized and elongated figure alternates with stylized flowers.  These bands form a V-shaped mid-way along each side.\nThreads: 2S silk: black, white, light blue, light green, pink, light pink, dark red, beige, yellow. \nFacing; light pink silk."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/dd913a13-4be8-3e5d-ab99-f3948ff43bbe/dimension/2> , <http://data.silknow.org/object/dd913a13-4be8-3e5d-ab99-f3948ff43bbe/dimension/1> ;
        dc:identifier                  "930-1889" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O158527> .

