<http://data.silknow.org/object/1a5c304d-c0e9-34e9-8d75-aaf307fd79f2/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Wool and silk embroidery on canvas, in cross and tent stitch. On a central panel in tent stitch of dark green are detatched sprays of flowers in natural colours. The panel is enclosed by an arabesque design in cross stitch in reds, greens, blues, and purples on a yellow ground."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1a5c304d-c0e9-34e9-8d75-aaf307fd79f2> .

