<http://data.silknow.org/object/5a3925cd-5a63-3a30-acf4-938115ef982e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Textile panel of silk woven with a mauve textured ground and a floral design in white, orange, yellow, black and green forming compartments.\n\nTabby ground with an additional flushing warp forming a cannellé effect. A white pattern weft forms the greater part of the design, and the other colours, also pattern wefts, are changed according to the requirements of the pattern. There is no binding warp. Two fragments are joined together to make up the panel which is lined with plain green taffeta and interlined with white net. A gold braid edges the panel."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5a3925cd-5a63-3a30-acf4-938115ef982e> .

<http://data.silknow.org/object/5a3925cd-5a63-3a30-acf4-938115ef982e>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Textile panel of silk, France, 1760-1800"@en , "Textile panel of silk woven with a mauve textured ground and a floral design in white, orange, yellow, black and green forming compartments.\n\nTabby ground with an additional flushing warp forming a cannellé effect. A white pattern weft forms the greater part of the design, and the other colours, also pattern wefts, are changed according to the requirements of the pattern. There is no binding warp. Two fragments are joined together to make up the panel which is lined with plain green taffeta and interlined with white net. A gold braid edges the panel."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0e01f6b0-ce5d-3b16-8c0d-bb7a11162dfd> ;
        ecrm:P3_has_note               "Textile panel of silk, France, 1760-1800"@en , "Textile panel of silk woven with a mauve textured ground and a floral design in white, orange, yellow, black and green forming compartments.\n\nTabby ground with an additional flushing warp forming a cannellé effect. A white pattern weft forms the greater part of the design, and the other colours, also pattern wefts, are changed according to the requirements of the pattern. There is no binding warp. Two fragments are joined together to make up the panel which is lined with plain green taffeta and interlined with white net. A gold braid edges the panel."@en ;
