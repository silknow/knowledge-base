<http://data.silknow.org/object/33c3f10a-452c-3dea-a661-8bd150a2a9ec>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Walking length umbrella of silk with a carved, acorn shaped, amber handle with a gold collar claw set with small diamonds. It has a gold mount and there is a pin that goes through it. \n\nThe cover is of black silk, with a scallop openwork net insertion border, outlined with a floral border in couched cord. It is unlined.\n\nThe ribs are hollow, cast, black japanned metal and the rib tips are of the same. There is a holding band fastening with a smoked pearl button."@en , "Umbrella of silk, manufactured by Brigg & Sons Ltd., London ca. 1890"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7da9b4c1-bed9-3ec2-8f50-104aac64bce1> , <http://data.silknow.org/image/9a6bc322-950e-3bd6-b99b-88b6206dce4f> ;
        ecrm:P3_has_note               "Umbrella of silk, manufactured by Brigg & Sons Ltd., London ca. 1890"@en , "Walking length umbrella of silk with a carved, acorn shaped, amber handle with a gold collar claw set with small diamonds. It has a gold mount and there is a pin that goes through it. \n\nThe cover is of black silk, with a scallop openwork net insertion border, outlined with a floral border in couched cord. It is unlined.\n\nThe ribs are hollow, cast, black japanned metal and the rib tips are of the same. There is a holding band fastening with a smoked pearl button."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/33c3f10a-452c-3dea-a661-8bd150a2a9ec/dimension/1> ;
        dc:identifier                  "T.432-1977" ;
