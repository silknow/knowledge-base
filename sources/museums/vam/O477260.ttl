<http://data.silknow.org/object/f9ddb349-0c15-3b83-b688-e7bcb2c9fa5a>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Man's silk shawl embroidered with floss silk; chain stitch, roman filling-stitch. Knotted silk fringes at both ends."@en , "ceremonial; Costume, silk, embroidered, Manipur, c1855"@en , "MAN'S SHAWL \n\nIn India’s far north-east, a chief of the Meitei community in Manipur would have worn this lanphi or shawl. The floral patterns of its embroidery closely follow woven silk designs from the same area. Embroidery is not common in Manipur: this is a rare surviving example.\n\nMeitei shawl\nSilk embroidered with silk\nManipur, about 1855\nV&A: 0190 (IS) [03/10/2015-10/01/2016]"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f345aac7-83e1-3511-bfe1-e74ba52ff2c3> , <http://data.silknow.org/image/6d4ff10c-ef51-35b8-86f4-4f0d2f5494e4> , <http://data.silknow.org/image/34b5b0ce-f4b1-3059-9f1a-9992a52b5ec6> , <http://data.silknow.org/image/1d9a2e55-dbef-380f-98f0-dde1f814aa4a> , <http://data.silknow.org/image/b8a1e95b-f14a-3caa-a2d7-35db87d71f97> , <http://data.silknow.org/image/38b6cf8f-4602-365d-8468-84ec5732db6f> , <http://data.silknow.org/image/001aa315-90e8-338c-a2f5-177cba8583d3> ;
        ecrm:P3_has_note               "ceremonial; Costume, silk, embroidered, Manipur, c1855"@en , "Man's silk shawl embroidered with floss silk; chain stitch, roman filling-stitch. Knotted silk fringes at both ends."@en , "MAN'S SHAWL \n\nIn India’s far north-east, a chief of the Meitei community in Manipur would have worn this lanphi or shawl. The floral patterns of its embroidery closely follow woven silk designs from the same area. Embroidery is not common in Manipur: this is a rare surviving example.\n\nMeitei shawl\nSilk embroidered with silk\nManipur, about 1855\nV&A: 0190 (IS) [03/10/2015-10/01/2016]"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f9ddb349-0c15-3b83-b688-e7bcb2c9fa5a/dimension/2> , <http://data.silknow.org/object/f9ddb349-0c15-3b83-b688-e7bcb2c9fa5a/dimension/3> , <http://data.silknow.org/object/f9ddb349-0c15-3b83-b688-e7bcb2c9fa5a/dimension/1> ;
