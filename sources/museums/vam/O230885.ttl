        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O230885" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/74608cfc-3006-345b-a3e6-7c581eaebd36> , <http://data.silknow.org/image/694de001-a9ba-3240-8954-ef10eadc92ae> , <http://data.silknow.org/object/131d1007-0758-30b5-b3c0-810e756c56ea> , <http://data.silknow.org/image/19063e3a-6e21-3807-846c-43b3c68315b3> , <http://data.silknow.org/image/3a72b5f5-3f3b-31b7-8e86-fde006baa1fd> , <http://data.silknow.org/event/e7defdd4-2996-35c3-8aec-8f9f73abcb6a> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/131d1007-0758-30b5-b3c0-810e756c56ea/observation/1> , <http://data.silknow.org/object/131d1007-0758-30b5-b3c0-810e756c56ea/domain/1> , <http://data.silknow.org/production/622380b9-d69e-3297-bcbe-14383ec40573> , <http://data.silknow.org/image/570f335e-09fd-3de2-a381-bf28d693119b> ;
