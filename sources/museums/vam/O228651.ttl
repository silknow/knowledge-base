<http://data.silknow.org/object/ac338b95-fb27-384f-bbeb-0cc761f8ee8f/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Description: Plain weave cotton, drawn thread work, needlewoven bars and embroidered metal thread, faced with block printed cotton.\nFacing for a bodice. White cotton with drawn thread work and needlewoven bars in red silk forming horizontal, vertical and diagonal lines.  Where these meet silver and silver-gilt threads have been embroidered to form small roundels; the type of metal thread alternates."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ac338b95-fb27-384f-bbeb-0cc761f8ee8f> .

<http://data.silknow.org/object/ac338b95-fb27-384f-bbeb-0cc761f8ee8f>
