<http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Scroll of embroidered silk, China, 18th century"@en , "Hanging scroll of silk embroidered with coloured silks in long and short, satin and stem stitches with knots. \n\nThe decoration depicts a crane standing on a rock around which grow narcissus. above is prunus tree in flower. In the top right hand corner is an inscription embroidered in black silk and two seals embroidered in red. \n\nThe scroll is mounted with borders of white silk damask in a diaper pattern of formal flowers and scrolling tendrils, with wooden rollers at each end."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/04c77272-23e1-31ff-8f25-dbf3484b3442> , <http://data.silknow.org/image/cc7b628a-8a7d-37ca-b0b8-8da2ee7521e9> ;
        ecrm:P3_has_note               "Hanging scroll of silk embroidered with coloured silks in long and short, satin and stem stitches with knots. \n\nThe decoration depicts a crane standing on a rock around which grow narcissus. above is prunus tree in flower. In the top right hand corner is an inscription embroidered in black silk and two seals embroidered in red. \n\nThe scroll is mounted with borders of white silk damask in a diaper pattern of formal flowers and scrolling tendrils, with wooden rollers at each end."@en , "Scroll of embroidered silk, China, 18th century"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa/dimension/4> , <http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa/dimension/3> , <http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa/dimension/5> , <http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa/dimension/1> , <http://data.silknow.org/object/8c0a5f3d-c868-3bf1-a77e-c9701cdf3afa/dimension/2> ;
