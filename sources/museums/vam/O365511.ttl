<http://data.silknow.org/object/81d7f50d-10c5-356a-9021-eee5664ab44b/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pattern book of ribbons (pages 1 to 100). The ribbons are in plain satin or open weave, some with stripes and some are figured. The samples are numbered in four columns on each page, and the season's production is headed with 'Counterpart' with the date and sometimes the name. Some contain silver thread, some are tartan, some are heavy plain ribbed weaves, etc."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/81d7f50d-10c5-356a-9021-eee5664ab44b> .

