        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Panel of a woman’s bleached linen, lined with a coarser linen.  It is embroidered with silk floss in yellow, shades of peach and terracotta, in a large plant with flowers and leaves, with satin, stem, cross and speckling stitches. The background is back-stitched with pale beige silk in a pattern of concentric diamonds.  There is a pocket opening at the waist in the centre, turned and hemmed."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8662332d-0565-3799-bbc2-d92c53231cf6> .

