<http://data.silknow.org/object/aea0b07a-75b5-348c-85db-1d7d201a7f9b>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O169581" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/domain/4> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/domain/1> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/domain/3> , <http://data.silknow.org/production/0821edde-5d9f-392e-a4e9-88b263ab2f0f> , <http://data.silknow.org/event/23bee28a-67d3-36c9-a02b-1e14197baaaf> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/observation/2> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/image/7610a348-e43f-3324-a452-8561a663d63d> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/observation/1> , <http://data.silknow.org/object/aea4c3c6-82f5-35a9-bfa4-ab7bc7082faf/domain/2> ;
