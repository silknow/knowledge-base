<http://data.silknow.org/object/0b34d632-00eb-3077-afc9-146a115fa558>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk striped woman's trousers, Pakistan, mid 19th century."@en , "These trousers are made of fine striped silk fabric, and are cut loose around the waist and thighs, but taper to a close-fitting lower section that is typical of the Indian subcontinent.  This narrow section would often be wrinkled up to the knee in a style called <i>chiridar</i>, which means 'with bangles'.  In more recent times, this narrow leg section would be bias-cut to give a more clinging effect, but surviving nineteenth-century trousers all seem to have straight-cut legs.  On this pair, the decorative effect is concentrated on the simple but elegant embroidered cuff.  The trousers would be worn with a long, straight shirt, probably also with embroidered decoration."@en , "Purple silk trousers with white stripes and white embroidery at the cuffs"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/353ccd6e-0213-3a3e-ad76-ad0bf2d48aed> , <http://data.silknow.org/image/0821969a-0e3c-3a0b-b839-3516eef3b4d3> ;
        ecrm:P3_has_note               "Silk striped woman's trousers, Pakistan, mid 19th century."@en , "Purple silk trousers with white stripes and white embroidery at the cuffs"@en , "These trousers are made of fine striped silk fabric, and are cut loose around the waist and thighs, but taper to a close-fitting lower section that is typical of the Indian subcontinent.  This narrow section would often be wrinkled up to the knee in a style called <i>chiridar</i>, which means 'with bangles'.  In more recent times, this narrow leg section would be bias-cut to give a more clinging effect, but surviving nineteenth-century trousers all seem to have straight-cut legs.  On this pair, the decorative effect is concentrated on the simple but elegant embroidered cuff.  The trousers would be worn with a long, straight shirt, probably also with embroidered decoration."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/0b34d632-00eb-3077-afc9-146a115fa558/dimension/1> , <http://data.silknow.org/object/0b34d632-00eb-3077-afc9-146a115fa558/dimension/2> ;
        dc:identifier                  "6047(IS)" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O69766> .

<http://data.silknow.org/object/0b34d632-00eb-3077-afc9-146a115fa558/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "These trousers are made of fine striped silk fabric, and are cut loose around the waist and thighs, but taper to a close-fitting lower section that is typical of the Indian subcontinent.  This narrow section would often be wrinkled up to the knee in a style called <i>chiridar</i>, which means 'with bangles'.  In more recent times, this narrow leg section would be bias-cut to give a more clinging effect, but surviving nineteenth-century trousers all seem to have straight-cut legs.  On this pair, the decorative effect is concentrated on the simple but elegant embroidered cuff.  The trousers would be worn with a long, straight shirt, probably also with embroidered decoration."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0b34d632-00eb-3077-afc9-146a115fa558> .

