<http://data.silknow.org/object/b9f33fff-0940-311d-bb1f-56916d880f86/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Fragments of a sari, cotton and silk, black cotton field with spots in white ikat weave, the pallu end has a latticework design in yellow, deep bands of orange, red, black and gold-wrapped thread in geometric designs; borders of yellow, on one side striped with black and gold-wrapped thread, the other striped with red and black."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b9f33fff-0940-311d-bb1f-56916d880f86> .

<http://data.silknow.org/object/b9f33fff-0940-311d-bb1f-56916d880f86>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Textiles, fragments of a woman's silk garment, Vellore, ca. 1867."@en , "Fragments of a sari, cotton and silk, black cotton field with spots in white ikat weave, the pallu end has a latticework design in yellow, deep bands of orange, red, black and gold-wrapped thread in geometric designs; borders of yellow, on one side striped with black and gold-wrapped thread, the other striped with red and black."@en , "The complete object would have been intended for use as a garment, clothing."@en ;
