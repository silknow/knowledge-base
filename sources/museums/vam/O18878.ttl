<http://data.silknow.org/object/54bb0d63-49bf-324c-82bb-b80313ee990e>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This delightful handkerchief is embroidered in white cotton thread with a repeating design of figures, palm trees and what appears to be railway carriages. Trains were popluar motifs in both embroidered and woven fabrics in Bengal in the 19th century. This type of fine white-on-white embroidery is known as chikan work, a term of unknown origin, and it was done mainly in Dhaka (today the capital of Bangladesh) and Calcutta in eastern India, and then in Lucknow."@en , "The East India Railway opened between Calcutta (Howrah) and Pandua in 1854."@en , "White muslin handkerchief with a border of  'chikan' embroidery in white cotton and pink silk, depicting figures in a type of Muslim dress and early steam locomotives, palm trees and birds."@en , "Handkerchief, with 'chikan' embroidery, Calcutta, mid 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c830dc5d-dde1-38c0-b21b-eccfdc711826> ;
        ecrm:P3_has_note               "White muslin handkerchief with a border of  'chikan' embroidery in white cotton and pink silk, depicting figures in a type of Muslim dress and early steam locomotives, palm trees and birds."@en , "This delightful handkerchief is embroidered in white cotton thread with a repeating design of figures, palm trees and what appears to be railway carriages. Trains were popluar motifs in both embroidered and woven fabrics in Bengal in the 19th century. This type of fine white-on-white embroidery is known as chikan work, a term of unknown origin, and it was done mainly in Dhaka (today the capital of Bangladesh) and Calcutta in eastern India, and then in Lucknow."@en , "The East India Railway opened between Calcutta (Howrah) and Pandua in 1854."@en , "Handkerchief, with 'chikan' embroidery, Calcutta, mid 19th century"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/54bb0d63-49bf-324c-82bb-b80313ee990e/dimension/1> , <http://data.silknow.org/object/54bb0d63-49bf-324c-82bb-b80313ee990e/dimension/2> ;
        dc:identifier                  "0542(IS)" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O18878> .

