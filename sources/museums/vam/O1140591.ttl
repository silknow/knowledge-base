<http://data.silknow.org/object/3da9199c-73b0-31c8-ba86-645d3bafe777>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Bolster cover of embroidered linen with silk and metal threads, England, ca. 1715"@en , "Bolster cover of embroidered linen with silk and metal threads in long and short, satin, stem and back stitches. Quilted in minute all-over pattern in yellow silk, and over this is embroidered a rich pattern of exotic flowers and bizarre shapes. The design radiates from a roundel in the centre. Worked with coloured silks in black and shades of red and green."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9b592b68-373d-3a05-a922-995e3b733b0a> , <http://data.silknow.org/image/2ff52f6f-c018-322c-b416-b093dc2372fd> , <http://data.silknow.org/image/05d7b61c-aa5e-3647-b8f1-802891b233c6> , <http://data.silknow.org/image/e0d9d374-df5b-319d-b1aa-b6fbb2c1f0cf> ;
        ecrm:P3_has_note               "Bolster cover of embroidered linen with silk and metal threads in long and short, satin, stem and back stitches. Quilted in minute all-over pattern in yellow silk, and over this is embroidered a rich pattern of exotic flowers and bizarre shapes. The design radiates from a roundel in the centre. Worked with coloured silks in black and shades of red and green."@en , "Bolster cover of embroidered linen with silk and metal threads, England, ca. 1715"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/3da9199c-73b0-31c8-ba86-645d3bafe777/dimension/1> , <http://data.silknow.org/object/3da9199c-73b0-31c8-ba86-645d3bafe777/dimension/2> ;
