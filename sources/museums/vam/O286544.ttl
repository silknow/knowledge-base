<http://data.silknow.org/object/b8331932-6059-3c4f-bd23-ab5ae112c446/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Fragment of embroidery made of pink silk satin, couched with silk cord and partially wrapped silver filé, parchment ‘leaves’ wrapped in pink silk floss and silk-wrapped purl, and embroidered with white and yellow silk floss. These are worked in French knots and satin stitch in a pattern of scrolling vines and flowers."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b8331932-6059-3c4f-bd23-ab5ae112c446> .

<http://data.silknow.org/object/b8331932-6059-3c4f-bd23-ab5ae112c446>
