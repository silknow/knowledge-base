<http://data.silknow.org/object/58aafea3-46f3-3a47-ac7f-03b13fee8d2c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Hanging (suzani), embroidered silk on cotton, probably Uzbekistan (Bukhara), 18-19th century; Textiles; Embroidery"@en , "Silk on cotton embroidery, using darning and ladder stitches. The central field is covered with a diaper of diamonds, divided from one another by leafy stems. The diamonds contain floral sprays in a bold style and small leafy sprays set alternately. This field is surrounded by a broad border consisting of a series of ovals, each containing a flowering spray of a bold type. The triangular spaces between these ovals are filled with sprays of leaves and flowers designed on a smaller scale. This border is edged on the inside and the outside by a running scroll design of leaves and flowers."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/fa357e6c-0397-3bf1-a549-8dbbacf00b9a> , <http://data.silknow.org/image/48c409aa-da94-3c8a-8471-2b0e7f26b3c0> , <http://data.silknow.org/image/fa4a5461-c61d-3561-aa33-98b7ffdabad5> ;
        ecrm:P3_has_note               "Hanging (suzani), embroidered silk on cotton, probably Uzbekistan (Bukhara), 18-19th century; Textiles; Embroidery"@en , "Silk on cotton embroidery, using darning and ladder stitches. The central field is covered with a diaper of diamonds, divided from one another by leafy stems. The diamonds contain floral sprays in a bold style and small leafy sprays set alternately. This field is surrounded by a broad border consisting of a series of ovals, each containing a flowering spray of a bold type. The triangular spaces between these ovals are filled with sprays of leaves and flowers designed on a smaller scale. This border is edged on the inside and the outside by a running scroll design of leaves and flowers."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/58aafea3-46f3-3a47-ac7f-03b13fee8d2c/dimension/2> , <http://data.silknow.org/object/58aafea3-46f3-3a47-ac7f-03b13fee8d2c/dimension/1> ;
