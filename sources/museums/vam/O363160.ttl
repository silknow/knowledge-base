<http://data.silknow.org/object/662a09a4-ef1b-32ca-ab29-2ed2686a5295/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Man's handkerchief of white silk with a plain centre and floral border, which is also in white and woven in fancy twills. There is a line of diamond shapes marking the edges of the border, smaller on the inner side and larger on the outer.\nThe handkerchief is hemmed at the top and bottom and has selvedges at the sides."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/662a09a4-ef1b-32ca-ab29-2ed2686a5295> .

<http://data.silknow.org/object/662a09a4-ef1b-32ca-ab29-2ed2686a5295>
