<http://data.silknow.org/object/40626970-53ca-3392-801a-ae185700bbcd>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects.  In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. This sampler was made in Denmark in 1798. The decoration includes ornamental alphabets and pairs of initials, probably of the maker's family. You can also see scenes from the Bible showing the Crucifixion and the Temptation of Adam and Eve."@en , "Linen sampler embroidered with silk; Danish; dated 1798."@en , "Embroidered sampler"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7c99721c-76da-3227-a010-d21f36535b4e> , <http://data.silknow.org/image/602b4783-dc8b-3a86-a549-e55eaee9dcb0> , <http://data.silknow.org/image/a7e63a40-23eb-35d2-be01-57a8af8d4e1b> , <http://data.silknow.org/image/54937b74-198e-3b66-834e-b962411fd5ae> , <http://data.silknow.org/image/b1f74420-0383-32bf-bfb8-d1235bc96e50> , <http://data.silknow.org/image/4bf9c6c9-2486-367a-a9aa-25bb6a1b8052> ;
        ecrm:P3_has_note               "Embroidered sampler"@en , "Linen sampler embroidered with silk; Danish; dated 1798."@en , "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects.  In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. This sampler was made in Denmark in 1798. The decoration includes ornamental alphabets and pairs of initials, probably of the maker's family. You can also see scenes from the Bible showing the Crucifixion and the Temptation of Adam and Eve."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/40626970-53ca-3392-801a-ae185700bbcd/dimension/1> , <http://data.silknow.org/object/40626970-53ca-3392-801a-ae185700bbcd/dimension/2> ;
