        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "The outward facing crown and brim of this hat are made up of brushed beaver felt. There is a decorative velvet ribbon band and a Peterham ribbon trim on the brim which covers a wire. On the underside of the brim is a plain weave cotton which covers a shellacked canvas. The wire and shellacked canvas strengthen the shape of the hat. Inside the hat's crown is a golden coloured silk which is glued to the body of the hat. There is a leather sweatband which is handsewn in the body of the hat."@en , "Boy's suit, buff silk and cotton blend, with white cotton shirt and black beaver hat, made in England, early 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c4baa9a4-3b43-3518-a1b9-c1ef0394ab76> , <http://data.silknow.org/image/97893c5d-fa18-3915-87eb-1a2eecbe3884> , <http://data.silknow.org/image/a8556df3-5997-3c58-a7df-5b9506075229> , <http://data.silknow.org/image/e2663ead-6177-3155-af75-b0c473fd345d> , <http://data.silknow.org/image/1cb93754-3e0c-3a63-8b7c-f01735713d01> , <http://data.silknow.org/image/084eba3c-d290-3f33-97a7-32b231785058> , <http://data.silknow.org/image/9175427a-321b-30ea-8ab5-6fb40d6a3a5e> , <http://data.silknow.org/image/7ce1d584-571f-3619-b43b-2d8d434272ed> , <http://data.silknow.org/image/107cec23-b381-3f65-8b1f-5bb3c3b2cbec> , <http://data.silknow.org/image/7b553384-119f-3d15-bcd0-e4b27ea4e166> ;
        ecrm:P3_has_note               "Boy's suit, buff silk and cotton blend, with white cotton shirt and black beaver hat, made in England, early 19th century"@en , "The outward facing crown and brim of this hat are made up of brushed beaver felt. There is a decorative velvet ribbon band and a Peterham ribbon trim on the brim which covers a wire. On the underside of the brim is a plain weave cotton which covers a shellacked canvas. The wire and shellacked canvas strengthen the shape of the hat. Inside the hat's crown is a golden coloured silk which is glued to the body of the hat. There is a leather sweatband which is handsewn in the body of the hat."@en ;
