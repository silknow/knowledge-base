<http://data.silknow.org/event/829a1d91-beaf-39eb-a68d-eaccfa56f28c>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "The programme was printed for the 'Grand Opening Performances' in October 1891 of  'Lady Clancarty', the period drama by Tom Taylor, presented by Lily Langtry and her company. The programme is dated 1 October.  The theatre, designed by Frank Matcham, and later re-named The Everyman, is the oldest Frank Matcham theatre still in use today."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/af77c33c-b00a-3176-b9e6-41f9aa92c505> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Rae Hammond" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/6e08a63a-8dad-32e0-901e-db7533911b15> ;
        ecrm:P3_has_note               "The programme was printed for the 'Grand Opening Performances' in October 1891 of  'Lady Clancarty', the period drama by Tom Taylor, presented by Lily Langtry and her company. The programme is dated 1 October.  The theatre, designed by Frank Matcham, and later re-named The Everyman, is the oldest Frank Matcham theatre still in use today."@en .
