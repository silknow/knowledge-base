<http://data.silknow.org/object/179e31ab-640f-36e1-9d27-0aaeda5be4a3>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Child's padded hat; French, 18th century"@en , "Child's padded hat of pink silk brocade lined with ecru silk twill,\n and trimmed with lines of silver lace.  The hat has a ribbed padded\n brim of blue and silver brocade, which would have had the same\n head-protecting function (for a child learning to walk) as the similar\n brims on \"puddings\".  The hat has a soft pointed crown which seems to\n have always been worn folded down across the head."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/75e8e0d2-f4c3-3ff7-93f7-61a123722abd> , <http://data.silknow.org/image/c057b5b8-87dd-305f-b289-2d926a9f2381> ;
        ecrm:P3_has_note               "Child's padded hat; French, 18th century"@en , "Child's padded hat of pink silk brocade lined with ecru silk twill,\n and trimmed with lines of silver lace.  The hat has a ribbed padded\n brim of blue and silver brocade, which would have had the same\n head-protecting function (for a child learning to walk) as the similar\n brims on \"puddings\".  The hat has a soft pointed crown which seems to\n have always been worn folded down across the head."@en ;
        dc:identifier                  "B.91-1993" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O38162> .

