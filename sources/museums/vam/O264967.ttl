<http://data.silknow.org/event/6b091a14-a9b2-33f9-b14b-997c9f13e4b8>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Registered File number 102/1930. From donor's letter, 1930: \"I am sending to you herewith a piece of woven and printed silk terry and taffeta ... I purchased this a few months ago in Constantinople at an antique shop, but it is almost undoubtedly of French manufacture, probably St. Etienne or Lyons. ... I believe it was produced probably between 1810 qnd 1830.\""@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/1428b01d-5465-38cc-9352-c98451e61798> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Mr W.J. Franklin, Esq." ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/7aced209-51a8-3149-8fa3-0bf6eb1dfdb6> ;
        ecrm:P3_has_note               "Registered File number 102/1930. From donor's letter, 1930: \"I am sending to you herewith a piece of woven and printed silk terry and taffeta ... I purchased this a few months ago in Constantinople at an antique shop, but it is almost undoubtedly of French manufacture, probably St. Etienne or Lyons. ... I believe it was produced probably between 1810 qnd 1830.\""@en .

