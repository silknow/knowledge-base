<http://data.silknow.org/production/b0c4cc8b-76e1-31d5-b6d6-646910c697b7>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/03751304-86b3-3e3c-ba3a-5d03e9ba3ad3> ;
        ecrm:P126_employed      "Walnut, partly turned, and beech, of pegged mortise-and-tenon construction, with original upholstery of feather-filled ticking, covered in wool with appliqué silk needlework and silk trimmings"@en ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/0a440082-902f-3799-9095-bd8f08f9bde8> ;
