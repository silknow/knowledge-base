        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Furnishing fabric of silk and linen double cloth with a symmetrical pattern of intertwining, flowering branches with geometric fillings. The pattern is in white linen on a ground of red silk satin with a white linen weft.\n\nPale blue and green silk with brown are used in the selvedges. \n\nThe fabric has curved and worn lower edges."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e863134d-ac56-38c6-b2f8-186b2080dfb0> .

