        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress panel of embroidered silk. The lower two-thirds of the panel is finely embroidered with coloured silks mainly in the shades of green, red, blue and yellow. With long and short and split stitches, and with French knots. The design consists of a delicate, irregular arrangement of flowers, buds and leaves connected by finely intertwined stems."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a0ca2f21-69d6-3bab-83ee-bb4a407cdfd5> .

