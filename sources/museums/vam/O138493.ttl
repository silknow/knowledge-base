<http://data.silknow.org/object/bd61e901-9e04-332e-85d6-839c381dacbe/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Cruciform textile panel of embroidered linen canvas with silk and silver-gilt threads and the lower third of an octagonal panel, applied to green velvet. Worked in pink, blue, green and brown with a raised border of silver-gilt embroidery.\nThe upper part of the fragmentary panel is T.33F-1955."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/bd61e901-9e04-332e-85d6-839c381dacbe> .

