<http://data.silknow.org/event/5d1f239d-7a8e-3993-96b4-d1dc32b1409d>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Worn with hat T.715:3-1997. The ensemble is believed to have been made for the trousseau of a French Duchess who married and emigrated to the US. She died shortly afterwards, hence the lack of wear to the pieces.\n\nThe objects were purchased from Christie's in 1997at £2239.63 for the entire ensemble."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/b4610047-14bb-3fbb-9701-71e9bece456b> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
