<http://data.silknow.org/event/ae7865c8-95fb-31da-9f0e-f86b7a317077>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This silk programme was produced to commemorate a \"Grand Amateur Night\" at the Theatre Royal, Jersey. The evening appears to have been organized by the local garrison - the majority of the participants are soldiers serving in the 66th Regiment. The programme details the full evening's entertainment which includes songs sung by Captain W.H. Brabazon Connor and the Band of H.M.'s 66th Regiment, as well as the two plays.  The programme itself has the added interest of being printed on coloured silk: most silks are either cream or white. Associated production: A Husband to Order. Playwright: J. Maddison Morton. Theatre Royal, Jersey, 9.8.1867. Performance category: Drama."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/72cef84c-70cb-3bc1-a56c-5eb779a24b6e> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Marjorie Knight" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/ddb88134-1b3f-3e65-af6d-18f0e32f9180> ;
        ecrm:P3_has_note               "This silk programme was produced to commemorate a \"Grand Amateur Night\" at the Theatre Royal, Jersey. The evening appears to have been organized by the local garrison - the majority of the participants are soldiers serving in the 66th Regiment. The programme details the full evening's entertainment which includes songs sung by Captain W.H. Brabazon Connor and the Band of H.M.'s 66th Regiment, as well as the two plays.  The programme itself has the added interest of being printed on coloured silk: most silks are either cream or white. Associated production: A Husband to Order. Playwright: J. Maddison Morton. Theatre Royal, Jersey, 9.8.1867. Performance category: Drama."@en .
