<http://data.silknow.org/event/bf09ef7f-8b76-3089-84c9-1e598575e933>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "A hand-written note in the register reads 'This pincushion was inherited from the family of Wade, which in Charles I's reign raised a troop of horses in his defence.  The 'rump' was the name given to the remnant of the body of Parliamentary members which joined Cromwell against the King in 1648.  This cushion was hung onto the belt or worn on the side'."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/9af89b1c-7c4e-3384-839d-80c0a74e2f0c> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Bequeathed by Miss Evelyn Cooke" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/ad91da4a-2c49-3a67-a4fc-7aea0f41a5f5> ;
        ecrm:P3_has_note               "A hand-written note in the register reads 'This pincushion was inherited from the family of Wade, which in Charles I's reign raised a troop of horses in his defence.  The 'rump' was the name given to the remnant of the body of Parliamentary members which joined Cromwell against the King in 1648.  This cushion was hung onto the belt or worn on the side'."@en .

