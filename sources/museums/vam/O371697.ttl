<http://data.silknow.org/production/310ea384-6b83-3599-8e53-c701d7649ced>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/dfbccabc-c197-36b1-9ca9-82de263e4f93> ;
        ecrm:P126_employed      "Carved and gilded walnut frame, with metal pulley wheels and audible sash weights. The frame standing on four castors.\n\nThe frame is fitted with a vertically sliding panel, designed to be operated by the pulley system. The panel covered on side in a panel of Gobelins wool tapestry of a floral composition"@en , "on the other in a silk panel embroidered with Chinoiserie motifs."@en ;
        ecrm:P126_employed      <http://data.silknow.org/vocabulary/644> , <http://data.silknow.org/vocabulary/900> ;
        ecrm:P32_used_general_technique
                "carving"@en ;
