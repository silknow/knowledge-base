<http://data.silknow.org/object/cdf5857f-4511-39bd-a74b-1c0a60ea751c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Furnishing fabric of yellow silk satin damask. Fragment of a large-scale design showing one vast stylised bloom and an ear of corn. The design is in satin and the background is 1/2 twill. There is a selvedge of multicoloured silks on one side. The repeat consists of two of these vast blooms and smaller ones, together with odd fruits and leaves on a fleshy stem."@en , "Furnishing fabric of silk satin damask, possibly made in France, ca. 1835-1850."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2fbaca6b-5c43-3a0d-b68e-57e58ecf778d> ;
        ecrm:P3_has_note               "Furnishing fabric of silk satin damask, possibly made in France, ca. 1835-1850."@en , "Furnishing fabric of yellow silk satin damask. Fragment of a large-scale design showing one vast stylised bloom and an ear of corn. The design is in satin and the background is 1/2 twill. There is a selvedge of multicoloured silks on one side. The repeat consists of two of these vast blooms and smaller ones, together with odd fruits and leaves on a fleshy stem."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/cdf5857f-4511-39bd-a74b-1c0a60ea751c/dimension/1> , <http://data.silknow.org/object/cdf5857f-4511-39bd-a74b-1c0a60ea751c/dimension/2> , <http://data.silknow.org/object/cdf5857f-4511-39bd-a74b-1c0a60ea751c/dimension/3> ;
        ecrm:P58_has_section_definition
                <http://data.silknow.org/object/cdf5857f-4511-39bd-a74b-1c0a60ea751c/dimension/pattern/1> , <http://data.silknow.org/vocabulary/444> ;
