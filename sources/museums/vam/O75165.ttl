        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This bag shows the transition between hidden pockets and external reticule.  Although embroidered for show and with drawstrings, the bag still resembles a pocket.  Domestic embroidery and beadwork was less sophisticated that that produced by workshops, although by the standards of today beautifully accomplished."@en ;
