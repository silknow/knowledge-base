<http://data.silknow.org/production/a6486817-714e-357f-b53d-7afdc4f77aeb>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/0dd9c910-40ba-31f6-a699-2b342d69f9f0> ;
        ecrm:P126_employed      "Jacquard woven, two-faced silk ribbon, constructed with one warp (threads arranged in yellow and black) and one weft (black). On one side, the ground is a warp-faced satin formed by the yellow warp and the black weft. The other side's ground is the weft-faced satin, hence black. The ornament is achieved by the floats of the warp, and the central design is bordered by pairs of thin stripes primarily obtained by the black warp threads."@en ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1860_1879> ;
        ecrm:P8_took_place_on_or_within
                <https://sws.geonames.org/6269131/> .

