<http://data.silknow.org/object/1c286c3d-3f8e-39a9-8f80-127d5d824c4c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Long skirt panel of fine white muslin embroidered with silk chenille in shades of green, yellow, brown, pink and white. With stem and satin stitches.\n\nThe embroidered decoration, a curving stem bearing roses and leaves, runs down the centre front and along the hem. The latter is additionally decorated with a narrow line of linked rose buds between parallel lines."@en , "Skirt panel of embroidered muslin, England, ca. 1810."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9d0768e8-0325-3e2d-9e98-15f8fa551d35> ;
        ecrm:P3_has_note               "Long skirt panel of fine white muslin embroidered with silk chenille in shades of green, yellow, brown, pink and white. With stem and satin stitches.\n\nThe embroidered decoration, a curving stem bearing roses and leaves, runs down the centre front and along the hem. The latter is additionally decorated with a narrow line of linked rose buds between parallel lines."@en , "Skirt panel of embroidered muslin, England, ca. 1810."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/1c286c3d-3f8e-39a9-8f80-127d5d824c4c/dimension/2> , <http://data.silknow.org/object/1c286c3d-3f8e-39a9-8f80-127d5d824c4c/dimension/1> ;
