        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Rectangular, lidded box with an overhanging lid, wood covered in black lacquer and decorated with floral scrolls over the entire exterior surface in gold <i>hiramaki-e</i> ('flat sprinkled picture') and <i>takamaki-e</i> ('high sprinkled picture') lacquer, with a pair of thick red silk cords, each with a large red tassel (faded), attached to either side of the lower part of the box by a silvered metal ring; black lacquer interior and underside."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d7203901-a794-3f5e-b4d8-9842d3d14873> .

