<http://data.silknow.org/object/5766209a-1341-30c9-9874-98d49e5cd152>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Linen sampler by Margreet Lucun, embroidered with silk; English; dated 1681"@en , "Embroidered sampler"@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a  band sampler. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework. Some band samplers, like this one, combine repeating patterns worked in coloured silks with areas of whitework."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/39c04c58-3683-399d-867e-2a1aa1a22115> , <http://data.silknow.org/image/fddebc9b-bddc-3364-b458-31baf223eb75> , <http://data.silknow.org/image/40286e97-2227-3eaf-9218-cdbd1fede000> , <http://data.silknow.org/image/8b0e6aeb-c4f3-37ea-bd14-422ce8679264> , <http://data.silknow.org/image/58f09227-9620-3947-b33d-be142a2b52d1> , <http://data.silknow.org/image/b5b76a5e-79d6-39ab-98da-b2bd24f680c5> , <http://data.silknow.org/image/2ffb79ca-6077-351c-b425-893936f3a9ff> ;
        ecrm:P3_has_note               "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a  band sampler. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework. Some band samplers, like this one, combine repeating patterns worked in coloured silks with areas of whitework."@en , "Linen sampler by Margreet Lucun, embroidered with silk; English; dated 1681"@en , "Embroidered sampler"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/5766209a-1341-30c9-9874-98d49e5cd152/dimension/2> , <http://data.silknow.org/object/5766209a-1341-30c9-9874-98d49e5cd152/dimension/1> ;
