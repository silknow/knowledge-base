<http://data.silknow.org/object/4a158d32-0d29-30ae-9b83-6d2a91503e48/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Tapestry fragment woven in wool and silk. 16-17 warp threads per in (6-7 per cm). Part of the lower right hand edge of the tapestry map of Oxford and Berkshire, and showing the coat of arms of Ralph Sheldon Senior (1537-1613), and the family motto 'OPTIMUM PATI'. In the border is a wild boar and the tip of Hercules' club which is visible in the right border."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4a158d32-0d29-30ae-9b83-6d2a91503e48> .

