<http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Hanging, plain weave cotton, embroidered with an eagle carrying off a shishi (mythical lion) cub with scared moneys below, Japan, 1860-1895. Tex, Japan, embroidery"@en , "This large and striking textile depicts an eagle sweeping down through a pine forest and carrying away a shishi (mythical lion)  cub while two monkeys try to pull a terrified companion across a stream. The whole scene is meticulously executed in embroidery, the stitches covering the entire surface of the cloth."@en , "Large hanging of plain weave cotton entirely covered with an embroidered scene, in silk and metallice threads, showing an eagle carrying away the cub of a shishi (mythical lion), while below two monkeys try to pull another to safety."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/4fcc1b7c-c36e-3870-8a86-3353c51fa438> , <http://data.silknow.org/image/9de7bb03-5304-3845-8840-879c0f073fee> , <http://data.silknow.org/image/2b6c84d1-753c-332b-9c8d-5f60f43d87ef> ;
        ecrm:P3_has_note               "Hanging, plain weave cotton, embroidered with an eagle carrying off a shishi (mythical lion) cub with scared moneys below, Japan, 1860-1895. Tex, Japan, embroidery"@en , "Large hanging of plain weave cotton entirely covered with an embroidered scene, in silk and metallice threads, showing an eagle carrying away the cub of a shishi (mythical lion), while below two monkeys try to pull another to safety."@en , "This large and striking textile depicts an eagle sweeping down through a pine forest and carrying away a shishi (mythical lion)  cub while two monkeys try to pull a terrified companion across a stream. The whole scene is meticulously executed in embroidery, the stitches covering the entire surface of the cloth."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e/dimension/5> , <http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e/dimension/3> , <http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e/dimension/4> , <http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e/dimension/2> , <http://data.silknow.org/object/785192e7-84a7-362e-babb-e48aa4a3c70e/dimension/1> ;
