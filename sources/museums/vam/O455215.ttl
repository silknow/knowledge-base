        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Complete sari, undyed cotton field with narrow side borders of red and green silk and metal wrapped thread. The pallu end has a broad band of metal-wrapped thread with two narrower bands of woven pink, green and black silk in a floral meander. The other end has three narrow bands of metal-wrapped thread."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/74aa8fe2-4163-3c0e-97e4-257ab9e517c2> .

