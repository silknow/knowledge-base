<http://data.silknow.org/actor/61a4f0c6-aea7-3b9b-93dc-0cbab4bfa7e9>
        a                         ecrm:E39_Actor ;
        rdfs:label                "Acquired with support from The Art Fund (with a contribution from the Wolfson Foundation), The Brigadier Clark Fund, and the London Historic House Museums Trust in memory of Wendy and George Levy" ;
