<http://data.silknow.org/object/ed4d820e-d603-38ca-a6dc-25ccd1ce873e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Towel/Napkin, cotton embroidered with silk in double running stitch variations and combinations and mushabak stitch and with metal thread in double running stitch variations and combinations and eyelets.\nThere is a border at either end in which a house-like structure alternates with a heavily stylised floral arrangement between two trees. Below this there is a narrow border of small floral motifs.  This border continues up the sides of the main border.  The ends have been oversewn with metal thread."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ed4d820e-d603-38ca-a6dc-25ccd1ce873e> .

