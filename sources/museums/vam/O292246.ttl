        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Silk ribbon woven in black and white silk. A large medallion with a black frame is ornamented with white motifs and draped with a ribbon bearing the inscription 'ALBERT THE GOOD', and contains a half-length portrait in profile of Prince Albert. Above and below the medallion are views of the buildings used for the Great Exhibition of 1851 and for the 1862 Exhibition. The former is set among trees."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f7895066-30ca-32b9-b0a6-13e8cc03ca24> .

