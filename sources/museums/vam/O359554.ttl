<http://data.silknow.org/object/5d01ff8c-cfcb-3939-9819-16eabccf4f1a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Short bolero, without fastenings, of cream silk bobbin lace made to shape. The collar consists of a back panel, two curved front pieces and a border, which decorates all of the edges.\n\nThe lace has a typical Maltese pattern of roundels containing the Maltese cross and, on the main panels, large rosettes with three dimensional armelles (wheat ears)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5d01ff8c-cfcb-3939-9819-16eabccf4f1a> .

