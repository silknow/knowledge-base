<http://data.silknow.org/object/f9636024-d7b3-3e74-bd98-1d75430e1a50/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This helmet was worn during parades.  It is of lacquered leather and gilded copper, and the neck-guard is of lacquered plates laced with silk.  It is decorated on each side of the crown with a dragon in raised gold lacquer with clouds below.\n\nThe helmet was put on display at the London Japan Society's Exhibition of Japanese Arms and Armour in June 1905."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f9636024-d7b3-3e74-bd98-1d75430e1a50> .

