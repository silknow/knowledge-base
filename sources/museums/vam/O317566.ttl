<http://data.silknow.org/event/dc690b48-bc21-3703-8e02-a99f00064a9b>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "A revision to the register suggests that this panel isn't from a lady's dress, and is instead part of a headdress for a baby.\n\nGiven by the Directors of the Museum of Art Industry, Christiania  along with objects 786 to 825-1884.  The register states that these objects  were received in the course of  \"international exchange\"."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/51b5cc6b-8059-3c54-b55e-a9311c5cc0e8> ;
