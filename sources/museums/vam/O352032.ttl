        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Cover consisting of two fragments of coarse cotton joined at the centre. It is embroidered with a large repeating design of conventional rose shapes surrounded by coiling stems and narrow serrated leaves. Embroidery with silk in two shades of red, two shades of blue, yellow, pink and fawn in fishbone stitch."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/dd316d31-fbbe-3a81-bfc0-e8a8cac3621e> .

