<http://data.silknow.org/object/7860f0e1-f552-35d8-8b0c-1ad92696acb9/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Chair of carved and gilt walnut, one of a set of four chairs and two armchairs, carved decoration including cupid's bows with quivers of arrows, and wreaths of flowers.\nOn this chair, in the trophy on the top rail, the single arrow points to the left, and the left side of the wreath lies behind the trophy (as on 1062-1882 and in reverse to 1062B-1882)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7860f0e1-f552-35d8-8b0c-1ad92696acb9> .

