<http://data.silknow.org/object/5c60bf8e-3bd8-3e43-8947-2d017b57e146/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The emperors of the Ming and Qing Dynasties (1368-1911) were patrons of Buddhism, and woven silks were frequently used as relic or <i>sutra</i> covers (volumes of Buddhist litanies), or for decoration. \n\nThis fragment was probably woven for use on a Buddhist object, although similarly designed textiles were used in Japan in tea ceremonies. Such textiles woven in patchwork colours were supposed to be reminiscent of early monastic robes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5c60bf8e-3bd8-3e43-8947-2d017b57e146> .

