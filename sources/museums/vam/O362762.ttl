        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Scarf of machine-made net embroidered with coloured floss silk in a floral design. There is a 2.25 inches wide border around the scarf with densely-packed flowers and leaves. each end of the scarf is decorated with two rows of three large floral sprays. The rest of the scarf is undecorated. The colour are green, red, orange, yellow, white and blue."@en , "Scarf of machine-made net embroidered with floss silk, Austria, 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0c4fe6de-436a-32fa-827d-a5edd101f665> ;
        ecrm:P3_has_note               "Scarf of machine-made net embroidered with coloured floss silk in a floral design. There is a 2.25 inches wide border around the scarf with densely-packed flowers and leaves. each end of the scarf is decorated with two rows of three large floral sprays. The rest of the scarf is undecorated. The colour are green, red, orange, yellow, white and blue."@en , "Scarf of machine-made net embroidered with floss silk, Austria, 19th century"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/2094eccb-a050-31a7-a458-34e2d1463cee/dimension/1> , <http://data.silknow.org/object/2094eccb-a050-31a7-a458-34e2d1463cee/dimension/2> ;
