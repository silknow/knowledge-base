        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Bonnet veil of white silk gauze with four rows of flowers. These are above a deep border of curling leaves with flowers at their base. Between them are guard stripes of flowers and leaves. The edge is cut in a series of points with applied edging."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4352ff06-2c63-347a-9813-7465779d06e7> .

