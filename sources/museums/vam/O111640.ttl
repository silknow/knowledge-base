        ecrm:P126_employed      <http://data.silknow.org/vocabulary/617> , <http://data.silknow.org/vocabulary/900> ;
        ecrm:P32_used_general_technique
                "hand stitching"@en ;
        ecrm:P32_used_general_technique
                <http://data.silknow.org/vocabulary/526> , <http://data.silknow.org/vocabulary/452> ;
        ecrm:P3_has_note        "Made in the neighbourhood of Inle Lake, Yawnshwe State. Misidentified by C. Stanley-clarke as <font -i>luntaya</font>." ;
