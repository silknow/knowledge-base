<http://data.silknow.org/event/a329926d-3078-3175-92d3-eed51ba84cf5>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Circ. 508 to 514 - 1919 formed part of the original  purchase from General Wallace (the donor) of 13 Shan weft-ikat textiles for £52. They were returned to the department in 1979.\n\nExtract from the donor's letter September 4 1919:\n\" In 1886 I was present when we occupied the Southern Shan States of Upper Burmah and purchased some cloths in the villages near Fort Stedman, then the headquarters of the South Shan States Administration\"."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/dd6ba8dd-c1a0-36ac-8a7c-6b246eb51217> ;
        ecrm:P3_has_note               "Circ. 508 to 514 - 1919 formed part of the original  purchase from General Wallace (the donor) of 13 Shan weft-ikat textiles for £52. They were returned to the department in 1979.\n\nExtract from the donor's letter September 4 1919:\n\" In 1886 I was present when we occupied the Southern Shan States of Upper Burmah and purchased some cloths in the villages near Fort Stedman, then the headquarters of the South Shan States Administration\"."@en .

