<http://data.silknow.org/object/dd6ba8dd-c1a0-36ac-8a7c-6b246eb51217/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "An example of a Shan silk and cotton <font -i>longyi</font> chiefly in yellow, pale-blue, red, white, purple and shades of green on a chestnut ground from Inle Lake, Shan States, Burma. In plain weave patterned with weft-ikat and supplementary weft tapestry designs. c. 1885"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/dd6ba8dd-c1a0-36ac-8a7c-6b246eb51217> .

<https://sws.geonames.org/1295645/>
