<http://data.silknow.org/event/fb2fb2c0-b3bf-39b9-bdf1-61fa66de776a>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Stitching of the kind used here was particularly associated with Gujarati craftsmen.  The style of the coat and the cool palette of the colours of the design suggest Iranian influence."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/fce81904-dd85-3856-8b33-00d4105cfece> ;
        ecrm:P3_has_note               "Stitching of the kind used here was particularly associated with Gujarati craftsmen.  The style of the coat and the cool palette of the colours of the design suggest Iranian influence."@en .

