        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This fragment of painted silk was produced in south China for export to the West. It is not a style that the Chinese would have used themselves. Judging by its present shape, this silk appears to have been part of a dress, a common use for this type of Chinese textile, but similar painted silks were also used for furnishings."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1dca1827-ccf3-375f-943d-02af4e0f849e> .

