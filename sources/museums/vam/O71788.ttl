<http://data.silknow.org/object/6774c1de-29eb-3436-9f25-06e42a79a2bc>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This yellow robe is the kind of garment that was worn by wealthy Chinese men. It is particularly soft and supple to the touch. The pronounced sheen on the satin enables the dragon roundels to stand out distinctly. The design has been matched across the seam and the side fastening."@en , "Robe of ochre satin damask with an all-over pattern of medallions, each of which contains a pair of five-clawed dragons. The robe is lined with a pale blue silk and fastened with 5 brass buttons."@en , "Man's robe of silk damask, China, late 18th century - early 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/03d53860-aaa9-3b39-9d76-1ffeb1ded82e> , <http://data.silknow.org/image/87ae51fb-3a39-3ffa-b231-b80df1ed7f54> , <http://data.silknow.org/image/6c69e943-79b5-3b5f-8e95-72a0474b272b> , <http://data.silknow.org/image/64e442fe-6120-3afd-ac5a-257f2f7c0cad> ;
        ecrm:P3_has_note               "This yellow robe is the kind of garment that was worn by wealthy Chinese men. It is particularly soft and supple to the touch. The pronounced sheen on the satin enables the dragon roundels to stand out distinctly. The design has been matched across the seam and the side fastening."@en , "Robe of ochre satin damask with an all-over pattern of medallions, each of which contains a pair of five-clawed dragons. The robe is lined with a pale blue silk and fastened with 5 brass buttons."@en , "Man's robe of silk damask, China, late 18th century - early 19th century"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6774c1de-29eb-3436-9f25-06e42a79a2bc/dimension/3> , <http://data.silknow.org/object/6774c1de-29eb-3436-9f25-06e42a79a2bc/dimension/1> , <http://data.silknow.org/object/6774c1de-29eb-3436-9f25-06e42a79a2bc/dimension/4> , <http://data.silknow.org/object/6774c1de-29eb-3436-9f25-06e42a79a2bc/dimension/2> ;
