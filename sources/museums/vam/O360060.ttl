<http://data.silknow.org/object/4aded2bd-82aa-3a94-95ab-f24df3e425e8>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Curtain, machine woven, ca. 1880, British; possibly woven by James Templeton & Company"@en , "Machine woven silk, wool and cotton curtain that has dado and filling patterned areas with various borders. The dado has a horizontal panel with a symmetrical pattern of stylised flower heads and fig leaves, and a border decorated with leaves and flower heads and punctuated by roundels enclosing floral and foliate motifs. The ground alternates between gold yellow and blue. The leaves are brown and the flower heads are green, red and pale blue. The filling has a blue ground with a 'strapwork' framework crossed by an enclosing arabesque decoration in gold yellow. The two main patterned areas have various decorative borders with ogees, roundels, quatrefoils, etc. in yellow on a blue ground."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/21c3247a-8ed0-3bfc-8785-743ca94df239> ;
        ecrm:P3_has_note               "Machine woven silk, wool and cotton curtain that has dado and filling patterned areas with various borders. The dado has a horizontal panel with a symmetrical pattern of stylised flower heads and fig leaves, and a border decorated with leaves and flower heads and punctuated by roundels enclosing floral and foliate motifs. The ground alternates between gold yellow and blue. The leaves are brown and the flower heads are green, red and pale blue. The filling has a blue ground with a 'strapwork' framework crossed by an enclosing arabesque decoration in gold yellow. The two main patterned areas have various decorative borders with ogees, roundels, quatrefoils, etc. in yellow on a blue ground."@en , "Curtain, machine woven, ca. 1880, British; possibly woven by James Templeton & Company"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4aded2bd-82aa-3a94-95ab-f24df3e425e8/dimension/1> , <http://data.silknow.org/object/4aded2bd-82aa-3a94-95ab-f24df3e425e8/dimension/2> ;
        dc:identifier                  "T.366-1976" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O360060> .

<http://data.silknow.org/object/4aded2bd-82aa-3a94-95ab-f24df3e425e8/observation/1>
        a                   crmsci:S4_Observation ;
