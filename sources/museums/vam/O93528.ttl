        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The combination of delicate embroidery and dark blue satin fabric give this kimono a  striking, lustrous appearance. This kimono has a design of ducks on rippling water among flowers. Paired ducks are a symbol of marital harmony, so this kimono may have been part of a wedding trousseau."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a3450efe-2470-3a84-97b7-8ddfb614d3f1> .

