<http://data.silknow.org/event/7968f642-cac6-3283-95ad-86233ffee127>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This tablecover was donated by the grandson of Laurence Hodson of Compton Hall,  Wolverhampton a great admirer of the work of William Morris who commissioned the firm of Morris & Co. to decorated part of the house. The commission was completed in 1896 and this cloth and related carpet (see T.425-1993) are likely to have been purchased for the house at this time.\n(Registered File number 1993/904)"@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/1f52b2c4-3359-39a2-9740-fbbbfbcce210> ;
