<http://data.silknow.org/object/61d1eee7-423b-3f97-b177-7da0755381e3/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Patchwork quilt, embroidered and made by Mrs Fanny Stirling, the Victorian actress, from pieces of her stage costumes.  Once owned by Lilian Baylis and used by Laurence Olivier in 1937."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/61d1eee7-423b-3f97-b177-7da0755381e3> .

