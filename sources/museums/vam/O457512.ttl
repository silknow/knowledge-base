        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of square mandarin badges of woven silk tapestry (kesi) in coloured silks and gold thread.\n\nEach square is woven with a design of a mandarin duck, the insignia of a civil official of the seventh rank, and a background of water, waves, rocks, clouds and Taoist symbols.\n\nFront square is 11.25 x 11 ins, back square: 11 x 11.25 ins."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d304f869-c465-318b-b17b-39aafef2e2c4> .

