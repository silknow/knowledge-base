<http://data.silknow.org/object/e10f825e-0cb4-3f13-b28b-6d42cdd938fd/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Woven silk panel with dark green ground, France, ca. 1730-1735"@en ;
