<http://data.silknow.org/event/de81935b-b174-3c00-82fa-bfb1a3ee6540>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This waistcoat and the associated shirt (T.561-1919) were worn by a Mr. Eeles for his wedding in 1848.\n\nAt least three Mr Eeles married in 1848, so it is unclear which of them might be associated with this waistcoat. It was originally thought that this might have been worn by Edwin Eeles, who married Harriet Elizabeth Murray at the India Office for Ecclesiastical Returns, Bengal, on 7 May 1848, but this is now in some doubt."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/17303839-5823-306e-87af-1cbeb62aca4b> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Francis C. Eeles" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/2cc8628c-2e79-3252-849a-528b1777ee78> ;
        ecrm:P3_has_note               "This waistcoat and the associated shirt (T.561-1919) were worn by a Mr. Eeles for his wedding in 1848.\n\nAt least three Mr Eeles married in 1848, so it is unclear which of them might be associated with this waistcoat. It was originally thought that this might have been worn by Edwin Eeles, who married Harriet Elizabeth Murray at the India Office for Ecclesiastical Returns, Bengal, on 7 May 1848, but this is now in some doubt."@en .

