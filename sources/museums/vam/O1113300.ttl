<http://data.silknow.org/object/4cea696d-53f3-3d5b-bfc6-c4476359ad9d>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk programme on cream silk in black typography.  Produced for The Benefit of R. Thomas with 'Chapter of Accidents', 'The Catch-Club' and 'Chrononhotonthologos', Theatre Brighthelmson, 7th October 1789. Printed silk, Gerald Morice Collection."@en , "Cream silk programme printed in black ink printed with the name of the theatre, the date and that it was 'by the desire of the Hon. Mrs. North', giving details of the performance of the curtain-raiser<i>The Chapter of Accidents</i> preceding the farce <i>The Catch Club</i> followed by the comic afterpiece <i>Chrononhotonontherlogos</i>"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/fc8d70db-c2a5-3372-a257-df0b7a443617> ;
        ecrm:P3_has_note               "Silk programme on cream silk in black typography.  Produced for The Benefit of R. Thomas with 'Chapter of Accidents', 'The Catch-Club' and 'Chrononhotonthologos', Theatre Brighthelmson, 7th October 1789. Printed silk, Gerald Morice Collection."@en , "Cream silk programme printed in black ink printed with the name of the theatre, the date and that it was 'by the desire of the Hon. Mrs. North', giving details of the performance of the curtain-raiser<i>The Chapter of Accidents</i> preceding the farce <i>The Catch Club</i> followed by the comic afterpiece <i>Chrononhotonontherlogos</i>"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4cea696d-53f3-3d5b-bfc6-c4476359ad9d/dimension/1> , <http://data.silknow.org/object/4cea696d-53f3-3d5b-bfc6-c4476359ad9d/dimension/2> ;
