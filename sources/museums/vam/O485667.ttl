<http://data.silknow.org/event/498f0585-17c0-31cd-b9b8-653c83faeb7f>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "There are seven of the eight Buddhist  emblems of Happy Augury (Pa Chi-hsiang), i.e.  the wheel (lun), the couch shell (Lo), the state  umbrella (san), the lotus-flower (hua), the  vase (p'ing), the pair of fish (yu), the \"entrails\"  or endless knot (chang)"@en ;
