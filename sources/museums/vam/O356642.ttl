<http://data.silknow.org/object/b08177ce-01e1-3840-a0f8-67f2b1ea570f>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pair of tapestry pictures woven in wool and silk on cotton warp (16 to the inch) with a wooden frame. It depicts a bunch of flowers on a dull blue-green ground with fawn and cream edging.\n\nAll colours are soft, muted reds, pinks, browns, brownish yellow, creams and a wide variety of grey-greens and olive-greens.\n\nThe tapestry is stretched on backboards and set in wooden frames."@en , "Pair of tapestry woven pictures of wool, silk and cotton, woven by William Haines, England,1891"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/376491e7-a15e-3272-b37d-e183e5f92a08> , <http://data.silknow.org/image/54d3750b-23df-31e1-9ca4-7de2ff2a0210> ;
        ecrm:P3_has_note               "Pair of tapestry woven pictures of wool, silk and cotton, woven by William Haines, England,1891"@en , "Pair of tapestry pictures woven in wool and silk on cotton warp (16 to the inch) with a wooden frame. It depicts a bunch of flowers on a dull blue-green ground with fawn and cream edging.\n\nAll colours are soft, muted reds, pinks, browns, brownish yellow, creams and a wide variety of grey-greens and olive-greens.\n\nThe tapestry is stretched on backboards and set in wooden frames."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/b08177ce-01e1-3840-a0f8-67f2b1ea570f/dimension/4> , <http://data.silknow.org/object/b08177ce-01e1-3840-a0f8-67f2b1ea570f/dimension/3> , <http://data.silknow.org/object/b08177ce-01e1-3840-a0f8-67f2b1ea570f/dimension/2> , <http://data.silknow.org/object/b08177ce-01e1-3840-a0f8-67f2b1ea570f/dimension/1> ;
