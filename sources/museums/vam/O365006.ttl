<http://data.silknow.org/object/fb07bdec-e5ae-34dd-9002-f1132592edbd/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Textile panel woven in pale blue silk with a self-coloured floral design in the warp. This consists of a meandering stem of fruit and leaves repeated three times in the width of the fabric. The silk is woven with a tabby ground and an additional flushing warp to form the pattern. Edged with silk braid and lined with yellow silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/fb07bdec-e5ae-34dd-9002-f1132592edbd> .

<http://data.silknow.org/object/fb07bdec-e5ae-34dd-9002-f1132592edbd>
