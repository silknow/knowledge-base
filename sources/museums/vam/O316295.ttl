<http://data.silknow.org/object/b0a24b0f-7829-34c5-ae75-dbf13571c08d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of slipper fronts. Two panels of grey Penelope canvas embroidered with wool and silk in tent stitch. In the centre of each panel is the outline of a slipper top, the front of which are decorated with flowery bowers containing, in one, a lady, and on the other, a man in a military uniform. The faces of the figures are worked in half-size tent stitched."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b0a24b0f-7829-34c5-ae75-dbf13571c08d> .

<http://data.silknow.org/object/b0a24b0f-7829-34c5-ae75-dbf13571c08d>
