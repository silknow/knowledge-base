<http://data.silknow.org/object/4403887f-5e18-3256-98fa-bbdc5265d383/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Satin ribbon sash embroidered at either end with a spray of flowers in silk and chenille thread, ribbon and coloured aerophane satin and chain stitches and couched work. Cream satin ground, the embroidered ends are lined and the weft threads have been removed from the last 1.25 inches to form a silk fringe."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4403887f-5e18-3256-98fa-bbdc5265d383> .

