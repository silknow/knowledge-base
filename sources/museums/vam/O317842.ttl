        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Textile of figured silk rep. Yellow silk, heavily ribbed, with a motif of rosettes within medallions from which radiate classical-style decorations. The pattern is formed by a portion of the yellow silk warp carried over three of the thick white ribbing wefts. Possibly a chair back."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/53456ec4-b297-3cf7-b3fb-4b42082f0784> .

