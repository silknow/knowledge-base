        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Scarf of white silk with narrow bands and stripes of more closely woven silk at the edges and marking off the border. This is filled with fantastic flowers, linked by black line stems, printed in pink, red, yellow, pale blue and green. Flowers of the same type appear in narrow bands across the whole scarf. The areas between are printed pale yellow. A yellow silk fringe is knotted into the two narrow ends."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/06e371dd-8165-317d-9054-b710d94ab304> .

