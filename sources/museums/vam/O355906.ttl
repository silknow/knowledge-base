<http://data.silknow.org/object/903f625e-b624-3f5b-acab-7a9ad4b18340>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O355906" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/71249fc1-4510-31da-a4a6-f7a0635ac523> , <http://data.silknow.org/object/71249fc1-4510-31da-a4a6-f7a0635ac523/domain/1> , <http://data.silknow.org/image/d8a39d1f-445b-3493-946d-8970a4b4958f> , <http://data.silknow.org/object/71249fc1-4510-31da-a4a6-f7a0635ac523/domain/2> , <http://data.silknow.org/object/71249fc1-4510-31da-a4a6-f7a0635ac523/observation/1> , <http://data.silknow.org/object/71249fc1-4510-31da-a4a6-f7a0635ac523/observation/2> , <http://data.silknow.org/event/61091632-d9e0-3b0f-9d41-fbcb167abe58> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/production/89d77c9b-a992-3b00-93f7-14b7034aa45f> ;
