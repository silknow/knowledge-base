        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Lozenge-shaped pendent reliquary of gilded copper, with trefoil ends decorated with imitation applied filigree.  In the centre is an oval space containing the relics of three saints, on a red silk background, under facetted glass.  There is a piece of cardboard at the back.  At the top is a winged angel's head, with a hole above it for suspension."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/558888b0-2c07-37da-95be-dfb3ee1b6279> .

