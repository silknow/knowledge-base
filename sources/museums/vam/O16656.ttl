<http://data.silknow.org/object/1737a8a6-48d7-3370-8207-b1f06240e8d3/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Furnishing fabric of woven silk. In fleshy scrolls and arabesques in sharp yellow to form a symmetrical pattern on a parti-coloured ground of blue, green, red and black. The blue silk has a satin binding, the rest in bound in 3/1 twill."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1737a8a6-48d7-3370-8207-b1f06240e8d3> .

