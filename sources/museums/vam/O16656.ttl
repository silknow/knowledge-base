<http://data.silknow.org/object/1737a8a6-48d7-3370-8207-b1f06240e8d3/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nThis high quality furnishing silk was called 'Alhambresque'. Its title and pattern emphasise the British fascination from about 1840 with the decorative style of the Islamic world. The colour scheme was influenced by illustrations in the publications of Owen Jones on the Alhambra and in his 'Grammar of Ornament' of 1856. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1737a8a6-48d7-3370-8207-b1f06240e8d3> .

