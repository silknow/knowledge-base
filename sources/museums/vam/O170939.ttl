        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O170939" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/610e3e13-7c4c-3ab0-9723-f6ccf96f38dd> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/observation/2> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/domain/1> , <http://data.silknow.org/image/e05873a6-f2d9-3fa8-8830-9c16a6b7d6d1> , <http://data.silknow.org/production/12872c2e-8682-3397-9113-cc900e70fec3> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/domain/4> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/observation/3> , <http://data.silknow.org/event/83751cb5-9fbb-3447-b3c5-864230d98270> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/observation/1> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/domain/2> , <http://data.silknow.org/image/11f1ddc4-a5bd-36b5-b84f-b6ab71616f75> , <http://data.silknow.org/object/a6b972a6-472c-344d-af4c-02a8826a3ae9/domain/3> ;
