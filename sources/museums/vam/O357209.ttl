        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Two halves of a man’s waistcoat made of green silk taffeta, tamboured with coloured silks in a pattern of swags and flowers.  It has a round neckline, shaped pocket flaps and short skirts reaching to the top of the thigh. The waistcoat fronts are lined with ivory silk twill, the back is made of and lined with fustian."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cd706ca1-340a-38e5-bb80-9a50b01b0a39> .

