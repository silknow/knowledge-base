<http://data.silknow.org/object/08d2aee8-e4db-3d2d-a4cc-f79e5d797400/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nSumpter cloths were used as decorative hangings but originally they were designed to cover goods being carried by packhorses. The design would have been visible either side of the animal. Each of the winged boys adopts a different pose against Baroque acanthus scrollwork. [27/03/2003]"@en ;
