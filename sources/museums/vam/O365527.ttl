        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Page with four silk samples attached. It is headed 'No XXIV. Dec. 1810', and has a printed surround for the samples. The print shows Fame and the royal arms above, Neptune and Britannia at the sides and an advertisement below requesting manufacturers and wholesale dealers to send patterns and samples. It reads 'Patterns of new Articles, as they come out...'."@en , "Page with four silk samples, 'No XXIV. Dec. 1810', published by R. Ackermann's Repository of Arts , Great Britain, 1810."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/40ea31b0-9da3-3b09-9c07-d964aa16ed41> , <http://data.silknow.org/image/c3948843-5c29-3686-94d9-5b304d85750c> , <http://data.silknow.org/image/7a9067d0-cc24-315f-bda4-1d4f6d7251d8> ;
        ecrm:P3_has_note               "Page with four silk samples attached. It is headed 'No XXIV. Dec. 1810', and has a printed surround for the samples. The print shows Fame and the royal arms above, Neptune and Britannia at the sides and an advertisement below requesting manufacturers and wholesale dealers to send patterns and samples. It reads 'Patterns of new Articles, as they come out...'."@en , "Page with four silk samples, 'No XXIV. Dec. 1810', published by R. Ackermann's Repository of Arts , Great Britain, 1810."@en ;
