<http://data.silknow.org/object/71777790-bcfb-313f-a128-495ed22e1190>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk crepe embroidered with coloured silks; knotted fringe, China, Qing dynasty, 1810-1840s"@en , "Shawl.Rectangular shape.White silk crepe ground embroidered with twisted coloured silks; knotted fringe at either end. The embroidery fills the ends, and forms a complete border to the shawl; the rest of the fabric is left plain, except for a few floral sprigs at wide intervals. The pattern represents lotuses, peonies, hydrangeas and other flowers, arranged in plant form at the ends and in continuous wavy stems in the border. One side is now rather faded up.\nUnhemmed loom-width of plain weave silk embroidered in coloured silks. Double sided."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6aa0481c-48fb-3a72-b483-f642d345b508> , <http://data.silknow.org/image/aa22d2b1-1dbf-3c08-8169-4f28bc128db1> , <http://data.silknow.org/image/4dc0a5ac-d0ad-30a0-898b-3503ef84c3f2> , <http://data.silknow.org/image/69d69c6a-73c5-33a1-9ec5-4f3aa749a6d9> ;
        ecrm:P3_has_note               "Shawl.Rectangular shape.White silk crepe ground embroidered with twisted coloured silks; knotted fringe at either end. The embroidery fills the ends, and forms a complete border to the shawl; the rest of the fabric is left plain, except for a few floral sprigs at wide intervals. The pattern represents lotuses, peonies, hydrangeas and other flowers, arranged in plant form at the ends and in continuous wavy stems in the border. One side is now rather faded up.\nUnhemmed loom-width of plain weave silk embroidered in coloured silks. Double sided."@en , "Silk crepe embroidered with coloured silks; knotted fringe, China, Qing dynasty, 1810-1840s"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/71777790-bcfb-313f-a128-495ed22e1190/dimension/1> , <http://data.silknow.org/object/71777790-bcfb-313f-a128-495ed22e1190/dimension/2> ;
