<http://data.silknow.org/object/e08e13f7-596b-3fb6-bc29-567fd7c7a921>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Panel of red and cream cut velvet, artichoke pattern, Italy, 1460s"@en , "Although it does not contain metal thread, the complex weave of this velvet imitates the effects of a richly looped cloth of gold. It would not have been as expensive as real cloth of gold, but would still have been a fabric of high status. \nThe velvet was acquired by the Museum as part of a dalmatic, a type of sleeved tunic worn by some clergy in the Christian Church."@en , "Woven velvet.\nWoven in cut pile on a cream ground.\nItalian; 1450 - 1500.\nThis velvet is thought to have been part of a dalmatic, a sleeved tunic worn by deacons.\n []"@en , "T.839-1919 and T.839A-1919 have been joined together, to the extent that they appear as one object."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/47c09ae2-2d5a-398f-ae44-fc144fe58982> , <http://data.silknow.org/image/ee6e7e18-d468-3d10-9307-af5f57b76e0a> , <http://data.silknow.org/image/95ecc4dc-8ffe-3dfd-b980-332b90a0e702> ;
        ecrm:P3_has_note               "Although it does not contain metal thread, the complex weave of this velvet imitates the effects of a richly looped cloth of gold. It would not have been as expensive as real cloth of gold, but would still have been a fabric of high status. \nThe velvet was acquired by the Museum as part of a dalmatic, a type of sleeved tunic worn by some clergy in the Christian Church."@en , "Woven velvet.\nWoven in cut pile on a cream ground.\nItalian; 1450 - 1500.\nThis velvet is thought to have been part of a dalmatic, a sleeved tunic worn by deacons.\n []"@en , "Panel of red and cream cut velvet, artichoke pattern, Italy, 1460s"@en , "T.839-1919 and T.839A-1919 have been joined together, to the extent that they appear as one object."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/e08e13f7-596b-3fb6-bc29-567fd7c7a921/dimension/2> , <http://data.silknow.org/object/e08e13f7-596b-3fb6-bc29-567fd7c7a921/dimension/1> ;
