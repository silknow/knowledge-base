<http://data.silknow.org/object/cd18d04f-3cb3-3caa-824e-65e3c1be661a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Furnishing fabric of silk twill satin. On a purple satin ground is an ogival lattice with a small heraldic rose at the interstices. Within the lattice is a bunch of thistles, clover and Tudor rose. The pattern is in cream or 'gold' silk, bound in twill."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cd18d04f-3cb3-3caa-824e-65e3c1be661a> .

