        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Textile fragment of brocaded silk with a blue tabby ground brocaded with a floral design in pink, tan and green silk and silver thread. The silver strip is loosely wound on a yellow silk core. There is a selvedge on the left hand side. Eight black warp threads woven in tabby with the white ground weft. The brocaded wefts are unbound."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/313d2d6f-0262-35b8-bda9-c76b6564253a> .

