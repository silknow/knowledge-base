<http://data.silknow.org/object/1dd8733a-861a-309f-8243-3c5fcbbf9330>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O168948" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/b4c4bbaa-bd86-32db-93e6-f8d1d7247be2> , <http://data.silknow.org/object/ae14ae2a-c7e8-3238-8b77-1bb58241bbf3/observation/2> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/ae14ae2a-c7e8-3238-8b77-1bb58241bbf3> , <http://data.silknow.org/image/9355d5ba-2a46-313b-ac3d-8520df724975> , <http://data.silknow.org/object/833a927a-31aa-36a3-93c2-9a578e9f9a18> , <http://data.silknow.org/object/ae14ae2a-c7e8-3238-8b77-1bb58241bbf3/observation/1> , <http://data.silknow.org/image/977de92b-46ed-396a-904c-2c6d8505af4d> , <http://data.silknow.org/production/265bc669-6aa7-36a9-b666-c66f02471b14> , <http://data.silknow.org/object/ae14ae2a-c7e8-3238-8b77-1bb58241bbf3/domain/1> ;
