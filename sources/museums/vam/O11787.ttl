<http://data.silknow.org/event/89f9ad8f-3836-3111-88be-44b0d8cdf128>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This military court costume was specially styled for a minister serving under King Thibaw (r. 1878-1885).  Said to have been removed from the palace of King Thebaw at Mandalay during the Third Burmese War (1885).\n\nHistorical significance: The quality and degree of gold decoration  signified the owner's rank and would have been authorised by the King."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/9bb694d0-b677-372a-8197-79a02d2c397b> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by H. D. Colt, Esq." ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/67195347-6a0c-3337-8dcb-0ce6f84c28ba> ;
        ecrm:P3_has_note               "This military court costume was specially styled for a minister serving under King Thibaw (r. 1878-1885).  Said to have been removed from the palace of King Thebaw at Mandalay during the Third Burmese War (1885).\n\nHistorical significance: The quality and degree of gold decoration  signified the owner's rank and would have been authorised by the King."@en .

