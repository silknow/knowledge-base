<http://data.silknow.org/object/67195347-6a0c-3337-8dcb-0ce6f84c28ba>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Minister's military court costume consisting of a robe, jacket and collar of embroidered velvet and silk, Burma, ca. 1878-1885"@en , "Unique"@en , "This ceremonial military costume of gold encrusted green and plum velvet was specially styled for a minister who served King Thibaw (r. 1878-1885), the last king of the Konbaung Dynasty, at the Court of Mandalay. Consisting of a long fitted robe, separate sleeveless jacket and spectacular \"cloud collar\". The quality of the velvet, its colour and degree of gold decoration defined the minister's rank, which he had been awarded by the King."@en , "Minister's military court costume consisting of a robe, jacket and collar of velvet and silk with gold brocade."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e875aa63-e98c-3e43-b10b-332f5273f6ab> , <http://data.silknow.org/image/d8153ff7-c6e8-38d3-a46f-4b34f27f7275> ;
        ecrm:P3_has_note               "Minister's military court costume consisting of a robe, jacket and collar of embroidered velvet and silk, Burma, ca. 1878-1885"@en , "This ceremonial military costume of gold encrusted green and plum velvet was specially styled for a minister who served King Thibaw (r. 1878-1885), the last king of the Konbaung Dynasty, at the Court of Mandalay. Consisting of a long fitted robe, separate sleeveless jacket and spectacular \"cloud collar\". The quality of the velvet, its colour and degree of gold decoration defined the minister's rank, which he had been awarded by the King."@en , "Minister's military court costume consisting of a robe, jacket and collar of velvet and silk with gold brocade."@en , "Unique"@en ;
        dc:identifier                  "IS.256 to B-1960" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O11787> .

