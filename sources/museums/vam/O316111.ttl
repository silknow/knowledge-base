<http://data.silknow.org/object/ff6e2837-8eab-3378-82d5-330a4620459b>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered chair seat, England, ca. 1730."@en , "Chair seat of canvas, embroidered with wool and silk in shades of   mustard, green, red, pink, blue, grey, beige, brown, mauve and   cream in cross and tent stitches.\nThe border has a mustard-coloured ground decorated with large,   brightly coloured flowers; carnation, lily, convolvulus and peony.\nThe central embroidered scene is of 'The Cur, the Horse and the Shepherd's Dog'. The initials 'E.W.' are embroidered on the wall in the middle distance."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b114a416-1808-3478-bf01-7c6dd2082dfa> , <http://data.silknow.org/image/c0262851-c076-3bab-94a3-3c042dc2ffe4> ;
        ecrm:P3_has_note               "Embroidered chair seat, England, ca. 1730."@en , "Chair seat of canvas, embroidered with wool and silk in shades of   mustard, green, red, pink, blue, grey, beige, brown, mauve and   cream in cross and tent stitches.\nThe border has a mustard-coloured ground decorated with large,   brightly coloured flowers; carnation, lily, convolvulus and peony.\nThe central embroidered scene is of 'The Cur, the Horse and the Shepherd's Dog'. The initials 'E.W.' are embroidered on the wall in the middle distance."@en ;
        dc:identifier                  "T.478-1970" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O316111> .

