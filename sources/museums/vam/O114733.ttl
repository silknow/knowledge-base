        ecrm:P3_has_note    "Scarf, silk velvet striped with bands of silk tissue, probably made in Great Britain, 1840-1850s."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8a568382-01d2-38f4-9a06-2fea68146d50> .

