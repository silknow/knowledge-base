<http://data.silknow.org/event/ec50d453-7ad8-38a8-be63-9aee83f51928>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Purchased by the Museum for £7 7s in 1914 from Mrs. Parker of Uppingham, Rutland. Mrs. Parker claimed it had been obtained by her father some fifty years before from an old lady who had been using it as a duster.\n\nRegistered Papers: 1913/5587"@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
