        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This unusual length of Japanese fabric is a wonderful example of a very sophisticated type of weaving.  It was probably created for use in a costume worn by a member of the imperial court.  It is mounted on paper bearing an inscription which suggests that it was presented as a gift perhaps to a temple or shrine."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/76b206f6-2fe9-3476-a763-ae315d9595ef> .

