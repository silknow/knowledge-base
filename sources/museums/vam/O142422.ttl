<http://data.silknow.org/object/e1e1e3f3-f608-35bb-9f6e-5b63f3ab3664>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O142422" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/84999b22-8a80-31a4-8c76-61897c7cf646> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/domain/2> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/domain/4> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/domain/1> , <http://data.silknow.org/object/700dbff2-b598-3a72-98ea-cc176726e7a4> , <http://data.silknow.org/image/d43ee407-82f7-3a23-91d4-8531084a3173> , <http://data.silknow.org/image/5138e987-1d9c-3d3d-9ecf-1f4db2693cd6> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e> , <http://data.silknow.org/production/b1467ae4-7aee-385e-b903-8d70a719ff72> , <http://data.silknow.org/event/5c084d0f-ddde-3880-b262-7b18254e485a> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/observation/1> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/domain/3> , <http://data.silknow.org/image/402ace0f-3ff0-3902-bd38-4a7ead96c0c1> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/observation/3> , <http://data.silknow.org/object/2d5f5543-0cb2-3b07-a932-9aa1039ea59e/observation/2> ;
