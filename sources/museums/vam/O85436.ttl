<http://data.silknow.org/event/48605c44-5eb2-3696-b1a6-75538e7c5446>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Fashionable gowns of the 1590s and early seventeenth century were often worn open in front to reveal a decorative petticoat or forepart underneath.\n\nThis panel is thought to have once belonged to a similarly decorated petticoat as that worn in a portrait of Elizabeth I at Hardwick Hall.  The choice of devices may represent a personal narrative now lost to us."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/086b3f47-6764-3a03-87d1-ebd6a246e687> ;
        ecrm:P3_has_note               "Fashionable gowns of the 1590s and early seventeenth century were often worn open in front to reveal a decorative petticoat or forepart underneath.\n\nThis panel is thought to have once belonged to a similarly decorated petticoat as that worn in a portrait of Elizabeth I at Hardwick Hall.  The choice of devices may represent a personal narrative now lost to us."@en .

