<http://data.silknow.org/event/b24f2bcb-6028-330d-8104-52dae4c4b225>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This bronze medal was awarded for the whitework shirt (T.47-1952).  It originally came in a circular bronze frame (now NIP) bearing the words 'Honourable Mention'.Awarded at the Great Exhibition of 1851, Class XX (No. 22). \n\nA printed label, possibly part of this box, found in 110 store in 120A"@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/33232a47-87af-366d-8bb4-a8c3e2cd75d9> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Mrs G. Wraith" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/e162e3dd-38d7-3748-9998-9cc0fc783a9a> ;
        ecrm:P3_has_note               "This bronze medal was awarded for the whitework shirt (T.47-1952).  It originally came in a circular bronze frame (now NIP) bearing the words 'Honourable Mention'.Awarded at the Great Exhibition of 1851, Class XX (No. 22). \n\nA printed label, possibly part of this box, found in 110 store in 120A"@en .

<http://data.silknow.org/object/e162e3dd-38d7-3748-9998-9cc0fc783a9a/domain/1>
