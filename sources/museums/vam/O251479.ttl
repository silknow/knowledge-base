        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Octagonal panel; white silk embroidered with festoons of ribbon bows, flower garlands and tassels, surrounding a pendant map of the \"Eastern, or Old World\" (showing Europe, Africa, Asia and the Russian Empire) worked in fine black silk against white, flanked with figures, the left depicting a black figure representing \"Africa\" wearing a turban with two lions; and on the right, a white woman (presumably \"Europe\") in a feathered headdress with a dog. Glazed and framed in an octagonal narrow wooden marquetry frame"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/3ed6b69b-3bbd-3448-afa5-4047b44a2c80> .

