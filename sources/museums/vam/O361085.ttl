        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Embroidered picture of fawn silk with black and fawn silks in overlaid stitches and speckling. With a landscape within an oval, a river running through a wooden valley with a country house on the right, and other scattered buildings. The back of the glass is painted in black and gold to form a surround to the oval picture. Gilt frame."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ca7c396f-73a2-30a5-8cff-1d4dffaf8132> .

