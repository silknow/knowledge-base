<http://data.silknow.org/object/7f01a5f8-2de1-390d-8c7e-add4775a88e1>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "This embroidery belongs to Group 3 as defined by Jennifer Wearden in 'Azerbaijanian Embroideries: A Synthesis of Contrasts' in Hali Issue 59, October 1991 pp. 102-111.  Group 3 textiles are characterised by  surface darning on the diagonal.\n<i>The Collection of Oriental Embroideries, etc. of the late Alfred Morrison, Esq</i> (1 December 1898), lot 78."@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/40d7ff5a-569d-3fe8-8188-ac153e0b9bc5> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "This embroidery belongs to Group 3 as defined by Jennifer Wearden in 'Azerbaijanian Embroideries: A Synthesis of Contrasts' in Hali Issue 59, October 1991 pp. 102-111.  Group 3 textiles are characterised by  surface darning on the diagonal.\n<i>The Collection of Oriental Embroideries, etc. of the late Alfred Morrison, Esq</i> (1 December 1898), lot 78."@en .
