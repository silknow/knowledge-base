<http://data.silknow.org/object/4abe9400-5d21-372d-b26b-4beafd2eb515>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O153048" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/602fa99e-2033-34f8-be83-130bd17ff0e7/observation/2> , <http://data.silknow.org/object/602fa99e-2033-34f8-be83-130bd17ff0e7/domain/1> , <http://data.silknow.org/image/32256958-3276-39ca-8565-10375483a8fb> , <http://data.silknow.org/image/da77255d-70f1-3cc3-8015-63397d8d22b3> , <http://data.silknow.org/image/50475836-e563-385c-b2e1-e11f9e81efc1> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/image/c1ea2c89-3eac-320a-8714-bb7ad7eeaa02> , <http://data.silknow.org/event/d73e1068-67d6-342c-8824-bad791092bb5> , <http://data.silknow.org/object/602fa99e-2033-34f8-be83-130bd17ff0e7> , <http://data.silknow.org/production/76595937-3964-3cd0-80b2-c37477ddc5da> , <http://data.silknow.org/object/602fa99e-2033-34f8-be83-130bd17ff0e7/observation/1> ;
