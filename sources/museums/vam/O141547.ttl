<http://data.silknow.org/object/76decde4-8846-39b5-a4a2-bad70ab16725/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "The left hand of a pair of elbow-length evening gloves of bright yellow kid of very fine quality. The glove is cut with a 'Bolton thumb', quirks and fourchettes and is constructed with  'pique' or 'lapseams'. The base of the the thumb has been decorated with a double line of stitching and the back of the hand is finished with points worked with double lines of stitching. The seam from the wrist to the cuff has not been closed."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/76decde4-8846-39b5-a4a2-bad70ab16725> .

