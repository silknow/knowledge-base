<http://data.silknow.org/object/b5b99092-4572-3f8f-b0ea-76d80def0e65>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Shawl of woven silk, probably woven in Paisley, Scotland, ca. 1848-1852"@en , "Shawl of woven silk. Woven with very deep ends and fairly broad borders of pattern protruding into a plain silk centre, fuschia pink on one side of the centre line and a deep blue on the other. The centre line is marked by a very narrow band of pattern. The pattern is a mixture of 'cone' design with flowers and frond-like filling. The colours of the wool are maroon, pink, orange, blue, green and white. A silk fringe is knotted into each end, in blue and pink respectively."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b734a8ed-f0fe-38dd-9128-ca64fc5b1ebe> , <http://data.silknow.org/image/83f3731b-5314-307e-9d66-5931043ea959> , <http://data.silknow.org/image/281bc3d5-7644-3fb5-a1cd-d7fbfcaf4795> , <http://data.silknow.org/image/32140dbe-f7fa-3c52-a87a-f8dc1f3dca86> , <http://data.silknow.org/image/44685ba6-a58b-37c2-b41b-978fae7a15ec> ;
        ecrm:P3_has_note               "Shawl of woven silk. Woven with very deep ends and fairly broad borders of pattern protruding into a plain silk centre, fuschia pink on one side of the centre line and a deep blue on the other. The centre line is marked by a very narrow band of pattern. The pattern is a mixture of 'cone' design with flowers and frond-like filling. The colours of the wool are maroon, pink, orange, blue, green and white. A silk fringe is knotted into each end, in blue and pink respectively."@en , "Shawl of woven silk, probably woven in Paisley, Scotland, ca. 1848-1852"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/b5b99092-4572-3f8f-b0ea-76d80def0e65/dimension/4> , <http://data.silknow.org/object/b5b99092-4572-3f8f-b0ea-76d80def0e65/dimension/1> , <http://data.silknow.org/object/b5b99092-4572-3f8f-b0ea-76d80def0e65/dimension/3> , <http://data.silknow.org/object/b5b99092-4572-3f8f-b0ea-76d80def0e65/dimension/2> ;
        dc:identifier                  "T.219-1968" ;
