<http://data.silknow.org/object/916ec747-a104-3292-936c-ffc8448ff613>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Sampler of linen, hand stitched by Maggie Jones, British, 1883"@en , "Darning and buttonhole sampler. Linen panel, the sides turned and secured with herringbone stitches in blue silk, the bottom simply hemmed with linen thread, the deep upper hem secured with two lines of back stitch in red silk.\n\nIn the upper hem are three worked buttonholes in pink and yellow silk. In the centre of the main panel are three patches of fancy darning in red and blue silk. At the bottom the inscription worked in blue, pink and yellow silk in cross stitch."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f21d3262-d3f5-380c-b727-1fbb20a25bc1> , <http://data.silknow.org/image/9925be1a-d72a-36d6-8149-5a9167a25760> ;
        ecrm:P3_has_note               "Darning and buttonhole sampler. Linen panel, the sides turned and secured with herringbone stitches in blue silk, the bottom simply hemmed with linen thread, the deep upper hem secured with two lines of back stitch in red silk.\n\nIn the upper hem are three worked buttonholes in pink and yellow silk. In the centre of the main panel are three patches of fancy darning in red and blue silk. At the bottom the inscription worked in blue, pink and yellow silk in cross stitch."@en , "Sampler of linen, hand stitched by Maggie Jones, British, 1883"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/916ec747-a104-3292-936c-ffc8448ff613/dimension/1> , <http://data.silknow.org/object/916ec747-a104-3292-936c-ffc8448ff613/dimension/2> ;
