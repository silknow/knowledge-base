<http://data.silknow.org/object/635ef1f5-ae26-36eb-bd34-d5c8442f5de9/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Handkerchief of fine bleached linen (approx 50 threads per cm, balanced plain weave) with a 1⅞-inch (4.7 cm) border, embroidered with crimson silk floss.  The embroidery is reversible, worked in counted thread, double running stitch and detached buttonhole stitches.  It is trimmed with ½-inch wide (1.3 cm) silver-gilt bobbin lace."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/635ef1f5-ae26-36eb-bd34-d5c8442f5de9> .

