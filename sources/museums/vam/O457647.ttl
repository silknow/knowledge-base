        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of square mandarin rank badges of silk tapestry (kesi) in coloured silks and gold thread.\n\nEach square is woven with a design of a paradise fly catcher, the insignia of a civil official of the ninth rank, and a background of water, waves, rocks, clouds and Taoist symbols.\n\nFront square is 11.5 x 11.25 ins, the back square: 11.75 x 11.5 ins."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/fde8de54-fcfd-3a6c-b69b-e8f6ed9e325a> .

