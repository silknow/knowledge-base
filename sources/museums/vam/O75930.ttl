<http://data.silknow.org/object/0361ae03-0597-3aa6-bace-ad6518dccc34>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pair of women's leather half-boots, Great Britain, 1815-1820"@en , "Pair of women's leather half-boots with front lacings and low heels. Trimmed with a silk rosette at each toe. The laces are of silk cord with a metal tag. Lined with canvas."@en , "These elegant half-boots for women have a low, stacked heel and rounded toe. Made of kid leather, they are laced up the front and trimmed with a silk rosette. This is the type of footwear worn by genteel women at the time of Jane Austen (1775-1817)."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ec5af741-4dfb-35a5-87d5-03c2e537bd03> , <http://data.silknow.org/image/3017219f-39cc-38ca-8a78-665561542c49> ;
        ecrm:P3_has_note               "Pair of women's leather half-boots with front lacings and low heels. Trimmed with a silk rosette at each toe. The laces are of silk cord with a metal tag. Lined with canvas."@en , "These elegant half-boots for women have a low, stacked heel and rounded toe. Made of kid leather, they are laced up the front and trimmed with a silk rosette. This is the type of footwear worn by genteel women at the time of Jane Austen (1775-1817)."@en , "Pair of women's leather half-boots, Great Britain, 1815-1820"@en ;
        dc:identifier                  "T.435&A-1971" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O75930> .

