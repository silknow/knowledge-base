<http://data.silknow.org/object/3a80b9e9-6db7-3f57-98db-51fa49a94dc2>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Shawl with silk warp and woolen weft, brocaded in cotton with narrow light blue and yellow silk stripes, alternating at four inch intervals. The shawl has a white ground and the brocaded pattern of stylised sprigs in blue, red, deep pink, buff, celadon and olive green. These are repeated throughout the shawl. There is no separate pattern for the border. The ground is woven in tabby, the warp stripes are bound in 2\\1 twill and the brocaded sprigs in 3\\1 weft faced twill."@en , "Shawl, possibly Paisley, ca. 1805-1815."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/11ece972-7e31-397d-9250-56c6887b32df> , <http://data.silknow.org/image/9cbe2e83-ad2e-3c81-bc16-793c98fa846f> , <http://data.silknow.org/image/530b01ad-cb90-3036-bc7e-88ddaeb0625f> , <http://data.silknow.org/image/38d73af0-bd45-327b-a277-486d297b9320> , <http://data.silknow.org/image/10dcefdc-0bc6-3076-bb10-ff836b1a3651> , <http://data.silknow.org/image/fd64b144-355e-309a-bbf0-56917a14b534> ;
        ecrm:P3_has_note               "Shawl, possibly Paisley, ca. 1805-1815."@en , "Shawl with silk warp and woolen weft, brocaded in cotton with narrow light blue and yellow silk stripes, alternating at four inch intervals. The shawl has a white ground and the brocaded pattern of stylised sprigs in blue, red, deep pink, buff, celadon and olive green. These are repeated throughout the shawl. There is no separate pattern for the border. The ground is woven in tabby, the warp stripes are bound in 2\\1 twill and the brocaded sprigs in 3\\1 weft faced twill."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/3a80b9e9-6db7-3f57-98db-51fa49a94dc2/dimension/2> , <http://data.silknow.org/object/3a80b9e9-6db7-3f57-98db-51fa49a94dc2/dimension/3> , <http://data.silknow.org/object/3a80b9e9-6db7-3f57-98db-51fa49a94dc2/dimension/1> ;
