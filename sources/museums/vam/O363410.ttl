<http://data.silknow.org/object/90e9d046-c682-3fe4-b947-04f72c826832>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Scarf of white woven silk with a decorative side edging formed by dark green and white silk warp threads. The scarf is long and narrow, and at each end is a row of seven squat and angular cones in the same green, with fillings in cream and magenta silk. A narrow band of decoration above and a wider below the cones are in the same colours. There is a warp fringe, the silk strands twisted, the pairs of twists are then twisted together and knotted at the bottom."@en , "Silk scarf, Paisley, Scotland, ca. 1810-1815"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c29679c4-a1fd-352c-89f2-bde4ac2af653> , <http://data.silknow.org/image/2f4e9b44-e6cf-3ab1-aef0-8474d1fa8607> , <http://data.silknow.org/image/1f2ada3f-9e65-371b-9e95-f563e721d9a7> ;
        ecrm:P3_has_note               "Scarf of white woven silk with a decorative side edging formed by dark green and white silk warp threads. The scarf is long and narrow, and at each end is a row of seven squat and angular cones in the same green, with fillings in cream and magenta silk. A narrow band of decoration above and a wider below the cones are in the same colours. There is a warp fringe, the silk strands twisted, the pairs of twists are then twisted together and knotted at the bottom."@en , "Silk scarf, Paisley, Scotland, ca. 1810-1815"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/90e9d046-c682-3fe4-b947-04f72c826832/dimension/3> , <http://data.silknow.org/object/90e9d046-c682-3fe4-b947-04f72c826832/dimension/2> , <http://data.silknow.org/object/90e9d046-c682-3fe4-b947-04f72c826832/dimension/1> , <http://data.silknow.org/object/90e9d046-c682-3fe4-b947-04f72c826832/dimension/4> ;
