<http://data.silknow.org/object/7198dc53-fd7f-3ec5-9d70-f0be9ca91802>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered chair seat, England, ca. 1730."@en , "Chair seat of canvas, embroidered with wool and silk in shades of   mustard, green, red, pink, blue, grey, beige, brown, mauve and   cream in cross and tent stitches.\nThe border has a mustard-coloured ground decorated with large,   brightly coloured flowers; carnation, lily, convolvulus and peony.\nThe central embroidered scene is of 'The Gardener and the Hog'. The initials 'E.W.' are embroidered on the balustrades in the middle distance of the scene."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3c909e76-b4f7-3e9e-b8a0-980c7ebfb516> , <http://data.silknow.org/image/701c4ca7-4d8d-37b3-9b60-93a88ff7dc92> ;
        ecrm:P3_has_note               "Chair seat of canvas, embroidered with wool and silk in shades of   mustard, green, red, pink, blue, grey, beige, brown, mauve and   cream in cross and tent stitches.\nThe border has a mustard-coloured ground decorated with large,   brightly coloured flowers; carnation, lily, convolvulus and peony.\nThe central embroidered scene is of 'The Gardener and the Hog'. The initials 'E.W.' are embroidered on the balustrades in the middle distance of the scene."@en , "Embroidered chair seat, England, ca. 1730."@en ;
