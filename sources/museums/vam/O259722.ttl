<http://data.silknow.org/object/3ee570db-4865-3dae-a8a0-2cffc631ffb5>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Panel of woven silk, 'The Annunciation,' Italy, 15th century."@en , "Panel of woven silk showing a scene typical of many paintings of the time with Renaissance ornament. The faces of the Virgin and Angel are worn away. Most of the scene is carried out in gold thread, but the coffered ceiling of the room is in cream silk and a few details of the clothing in blue. The faces were originally woven in cream silk. Some details of the architecture in green have totally disappeared."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3597127d-ca30-355f-8912-a173fc91053d> ;
        ecrm:P3_has_note               "Panel of woven silk, 'The Annunciation,' Italy, 15th century."@en , "Panel of woven silk showing a scene typical of many paintings of the time with Renaissance ornament. The faces of the Virgin and Angel are worn away. Most of the scene is carried out in gold thread, but the coffered ceiling of the room is in cream silk and a few details of the clothing in blue. The faces were originally woven in cream silk. Some details of the architecture in green have totally disappeared."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/3ee570db-4865-3dae-a8a0-2cffc631ffb5/dimension/1> ;
        dc:identifier                  "T.196-1977" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O259722> .

