<http://data.silknow.org/object/a4a5cc48-feff-3478-b3d4-a59ce0878c03/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Beadwork tea cosy of glass beads on a linen ground, and lined with yellow quilted silk. With a design of large lilies and roses on a blue ground. Edged with yellow and black twisted silk braid cord and decorated with four tassels in yellow and black silk and glass beads."@en ;
