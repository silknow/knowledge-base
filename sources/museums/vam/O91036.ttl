        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "SILK\nPERSIAN; 16th century.\nMen eating and drinking, among flowers and leaves. Pattern in 1.3 twill on a satin ground. [Used until 11/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e65d5429-daf1-32f3-8cf9-761ab90db94d> .

<http://data.silknow.org/object/e65d5429-daf1-32f3-8cf9-761ab90db94d>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "A decorative silk fabric with motifs executed in blue, yellow and orange on a dark brown ground. The pattern consists of alternating rows of pairs of human figures eating and drinking in a landscape setting of floral and plant motifs. \nThe figurative compositions consist of pairs of male figures facing one another. One pair is constituted by a seated noble to the right, and, to the left, a standing attendant who offers a closed cup. In the second pair, both figures are seated and cross legged - this time the attendant is placed to the right and he offers a bowl of fruit to the noble at the left. The floral and plant motifs that surround the figures are highly decorative. All the motifs are executed in bright colours and thus stand out against the dark monochrome ground."@en , "Middle East, Textile; Panel for a coat, woven silk in a pattern of 1.3 twill on a satin ground, depicting men in Safavid court dress relaxing in a garden setting, Iran, 1500-1510"@en , "SILK\nPERSIAN; 16th century.\nMen eating and drinking, among flowers and leaves. Pattern in 1.3 twill on a satin ground. [Used until 11/2003]"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/75176ff6-9c84-3efc-844a-8c1a7ce051dd> , <http://data.silknow.org/image/61c74913-9133-3057-99fb-4593fe17f826> , <http://data.silknow.org/image/cc01a14e-2dea-3e23-bceb-0766c64fe050> , <http://data.silknow.org/image/9bb46b97-13f4-3e35-86b0-6a95f2e2bb10> , <http://data.silknow.org/image/46bf43ce-7365-3e5b-bb06-281c4b92339f> ;
        ecrm:P3_has_note               "A decorative silk fabric with motifs executed in blue, yellow and orange on a dark brown ground. The pattern consists of alternating rows of pairs of human figures eating and drinking in a landscape setting of floral and plant motifs. \nThe figurative compositions consist of pairs of male figures facing one another. One pair is constituted by a seated noble to the right, and, to the left, a standing attendant who offers a closed cup. In the second pair, both figures are seated and cross legged - this time the attendant is placed to the right and he offers a bowl of fruit to the noble at the left. The floral and plant motifs that surround the figures are highly decorative. All the motifs are executed in bright colours and thus stand out against the dark monochrome ground."@en , "SILK\nPERSIAN; 16th century.\nMen eating and drinking, among flowers and leaves. Pattern in 1.3 twill on a satin ground. [Used until 11/2003]"@en , "Middle East, Textile; Panel for a coat, woven silk in a pattern of 1.3 twill on a satin ground, depicting men in Safavid court dress relaxing in a garden setting, Iran, 1500-1510"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/e65d5429-daf1-32f3-8cf9-761ab90db94d/dimension/2> , <http://data.silknow.org/object/e65d5429-daf1-32f3-8cf9-761ab90db94d/dimension/1> ;
        dc:identifier                  "69(IS)-1886" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O91036> .

