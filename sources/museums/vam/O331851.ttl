<http://data.silknow.org/object/85263bf0-b312-39a9-9ed6-c03de1cb7a6b>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk cuff covered with silk gauze, England, ca. 1770-1780"@en , "Cuff made from green silk covered with cream-coloured striped silk gauze which is gauged and gathered into it. The cuff is shaped to the bend of the elbow which may have once been attached to the sleeve of a dress. The edges form a frill and to them is attached a narrow cream silk ribbon. The cuff is lined with linen."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b7a59398-7035-356b-82fb-81ecf55dc335> ;
        ecrm:P3_has_note               "Silk cuff covered with silk gauze, England, ca. 1770-1780"@en , "Cuff made from green silk covered with cream-coloured striped silk gauze which is gauged and gathered into it. The cuff is shaped to the bend of the elbow which may have once been attached to the sleeve of a dress. The edges form a frill and to them is attached a narrow cream silk ribbon. The cuff is lined with linen."@en ;
        dc:identifier                  "T.73-1968" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O331851> .

