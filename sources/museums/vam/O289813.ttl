<http://data.silknow.org/object/95b49351-fd13-32d3-a27f-c4b93c5a8939/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Straight-edged border of bobbin lace with a net ground worked with white silk and the pattern in green, pink, purple and yellow silk. Twist-net ground worked on a smaller scale within the 0.75 inch (1.5 cms) border along the lower edge. This border and the motifs are outlined with coloured silk cordonnets. The main part of the ground is decorated with simple sprigs arranged in two rows. Diagonal leaf-like motifs fill the border."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/95b49351-fd13-32d3-a27f-c4b93c5a8939> .

