        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Waistcoat of ivory satin woven with gold thread. With a woven pattern down the fronts on the neck and pocket band. The buttons are twisted silk on a core. The back is of white twilled cotton with boned tags with gilt metal eyelets holes for a lace adjustment. The fronts are faced back with satin and lined with the same material as the back."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ce2ca41f-7710-3bc1-9bce-e1977a5ce604> .

