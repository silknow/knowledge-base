        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Border of bobbin lace. With a design of a simple repeating floral device filled with ornamental 'à jours', and edged with an undulating openwork border outlined with a silk cordonnet. This design is known as the 'Dog-rose' pattern."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0a90bbf0-2bf5-34c8-90c9-45912c19052a> .

