<http://data.silknow.org/object/7b68aeed-7cf2-347b-be49-3a66511c86db/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Heart-shaped silver locket stamped with a figure of Cupid drawing his bow and with the motto 'noe heart more trve then mine to yov' stamped around the edge. The back is plain except for the maker's mark 'RA'. There is a silver loop at the top of the locket, through which a pale green silk ribbon is threaded (which may not be contemporary)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7b68aeed-7cf2-347b-be49-3a66511c86db> .

