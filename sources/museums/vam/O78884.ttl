<http://data.silknow.org/object/92d9c7a1-e7f4-34bc-9dff-59b2514f7ac9/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nGuests were generally expected to take their own knives to dinners or feasts. Cutlery was also a traditional gift at many special occasions. The custom of giving brides a pair of decorated knives had started in the Middle Ages and continued into the 18th century. Wedding knives often came in pretty embroidered cases and the bride would hang them from her waist. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/92d9c7a1-e7f4-34bc-9dff-59b2514f7ac9> .

