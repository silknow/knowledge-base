        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O163643" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/c7317173-eecf-37be-a970-702e4687969c> , <http://data.silknow.org/image/88ad70af-bdb1-306b-ba20-37f7100bf1ea> , <http://data.silknow.org/image/53af3f91-a04b-39c1-9f3b-57f501380148> , <http://data.silknow.org/image/1a66aec7-43b3-3ec9-8d77-f3957e41e153> , <http://data.silknow.org/object/2e05405d-8c2a-37e3-98d7-f65e464f0764/observation/1> , <http://data.silknow.org/image/577b176a-cab1-3b8a-9558-0e0e954da90c> , <http://data.silknow.org/object/2e05405d-8c2a-37e3-98d7-f65e464f0764/observation/2> , <http://data.silknow.org/production/1ab85c4e-2e7f-3ec7-8c0e-794277cd4afb> , <http://data.silknow.org/object/2e05405d-8c2a-37e3-98d7-f65e464f0764/domain/1> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/event/d2492768-5729-3fc4-b776-39c51ca30995> , <http://data.silknow.org/object/2e05405d-8c2a-37e3-98d7-f65e464f0764> ;
