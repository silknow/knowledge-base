        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This tapestry is woven with the arms of the Contarini, one of the most distinguished ruling families in Venice for several hundred years. It exemplifies the taste of Venetians for surrounding themselves in their city homes with garden and pastoral scenes. The museum has five tapestries in the set. This one shows boating on a river, with a palace behind."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cbc589dc-45c9-36bf-9d2b-93017fa8512f> .

