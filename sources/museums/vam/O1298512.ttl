        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O1298512" ;
        ecrm:P129_is_about  <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/domain/1> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/observation/1> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/observation/3> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/domain/3> , <http://data.silknow.org/image/4ef2f1bc-1138-3ea0-818a-b01952f71760> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/domain/2> , <http://data.silknow.org/event/2b9ae04a-4a3c-357a-8055-42c58deb3ac0> , <http://data.silknow.org/object/f1976051-2c8a-35e5-a51e-5f76872d10ac/observation/2> , <http://data.silknow.org/production/ed68588e-b741-3663-a4e4-d71719808b9f> ;
