<http://data.silknow.org/object/03bd5d3d-8034-3e13-9b79-0c04d3c2b653>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Set of coat panels consisting of four embroidered silks and two printed cotton linings, Russia, 19th century"@en , "Set of coat panels consisting of four embroidered silks and two printed cotton linings.\n\nFour panels of embroidered yellow silk with red, green, blue and white silks in ladder stitch. The pattern mainly consists of geometric forms resembling stylised flowers.\n\nTwo linings made of resist-dyed blue and printed cotton. With a cone shape design in red, yellow and green."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/032592e9-f2d1-35af-8eb3-8f9e1d58ac84> , <http://data.silknow.org/image/76e19c29-6b26-34b6-87af-8ef0a542efbd> ;
        ecrm:P3_has_note               "Set of coat panels consisting of four embroidered silks and two printed cotton linings, Russia, 19th century"@en , "Set of coat panels consisting of four embroidered silks and two printed cotton linings.\n\nFour panels of embroidered yellow silk with red, green, blue and white silks in ladder stitch. The pattern mainly consists of geometric forms resembling stylised flowers.\n\nTwo linings made of resist-dyed blue and printed cotton. With a cone shape design in red, yellow and green."@en ;
        dc:identifier                  "T.164 to E-1961" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O317993> .

