        ecrm:P138i_has_representation  <http://data.silknow.org/image/87ebcabe-8c57-3db7-955a-423d5931cd87> , <http://data.silknow.org/image/1d413601-ffe2-3821-8dd7-93e1621a6ac6> , <http://data.silknow.org/image/f8bd70f7-73bd-3227-aa53-bff77da264a0> , <http://data.silknow.org/image/df91ce8a-c8c1-3559-a749-716b59c259e7> , <http://data.silknow.org/image/9073512b-18a6-34b4-b581-a03be2dbd03a> ;
