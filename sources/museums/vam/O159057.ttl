<http://data.silknow.org/object/acbd69fd-38c2-3847-8ac6-566ba7bc7b7b/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A pair of kidskin gloves with applied white silk tabbed gauntlet, embroidered with coloured silks and silver-gilt thread, purl and spangles in a floral pattern.  The gauntlet is lined with pale pink silk and edged with silver-gilt bobbin lace and spangles."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/acbd69fd-38c2-3847-8ac6-566ba7bc7b7b> .

