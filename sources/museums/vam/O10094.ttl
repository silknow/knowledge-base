<http://data.silknow.org/object/51bbf045-0143-38c1-a34f-afb96fbe8c98/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Band sampler embroidered on linen with silk and linen thread in satin stitch. Three different sized bands of geometrical whitework, and three bands of cutwork, and two of them incorporating S-shapes. 'ME' [for Martha Edlin] and the date '1669' are embroidered at the bottom edge."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/51bbf045-0143-38c1-a34f-afb96fbe8c98> .

