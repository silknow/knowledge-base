<http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Brown wall hanging of cotton embroidered with silk. Decorated with a large floral pink chrysanthemums and green foliage, depicting flying birds, butterflies and small insects. The lower portion of the hanging illustrates a scene of deer and rabbits with hunters and herders. A scrolling pink and green floral border is enclosed by a green chain stitch. Possibly also for a bed."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29> .

<http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Wall hanging of cotton embroidered with silk, Gujarat, late 17th century"@en , "This wall hanging is probably one of the earliest surviving pieces of the set from Ashburnham house characterised by using deep colours of dark blues, pinks and reds. The fine chain stitch often depicts patterns of natural vegetation entwined with animals, birds and insects which are influenced by european designs."@en , "Brown wall hanging of cotton embroidered with silk. Decorated with a large floral pink chrysanthemums and green foliage, depicting flying birds, butterflies and small insects. The lower portion of the hanging illustrates a scene of deer and rabbits with hunters and herders. A scrolling pink and green floral border is enclosed by a green chain stitch. Possibly also for a bed."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/1b31dbfc-cff7-39dd-a195-45b891cc5610> , <http://data.silknow.org/image/06a3a06e-6faa-3e16-ba6c-2506bec701c4> , <http://data.silknow.org/image/48754c37-8891-349f-8c56-cc5925b95425> , <http://data.silknow.org/image/c2bb9cd1-cf82-3482-b6f6-fd57b441b0bc> , <http://data.silknow.org/image/1ba0393a-bec9-3f19-84b0-8b0fce30b807> , <http://data.silknow.org/image/840a1a3b-950b-36de-9469-f8a1ab3b63c3> , <http://data.silknow.org/image/33a4b4d6-2713-3c3b-8f84-238d8c4f2620> , <http://data.silknow.org/image/c0680674-f71d-35c7-af23-f1ca30ccc467> , <http://data.silknow.org/image/7d6a0a86-24b1-3261-8646-be6c0ad45b5c> ;
        ecrm:P3_has_note               "Wall hanging of cotton embroidered with silk, Gujarat, late 17th century"@en , "This wall hanging is probably one of the earliest surviving pieces of the set from Ashburnham house characterised by using deep colours of dark blues, pinks and reds. The fine chain stitch often depicts patterns of natural vegetation entwined with animals, birds and insects which are influenced by european designs."@en , "Brown wall hanging of cotton embroidered with silk. Decorated with a large floral pink chrysanthemums and green foliage, depicting flying birds, butterflies and small insects. The lower portion of the hanging illustrates a scene of deer and rabbits with hunters and herders. A scrolling pink and green floral border is enclosed by a green chain stitch. Possibly also for a bed."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29/dimension/1> , <http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29/dimension/3> , <http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29/dimension/2> , <http://data.silknow.org/object/84d749f7-9ab9-3aeb-9b94-c773a1772b29/dimension/4> ;
