        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Ribbon of white silk with metal thread and silk gauze. One of the bands is edged with white silk heart-shaped decoration, and the two other narrow ones are edged with white silk and 'beading'. The metal thread is bound in twill and the white silk is unbound."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6fa35342-5816-3586-bb57-8cc811f2abfc> .

