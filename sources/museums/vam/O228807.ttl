<http://data.silknow.org/object/09e87faf-9c0d-3a5a-8ae8-eccdf6d0f016>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Description: Plain weave silk brocaded with silk and metal thread.\nWeft-faced blue silk ground woven with offset rows of confronting birds [parrots] above a floral cluster in which one stem curves to create an almost circular motif of flowers and buds. These motifs alternate in light or dark colours and are separated by a small, fish-like motif. There is a narrow band at the top, turned under and stitched in place, marking the end of a loom piece. The lower edge has also been turned and stitched.\nMetal thread: silver-gilt strip open S-wound on a yellow silk core."@en , "Brocaded silk panel"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/21295192-62d1-3612-95c2-94b5f44fd48b> , <http://data.silknow.org/image/456c5daf-8db7-3650-a24e-8569d51e666b> , <http://data.silknow.org/image/ce432944-2963-3083-91c8-95f7df618301> ;
        ecrm:P3_has_note               "Brocaded silk panel"@en , "Description: Plain weave silk brocaded with silk and metal thread.\nWeft-faced blue silk ground woven with offset rows of confronting birds [parrots] above a floral cluster in which one stem curves to create an almost circular motif of flowers and buds. These motifs alternate in light or dark colours and are separated by a small, fish-like motif. There is a narrow band at the top, turned under and stitched in place, marking the end of a loom piece. The lower edge has also been turned and stitched.\nMetal thread: silver-gilt strip open S-wound on a yellow silk core."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/09e87faf-9c0d-3a5a-8ae8-eccdf6d0f016/dimension/1> , <http://data.silknow.org/object/09e87faf-9c0d-3a5a-8ae8-eccdf6d0f016/dimension/2> ;
