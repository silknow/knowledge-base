<http://data.silknow.org/object/0ddfd033-19d0-30af-98f9-d0962443d280>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Nevinson, J., Catalogue of Domestic English Embroidery of the Sixteenth & Seventeenth Centuries (London,1950)."@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/b9f7d5a8-ddc7-3b25-9e1f-6fb3bf177d5c> ;
