<http://data.silknow.org/object/6dc1c346-3fda-3937-bf1d-2cb597065bc6>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Sampler of linen, hand stitched by Jane Whittaker, English, 1877-1879"@en , "Hem and patch sampler, unfinished, of fine linen. The sides, turned and tacked, partially hemmed with blue silk in hem and herringbone stitches and a little back stitch. In the deep upper hem, two worked buttonholes. In the main panel, one set-in patch with partially worked sew and fell seams, one patch of fancy darning and a letter in cross stitch."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f2968527-1156-3cc6-9d3e-3d48de0afd39> , <http://data.silknow.org/image/57c6aa25-ee13-3cca-8cac-1b3472138029> , <http://data.silknow.org/image/b472def1-90da-3a56-81db-7ca31da64869> ;
        ecrm:P3_has_note               "Sampler of linen, hand stitched by Jane Whittaker, English, 1877-1879"@en , "Hem and patch sampler, unfinished, of fine linen. The sides, turned and tacked, partially hemmed with blue silk in hem and herringbone stitches and a little back stitch. In the deep upper hem, two worked buttonholes. In the main panel, one set-in patch with partially worked sew and fell seams, one patch of fancy darning and a letter in cross stitch."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6dc1c346-3fda-3937-bf1d-2cb597065bc6/dimension/2> , <http://data.silknow.org/object/6dc1c346-3fda-3937-bf1d-2cb597065bc6/dimension/1> ;
