<http://data.silknow.org/object/79f37c14-dfdd-3660-b7aa-da65e7eaef85/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Folding umbrella with a hand-stitched green silk cover and telescopic metal handle with a hooked wooden end. The ribs are of black metal and with a circular section hinge outwards to allow the cover to fold when the handle is retracted. There is a metal wire catch to keep the umbrella in tension when it is unfolded and inside the pocket is a stencilled chintz label. A tape loop and button are stitched inside the cover near the metal tips."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/79f37c14-dfdd-3660-b7aa-da65e7eaef85> .

