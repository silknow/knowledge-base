<http://data.silknow.org/object/76e17d6c-48b3-3dc2-84fb-02e02f549c82>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dress and collar of striped silk with a high waist and long tight sleeves. The sleeves have satin decoration in openwork and piping on the shoulders and cuffs. The skirt is long with double flounced of gauze round the bottom. The collar is small and rounded with pointed ends and with a frilled trimming. Scalloped edge."@en , "Dress and collar of striped silk, satin and gauze, England, ca. 1815-1820"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2f0fd24a-4a26-3c6b-ba73-05e100155985> , <http://data.silknow.org/image/bd95e933-9e6d-3e4d-a7a8-8268df32c5ca> , <http://data.silknow.org/image/a7ace7a1-47a7-30cf-907f-86c0a6ea5919> , <http://data.silknow.org/image/e955b328-3afb-309b-a28c-3bffa9b5a373> ;
        ecrm:P3_has_note               "Dress and collar of striped silk, satin and gauze, England, ca. 1815-1820"@en , "Dress and collar of striped silk with a high waist and long tight sleeves. The sleeves have satin decoration in openwork and piping on the shoulders and cuffs. The skirt is long with double flounced of gauze round the bottom. The collar is small and rounded with pointed ends and with a frilled trimming. Scalloped edge."@en ;
        dc:identifier                  "T.182&A-1931" ;
