<http://data.silknow.org/object/3558034d-784f-345f-8f62-32f1811d6dcf>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Super-frontal\nColoured silk and gold thread, probably on linen.  Attached to a frontal or panel of blue linen\nWorked in long and short stitch, stem stitch, split stitch, French knots, laid work with Bayeux stitch and couched goldwork.\n\nThe Superfrontal has an indented lower edge with a border containing leaves and flowers. The main ground of the frontal is solidly worked with russet coloured silk and patterned with five large gold crosses, set on pearl-grey panels and surrounded by trailing vines and grapes.\nThe frontal is backed with blue cotton and attached to a panel of cotton."@en , "International Arts & Crafts\nSuperfrontal\n1898-9\nBritain; designed by Philip Webb\nEmbroidered linen\nV&A:T.379-1970 [17/03/2005]"@en , "Superfrontal, designed by Phillip Webb, embroidered by May Morris, England, 1898-1899."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6202cbc8-f681-3fb2-a5b0-44b0da3dc4c3> , <http://data.silknow.org/image/2512aa77-1793-3d8d-bb26-ad773ef6e1a9> , <http://data.silknow.org/image/96286df7-9d9b-3256-9a8d-c8ec2a29d7e8> ;
        ecrm:P3_has_note               "Super-frontal\nColoured silk and gold thread, probably on linen.  Attached to a frontal or panel of blue linen\nWorked in long and short stitch, stem stitch, split stitch, French knots, laid work with Bayeux stitch and couched goldwork.\n\nThe Superfrontal has an indented lower edge with a border containing leaves and flowers. The main ground of the frontal is solidly worked with russet coloured silk and patterned with five large gold crosses, set on pearl-grey panels and surrounded by trailing vines and grapes.\nThe frontal is backed with blue cotton and attached to a panel of cotton."@en , "Superfrontal, designed by Phillip Webb, embroidered by May Morris, England, 1898-1899."@en , "International Arts & Crafts\nSuperfrontal\n1898-9\nBritain; designed by Philip Webb\nEmbroidered linen\nV&A:T.379-1970 [17/03/2005]"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/3558034d-784f-345f-8f62-32f1811d6dcf/dimension/1> , <http://data.silknow.org/object/3558034d-784f-345f-8f62-32f1811d6dcf/dimension/3> , <http://data.silknow.org/object/3558034d-784f-345f-8f62-32f1811d6dcf/dimension/2> ;
        dc:identifier                  "T.379-1970" ;
