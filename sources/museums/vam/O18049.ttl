<http://data.silknow.org/object/c83efb2b-a2e2-3410-b4f6-749dce37ef9c/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "BED-COVER FOR PORTUGAL \n\nThis bed-cover was made in India for export to Portugal. The Portuguese were the first Europeans to settle in India, and embroideries like this were made near their base at Hugli in Bengal. It shows European ships and people, and in the centre is the coat-of-arms of a Portuguese noble family. The embroidery stitches draw on the local kantha tradition.\n\nCotton, quilted and embroidered with silk\nSatgaon, West Bengal, 1600-25\nV&A: 438-1882 [03/10/2015-10/01/2016]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/c83efb2b-a2e2-3410-b4f6-749dce37ef9c> .

