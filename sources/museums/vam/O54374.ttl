        rdfs:comment        "Illustrated in 'Ottoman Embroidery' by Marianne Ellis and Jennifer Wearden (V&A Publication, 2001), plate 40"@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/e29c9abf-1718-3c6d-aa8f-ddb0cdfd6aab> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Illustrated in 'Ottoman Embroidery' by Marianne Ellis and Jennifer Wearden (V&A Publication, 2001), plate 40"@en .

