        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Tie of blue silk satin and lined with black silk. Made up into a wide Windsor knot with two peaked dependent ends, and kept in place by a narrow band which passes from the knot around the neck, and tucks into the knot again where it is kept in place by a steel spring clip and an elastic band stitched to the lining of the innermost end."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6f85852b-1cbb-3bb2-822e-b7eabdcb9b2c> .

