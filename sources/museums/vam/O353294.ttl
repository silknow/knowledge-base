<http://data.silknow.org/object/29f433ad-ea1d-358a-99cf-1ec1d341dbc9>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Cope of silk with gold and silver threads on white damask. With rows of large floral devices springing from curved bands in gold and silver and coloured silks on white with a foliage pattern. Morse in the same material, and broad orphrey with a close repeating design of floral stems in gold and white. Trimmed with gold braid and lace. Lined with red linen."@en , "Cope of silk with gold and silver threads on damask, Italy, 1695-1705"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ba20cd01-8763-38f6-953a-5716372515bf> , <http://data.silknow.org/image/42405882-e3a2-33f7-b6f1-919e6e9e89d3> ;
        ecrm:P3_has_note               "Cope of silk with gold and silver threads on damask, Italy, 1695-1705"@en , "Cope of silk with gold and silver threads on white damask. With rows of large floral devices springing from curved bands in gold and silver and coloured silks on white with a foliage pattern. Morse in the same material, and broad orphrey with a close repeating design of floral stems in gold and white. Trimmed with gold braid and lace. Lined with red linen."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/29f433ad-ea1d-358a-99cf-1ec1d341dbc9/dimension/3> , <http://data.silknow.org/object/29f433ad-ea1d-358a-99cf-1ec1d341dbc9/dimension/2> , <http://data.silknow.org/object/29f433ad-ea1d-358a-99cf-1ec1d341dbc9/dimension/1> ;
