<http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Tapestry woven in silk and wool on a woollen warp, about 20 threads to an inch. Depicting sheep dipping and sheering in June. In the foreground are two men dipping two struggling sheep in a pond fringed with reeds. On the left under a thatched roof, a man is bringing a sheep to be sheared. There is a large tree on the right and in the foreground is a small port with ships drawn up at the quay side. The border contains a curling wine leaf in brown and green-yellow on a slate coloured ground. In the top border is woven a sign of the zodiac 'Scorpio'."@en , "Tapestry woven in silk and wool on a woollen warp, Mortlake Tapestry Factory, England, 1660-1669"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/883b72aa-2f4d-310b-b6aa-9c8298993692> , <http://data.silknow.org/image/0303e6d8-a3c3-396a-aedc-7c9bf8628020> , <http://data.silknow.org/image/6913ccb4-b7e0-306d-a9ba-c77934f4f669> , <http://data.silknow.org/image/d5e0e0fa-3269-39ba-8d13-1efa47f4a801> , <http://data.silknow.org/image/0629fd8c-939b-3ef3-892e-719d1eea9f28> ;
        ecrm:P3_has_note               "Tapestry woven in silk and wool on a woollen warp, about 20 threads to an inch. Depicting sheep dipping and sheering in June. In the foreground are two men dipping two struggling sheep in a pond fringed with reeds. On the left under a thatched roof, a man is bringing a sheep to be sheared. There is a large tree on the right and in the foreground is a small port with ships drawn up at the quay side. The border contains a curling wine leaf in brown and green-yellow on a slate coloured ground. In the top border is woven a sign of the zodiac 'Scorpio'."@en , "Tapestry woven in silk and wool on a woollen warp, Mortlake Tapestry Factory, England, 1660-1669"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0/dimension/4> , <http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0/dimension/5> , <http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0/dimension/1> , <http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0/dimension/3> , <http://data.silknow.org/object/15a8213e-a48d-3cf2-bcda-e98d6a82d2f0/dimension/2> ;
