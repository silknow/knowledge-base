<http://data.silknow.org/object/2722978b-d2cc-396c-a230-f68e2881d7e8/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress fabric of a blue satin ground with the pattern woven in white and further details brocaded in yellow and pink. The pattern consists of stylised leaf and flower shapes with a meandering vertical movement. There is a selvedge with four green stripes on the left hand edge."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/2722978b-d2cc-396c-a230-f68e2881d7e8> .

