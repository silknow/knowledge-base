<http://data.silknow.org/object/bf1d67e5-eb93-38cd-bdf4-a317912deea4>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered silk net cap trimmed with silk bobbin lace and silk ribbons, Great Britain, ca. 1770"@en , "Embroidered silk net cap trimmed with silk bobbin lace and cherry silk ribbons. Cherry silk bow in front. Mounted on a cream silk lining. The crown is high and slightly gathered, shaped to a slight peak over the forehead where it is trimmed with a ribbon and blond rosette and curving to cover the ears. The trimming extends round the edges and finishes with lappets of blond extended by the cherry ribbon ties."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e29a7c5d-0eee-3a8a-ad29-586ef6e2d137> , <http://data.silknow.org/image/e8f2f79a-0fbe-3a1c-a3a0-235dff18d67c> ;
        ecrm:P3_has_note               "Embroidered silk net cap trimmed with silk bobbin lace and silk ribbons, Great Britain, ca. 1770"@en , "Embroidered silk net cap trimmed with silk bobbin lace and cherry silk ribbons. Cherry silk bow in front. Mounted on a cream silk lining. The crown is high and slightly gathered, shaped to a slight peak over the forehead where it is trimmed with a ribbon and blond rosette and curving to cover the ears. The trimming extends round the edges and finishes with lappets of blond extended by the cherry ribbon ties."@en ;
