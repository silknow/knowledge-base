<http://data.silknow.org/object/410084a5-78a4-377a-91d9-498f9ac3301c/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This delicate length of gold-cloth has been embellished with shards of jewel beetle-wings, crimped silver-gilt wire, metal-wrapped thread and sequins. Gold-cloth is woven of flattened silver-gilt wire and silk and is very fragile. This length was probably made to be used as trimming for a garment."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/410084a5-78a4-377a-91d9-498f9ac3301c> .

