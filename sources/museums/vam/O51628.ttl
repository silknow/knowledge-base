<http://data.silknow.org/production/c0acf4d0-127f-3098-ab37-029555bb72fb>
        a                       ecrm:E12_Production ;
        rdfs:comment            "It is impossible to identify the precise maker of this marionette since the company made, altered and used figures throughout its career.  It is possible, however, to distinguish distinct types, and therefore groups, made by different makers, due to the type of carving.  The carver of this object has been distinguished possibly as Maker D because the treatment of the nostrils and beard is simliar to that of the Cures (S.279-1999; S.280-1999)." ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/ab7616cc-4338-3d7f-bd5e-7bae86a9250d> ;
        ecrm:P126_employed      "Wood"@en , "Carved wood with painted decoration, with silk, cotton, cotton braid and steel sequin costume"@en ;
        ecrm:P126_employed      <http://data.silknow.org/vocabulary/900> , <http://data.silknow.org/vocabulary/617> ;
        ecrm:P32_used_general_technique
                "Carved"@en , "Sewn"@en ;
        ecrm:P32_used_general_technique
                <http://data.silknow.org/vocabulary/379> ;
        ecrm:P3_has_note        "It is impossible to identify the precise maker of this marionette since the company made, altered and used figures throughout its career.  It is possible, however, to distinguish distinct types, and therefore groups, made by different makers, due to the type of carving.  The carver of this object has been distinguished possibly as Maker D because the treatment of the nostrils and beard is simliar to that of the Cures (S.279-1999; S.280-1999)." ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1870_1899> ;
        ecrm:P8_took_place_on_or_within
                <https://sws.geonames.org/11609040/> ;
