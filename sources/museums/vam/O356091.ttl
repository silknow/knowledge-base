<http://data.silknow.org/object/0f90c6b1-ab05-3e9d-b49e-285c573cbdee/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Stole pieced together from a silk having a wide chiné stripe in the centre in white and pink, flanked by narrow stripes in pale blues, wider stripes in plain yellow and a fancy stripe of spaced salmon-pink stripes on creamy-white silk.\n\nThe ends are trimmed with a narrow gold lace. At each end and in the centre is a cross of gold braid woven from gold thread, gilt metal strip in two widths and cream silk. \n\nThe stole is stiffened with white linen and lined with pink silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0f90c6b1-ab05-3e9d-b49e-285c573cbdee> .

<http://data.silknow.org/object/0f90c6b1-ab05-3e9d-b49e-285c573cbdee>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Stole of chiné silk, France, 18th century"@en , "Stole pieced together from a silk having a wide chiné stripe in the centre in white and pink, flanked by narrow stripes in pale blues, wider stripes in plain yellow and a fancy stripe of spaced salmon-pink stripes on creamy-white silk.\n\nThe ends are trimmed with a narrow gold lace. At each end and in the centre is a cross of gold braid woven from gold thread, gilt metal strip in two widths and cream silk. \n\nThe stole is stiffened with white linen and lined with pink silk."@en ;
