<http://data.silknow.org/object/7123c145-1a1c-300b-a7e3-81787375552c/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This silk was painted in China for export to Europe. These floral textiles were popular in the West from the end of the 18th century until about 1900. They were made up into women's dresses and also used for furnishings. This type of fabric was not used in China itself."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7123c145-1a1c-300b-a7e3-81787375552c> .

