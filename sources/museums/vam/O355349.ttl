<http://data.silknow.org/object/1469414e-cb4e-3b07-ade4-24542a23a5ca>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Christening basket of wicker lined with quilted satin, England, 1775."@en , "Christening basket consisting of a shallow wicker basket standing on a small rectangular base. The interior is padded and lined with cream satin which is quilted with cream thread in running stitches of diamonds overlapping circles and shell-shapes. The sloping sides are decorated at each corner with double lines of fringed braid decorated with fly braid. The sides of the basket are hidden by hanging 'skirts' of cream satin pleated to fit round the corners. The scalloped lower edges are trimmed with fringed silk braid and fly braid. A narrow fringed braid is used along the upper edge."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e64a4e45-74d1-30b8-9302-bd2f332aa656> ;
        ecrm:P3_has_note               "Christening basket of wicker lined with quilted satin, England, 1775."@en , "Christening basket consisting of a shallow wicker basket standing on a small rectangular base. The interior is padded and lined with cream satin which is quilted with cream thread in running stitches of diamonds overlapping circles and shell-shapes. The sloping sides are decorated at each corner with double lines of fringed braid decorated with fly braid. The sides of the basket are hidden by hanging 'skirts' of cream satin pleated to fit round the corners. The scalloped lower edges are trimmed with fringed silk braid and fly braid. A narrow fringed braid is used along the upper edge."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/1469414e-cb4e-3b07-ade4-24542a23a5ca/dimension/2> , <http://data.silknow.org/object/1469414e-cb4e-3b07-ade4-24542a23a5ca/dimension/1> , <http://data.silknow.org/object/1469414e-cb4e-3b07-ade4-24542a23a5ca/dimension/3> ;
