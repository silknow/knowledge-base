        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Hand loom woven cotton bedding known as 'khes' are labour intensive and expensive to produce.  Khes like this large piece made up of smaller fragments were commonly used as spreads in Baluchistan.  An original paper label on this piece reads in English 'Presented by the Governer of Turbat 21st April 1872'."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/63e6186f-c30e-3dc1-a85a-93a58988102c> .

