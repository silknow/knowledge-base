<http://data.silknow.org/object/7fadd708-f573-3a77-add1-4ac6317d7bd1>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Man's court waistcoat,1780s, English; court , cream silk taffeta embroidered with coloured silks, net appliqué"@en , "Man’s court waistcoat of ivory silk taffeta, backed and lined with linen; the fronts and skirts faced with ivory silk twill. It has a 2½-inch (6.3 cm) standing collar, pockets with shaped flaps and short skirts reaching to the top of the thigh. It is applied with net and embroidered with coloured silks, in a floral pattern. There are 13 embroidered buttons on the right front and 13 corresponding worked buttonholes on the left front."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/10562cdf-bdb3-33d5-b08d-ac191b8c846b> , <http://data.silknow.org/image/490cb2a7-3232-35ec-987d-3ec2b02643f9> , <http://data.silknow.org/image/10316fd5-9ab6-3fc1-a5ca-e83cf998ac2d> , <http://data.silknow.org/image/4f3ae413-9c41-3b40-9916-995848f3dbd0> ;
        ecrm:P3_has_note               "Man's court waistcoat,1780s, English; court , cream silk taffeta embroidered with coloured silks, net appliqué"@en , "Man’s court waistcoat of ivory silk taffeta, backed and lined with linen; the fronts and skirts faced with ivory silk twill. It has a 2½-inch (6.3 cm) standing collar, pockets with shaped flaps and short skirts reaching to the top of the thigh. It is applied with net and embroidered with coloured silks, in a floral pattern. There are 13 embroidered buttons on the right front and 13 corresponding worked buttonholes on the left front."@en ;
