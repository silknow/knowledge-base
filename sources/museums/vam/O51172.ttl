        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O51172" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/7b3ad2be-b9f6-3d9a-b83a-4fb2e831774e> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd/observation/3> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/19c8fc8b-f45e-3fc7-b9a6-d2fb30b3d7e4> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd/domain/2> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd/domain/1> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd/observation/2> , <http://data.silknow.org/image/2244f5e3-a134-3322-bebd-0c0bb45ff8bf> , <http://data.silknow.org/object/7206f0ef-a07a-3003-beb5-3f0d138f28bd/observation/1> , <http://data.silknow.org/production/599e0a3d-d7f0-3917-9ed7-5067ae5acb32> ;
