        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A woman's straight, heeled shoe of white leather, with pointed toe.  The upper is pointed toward the ankle.  The seams between upper and the quarters are covered with white silk grosgrain ribbon.  The sole is made of brown leather; the heel of wood covered with white leather.  The shoe is lined with linen."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e5a6cc0d-077b-319c-9acc-6478806b5258> .

