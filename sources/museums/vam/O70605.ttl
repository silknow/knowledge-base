<http://data.silknow.org/object/fae02d03-500a-3201-84bc-13872eac5bea>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Linen sampler by Anastasia Anrrigues, embroidered with silk; Mexican; dated 1826."@en , "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects.  In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. Making a sampler was part of a girl's school education throughout the 18th century and into the early 1800s. Spanish samplers traditionally included the areas of geometric pattern you can see on this Mexican sampler of 1826."@en , "Embroidered sampler"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/bd63a750-62a4-3eca-a90e-5528ae6ac0be> , <http://data.silknow.org/image/bb1ab870-e826-3a63-b91d-2e290f940409> , <http://data.silknow.org/image/036c7584-41a3-3a7f-a47f-e2d56627fc3f> ;
        ecrm:P3_has_note               "Embroidered sampler"@en , "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects.  In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. Making a sampler was part of a girl's school education throughout the 18th century and into the early 1800s. Spanish samplers traditionally included the areas of geometric pattern you can see on this Mexican sampler of 1826."@en , "Linen sampler by Anastasia Anrrigues, embroidered with silk; Mexican; dated 1826."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/fae02d03-500a-3201-84bc-13872eac5bea/dimension/1> , <http://data.silknow.org/object/fae02d03-500a-3201-84bc-13872eac5bea/dimension/2> ;
        dc:identifier                  "CIRC.551-1923" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O70605> .

