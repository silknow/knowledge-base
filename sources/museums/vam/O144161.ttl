<http://data.silknow.org/object/3c9d62b3-077e-3b6e-8aa7-f03a6ac9aabd/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Woven silk, satin ground\nWarp: black or very dark blue, red, green, white silk\nWeft: \nRepeating pattern of two main narrow stripes in black or very dark blue and white, both edged with red and green stripes.\n[1] black or very dark blue ground with red meander and small blue leaves and green and red flowers.\n[2] white ground with a red flower edged in blue alternating with a blue flower edged in red linked by a green stem.\n\nThere is one selvedge: it has one cotton thread.\nVery similar to 892-1877 and 893-1877"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/3c9d62b3-077e-3b6e-8aa7-f03a6ac9aabd> .

