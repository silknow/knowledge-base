<http://data.silknow.org/event/1eef83d8-f791-3fc5-99f1-a00a3cba1a6c>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "One of two silk playbills printed in different colours but issued for the same matinée at the Lyceum Theatre, a double bill of two plays by W.S. Gilbert <i>Pygmalion & Galatea</i> and <i>Comedy and Tragedy</i>, both directed by W.S. Gilbert.  <i>Pygmalion & Galatea</i> featured J.H. Barnes as Pygmalion, F.H. Macklin as Leucippe, H. Kemble as Chrysos, E.T. March as Agesimos, Arthur Lewis as Mimos, Amy Roselle as Cynisca, Arthur Stirling as Daphne, Annie Rose as Myrine and Mary Anderson as Galatea. <i>Comedy and Tragedy</i> included J.H. Barnes as the Duc D'Orléons, George Alexander as D'Aulnay, Arthur Lewis as De la Ferté and Mary Anderson as Clarice."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/5ea7b85d-88ed-383b-84ed-9ca4d222dc72> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Allan C. Squire" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/248dd6e2-898f-3e8a-be27-70661222e8d4> ;
        ecrm:P3_has_note               "One of two silk playbills printed in different colours but issued for the same matinée at the Lyceum Theatre, a double bill of two plays by W.S. Gilbert <i>Pygmalion & Galatea</i> and <i>Comedy and Tragedy</i>, both directed by W.S. Gilbert.  <i>Pygmalion & Galatea</i> featured J.H. Barnes as Pygmalion, F.H. Macklin as Leucippe, H. Kemble as Chrysos, E.T. March as Agesimos, Arthur Lewis as Mimos, Amy Roselle as Cynisca, Arthur Stirling as Daphne, Annie Rose as Myrine and Mary Anderson as Galatea. <i>Comedy and Tragedy</i> included J.H. Barnes as the Duc D'Orléons, George Alexander as D'Aulnay, Arthur Lewis as De la Ferté and Mary Anderson as Clarice."@en .

