<http://data.silknow.org/object/ed203bc4-924f-37ec-86b3-119e6cde31cd/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nDuring the 1850s Queen Victoria admired the decoration undertaken for the Emperor Napoleon III in his French palaces. The decorations ordered for Windsor at this time show how the British court tried to compete. A local department store, Caley Brothers of Windsor, was the supplier of the large ribbon and the fabrics with it. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ed203bc4-924f-37ec-86b3-119e6cde31cd> .

