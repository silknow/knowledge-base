<http://data.silknow.org/object/83d49abd-6866-3980-a699-caf494b6e639>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered sampler"@en , "Linen sampler by Mildred Mayow, embroidered with silk; English; dated 1633."@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler, and it is the earliest signed and dated example in the Museum's collection. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b92cd7a7-af5b-30eb-b90a-6cd24be729bf> , <http://data.silknow.org/image/b5ffb255-55f4-30ea-896e-b586e18c561b> , <http://data.silknow.org/image/646ba0f6-bcc5-336e-a50b-326676f65632> , <http://data.silknow.org/image/e8b41fd8-2e66-33dd-a1bb-478a2b4dd0ee> , <http://data.silknow.org/image/cb6e6d31-e489-3225-8119-e6dbf5989b42> , <http://data.silknow.org/image/24660b1a-16c9-3576-a3f3-37f0a99caeb4> , <http://data.silknow.org/image/4455304c-9656-3186-83b1-dfb800885315> ;
        ecrm:P3_has_note               "Linen sampler by Mildred Mayow, embroidered with silk; English; dated 1633."@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler, and it is the earliest signed and dated example in the Museum's collection. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en , "Embroidered sampler"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/83d49abd-6866-3980-a699-caf494b6e639/dimension/1> , <http://data.silknow.org/object/83d49abd-6866-3980-a699-caf494b6e639/dimension/2> ;
