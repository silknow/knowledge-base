<http://data.silknow.org/object/3960c174-01e9-3905-9e7f-726d0ea23f1e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Embroidery depicting the story of Esther and Ahasuerus in silk thread on white satin.  Eight scenes from the story and a fountain are embroidered using a wide range of materials and techniques, including twisted thread, silk floss, thread cut to form a velvet-like pile and raised work."@en ;
