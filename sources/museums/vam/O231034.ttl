<http://data.silknow.org/object/d552f97d-1160-3e19-a8f9-cb90a0645708>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O231034" ;
        ecrm:P129_is_about  <http://data.silknow.org/production/bbae1b30-4978-3754-a2cd-0287d364b0b3> , <http://data.silknow.org/image/dfddfd02-0ea3-30b3-aa2a-4db847ca633d> , <http://data.silknow.org/object/977927f5-e9b4-3731-9042-abfccb8c4f85/domain/1> , <http://data.silknow.org/object/805b1bea-1cb1-3f19-91c8-98a8f1487459> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/977927f5-e9b4-3731-9042-abfccb8c4f85/observation/2> , <http://data.silknow.org/event/888b42ab-d149-36ca-9724-4790e598e864> , <http://data.silknow.org/object/977927f5-e9b4-3731-9042-abfccb8c4f85/observation/1> , <http://data.silknow.org/object/977927f5-e9b4-3731-9042-abfccb8c4f85> , <http://data.silknow.org/image/4910866a-bf74-3931-a4ef-adf5e8d3456f> ;
