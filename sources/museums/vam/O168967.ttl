<http://data.silknow.org/object/6a5cb7e6-ab49-3991-ac8e-ba618c9e8240>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "embroidered & quilted, 1800s, Persian"@en , "Mat of plain-weave cotton embroidered with silk in chain or tambour, straight and running stitches with laid and couched silk thread and laid and couched metal thread. There is an interlining/backing of striped cotton through which some of the couching has been worked.\nRunning stitch has been used to create the effect of quilting on the surface fabric."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2cde839d-9db4-30dd-9f6f-0ff81a66ccda> , <http://data.silknow.org/image/5791627b-6b67-3d67-8dfc-3a43d52b2766> , <http://data.silknow.org/image/b3232800-c55c-3ff1-82e1-06fac1ee81f6> , <http://data.silknow.org/image/ed41099d-1c2b-3fc6-afd1-212144c8cb1c> , <http://data.silknow.org/image/b5a3ab1d-d4b8-34db-ad06-de7338c25402> , <http://data.silknow.org/image/fb109ec8-d4fe-387f-b8c7-0f3809833a92> , <http://data.silknow.org/image/cb715ab3-83a1-340d-b02c-5f018eeb0ffe> , <http://data.silknow.org/image/11fe9787-b391-3b51-bb4e-d5263f6b52d9> , <http://data.silknow.org/image/6a53020e-40d1-3683-8daa-c41fa90a0297> , <http://data.silknow.org/image/ddb04e38-2cc0-32d8-b6fc-82d3fb96e1d3> ;
        ecrm:P3_has_note               "Mat of plain-weave cotton embroidered with silk in chain or tambour, straight and running stitches with laid and couched silk thread and laid and couched metal thread. There is an interlining/backing of striped cotton through which some of the couching has been worked.\nRunning stitch has been used to create the effect of quilting on the surface fabric."@en , "embroidered & quilted, 1800s, Persian"@en ;
