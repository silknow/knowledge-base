<http://data.silknow.org/object/47de6c7d-6c3e-3050-aec4-5aced9c0788d>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "stipple engraving print on silk"@en , "Allegory of Spring by Francesco Bartolozzi ((1727-1815), stipple engraving printed on silk (impression printed in red)"@en , "There must have been a demand from collectors for Bartolozzi subjects printed on silk, for Francesco Bartolozzi, is the printmaker whose designs are most frequently encountered in this form. Prints on silk were always aimed at a niche market, and their fragility has made them especially rare today. This may be because prints on silk tended to be framed and hung on the wall. Thus they were exposed to the damaging effects of light."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9b550504-bc3f-3f1c-ac38-bac45237e008> ;
        ecrm:P3_has_note               "Allegory of Spring by Francesco Bartolozzi ((1727-1815), stipple engraving printed on silk (impression printed in red)"@en , "There must have been a demand from collectors for Bartolozzi subjects printed on silk, for Francesco Bartolozzi, is the printmaker whose designs are most frequently encountered in this form. Prints on silk were always aimed at a niche market, and their fragility has made them especially rare today. This may be because prints on silk tended to be framed and hung on the wall. Thus they were exposed to the damaging effects of light."@en , "stipple engraving print on silk"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/47de6c7d-6c3e-3050-aec4-5aced9c0788d/dimension/1> , <http://data.silknow.org/object/47de6c7d-6c3e-3050-aec4-5aced9c0788d/dimension/2> ;
        dc:identifier                  "E.1105-2002" ;
