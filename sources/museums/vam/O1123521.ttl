        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Girl's dress bodice of white Spitalfields silk damask brocade, with a pattern of zig zag floral stems and detached sprays of roses on a diapered background of lozenges with rosettes at their corners.  The bodice has leading strings of matching fabric attached at the shoulder back, elbow length sleeves and a back fastening."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7001d6fc-9495-3cd8-87b3-09f06fc77a9c> .

