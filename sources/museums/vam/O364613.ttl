<http://data.silknow.org/event/ba013781-6722-3f75-b187-4c67ab3521cc>
        a                              ecrm:E8_Acquisition ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/c7323546-2fe4-371a-bb6e-ac9ebedb408d> ;
