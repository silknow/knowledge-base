<http://data.silknow.org/object/48fdbb25-9fe0-32c0-94e4-8f176a4a97b3>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk brocade textile, Varanasi, 19th Century."@en , "Brocade is a rich silk fabric with patterns in gold and silver thread.  This piece has a running floral design in gold and various coloured silks on a rose coloured ground."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2e74706e-a4ee-365c-928e-48c763ff5201> ;
