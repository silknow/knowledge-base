        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "The 24th Regiment of Foot was a British Regiment serving in Canada\nfrom 1829 until 1840 when it returned to Great Britain [http://www.regiments.org/regiments/uk/inf/024SWB.htm] \n\nTidy's full and correct title was Colonel Francais Skelly Tidy"@en ;
