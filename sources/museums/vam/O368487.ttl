<http://data.silknow.org/object/fc1a69b4-0a77-3938-81c7-11a3ec28e4a8>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Nightcap of embroidered machine-knitted silk, England, ca. 1820"@en , "Nightcap of purple machine-knit silk. Circular, with a seam, and drawn in at the crown where it is trimmed with a self-coloured silk tassel. There is a border, banded by white stripes and embroidered with a red zig-zag design, and there are rows of formal flowers in white embroidered in the main border. There is another white stripe toward the top of the cap. The cap is finished by turning back the edge and knitting the last stitch into the body of the cap. A coarser mottled purple thread is used on the turn-back. The cap is hand-stitched and finished at the crown."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/cb9785cb-5406-304d-8005-32f1b5925fb1> , <http://data.silknow.org/image/f7c26cf4-e4d4-3643-8e94-7c9dc3f6f85d> , <http://data.silknow.org/image/49f3448f-eb3e-3fc3-9772-eaa7e37804b0> ;
        ecrm:P3_has_note               "Nightcap of embroidered machine-knitted silk, England, ca. 1820"@en , "Nightcap of purple machine-knit silk. Circular, with a seam, and drawn in at the crown where it is trimmed with a self-coloured silk tassel. There is a border, banded by white stripes and embroidered with a red zig-zag design, and there are rows of formal flowers in white embroidered in the main border. There is another white stripe toward the top of the cap. The cap is finished by turning back the edge and knitting the last stitch into the body of the cap. A coarser mottled purple thread is used on the turn-back. The cap is hand-stitched and finished at the crown."@en ;
        dc:identifier                  "T.214-1966" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O368487> .

