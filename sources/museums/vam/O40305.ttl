        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "<i>Kalaga </i>(hanging) of felted wool with silk embroidery. Central field of a flower head within a cartouche surrounded by a repeating lotus pattern bounded by a wide leafy border with 4 framed birds on perches and corner pear shaped medallions on a dark red ground."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/90467138-bceb-30a4-85eb-bfc001fdbe8a> .

