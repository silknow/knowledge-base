<http://data.silknow.org/object/3de87129-56f7-342c-91c4-d5cc79a713fa>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "brocaded, 1800s, Persian; Flowers"@en , "Woven silk and cotton brocaded with silk and metal thread\nDisplayed behind glass.\nWhite silk warp; white cotton ground weft.\nBrocading wefts: green, red and yellow silk and silver-gilt strip S-wound on a white silk core.\nWhite ground with offset rows of a floral motif: green and yellow leaves almost interlacing at the bottom with a mass of flowerheads in worn metal thread outlined in red."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/a537aa1f-8f19-30ef-8d6d-199b7bc14f64> , <http://data.silknow.org/image/9969d428-ecdc-35e0-bb78-d336d1cf5349> ;
        ecrm:P3_has_note               "brocaded, 1800s, Persian; Flowers"@en , "Woven silk and cotton brocaded with silk and metal thread\nDisplayed behind glass.\nWhite silk warp; white cotton ground weft.\nBrocading wefts: green, red and yellow silk and silver-gilt strip S-wound on a white silk core.\nWhite ground with offset rows of a floral motif: green and yellow leaves almost interlacing at the bottom with a mass of flowerheads in worn metal thread outlined in red."@en ;
