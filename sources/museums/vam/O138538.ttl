        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Cruciform textile panel of embroidered linen canvas with silk and silver-gilt threads. Horizontally cut in half, and embroidered in brown, blue, green, yellow and white silks with a raised border of silver-gilt embroidery. Depicts a heron."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6efbd3eb-03dc-3a2f-b753-b64ccf2f057c> .

