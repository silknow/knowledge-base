        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Bag of embroidered cream satin with beads. Vertically tucked and wedge shaped. Beadwork band at the top opening embroidered in grey, green and yellow, and another simulating a triangular pocket flap half way down and trimmed with a looped braid of white and gold. The carrying cord is also of white and gold with silk covered wooden bobbins which match the chenille tassels stitched to either side. Lined with glazed linen."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cb38b197-1d3f-3bd7-aab4-9f8415d4e30f> .

