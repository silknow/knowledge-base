<http://data.silknow.org/object/13709682-206a-3a9e-97fb-be57068b3ab5>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "part, embroidered net, 1800s, Persian"@en , "Description: Plain weave cotton, drawn thread work, needlewoven bars and embroidered metal thread, faced with block printed cotton.\nWhite cotton with drawn thread work and needlewoven bars in red silk forming horizontal, vertical and diagonal lines.  Where these meet silver and silver-gilt threads have been embroidered to form small roundels; the type of metal thread alternates.\nThis is a panel which has been cut to create a deep round neck and right-angled edges to which sleeves would have been attached; then worked with drawn thread etc.. the facing has a cream ground printed with a delicate floral pattern in blues, reds, yellow and mauve."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/a1015767-22b3-361c-975e-45ae5e9c7008> ;
        ecrm:P3_has_note               "part, embroidered net, 1800s, Persian"@en , "Description: Plain weave cotton, drawn thread work, needlewoven bars and embroidered metal thread, faced with block printed cotton.\nWhite cotton with drawn thread work and needlewoven bars in red silk forming horizontal, vertical and diagonal lines.  Where these meet silver and silver-gilt threads have been embroidered to form small roundels; the type of metal thread alternates.\nThis is a panel which has been cut to create a deep round neck and right-angled edges to which sleeves would have been attached; then worked with drawn thread etc.. the facing has a cream ground printed with a delicate floral pattern in blues, reds, yellow and mauve."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/13709682-206a-3a9e-97fb-be57068b3ab5/dimension/1> , <http://data.silknow.org/object/13709682-206a-3a9e-97fb-be57068b3ab5/dimension/2> ;
