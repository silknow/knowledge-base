<http://data.silknow.org/object/9b13cd3e-289a-3e45-bf25-bfe483645ce4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress embroidered in silk and wool on cotton. Satin, stem and long and short stitches. Black, red, green and touches of other colours. A wide band of geometric pattern round the hem of the skirt. Vertical oblong shapes in black wool appear to have been added later.\n\nJacket of black velvet, lined with white cotton. The cuffs are lined with black silk. Ornamented round the neck, front and lower edges and cuffs with applied gold lace and gold braid."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9b13cd3e-289a-3e45-bf25-bfe483645ce4> .

