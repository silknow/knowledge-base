        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Two halves of a man’s waistcoat made of figured blue silk taffeta, brocaded with silver strip and coloured silks in vertical, floral trails. It has a round neck and reaches to the hip, with welted pockets. It is lined with fustian, backed and faced with glazed blue worsted twill."@en , "Two halves of a man's, 1790s, French, made from blue silk brocaded with silver, coloured silks, 1750s"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/429f4025-94bd-3753-b3c2-b653141fffeb> , <http://data.silknow.org/image/a07e7f17-820e-36ae-b91f-f00b76c8598e> , <http://data.silknow.org/image/ffde5bf6-b1ad-373c-9613-cb577bc69e9e> , <http://data.silknow.org/image/96197402-da65-33fb-9661-b957b35d3968> , <http://data.silknow.org/image/be079644-3dd3-386e-9f0c-9a4c53eb6a8a> , <http://data.silknow.org/image/86211073-b580-3c64-8e69-750f862c30fc> , <http://data.silknow.org/image/5bfd9b2a-0660-3e73-9630-962593a74a33> , <http://data.silknow.org/image/228bf913-eee3-3d65-9ccc-4551680a363b> ;
        ecrm:P3_has_note               "Two halves of a man's, 1790s, French, made from blue silk brocaded with silver, coloured silks, 1750s"@en , "Two halves of a man’s waistcoat made of figured blue silk taffeta, brocaded with silver strip and coloured silks in vertical, floral trails. It has a round neck and reaches to the hip, with welted pockets. It is lined with fustian, backed and faced with glazed blue worsted twill."@en ;
