<http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Shawl of woven silk, wool and cotton. Plain red wool and silk centre. Deep border of fairly plain cones with simple flower fillings, on grounds white within the cone, red without. A narrow border of shawl-flowers meander around the panel with cones and along the side of the shawl. Within this is an edging of shawl-flowers on the red ground of the shawl, with a cone in each corner. The warp is of red silk, the weft is of wool. The weave is twill with the pattern bound in 1/3 twill."@en , "Shawl of woven silk, wool and cotton, possibly made in Austria, ca. 1835"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ca5e9234-e0ff-3ec3-aae7-dcd8f5a2cd0d> , <http://data.silknow.org/image/c31714ef-0ed4-3d8f-8ce6-3cab057d98c4> , <http://data.silknow.org/image/f5ba0b13-6c5a-3265-9a07-6882f65f42f1> ;
        ecrm:P3_has_note               "Shawl of woven silk, wool and cotton. Plain red wool and silk centre. Deep border of fairly plain cones with simple flower fillings, on grounds white within the cone, red without. A narrow border of shawl-flowers meander around the panel with cones and along the side of the shawl. Within this is an edging of shawl-flowers on the red ground of the shawl, with a cone in each corner. The warp is of red silk, the weft is of wool. The weave is twill with the pattern bound in 1/3 twill."@en , "Shawl of woven silk, wool and cotton, possibly made in Austria, ca. 1835"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048/dimension/3> , <http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048/dimension/5> , <http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048/dimension/2> , <http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048/dimension/1> , <http://data.silknow.org/object/0d8a0aaa-f16c-3b07-a0a9-a2b6885f1048/dimension/4> ;
