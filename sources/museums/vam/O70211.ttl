<http://data.silknow.org/event/b2263a43-e3f4-348b-8fc1-6087c3331f04>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "A search on the International Genealogical Index produces only one likely candidate for Elizabeth Mackett; the daughter of Thomas Mackett, christened on 4 April 1681 at Godshill on the Isle of Wight."@en ;
