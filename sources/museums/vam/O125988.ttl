<http://data.silknow.org/event/1ae06077-5a94-3b1b-b22b-752862c9fa4c>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Purchased from M. Stanislas Baron. Arrived at the museum on 17 November 1896, with an asking price of 4864 francs for the whole lot. 4300 was offered. For these five fragments the museum paid 11 pounds and 9 shilling.\n\nNeg. no. 22752\n\nNeg. 22752."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/ce22ad54-2c43-3755-a3bb-610fdb449d5d> ;
        ecrm:P3_has_note               "Purchased from M. Stanislas Baron. Arrived at the museum on 17 November 1896, with an asking price of 4864 francs for the whole lot. 4300 was offered. For these five fragments the museum paid 11 pounds and 9 shilling.\n\nNeg. no. 22752\n\nNeg. 22752."@en .

