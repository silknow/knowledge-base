<http://data.silknow.org/object/8e0ac65c-7251-3a25-886e-829192bda7e7>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Stevengraph picture woven in silk and mounted on card. Showing a locomotive hauling an express passenger train. The silks used for the locomotive are black, yellow and red, and the carriages are in yellow. The train is travelling from the right to left. On the left is a signal box and on the right is a bridge. The picture is in a beige mount with an 1888 trade label on the reverse."@en , "Stevengraph picture 'The Present Time' woven in silk and mounted on card, Coventry, 1850s-1870s"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ec5aee76-1931-3e0f-942a-d16286026d2f> ;
        ecrm:P3_has_note               "Stevengraph picture 'The Present Time' woven in silk and mounted on card, Coventry, 1850s-1870s"@en , "Stevengraph picture woven in silk and mounted on card. Showing a locomotive hauling an express passenger train. The silks used for the locomotive are black, yellow and red, and the carriages are in yellow. The train is travelling from the right to left. On the left is a signal box and on the right is a bridge. The picture is in a beige mount with an 1888 trade label on the reverse."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/8e0ac65c-7251-3a25-886e-829192bda7e7/dimension/1> , <http://data.silknow.org/object/8e0ac65c-7251-3a25-886e-829192bda7e7/dimension/2> ;
