<http://data.silknow.org/event/0ba4d3de-450e-3bc4-bc44-d57449ca9f7d>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This costume comes from Meleto Castle in Tuscany, where there is a private theatre, which was opened in 1741.  It is a very early example of a costume made specially for the stage and, although probably used in productions of plays, it was also undoubtedly used for masques and other entertainments which included dancing.\n\nSarah Woodcock & Philip Dyer, 1981."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3> ;
        ecrm:P3_has_note               "This costume comes from Meleto Castle in Tuscany, where there is a private theatre, which was opened in 1741.  It is a very early example of a costume made specially for the stage and, although probably used in productions of plays, it was also undoubtedly used for masques and other entertainments which included dancing.\n\nSarah Woodcock & Philip Dyer, 1981."@en .

