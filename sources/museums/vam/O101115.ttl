<http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Stage coat of green satin worn in private court theatre performances at the Meleto Castle, Tuscany, ca. 1750."@en , "Stage coat worn in private court theatre performances at the Meleto Castle, Tuscany, ca. 1750. Green silk satin edge to edge frock coat decorated with metallic braid 'military' trim on front edges and metallic braid at hem and sleeve cuffs. The coat fastens with a row of covered buttons and thread loops. It is lined throughout with black wool, though this lining may be a later addition."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/30759c09-c214-34b5-b65a-985c9f63be01> , <http://data.silknow.org/image/5e74d8c2-d0ab-3910-b9b3-92d39d1efc82> , <http://data.silknow.org/image/a9cf90a4-fa78-32ec-9fa6-763db3884a3c> , <http://data.silknow.org/image/026ddb0d-7280-3994-9f72-9772664d24af> , <http://data.silknow.org/image/2c74dfe0-5e16-3780-bc56-192055ef8282> ;
        ecrm:P3_has_note               "Stage coat of green satin worn in private court theatre performances at the Meleto Castle, Tuscany, ca. 1750."@en , "Stage coat worn in private court theatre performances at the Meleto Castle, Tuscany, ca. 1750. Green silk satin edge to edge frock coat decorated with metallic braid 'military' trim on front edges and metallic braid at hem and sleeve cuffs. The coat fastens with a row of covered buttons and thread loops. It is lined throughout with black wool, though this lining may be a later addition."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3/dimension/3> , <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3/dimension/5> , <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3/dimension/4> , <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3/dimension/1> , <http://data.silknow.org/object/4a814a25-fa80-3f19-ad9b-06ca292d23e3/dimension/2> ;
