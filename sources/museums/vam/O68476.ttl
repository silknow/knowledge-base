<http://data.silknow.org/object/5e1e4e22-39ca-3d1b-9ae6-ffcd23fe7230/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Sari fragment of silk.  In this sari, warp ikat is used as a means of changing the warp colour from yellow to red where the striped field joins the pallav, a common technique in south India. The borders are undecorated but for narrow stripes of supplementary warp in a chevron pattern."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5e1e4e22-39ca-3d1b-9ae6-ffcd23fe7230> .

