<http://data.silknow.org/object/802576e2-52f5-31cf-9d5e-0bb8ef083fb1>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Funeral programme of printed silk satin. White satin lithographed in black for the funeral of the first Duke of Wellington. Headed 'In Memory of Arthur, Duke of Wellington' with his coat of arms. Below this is 'Funeral Programme by Authority of the Earl Marshal', and giving the order of procession. On either side are lists of the Duke's military actions on banners held by two Fames. At the bottom is a mourning Britannia looking across to a medallion of the Duke's head, and a list of his titles and decorations. White silk fringe."@en , "Funeral programme of printed silk satin, D. Williams, London, 1852"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/2ddce3b8-5a1b-37db-bce7-19d9dcdf5e11> ;
        ecrm:P3_has_note               "Funeral programme of printed silk satin. White satin lithographed in black for the funeral of the first Duke of Wellington. Headed 'In Memory of Arthur, Duke of Wellington' with his coat of arms. Below this is 'Funeral Programme by Authority of the Earl Marshal', and giving the order of procession. On either side are lists of the Duke's military actions on banners held by two Fames. At the bottom is a mourning Britannia looking across to a medallion of the Duke's head, and a list of his titles and decorations. White silk fringe."@en , "Funeral programme of printed silk satin, D. Williams, London, 1852"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/802576e2-52f5-31cf-9d5e-0bb8ef083fb1/dimension/2> , <http://data.silknow.org/object/802576e2-52f5-31cf-9d5e-0bb8ef083fb1/dimension/1> ;
