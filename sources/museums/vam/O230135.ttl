<http://data.silknow.org/object/f6bd4068-6b27-3951-b97b-7ab2109cfdb9>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "A man's night cap, Italian, 1700-1724; cream silk hand-painted with flowers and cherries."@en , "Cream silk undress-cap, rounded crown, turned-up brim. Silk hand-painted with a green, crimson and oyster (probably faded green) leaves, flowers and cherries design.  As the brim and crown are one piece,  the former was painted on the wrong side of the silk, so that the right side of the painting would show when the brim was turned up."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/e15c89cd-570d-3c3d-8bc1-871bf4b0a609> , <http://data.silknow.org/image/37a3b5d9-cf6e-3357-b627-bbf7bfd66fe5> , <http://data.silknow.org/image/eea08e10-7bf0-3016-9667-061d82c2a952> , <http://data.silknow.org/image/e85dcf2c-fac6-3eec-bbed-50b236ef8f0d> , <http://data.silknow.org/image/3db227bf-ce9c-35fa-9c44-1b13227b6c8e> ;
        ecrm:P3_has_note               "A man's night cap, Italian, 1700-1724; cream silk hand-painted with flowers and cherries."@en , "Cream silk undress-cap, rounded crown, turned-up brim. Silk hand-painted with a green, crimson and oyster (probably faded green) leaves, flowers and cherries design.  As the brim and crown are one piece,  the former was painted on the wrong side of the silk, so that the right side of the painting would show when the brim was turned up."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f6bd4068-6b27-3951-b97b-7ab2109cfdb9/dimension/1> ;
        dc:identifier                  "528-1898" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O230135> .

