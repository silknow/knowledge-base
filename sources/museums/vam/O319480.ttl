<http://data.silknow.org/production/5fca65f2-85ce-3bb5-a45a-9252f9edaf52>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/4ea0721e-4c98-3e2f-8b3f-fb76fccbe94f> ;
        ecrm:P126_employed      "pile count: warps 11, along weft 17. Binding weft threads: silk, skinny ivory. Brocade structure: whole 4/1 twill, count 20, shots between pile 2. Metal and twist: gilt (?)  S-twist, tightly wrapped. Selvedges: 2cm, very fine, densely packed satin with little cotton weft exposed"@en , "Voided and brocaded silk. Satin foundation structure: ivory silk warp, single strand ivory cotton weft. Satin and velvet warp order 3-1-2. Velvet structure: red and green silk"@en , "one colour."@en , "satin warps seem slightly thicker silk bits"@en ;
        ecrm:P126_employed      <http://data.silknow.org/vocabulary/617> , <http://data.silknow.org/vocabulary/900> ;
