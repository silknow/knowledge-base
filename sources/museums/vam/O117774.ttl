<http://data.silknow.org/object/04c0e163-68fa-3d58-8ac2-89f7f2b9ac69>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Unique"@en , "Embroidered in polychrome silk on linen.  Double darning, brick, outline, satin and chain stitches.  Two widths of a three width spread, which have been joined horizontally one above the other and finished with a coloured silk fringe.  The motif of a man in Turkish dress, attended by two women on a smaller scale, and surrounded by flower sprays and birds, is repeated horizontally along each width."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/07ec7c2b-a80c-3de5-8646-b79bd677e0e5> , <http://data.silknow.org/image/25618e17-49c2-3a8b-bba0-9d5fafe219df> , <http://data.silknow.org/image/90fa94ca-2c52-3a25-8acb-9bf7b99b621d> , <http://data.silknow.org/image/139955f1-e165-38c8-9b39-2e8f9d870c8b> , <http://data.silknow.org/image/e81e2188-cefa-3796-99cc-480eddb208ac> , <http://data.silknow.org/image/0a88ce35-c872-3966-a380-7b7cbd2df391> , <http://data.silknow.org/image/66676289-0559-3ceb-bf5f-02e0cfbf5cbf> ;
        ecrm:P3_has_note               "Unique"@en , "Embroidered in polychrome silk on linen.  Double darning, brick, outline, satin and chain stitches.  Two widths of a three width spread, which have been joined horizontally one above the other and finished with a coloured silk fringe.  The motif of a man in Turkish dress, attended by two women on a smaller scale, and surrounded by flower sprays and birds, is repeated horizontally along each width."@en ;
