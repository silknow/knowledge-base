<http://data.silknow.org/object/b7441dbd-eaba-3f8a-b7df-a24aa3ecb6e9/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "X-framed stool, one of a pair, of mahogany, the frame carved with lion heads and paws, parcel gilt, the stretchers of stained beechwood, the seat with renewed upholster in beige silk satin, edged with woven braid"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b7441dbd-eaba-3f8a-b7df-a24aa3ecb6e9> .

<http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390>
        a                         ecrm:E39_Actor , ecrm:E40_Legal_Body ;
        rdfs:label                "Victoria and Albert Museum" ;
        ecrm:P1_is_identified_by  "Victoria and Albert Museum" ;
        <http://www.w3.org/2002/07/owl#sameAs>
