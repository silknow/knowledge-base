<http://data.silknow.org/object/ba7b5009-d7bd-330d-8a0e-93bc1188eba3/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nThis image of St Catherine came from a set of church furnishings made for the Neville family. Images of saints were forbidden during the reigns of Edward VI (1547-1553) and Elizabeth I (1558-1603). The Nevilles were faithful to traditional religion and supported the northern revolt of 1569 against the Reformation. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ba7b5009-d7bd-330d-8a0e-93bc1188eba3> .

