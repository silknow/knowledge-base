        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Silk brocaded textile, woven chiefly in green, blue and yellow on red. The pattern, which is repeating, shows the influence of European chinoiserie designs. It consists of a phoenix (fêng huang) beside a pagoda and a balustrade, as well as small animals and flowers."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a27ad036-71f4-3d20-bdf7-44117d518a3e> .

