        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Polychrome silk velvet with cut and uncut pile on a ground of silk and silver-gilt thread"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ffc1da62-b113-3c2c-bd42-1e7c8f45b3f3> .

