        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk and wool evening dress and bertha, made in England, ca. 1865"@en , "Evening dress and bertha of pink silk and wool gauze with horizontal bands of narrow stripes of satin and open weave edging flounce and hem. \n\nThe evening dress laces at the back and is mounted on a white taletan foundation. The bodice is boned at the centre front, sides and back.\n\nThe bertha fits over a plain low necked top with short pleated sleeves edged with a fringe."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6c98aa47-eebf-322a-87b5-9f7f4878b659> , <http://data.silknow.org/image/50b1ecd7-8fc5-3831-8e97-2c7a2989024c> ;
        ecrm:P3_has_note               "Silk and wool evening dress and bertha, made in England, ca. 1865"@en , "Evening dress and bertha of pink silk and wool gauze with horizontal bands of narrow stripes of satin and open weave edging flounce and hem. \n\nThe evening dress laces at the back and is mounted on a white taletan foundation. The bodice is boned at the centre front, sides and back.\n\nThe bertha fits over a plain low necked top with short pleated sleeves edged with a fringe."@en ;
