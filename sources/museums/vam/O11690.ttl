<http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Part of a pah-soe (man's skirt) tapestry woven in luntaya silk, possibly made in Mandalay, ca. 1870"@en , "Part of a pah-soe (man's skirt) woven in luntaya silk, or '100' shuttles, interlocking tapestry weave. The cloth is made up of  five repeats of various weft acheik (horizontal wave) patterns with checkered end borders in pinks, blues, yellows and greens on a ground of dark pink shading to lilac and to dark blue. This length would have formed half a pah-soe."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6010363b-439d-3dac-a8bf-19c167a12ca8> , <http://data.silknow.org/image/04bd3149-5e0f-3be5-b2e2-389518b60bcf> ;
        ecrm:P3_has_note               "Part of a pah-soe (man's skirt) woven in luntaya silk, or '100' shuttles, interlocking tapestry weave. The cloth is made up of  five repeats of various weft acheik (horizontal wave) patterns with checkered end borders in pinks, blues, yellows and greens on a ground of dark pink shading to lilac and to dark blue. This length would have formed half a pah-soe."@en , "Part of a pah-soe (man's skirt) tapestry woven in luntaya silk, possibly made in Mandalay, ca. 1870"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1/dimension/4> , <http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1/dimension/1> , <http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1/dimension/3> , <http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1/dimension/2> ;
        dc:identifier                  "T.244-1917" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O11690> .

<http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Part of a pah-soe (man's skirt) woven in luntaya silk, or '100' shuttles, interlocking tapestry weave. The cloth is made up of  five repeats of various weft acheik (horizontal wave) patterns with checkered end borders in pinks, blues, yellows and greens on a ground of dark pink shading to lilac and to dark blue. This length would have formed half a pah-soe."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8d8c2fd1-0302-3c75-afaf-5dd8b6710fb1> .

