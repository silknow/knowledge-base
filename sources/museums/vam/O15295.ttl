<http://data.silknow.org/actor/c847bb0c-352c-32e6-bbb6-d5cca10d1aa8>
        a                         ecrm:E39_Actor ;
        rdfs:label                "Godwin, Edward William" ;
        ecrm:P1_is_identified_by  "Godwin, Edward William" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://isni.org/isni/0000000109117828> , <https://viaf.org/viaf/68929729> , <http://dbpedia.org/resource/William_Godwin> ;
