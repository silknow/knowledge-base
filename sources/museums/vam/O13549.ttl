        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Coverlet of embroidered linen with silk and metal threads in long and short, satin, stem and back stitches. Quilted in minute all-over pattern in yellow silk, and over this is embroidered a rich pattern of exotic flowers and bizarre shapes. The design radiates from a roundel in the centre. Worked with coloured silks in black and shades of red and green."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/bda36d9b-95b0-3f94-be79-267b5d29f490> .

