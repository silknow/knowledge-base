<http://data.silknow.org/object/98b8ffbb-9900-3b2d-b60c-e3b3c64876c4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Linen canvas embroidered with silk, wool and metal thread, mainly in tent stitch, with some plaited and long-armed cross stitch. The stitches are minute, averaging 31 to 39 to the inch.\n\nLetters MH once worked on either side of the shield have been filled in and replaced with stars."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/98b8ffbb-9900-3b2d-b60c-e3b3c64876c4> .

