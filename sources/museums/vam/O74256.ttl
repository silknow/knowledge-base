<http://data.silknow.org/object/d170d767-2fde-3fef-bd6f-95409b97efe2>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Hanging, white gauze-weave silk, painted in colours, China, ca. 1820-1840"@en , "Hanging of white gauze-weave silk, painted in colours with pot of flowers, birds and insects."@en , "This long, narrow piece of silk gauze was painted in China for export to Europe. The design is very similar to that found on wallpapers that were also painted in China for the export market. It may well be that the gauze and the wallpaper were produced in the same workshops.\n\nIt is not clear, however, exactly how this silk would have been used in a Western interior. It is not very durable, as the paint rubs off easily and the silk gauze is vulnerable to splitting."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/5cc9e419-5cfa-3247-8099-c5e5b4c68b5a> , <http://data.silknow.org/image/9236ac7f-c576-3666-9ba0-39ed062b4ef6> , <http://data.silknow.org/image/9d3bf0c3-c643-33b6-9607-6c94fc8b2226> , <http://data.silknow.org/image/25bf33d3-d850-3c61-8818-0ad1f7145b90> , <http://data.silknow.org/image/13ed6425-2b0d-335f-960d-17b1a7ee7d61> ;
        ecrm:P3_has_note               "This long, narrow piece of silk gauze was painted in China for export to Europe. The design is very similar to that found on wallpapers that were also painted in China for the export market. It may well be that the gauze and the wallpaper were produced in the same workshops.\n\nIt is not clear, however, exactly how this silk would have been used in a Western interior. It is not very durable, as the paint rubs off easily and the silk gauze is vulnerable to splitting."@en , "Hanging of white gauze-weave silk, painted in colours with pot of flowers, birds and insects."@en , "Hanging, white gauze-weave silk, painted in colours, China, ca. 1820-1840"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/d170d767-2fde-3fef-bd6f-95409b97efe2/dimension/1> , <http://data.silknow.org/object/d170d767-2fde-3fef-bd6f-95409b97efe2/dimension/2> ;
        dc:identifier                  "1366-1873" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O74256> .

