        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Man's coat of purple silk velvet with a triangular and chequered woven figured pattern. The top of the cuff and pockets and collar are covered with looped gilt braid. The coat is lined with silk quilted at chest and shoulders. The buttons are self covered and only the two on the apex of the very convex chest can be fastened. Hand-sewn."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/15bb3632-ef72-3298-97e7-2271cc87c2e2> .

