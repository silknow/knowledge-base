        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Repeating acheik (horizontal wave patterned) stripes of black, red and white on a warp ground of yellow, red, black and white stripes.  This may have formed a pah-soe (man's wrap around skirt) with 6151 (IS) which is an identical fabric."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ea7ca8af-e76a-3502-8c64-8353afd0e1d0> .

