        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A length of 3 pattern repeats of acheik (horizontal wave) patterns with a central checkered area (L. 87 cm.) and checkered end borders (36 cm.) in navy, green, cream, yellow, white on a deep pink ground.\n\nTo form the pah-soe the piece would have been \"doubled and its edges sewn together along one side; the turn of the cloth serves as a bag or wallet\".(Ferrars 1901)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/fdd3fa46-484c-3381-b41e-24b6d9586b20> .

