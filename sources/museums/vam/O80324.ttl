<http://data.silknow.org/object/4c2610eb-4cd6-3d8e-a286-c0526d86992a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Chair, with cabriole front legs and heavily raked back legs, terminating in square hoofed feet; rectangular back with rounded corners, covered in green velvet.\n\nFixed top covers of dark green silk velvet, trimmed with dark silk braid.\nRemains of green silk scarf at top of chair-back, fixed under the braid but over the cord. \nThe seat foundation has a 4-chevron webbing, and a striped plain-weave base cloth (the warp-stripes running from side to side)"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4c2610eb-4cd6-3d8e-a286-c0526d86992a> .

