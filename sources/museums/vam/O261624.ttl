<http://data.silknow.org/object/79343322-2fb6-3d00-b39d-67913bcd0a72/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress fabric of pale blue silk moiré. Blue watered silk with a floral pattern created with a flushing warp, and red selvedge. The pattern represents sprays of flowers in a unconnected meander. Two repeats per loom width. The repeats across the width of the silk are mirror-images of each other."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/79343322-2fb6-3d00-b39d-67913bcd0a72> .

