<http://data.silknow.org/object/459513a5-70fd-35eb-b43a-3d15ba7680c9>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pair of embroidered linen pillow covers, England, 1600-20"@en , "Pair of linen embroidered pillow-beres with black silk in half-ladder stich and knots. The edges are worked in buttonhole stitch and interlaced interlaced insertion stitched are used for the two seams. \n\nOnly the front of the pillow-bered are decorated. Within a narrow border containing coiling leafy steams, there are four staggered rows of stylised peascod plants; at the base of each are confronted worms and between the plants are insects and coiling tendrils."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/26ea9f46-de86-362c-b47e-eda8686ef1ca> , <http://data.silknow.org/image/98e93ffa-74d9-34be-88db-062b2eba1bbd> ;
        ecrm:P3_has_note               "Pair of embroidered linen pillow covers, England, 1600-20"@en , "Pair of linen embroidered pillow-beres with black silk in half-ladder stich and knots. The edges are worked in buttonhole stitch and interlaced interlaced insertion stitched are used for the two seams. \n\nOnly the front of the pillow-bered are decorated. Within a narrow border containing coiling leafy steams, there are four staggered rows of stylised peascod plants; at the base of each are confronted worms and between the plants are insects and coiling tendrils."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/459513a5-70fd-35eb-b43a-3d15ba7680c9/dimension/2> , <http://data.silknow.org/object/459513a5-70fd-35eb-b43a-3d15ba7680c9/dimension/1> ;
