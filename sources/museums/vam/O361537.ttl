        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/1ecaa768-06c1-3b18-a8eb-d604d7214831> ;
        ecrm:P3_has_note               "Purchased from Miss L. FitzGerald, London."@en .

