<http://data.silknow.org/object/c80f0895-94b9-3095-b260-0d9440617c6c/observation/5>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/historical-observation> ;
        ecrm:P3_has_note    "Silk and satin programmes were produced from the 18th century onwards to commemorate special theatrical productions such as first nights, gala, commemorative and benefit performances.  The custom had largely died out by the 1920s, and by the 1970s any such programmes were usually for ballet or opera gala performances and produced on nylon."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/c80f0895-94b9-3095-b260-0d9440617c6c> .

