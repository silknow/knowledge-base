<http://data.silknow.org/object/6bd2229f-da80-3de4-a7cb-edb53f75e520/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Embroidered picture on panel of cream silk satin, embroidered with silk in shades of yellow, green beige, blue and grey with long and short stem stitches, French knots and a little couched work.\n\nIn the centre is a scene of two ladies and a gentleman watching two fishermen haul in their net and to one side is a black servant. Above are birds and butterflies and there is a border of naturalistic sprays of tulips and roses.\n\nBeneath the scene is embroidered 'Maria Encarnacion Grinda Ario de 1823.'\n\nThe gilt frame with an inner, painted border of black and gold, has been added at a later date."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6bd2229f-da80-3de4-a7cb-edb53f75e520> .

<http://data.silknow.org/object/6bd2229f-da80-3de4-a7cb-edb53f75e520>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered picture in frame, Spain, 1823"@en , "Embroidered picture on panel of cream silk satin, embroidered with silk in shades of yellow, green beige, blue and grey with long and short stem stitches, French knots and a little couched work.\n\nIn the centre is a scene of two ladies and a gentleman watching two fishermen haul in their net and to one side is a black servant. Above are birds and butterflies and there is a border of naturalistic sprays of tulips and roses.\n\nBeneath the scene is embroidered 'Maria Encarnacion Grinda Ario de 1823.'\n\nThe gilt frame with an inner, painted border of black and gold, has been added at a later date."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/74c717b6-2b59-37d5-88f6-ef498ac2a799> ;
        ecrm:P3_has_note               "Embroidered picture in frame, Spain, 1823"@en , "Embroidered picture on panel of cream silk satin, embroidered with silk in shades of yellow, green beige, blue and grey with long and short stem stitches, French knots and a little couched work.\n\nIn the centre is a scene of two ladies and a gentleman watching two fishermen haul in their net and to one side is a black servant. Above are birds and butterflies and there is a border of naturalistic sprays of tulips and roses.\n\nBeneath the scene is embroidered 'Maria Encarnacion Grinda Ario de 1823.'\n\nThe gilt frame with an inner, painted border of black and gold, has been added at a later date."@en ;
