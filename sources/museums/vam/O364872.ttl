<http://data.silknow.org/object/53685979-3796-3417-b0d2-71aa8a0c2051>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O364872" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/5bf1878f-e888-3f1e-8a23-faf57690b60b> , <http://data.silknow.org/image/4a8ea562-3b27-30af-ae78-682ae2564b2d> , <http://data.silknow.org/image/36cbacb9-2180-3025-aa57-50859749ddc5> , <http://data.silknow.org/image/a0c36bfb-829e-34a7-9525-3bf087b74122> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c/observation/1> , <http://data.silknow.org/image/85b34c74-3019-3352-ae6e-36d85e0bd98a> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c/observation/4> , <http://data.silknow.org/object/98e8ed67-3c87-3ecf-8f9b-853dcf28a218> , <http://data.silknow.org/image/3659fbd8-6ccd-3d05-935b-b32fc0dc597c> , <http://data.silknow.org/event/418704e1-1593-3974-a3b4-475e52d705f7> , <http://data.silknow.org/production/8b1743b7-7114-322e-965c-c72674fe6408> , <http://data.silknow.org/image/15fcd70b-8b70-36a2-b00f-1b37ad8d341c> , <http://data.silknow.org/image/ea791188-ebf3-3780-836e-4ed3b0bae26d> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c/observation/3> , <http://data.silknow.org/image/f195af2f-625f-300d-847a-0240c86734dc> , <http://data.silknow.org/image/d47f570c-bb6f-339a-9e75-a4f56f75151a> , <http://data.silknow.org/image/bd4d9a17-aefe-3e5f-bb1f-78b3faa2c7b5> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c/observation/2> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/6e81a979-63b2-3f33-a5c6-3fca8ef5c40c/domain/1> , <http://data.silknow.org/image/66723b87-d861-3f88-8ffa-269d25ecd79e> ;
