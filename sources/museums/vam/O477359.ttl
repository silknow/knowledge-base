<http://data.silknow.org/object/f7f0ab93-df35-35dd-9d6f-7479e5995dfa>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Intended for use as a garment, clothing."@en , "Silk sari, fine maroon cotton and silk, woven with designs in gold-wrapped thread. Some motifs in the field, one end has a stylised plant motif and also bands of red and orange."@en , "Textile, sari, woven cotton and silk with gold-wrapped thread, Tamil Nadu, probably Madurai or Thanjavur, ca. 1855"@en , "SILK AND COTTON SARI \n\nDark red saris with gold borders are typical of southern Tamil Nadu. They were usually woven entirely in cotton, but for this plain weave, silk warps in red were combined\nwith black cotton wefts. A lavish amount of metal-wrapped thread decorates the pallu, the end to be shown when worn.\n\nSilk and cotton with metal-wrapped thread brocading\nMadurai or Thanjavur, Tamil Nadu, about 1855\nV&A: 6026 (IS) [03/10/2015-10/01/2016]"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0352eb3e-10a4-3af6-8e70-7ddb0d7db109> , <http://data.silknow.org/image/547336bf-d541-3f33-bdb3-8e10703ee13a> , <http://data.silknow.org/image/60c41b65-6960-312d-ac24-72fb40ff3586> , <http://data.silknow.org/image/ea75eb49-792c-38de-b54a-88023a520efc> , <http://data.silknow.org/image/aa392712-bd31-36a6-b8c3-7e530618d108> ;
        ecrm:P3_has_note               "Textile, sari, woven cotton and silk with gold-wrapped thread, Tamil Nadu, probably Madurai or Thanjavur, ca. 1855"@en , "Silk sari, fine maroon cotton and silk, woven with designs in gold-wrapped thread. Some motifs in the field, one end has a stylised plant motif and also bands of red and orange."@en , "SILK AND COTTON SARI \n\nDark red saris with gold borders are typical of southern Tamil Nadu. They were usually woven entirely in cotton, but for this plain weave, silk warps in red were combined\nwith black cotton wefts. A lavish amount of metal-wrapped thread decorates the pallu, the end to be shown when worn.\n\nSilk and cotton with metal-wrapped thread brocading\nMadurai or Thanjavur, Tamil Nadu, about 1855\nV&A: 6026 (IS) [03/10/2015-10/01/2016]"@en , "Intended for use as a garment, clothing."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f7f0ab93-df35-35dd-9d6f-7479e5995dfa/dimension/1> , <http://data.silknow.org/object/f7f0ab93-df35-35dd-9d6f-7479e5995dfa/dimension/2> , <http://data.silknow.org/object/f7f0ab93-df35-35dd-9d6f-7479e5995dfa/dimension/3> ;
