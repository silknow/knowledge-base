<http://data.silknow.org/object/f8d9e3b6-3a59-3a03-b6fa-509d4a28890a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of men's gloves of kidskin dyed golden brown, with silver thread embroidery at the back of the hand extending around to the base of the thumb. The short curved cuff is reinforced inside with card or heavy paper, and lined with yellow silk. The gloves are trimmed with heavy fringe of silver-gilt thread, tassels and coils of purl."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f8d9e3b6-3a59-3a03-b6fa-509d4a28890a> .

