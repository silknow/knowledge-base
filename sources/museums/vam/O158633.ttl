        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Flat and square bag of embroidered linen canvas worked in tent stitch with a silver thread ground and floral pattern of coloured silks. The bag is lined with coral-pink silk, with a plaited silk drawstring, and silver loops and finials."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/775cfa16-30da-3fba-acfe-810fcb808c28> .

