<http://data.silknow.org/event/11ced0ae-4382-3202-b2cd-d89517a078ad>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This drawing is anonymous but represents the Swedish singer Jenny Lind as Marie in Act I of Gaetano Donizetti's opera <i>La Fille du Regiment</i> that had its first London performance  at Her Majesty's Opera House on 27 May 1847. This drawing was once the property of the singer Dame Joan Sutherland."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/34f99dac-f536-327c-9786-3b843cb4e0c4> ;
