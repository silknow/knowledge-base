        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Blouse made of striped silk gauze embroidered in chain stitch with gilt thread. The embroidery around the V neck and the wrists is composed of floral stems bordered with a scallop pattern. On each side of the neck is a 'tughra' and inscriptions, encircled by a floral stem. \n\nThe neck and sleeves are finished with a fringe of gilt thread and sequins."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6d151083-d84b-3999-8c63-877efdd97e1c> .

