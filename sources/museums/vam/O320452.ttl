<http://data.silknow.org/object/a9d44055-aa93-3924-a282-8d9f66da13ba/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This cushion cover is worked in an embroidery technique typical of the Ionian Islands, to the west of the Greek mainland, and is usually associated with the island of Cephalonia. Cephalonia came under Venetian rule in 1500, and the drawn threadwork used here is directly influenced by Italian embroidery."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a9d44055-aa93-3924-a282-8d9f66da13ba> .

<http://data.silknow.org/vam>
