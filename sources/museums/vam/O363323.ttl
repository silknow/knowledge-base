<http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Woven wool and silk shawl, Paisley, Scotland, ca. 1847."@en , "Shawl of woven wool on a silk warp dyed red for the borders and brown, red and green for the narrow plain-woven end-pieces. \n\nIt has a design of cones with surrounding small cone 'leaves' and fan shaped borders of tape-like cones with simple outline in white. There is a large central stylised flower-head, from which spring trails of bright flowers on a white ground. The rest of the field is filled with elaborate finials from corners and central side borders, linked by stems of flowers. The wide border is divided in two by one of the outer guard-strips. It is further overrun by large complexes of cones.\n\nThe colours are in bright red, chocolate brown, bright green, bright light blue, golden yellow, pinkish lilac and white."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/33fb18b0-c04a-3cfe-99e2-cec61c810824> , <http://data.silknow.org/image/02e48c08-d238-3639-833a-d70a76c68aac> , <http://data.silknow.org/image/d6feb0dd-7183-3a00-acbb-1510e0c958d9> , <http://data.silknow.org/image/4e15e671-ad73-3e6c-b8a0-9ebb1242e246> , <http://data.silknow.org/image/e2ef1572-5c61-3ff9-9f77-c48955e12e58> , <http://data.silknow.org/image/0922ea34-6426-324a-9084-c3032dbe9419> ;
        ecrm:P3_has_note               "Woven wool and silk shawl, Paisley, Scotland, ca. 1847."@en , "Shawl of woven wool on a silk warp dyed red for the borders and brown, red and green for the narrow plain-woven end-pieces. \n\nIt has a design of cones with surrounding small cone 'leaves' and fan shaped borders of tape-like cones with simple outline in white. There is a large central stylised flower-head, from which spring trails of bright flowers on a white ground. The rest of the field is filled with elaborate finials from corners and central side borders, linked by stems of flowers. The wide border is divided in two by one of the outer guard-strips. It is further overrun by large complexes of cones.\n\nThe colours are in bright red, chocolate brown, bright green, bright light blue, golden yellow, pinkish lilac and white."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f/dimension/2> , <http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f/dimension/4> , <http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f/dimension/1> , <http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f/dimension/3> , <http://data.silknow.org/object/8ae450a3-441e-36a0-b6b7-a462eec2ca8f/dimension/5> ;
        dc:identifier                  "T.38-1973" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O363323> .

