<http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "This pair of women's shoes have a thick, waisted heel and a blunt pointed toe. They have ribbon-ties and the tongue has the fashionable vandyke decoration. The brocaded silk was woven in Spitalfields, London, and dates from about 1715 to 1720.  At this time shoemakers still made 'straights'. These were identical right and left shoes, which made walking difficult. If the shoemaker placed the heel incorrectly or made the angle of the heel too sharp, the wearer's weight was thrown forward. This added to the discomfort."@en , "Silk brocade, English, ca. 1720\n\nF, 1730-35, English; Ivory blue silk brocade, Van Dyke tongue"@en , "Pair of women's shoes of brocaded silk, withmedium heel and vandyked tongue"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b9c63a8d-71c4-3241-94f9-30280e00de71> , <http://data.silknow.org/image/a53010cc-16fa-3620-a89d-5ad8caf0048b> , <http://data.silknow.org/image/24327939-99e7-39e4-8946-de45e0cee385> , <http://data.silknow.org/image/bf2f6339-65c0-3c27-ac53-4c6509603726> , <http://data.silknow.org/image/bfe1fc6b-219b-334d-804a-52e3b51c2b54> , <http://data.silknow.org/image/1ba03138-5d43-30d4-bc95-2508db6995a1> ;
        ecrm:P3_has_note               "Pair of women's shoes of brocaded silk, withmedium heel and vandyked tongue"@en , "This pair of women's shoes have a thick, waisted heel and a blunt pointed toe. They have ribbon-ties and the tongue has the fashionable vandyke decoration. The brocaded silk was woven in Spitalfields, London, and dates from about 1715 to 1720.  At this time shoemakers still made 'straights'. These were identical right and left shoes, which made walking difficult. If the shoemaker placed the heel incorrectly or made the angle of the heel too sharp, the wearer's weight was thrown forward. This added to the discomfort."@en , "Silk brocade, English, ca. 1720\n\nF, 1730-35, English; Ivory blue silk brocade, Van Dyke tongue"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/6> , <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/3> , <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/4> , <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/5> , <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/1> , <http://data.silknow.org/object/bcba1be4-7280-328e-b345-692f00e2076e/dimension/2> ;
