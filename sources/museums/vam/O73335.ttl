<http://data.silknow.org/object/7e4e52a5-cebd-3b2b-a6dd-d20febbe11b2/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nRichly decorated caps like this one were worn informally by aristocratic gentlemen. Despite their name, they were worn during the day at home. Although they do appear in portraits, they were never worn in public.  Nevertheless they were usually elaborately embroidered with metal threads, lace and spangles (sequins). [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7e4e52a5-cebd-3b2b-a6dd-d20febbe11b2> .

