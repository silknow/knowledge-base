<http://data.silknow.org/event/51d8af1b-762c-387d-a2b7-cf92c0ba4172>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This garment was bought for the Museum in India in 1882 by Caspar Purdon Clarke. 1883 Register entry: 'DRESS. Blue satin with a narrow border of a red figured silk round the bottom. Embroidered in various coloured silks, and ornamented with pieces of looking glass. Worn by Mussulman women. Kattywar. 19th cent. L. 3 ft. 8 in.. W. 3 ft. 4 in. Bought, 12s. 2327-1883 (IS)'"@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/683dfacd-22e6-36d2-89c2-8a9b138e3f67> ;
        ecrm:P3_has_note               "This garment was bought for the Museum in India in 1882 by Caspar Purdon Clarke. 1883 Register entry: 'DRESS. Blue satin with a narrow border of a red figured silk round the bottom. Embroidered in various coloured silks, and ornamented with pieces of looking glass. Worn by Mussulman women. Kattywar. 19th cent. L. 3 ft. 8 in.. W. 3 ft. 4 in. Bought, 12s. 2327-1883 (IS)'"@en .

