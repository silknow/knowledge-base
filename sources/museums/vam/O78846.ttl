<http://data.silknow.org/image/aa075ee9-e11f-3d1f-9055-5287d7ab5b4d>
        a                  ecrm:E38_Image ;
        dc:identifier      "2006AT2302" ;
        schema:contentUrl  <https://silknow.org/silknow/media/vam/O78846_2.jpg> , <http://media.vam.ac.uk/media/thira/collection_images/2006AT/2006AT2302.jpg> .

<http://data.silknow.org/object/15761458-ae5f-3ce8-928d-7d1e842c60b3/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nSimon Julins, a specialist damask weaver, commissioned the design for this silk. It has an exceptionally long pattern repeat of over one metre. Silk damasks, woven in a single colour, often had large-scale patterns. Their subtle outlines could be seen through the effect of light on the contrasting surfaces of the weave. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/15761458-ae5f-3ce8-928d-7d1e842c60b3> .

