<http://data.silknow.org/object/aaabe2c3-b0d6-3061-aee7-4d5b3f94d2ec>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dress fabric of brocaded silk.\n\nWoven silk, weft-faced plain weave ground.\nWarp: yellow silk, Z-twist; pink silk, Z-twist.\nWeft: silk, dark green, red, black, blue and yellow, all indeterminable twist; there could be some more colours.\nYellow ground with a black lattice decorated with red and black dots; the compartments contain a repeating pattern of a floral spray with two red and one blue flower and green leaves."@en , "Dress fabric of brocaded silk, Iran, 1800-1899"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f9ddcd24-5a0f-3deb-a09b-63888867014d> ;
        ecrm:P3_has_note               "Dress fabric of brocaded silk.\n\nWoven silk, weft-faced plain weave ground.\nWarp: yellow silk, Z-twist; pink silk, Z-twist.\nWeft: silk, dark green, red, black, blue and yellow, all indeterminable twist; there could be some more colours.\nYellow ground with a black lattice decorated with red and black dots; the compartments contain a repeating pattern of a floral spray with two red and one blue flower and green leaves."@en , "Dress fabric of brocaded silk, Iran, 1800-1899"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/aaabe2c3-b0d6-3061-aee7-4d5b3f94d2ec/dimension/2> , <http://data.silknow.org/object/aaabe2c3-b0d6-3061-aee7-4d5b3f94d2ec/dimension/1> ;
        dc:identifier                  "T.21:63-1955" ;
