<http://data.silknow.org/object/57eadadb-2fb4-3ca4-9c5b-3a55b79bce25>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Hart, Avril and Susan North, Historical Fashion in Detail: The 17th and 18th Centuries, London:  V&A Publications, 1998, p. 84"@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/25c0c6ab-7ffe-3f5c-97a6-fc25cc5456fc> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
