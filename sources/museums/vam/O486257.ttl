<http://data.silknow.org/object/cd36e5db-f672-30a1-bb76-dcdf03dfcd66>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Fragment, silk damask, 16th century, China"@en , "SILK DAMASK.\nSINO-PORTUGUESE;  16th century.\nProbably woven by Chinese or Japanese weavers at Macao under Portuguese influence. []"@en , "Damask or red and yellow silk, probably from a Euroepan design. Symmetrical pattern of scrolling floral stems, amid which are crowned double-headed eagles. The pattern is in two vertical bands, the ground of the one being red, and of the other yellow."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7a9f1219-0474-3c1e-b180-8d683e9ac4a3> , <http://data.silknow.org/image/89136f43-1f89-33f6-afd0-6f83e0fcd880> ;
        ecrm:P3_has_note               "SILK DAMASK.\nSINO-PORTUGUESE;  16th century.\nProbably woven by Chinese or Japanese weavers at Macao under Portuguese influence. []"@en , "Fragment, silk damask, 16th century, China"@en , "Damask or red and yellow silk, probably from a Euroepan design. Symmetrical pattern of scrolling floral stems, amid which are crowned double-headed eagles. The pattern is in two vertical bands, the ground of the one being red, and of the other yellow."@en ;
