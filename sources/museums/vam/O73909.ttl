<http://data.silknow.org/object/f2d7c0b5-2bcb-32b4-a0d7-7b19961a7b1d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "The six-legged settee features striking carved winged lions on either side, forming the legs and arm supports, with the tail curving up the back. The settee is slightly curved to fit perfectly in the curved aspe of the room. Guilloche ornament along the back and heavily fluted decoration to the seat rails add to the neoclassical style."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f2d7c0b5-2bcb-32b4-a0d7-7b19961a7b1d> .

