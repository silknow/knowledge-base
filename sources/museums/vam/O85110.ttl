<http://data.silknow.org/object/c4a7914f-1467-3b85-8257-3fee880c264b>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Victoria and Albert Museum, Textiles Department, <i>Brief Guide to the Turkish Woven Fabrics</i>, London: H.M.S.O., 1923, text p. 17, and pl. 1.\nVictoria and Albert Museum, Department of Textiles, <i>Brief Guide to the Turkish Woven Fabrics</i>, London: Board of Education, 1931, text p. 27, and pl. 13.\nVictoria and Albert Museum,  <i>Brief Guide to the Turkish Woven Fabrics</i>, London: H.M.S.O., 1950, text p. 22, and pl. 16.\n<i>The Arts of Islam</i>, catalogue of the exhibition held at Hayward Gallery, London, 8 April - 4 July, 1976, London: The Arts Council of Great Britain, 1976, p.84, no.25."@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/9f0a3d3c-d291-307c-9975-e6b119194f16> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Victoria and Albert Museum, Textiles Department, <i>Brief Guide to the Turkish Woven Fabrics</i>, London: H.M.S.O., 1923, text p. 17, and pl. 1.\nVictoria and Albert Museum, Department of Textiles, <i>Brief Guide to the Turkish Woven Fabrics</i>, London: Board of Education, 1931, text p. 27, and pl. 13.\nVictoria and Albert Museum,  <i>Brief Guide to the Turkish Woven Fabrics</i>, London: H.M.S.O., 1950, text p. 22, and pl. 16.\n<i>The Arts of Islam</i>, catalogue of the exhibition held at Hayward Gallery, London, 8 April - 4 July, 1976, London: The Arts Council of Great Britain, 1976, p.84, no.25."@en .

