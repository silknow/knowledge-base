<http://data.silknow.org/object/0f5af4f9-df1a-3e4c-87d7-386a3489a00c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Embroidered sleevebands such as this pair were ornamental haberdashery, made to be sewn onto the sleeves of Chinese womens' robes or dresses during the Qing Dynasty (1644-1911).  Commonly-used ornamentation vary from generic Chinese landscapes to scenes from Chinese tales, or motifs of birds and flowers."@en , "Sleeveband, gold and silver embroidery on white silk satin, China, Qing dynasty, possibly 1875-1881."@en , "Sleeveband of a woman's robe. Goldfish in pond, embroidered in gold and silver thread on white satin, couched work."@en , "SLEEVE BAND for Lady's Robe.\nGold and silver thread on satin:  couched work.\nCHINESE;  (Ch'ing dynasty);  late 19th century;  (Kuang Hsu).\nVuilleumier Collection. []"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/a38af429-0f5a-39e5-a0c8-c9996d0333dd> , <http://data.silknow.org/image/08ce3d78-e994-3f93-a45a-f4206f727415> , <http://data.silknow.org/image/a5d15f7d-7ffa-3bed-a023-4239e87e9fe5> , <http://data.silknow.org/image/df49f6ab-c574-38ed-92c9-aec001375c2b> ;
        ecrm:P3_has_note               "Embroidered sleevebands such as this pair were ornamental haberdashery, made to be sewn onto the sleeves of Chinese womens' robes or dresses during the Qing Dynasty (1644-1911).  Commonly-used ornamentation vary from generic Chinese landscapes to scenes from Chinese tales, or motifs of birds and flowers."@en , "Sleeveband of a woman's robe. Goldfish in pond, embroidered in gold and silver thread on white satin, couched work."@en , "Sleeveband, gold and silver embroidery on white silk satin, China, Qing dynasty, possibly 1875-1881."@en , "SLEEVE BAND for Lady's Robe.\nGold and silver thread on satin:  couched work.\nCHINESE;  (Ch'ing dynasty);  late 19th century;  (Kuang Hsu).\nVuilleumier Collection. []"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/0f5af4f9-df1a-3e4c-87d7-386a3489a00c/dimension/2> , <http://data.silknow.org/object/0f5af4f9-df1a-3e4c-87d7-386a3489a00c/dimension/1> ;
