<http://data.silknow.org/object/0c2fe44b-ce76-393b-a008-6b7519d96085/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Textile of brocaded silk. Decorated with sprays of flowers curving round decorative lattice motifs on a cream ground. Colours are pink, buff, tan, blue, yellow and green. The ground is tabby with additional floated wefts to form the ground colour pattern. The rest of the pattern is brocaded. There is one repeat in the width of the material."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0c2fe44b-ce76-393b-a008-6b7519d96085> .

