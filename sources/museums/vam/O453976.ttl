<http://data.silknow.org/object/36b5105e-f7a5-372b-a1df-8a49a613af80>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Man's belt ikat woven with a silk weft and cotton warp. The cotton warp is red and the silk weft is dyed white, blue or red. The central design is formed by repetitions of a roughly diamond-shaped compartment with a rosette at each angle and a 12-armed floral star in the middle. Down each side runs a band of stalactite-like ornament."@en , "Man's belt ikat woven with silk and cotton, Bali, Indonesia, 19th century."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0510572d-3cf3-3ad3-a5e8-9f86a6721ace> , <http://data.silknow.org/image/51129baa-d0f9-378e-a955-0e2a4eefe2ea> , <http://data.silknow.org/image/dba5453c-668c-3946-94eb-79c5b3c80d10> ;
        ecrm:P3_has_note               "Man's belt ikat woven with silk and cotton, Bali, Indonesia, 19th century."@en , "Man's belt ikat woven with a silk weft and cotton warp. The cotton warp is red and the silk weft is dyed white, blue or red. The central design is formed by repetitions of a roughly diamond-shaped compartment with a rosette at each angle and a 12-armed floral star in the middle. Down each side runs a band of stalactite-like ornament."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/36b5105e-f7a5-372b-a1df-8a49a613af80/dimension/1> , <http://data.silknow.org/object/36b5105e-f7a5-372b-a1df-8a49a613af80/dimension/2> ;
