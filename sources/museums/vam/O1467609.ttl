<http://data.silknow.org/event/d672e4b4-f991-3624-9100-66cab4af440c>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Actors credited on this programme were Lieutenant W.A.D. Anderson VRR, Dr. Bernard from HMS Electra, F.A. Fitzgerald, R.B.B. Bower, C.M. Harward, Mrs. Charles Poole, Captain Hotham,  A.G. Leeson, W.C. Carr, Mrs. Thom, Mrs. Brougham, and Miss Fanny Sinclair. The event was advertised in the Melbourne <i>Argos</i> on 25th and 29th September 1855."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/234ca1e5-40a5-34f0-8297-91eb56ca7ae2> ;
