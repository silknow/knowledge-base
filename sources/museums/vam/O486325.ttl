<http://data.silknow.org/object/6744138b-4e1d-3589-ba34-e3165df2032c/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Boy's cap with globular-shaped crown of white silk gauze, embroderied in coloured silks with peony and melons in knot stitches and couched gilt metal wrapped threads; a winged crest across the top of white silk damask, embellished on the central front with a circular <i>shou</i> (longevity) character, edged with silk braids. The cap is lined with red cotton and has a yellow silk ribbon at the back."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6744138b-4e1d-3589-ba34-e3165df2032c> .

