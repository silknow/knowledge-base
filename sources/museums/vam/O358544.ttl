        a                  ecrm:E38_Image ;
        dc:identifier      "2020MT7723" ;
        schema:contentUrl  <https://silknow.org/silknow/media/vam/O358544_1.jpg> , <http://media.vam.ac.uk/media/thira/collection_images/2020MT/2020MT7723.jpg> .

<http://data.silknow.org/object/35a7b4ae-0afc-3325-8241-5ebfb9983bc7>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dress of brocaded 1770s silk and bodices, England, ca. 1830"@en , "Dress of brocaded yellow 1770s silk and two tight fitting bodices. With floral motifs at intervals in green, red, pink, yellow, cream and black.\n\nThe dress has a low round neckline trimmed with lace and with long sleeves tightly fitting at the wrists and gathered at the shoulder. The back of the skirt has been pleated into the waistline but the front remains detached, there being a satin drawstring through the upper edge of the skirt, presumably to adjust to the waistline. \n\nThe front of the bodice is slightly gathered at the waistline. The bodice is lined with stout white cotton, and the hemline is piped with matching silk and padded with fine cream silk. Small shaped stomacher to match, slightly boned down the front and laced with a pink silk ribbon. The top is scooped out and trimmed with a fluted band of the same material as the dress. Lined with white cotton."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ecc7a845-8c0a-3e01-ae04-f6581f0fa268> , <http://data.silknow.org/image/40acea32-5c20-3a88-8d42-9fd5f864781e> , <http://data.silknow.org/image/2c0b0034-857e-3a3b-92d3-86615e8ae91e> , <http://data.silknow.org/image/eb9246e0-5ef2-30fe-aace-c259c60b123d> ;
        ecrm:P3_has_note               "Dress of brocaded yellow 1770s silk and two tight fitting bodices. With floral motifs at intervals in green, red, pink, yellow, cream and black.\n\nThe dress has a low round neckline trimmed with lace and with long sleeves tightly fitting at the wrists and gathered at the shoulder. The back of the skirt has been pleated into the waistline but the front remains detached, there being a satin drawstring through the upper edge of the skirt, presumably to adjust to the waistline. \n\nThe front of the bodice is slightly gathered at the waistline. The bodice is lined with stout white cotton, and the hemline is piped with matching silk and padded with fine cream silk. Small shaped stomacher to match, slightly boned down the front and laced with a pink silk ribbon. The top is scooped out and trimmed with a fluted band of the same material as the dress. Lined with white cotton."@en , "Dress of brocaded 1770s silk and bodices, England, ca. 1830"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/35a7b4ae-0afc-3325-8241-5ebfb9983bc7/dimension/1> ;
        dc:identifier                  "T.25 to B-1955" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O358544> .

