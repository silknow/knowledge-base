<http://data.silknow.org/object/41aadfa2-0aaa-39b7-8ea3-4070082537e1/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Orphreys were decorative bands applied to copes, dalmatics and chasubles--vestments worn by Christian clergy. They were often embroidered to show religious scenes, and were attached in cross shapes or in straight pillars. In this example the monograms I H S \n(<i>Iesus Hominum Salvator</i>, latin for 'Jesus Savior of Men') and AM (<i>Ave Maria</i>, latin for 'Hail Mary') are incorporated into the strapwork pattern."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/41aadfa2-0aaa-39b7-8ea3-4070082537e1> .

