<http://data.silknow.org/object/b9f89b8f-e13d-382f-b071-936d6bf3ee56/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Doll's petticoat of French or Italiansalmon pink silk satin with a floral pattern of purple, pale blue, emerald green, lime green, orange and deep pink. The petticoat is gathered at the waist and trimmed at the top with ivory taffeta, and at the bottom with Chinese blue silk damask. The petticoat is pleated from a narrow centre front panel to the back where it fastens."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b9f89b8f-e13d-382f-b071-936d6bf3ee56> .

