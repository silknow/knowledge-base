        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Hem and patch sampler of linen, turned and hemmed in fine back stitch. The lower hem, decorated with herringbone stitches in brown silk. In the deep upper hem, two buttonholes worked with brown silk. In the main panel, a large patch set in with sew and fell seams and initials worked in cross stitch."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/bc09b589-358e-3013-8991-c2513b93ddb0> .

