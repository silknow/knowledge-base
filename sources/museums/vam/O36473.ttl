<http://data.silknow.org/object/a0f4ec77-1d43-3cda-acd2-5a146d1de40f/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "In Japan small swords like this are called <i>wakizashi</i>.  The fittings of this example are in blue-and-white porcelain, and the scabbard is covered in basket work.  The handle, or <i>kozuka</i>, is made of copper and decorated with a spray of gourd."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a0f4ec77-1d43-3cda-acd2-5a146d1de40f> .

