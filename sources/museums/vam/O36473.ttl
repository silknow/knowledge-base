        ecrm:P3_has_note    "Small sword (<i>wakizashi</i>) with dagger blade, tightly woven bamboo-covered wooden scabbard and copper iroe handle <i>kozuka</i> for scabbard-knife"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a0f4ec77-1d43-3cda-acd2-5a146d1de40f> .

