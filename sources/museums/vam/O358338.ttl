<http://data.silknow.org/object/91a3b0ca-46af-3ba6-b4e3-483162645288>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Sampler of embroidered linen in silk and silver-gilt threads in satin, stem, overcast, back and double-running stitches and punched work. In the form of a cover with tassels at the corners. Wide borders have many panels with a variety of geometrical and floral patterns. In the centre is a rough shield bearing a cross upon a mountain. Around are tendril borders and inscription 'SOY DE DOÑA MA EDP ZIVTZ VAZ 9  Z AÑO. DC. 1775'."@en , "Sampler of embroidered linen in silk and silver-gilt threads, Spain, 1775"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7ae3b384-a646-3a78-84c0-d900544d8a68> , <http://data.silknow.org/image/5486589e-ff30-3841-994f-900fc444ec4d> , <http://data.silknow.org/image/29e1fb10-db00-31d6-aad9-13e54101ff3e> , <http://data.silknow.org/image/8d522289-c44e-34d3-ae46-bce0902bd284> ;
        ecrm:P3_has_note               "Sampler of embroidered linen in silk and silver-gilt threads, Spain, 1775"@en , "Sampler of embroidered linen in silk and silver-gilt threads in satin, stem, overcast, back and double-running stitches and punched work. In the form of a cover with tassels at the corners. Wide borders have many panels with a variety of geometrical and floral patterns. In the centre is a rough shield bearing a cross upon a mountain. Around are tendril borders and inscription 'SOY DE DOÑA MA EDP ZIVTZ VAZ 9  Z AÑO. DC. 1775'."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/91a3b0ca-46af-3ba6-b4e3-483162645288/dimension/2> , <http://data.silknow.org/object/91a3b0ca-46af-3ba6-b4e3-483162645288/dimension/1> ;
