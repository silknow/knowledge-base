        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Evening dress consisting of a bodice and skirt of brocaded silk satin, made by Worth, Paris, ca. 1895"@en ;
