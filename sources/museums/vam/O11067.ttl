<http://data.silknow.org/object/a5fad915-7e9b-3ca3-9dc3-81f4a95014c5>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Burmese silk acheik-luntaya multi-coloured pah-soe cloth; Konbaung Dynasty (1752-1885), ca. 1850."@en , "Double length continuously loomed in one piece. Difference in ground: 1 length forest green; 1 length blue grey. The same weft acheik (horizontal wave patterns) are used along the two lengths in colours of dark crimson, fawn, white dark and light green. To be cut and stitched together at the sides to form a pah-soe (man's wrap around skirt)."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/4cf8e29f-0a8e-38e4-b417-8bc9df39280a> ;
        ecrm:P3_has_note               "Burmese silk acheik-luntaya multi-coloured pah-soe cloth; Konbaung Dynasty (1752-1885), ca. 1850."@en , "Double length continuously loomed in one piece. Difference in ground: 1 length forest green; 1 length blue grey. The same weft acheik (horizontal wave patterns) are used along the two lengths in colours of dark crimson, fawn, white dark and light green. To be cut and stitched together at the sides to form a pah-soe (man's wrap around skirt)."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/a5fad915-7e9b-3ca3-9dc3-81f4a95014c5/dimension/1> , <http://data.silknow.org/object/a5fad915-7e9b-3ca3-9dc3-81f4a95014c5/dimension/2> ;
