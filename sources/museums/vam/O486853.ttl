<http://data.silknow.org/event/d3cf5202-4db0-34e3-9667-b69236101ca4>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This is the top portion of a dragon robe of the Ming type which was worn under the early Qing dynasty, but went out in the 18th century. But the central aperture for the head has not been cut, which indicates that this may never have been made up into a robe."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/867df60f-f196-3385-b7ea-114147058891> ;
        ecrm:P3_has_note               "This is the top portion of a dragon robe of the Ming type which was worn under the early Qing dynasty, but went out in the 18th century. But the central aperture for the head has not been cut, which indicates that this may never have been made up into a robe."@en .

