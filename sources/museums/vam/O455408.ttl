<http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Sari in four fragments, purple cotton with trellis design in white ikat, Madras, ca. 1881-1882; Textiles; Clothing; Women's Clothes"@en , "Sari in four fragments, cotton, dark purple woven with weft ikat flecks in a diamond pattern in the field, plain at one end. The principle end has a woven band of orange silk and smaller bands of dotted orange silk. The side borders are patterned with white cotton in a diamond pattern on blue, with guard strips in orange."@en , "The complete object would have been intended for use as a garment, clothing."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/809e7620-52d4-3e5b-9a4f-c14e901c3541> , <http://data.silknow.org/image/dfa6a481-3721-38b0-8a9b-ffe79eb5e8b3> , <http://data.silknow.org/image/89ca5b6f-96c0-30d6-b97e-35e1a6838baa> , <http://data.silknow.org/image/3375294b-de23-3612-9a84-b4714a686eee> , <http://data.silknow.org/image/5c5b4c07-6a77-32ed-a6d4-44b779ad612d> , <http://data.silknow.org/image/4bfebe5e-abfd-3f22-82de-aa63c266556d> , <http://data.silknow.org/image/02fdd5ab-5dd7-3874-b817-b243eaeb3e5f> , <http://data.silknow.org/image/13420168-373c-3a4c-9f3b-1fb448fbc104> , <http://data.silknow.org/image/c2b788e4-2cbf-3923-a8ed-47eaafef7d10> ;
        ecrm:P3_has_note               "Sari in four fragments, cotton, dark purple woven with weft ikat flecks in a diamond pattern in the field, plain at one end. The principle end has a woven band of orange silk and smaller bands of dotted orange silk. The side borders are patterned with white cotton in a diamond pattern on blue, with guard strips in orange."@en , "Sari in four fragments, purple cotton with trellis design in white ikat, Madras, ca. 1881-1882; Textiles; Clothing; Women's Clothes"@en , "The complete object would have been intended for use as a garment, clothing."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/6> , <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/5> , <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/4> , <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/3> , <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/2> , <http://data.silknow.org/object/e4d8f13a-e720-3573-bf68-648bad4ffa11/dimension/1> ;
