<http://data.silknow.org/object/a3078198-651f-3a8b-9aa3-a697d1262e90/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ruyi sceptre \nQing dynasty\n1740-1790\n\nThe word ruyi literally means 'as you wish'. Here several auspicious symbols - peaches, bats, Buddha's hand citrons, pomegranates and cicadas - convey the wish 'may you fulfil all the wishes'. \n\nCarved bamboo with silk tassel\n\nMuseum no. FE.21-1976 [2009]\nJU-I SCEPTRE\nBamboo root carved with auspicious fruits, animals and insects\nCHINESE; 18th century\nFE21-1976 [pre 2005]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a3078198-651f-3a8b-9aa3-a697d1262e90> .

