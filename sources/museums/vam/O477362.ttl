        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Wrapped garment of undyed muga silk, woven in a chequered design, with striped borders and embroidered with rows of leaves in undyed muga silk. There are foliate buta designs in the corner of the field, and the hems have large embroidered buta motifs containing flowers and leaves. Side borders embroidered with stylised flowers. With slightly scalloped edges. Complete piece."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/13972bd1-7a5e-343e-a995-812e15a559ef> .

