        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Linda Baumgarten, 'The Layered Look, Design in Eighteenth-Century Quilted Petticoats', Dress, vol.34, 2007, pp.7-30, p.9, fig.2"@en ;
