<http://data.silknow.org/object/6eb6217e-41fd-3b79-bcfd-2160b972edda/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6eb6217e-41fd-3b79-bcfd-2160b972edda> .

<http://data.silknow.org/object/6eb6217e-41fd-3b79-bcfd-2160b972edda>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Linen sampler by Sarah Blake, embroidered with silk; English; dated 1664."@en , "Embroidered sampler"@en , "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ede6b61c-f44b-38b4-a7d1-739f7cfad7c4> ;
        ecrm:P3_has_note               "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This is a type known as a band sampler. With the composition of band samplers comes the first clear indication in England of the form being used as a method of instruction and practice for girls learning needlework."@en , "Embroidered sampler"@en , "Linen sampler by Sarah Blake, embroidered with silk; English; dated 1664."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6eb6217e-41fd-3b79-bcfd-2160b972edda/dimension/1> , <http://data.silknow.org/object/6eb6217e-41fd-3b79-bcfd-2160b972edda/dimension/2> ;
