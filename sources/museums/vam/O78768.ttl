<http://data.silknow.org/object/84158476-42c4-3872-8e68-9641d3ede5ee/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nBRACES<br>\nBraces held up trousers giving a firm, smooth line to the shape of the leg. Brightly patterned braces came into fashion during the 1840s and 1850s. Women often embroidered them at home as gifts for close friends and relatives. Braces joined at the back appeared in the second half of the century. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/84158476-42c4-3872-8e68-9641d3ede5ee> .

