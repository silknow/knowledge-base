<http://data.silknow.org/object/7637ff47-2583-3814-a28d-e4840b0c8d38/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Handkerchief of plate-printed silk woven in plain cream-coloured silk and printed with a wide red border. In the centre in black is a scene showing the interior of Crystal Palace during the Great Exhibition. In the foreground is a fountain and behind it is a tree. On either side are the exhibition stands 'Persia' on the right and 'India' on the left. Members of the public are shown walking in the main hall and in the galleries above the stands."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7637ff47-2583-3814-a28d-e4840b0c8d38> .

<http://data.silknow.org/object/7637ff47-2583-3814-a28d-e4840b0c8d38>
        a                              ecrm:E22_Man-Made_Object ;
