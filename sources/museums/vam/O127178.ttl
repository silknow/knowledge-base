<http://data.silknow.org/event/6bcc7679-18fb-353c-b81d-cc975315431b>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This suit is reputed to have been made for the wedding of Sir Thomas Isham, which was scheduled for 9 August 1681. However, the bridegroom died of smallpox the day before the wedding."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/13e13e73-fd48-38e4-9bf4-4b25d12bed85> ;
