        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Day dress, woman's, plum silk satin with pleated crossover front and front fastening, British, about 1838-1840"@en , "Plum satin dress with long sleeves gathered just above the elbow and trimmed with silk braid.  The bodice has a pleated crossover front decorated with four bands of orange chain stitch.  The skirt is quite full and is pleated at the waist.  The bodice is lined with cotton and the skirt with glazed cotton.  It is fastened at the front."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/564a5561-73f7-31df-b6e4-a5162c74b04d> , <http://data.silknow.org/image/ef99cea3-9637-3072-aedf-365b0ea8b93b> ;
        ecrm:P3_has_note               "Day dress, woman's, plum silk satin with pleated crossover front and front fastening, British, about 1838-1840"@en , "Plum satin dress with long sleeves gathered just above the elbow and trimmed with silk braid.  The bodice has a pleated crossover front decorated with four bands of orange chain stitch.  The skirt is quite full and is pleated at the waist.  The bodice is lined with cotton and the skirt with glazed cotton.  It is fastened at the front."@en ;
