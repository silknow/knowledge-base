<http://data.silknow.org/production/fd850c72-303e-3769-ba20-ef69475c6894>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/5c73e996-db4f-3a5a-ae7e-65e69f10cf82> ;
        ecrm:P126_employed      "A piece of the same silk was with Cora Ginsburg LLC in 2010, and  was analysed by Milton Sonday. This is a summary of his analysis : 7 & 1 satin with  interruption of 4"@en , "warps in two shades of blue silk as well as gold metallic thread,  wefts alternate blue and yellow.The yellow weft comes to the surface in the  brocaded stripes to highlight them. Selvedge of red and white satin with very  narrow strip of plain weave at outermost edge with red warps and blue and yellow  wefts."@en ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1660_1669> ;
        ecrm:P8_took_place_on_or_within
                <https://sws.geonames.org/3017382/> .

