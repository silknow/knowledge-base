        rdfs:comment        "Illustrated in 'Ottoman Embroidery' by Marianne Ellis and Jennifer Wearden (V&A Publication, 2001); plate 131"@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/1d1b7bee-cb82-3371-9bcc-e730d03f1e4e> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Illustrated in 'Ottoman Embroidery' by Marianne Ellis and Jennifer Wearden (V&A Publication, 2001); plate 131"@en .

