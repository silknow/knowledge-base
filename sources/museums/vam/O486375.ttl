        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Hanging scroll of silk embroidered with coloured silk threads and seed pearls in satin, long and short and stem stitches with knots and couched work. \n\nAt the bottom of the scroll rocks, bamboo and narcissus are depicted, above,  a branch of prunus in blossom. \n\nThe scroll is mounted with ivory silk damask of floral pattern and has two wooden rollers for hanging."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/52c5dbd8-d62c-3b31-90cd-cd747585e1c4> .

