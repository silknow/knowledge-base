<http://data.silknow.org/image/2f1a94ff-a503-3036-a99e-f14ce99acdbe>
        a                  ecrm:E38_Image ;
        dc:identifier      "2019LK6946" ;
        schema:contentUrl  <https://silknow.org/silknow/media/vam/O126688_2.jpg> , <http://media.vam.ac.uk/media/thira/collection_images/2019LK/2019LK6946.jpg> .

<http://data.silknow.org/object/0f2efa9a-0d2d-3755-836e-937254d3098f/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The short sleeves of this kimono indicate that it was probably worn by a married woman.  The delicate design of flowers, birds and butterflies at the water's edge was created using a freehand method of drawing in paste on the fabric surface, a resist-dyeing technique known as <i>yuzen</i>.  Touches of red, gold and green embroidery provide added contrast against the blue ground."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0f2efa9a-0d2d-3755-836e-937254d3098f> .

