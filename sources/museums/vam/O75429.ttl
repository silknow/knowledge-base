        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Turquoise silk plush handbag with metal clasp and slide fastening and brackets for the padded handle.  Pouch-shaped and made from a single piece of fabric with gussets inserted in each side. The fastening is released by sliding the oval terminal sideways. Lined with beige leather and has an inner pocket which is machine-stitched."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7bac27fe-14a5-384a-b102-953f99b881c4> .

