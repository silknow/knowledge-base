<http://data.silknow.org/object/7bac27fe-14a5-384a-b102-953f99b881c4/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This handbag is made of silk plush, with a metal clasp and brackets for the padded handle.  It is made from a single piece of fabric, with gussets inserted in each side. The fastening is released by sliding it sideways. The bag belonged to the donor's mother, who was born in 1875 and apprenticed at the age of 14 to a Court Dressmaker."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7bac27fe-14a5-384a-b102-953f99b881c4> .

