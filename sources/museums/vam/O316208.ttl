        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Fire screen of embroidered canvas with coloured wools and white silk in tent stitch. Oblong panel with rounded corners. In the centre is a bunch of roses and other flowers worked in brown, pink, mauve, blue, white and black. The background is left plain with no embroidery. Lined first with a piece of cream-coloured velvet and then with a piece of cream-coloured glazed cotton."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/33d06596-aa20-3501-9260-0f428e362854> .

