        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Silk ribbon of salmon-pink ground with large, woven flowers in white, yellow and emerald green bound in fancy twill, with black outlines. The flowers have angular shapes, suggesting inspiration from woven shawls. The ribbon is jacquard woven and has a pink edging."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/fc3fd88e-111e-3fee-be99-01d6e68b7091> .

