        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Ribbon of chiné silk. With a white taffeta ground with narrow stripe of blue satin at the selvedges and a repeating pattern in chiné of a bunch of flowers 10.5 inches high. The flowers are in pink, orange, lilac and fawn and with green and fawn foliage. They are tied together with a bow of blue ribbon."@en ;
