<http://data.silknow.org/object/89580cd0-d1da-32bf-84ed-4060ce46f689>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Fragment of a wrapped garment, reversible. One side is magenta with squares of gold-wrapped thread  containing green spots; the reverse green with squares of gold-wrapped thread containing magenta spots; a deep end border and side borders of gold-wrapped and silver-wrapped thread, the end border also features alternate stripes of magenta, green and gold-wrapped and silver-wrapped thread."@en , "The complete object would have been intended for use as a garment, clothing."@en , "Textiles, fragment of a reversible silk garment, Varanasi, ca. 1867"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/cf5099d6-9c21-3a6c-8fd1-091a1119bcdd> , <http://data.silknow.org/image/335f48a0-b2ab-32fd-91d6-8959bba537c9> , <http://data.silknow.org/image/5fc1013f-88bf-3f49-ab0d-0505a2f9c8af> , <http://data.silknow.org/image/15867dc8-28d6-3432-943b-6c4899eca38a> ;
        ecrm:P3_has_note               "Textiles, fragment of a reversible silk garment, Varanasi, ca. 1867"@en , "Fragment of a wrapped garment, reversible. One side is magenta with squares of gold-wrapped thread  containing green spots; the reverse green with squares of gold-wrapped thread containing magenta spots; a deep end border and side borders of gold-wrapped and silver-wrapped thread, the end border also features alternate stripes of magenta, green and gold-wrapped and silver-wrapped thread."@en , "The complete object would have been intended for use as a garment, clothing."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/89580cd0-d1da-32bf-84ed-4060ce46f689/dimension/1> , <http://data.silknow.org/object/89580cd0-d1da-32bf-84ed-4060ce46f689/dimension/2> ;
