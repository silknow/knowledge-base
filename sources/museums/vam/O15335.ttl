<http://data.silknow.org/object/e91968c7-3a39-3a8d-8871-7dbf801ef909>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "An embroidered long cushion cover with a central shield surrounded by stylised flowers and vines."@en , "embroidered, 1604, English; Arms initials inscription James I, canvaswork"@en , "In England in the 17th century the majority of wooden chairs and stools were not upholstered, and in more prosperous homes, decorated cushions were widely used both for comfort and for the attractiveness of their appearance.\n\nThis cushion was embroidered for the Mayor of Hereford. The Latin inscription can be translated as 'The Mayor's cushion of the City of Hereford; 3rd day of July of the 2nd year of King James'. It shows the arms of the City of Hereford and the letters I.R., which stand for Jacobus Rex, Latin for King James."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/40ab7302-e8ad-316b-bf8f-43e201601957> , <http://data.silknow.org/image/d3e6f182-9eeb-3106-ae3c-82c744b06a9b> , <http://data.silknow.org/image/8d0749a9-688f-3fa3-8b6a-8de38388a91b> , <http://data.silknow.org/image/e7ccdf72-d6b6-320b-a3eb-1086512c8d45> , <http://data.silknow.org/image/0cbed243-10a4-3bfe-8bc3-dcf3f9aaad6b> ;
        ecrm:P3_has_note               "An embroidered long cushion cover with a central shield surrounded by stylised flowers and vines."@en , "embroidered, 1604, English; Arms initials inscription James I, canvaswork"@en , "In England in the 17th century the majority of wooden chairs and stools were not upholstered, and in more prosperous homes, decorated cushions were widely used both for comfort and for the attractiveness of their appearance.\n\nThis cushion was embroidered for the Mayor of Hereford. The Latin inscription can be translated as 'The Mayor's cushion of the City of Hereford; 3rd day of July of the 2nd year of King James'. It shows the arms of the City of Hereford and the letters I.R., which stand for Jacobus Rex, Latin for King James."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/e91968c7-3a39-3a8d-8871-7dbf801ef909/dimension/3> , <http://data.silknow.org/object/e91968c7-3a39-3a8d-8871-7dbf801ef909/dimension/2> , <http://data.silknow.org/object/e91968c7-3a39-3a8d-8871-7dbf801ef909/dimension/1> ;
