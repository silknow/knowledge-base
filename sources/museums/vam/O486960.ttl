<http://data.silknow.org/object/567a66cf-10df-3f8d-9a62-cd45c88a5357/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Purse of brocaded silk woven in coloured silks and gilt-paper thread. The front is embroidered with gilt-paper thread and coloured silks. The pattern on the brocade consists of conventional flowers and foliage. The pattern on the front consists of a gold-fish, near a basket, among waves, which is worked in blue and white silk. The purse is held by knotted red silk cords."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/567a66cf-10df-3f8d-9a62-cd45c88a5357> .

