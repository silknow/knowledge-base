<http://data.silknow.org/object/28b06b2f-d7ad-3a13-b84e-f65ec9132501>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk satin wedding dress with satin belt and tulle band."@en , "Peter Bayne, M.A., LL.D. (1830-10 February 1896) was a Scottish author and critic who was educated in Marischal College, Aberdeen. He studied theology and philoophy at Edinburgh, and wrote a number of books on Christianity and a historical novel called \"The Days Of Jezebel\". He edited the the \"Glasgow Commonwealth\", \"Edinburgh Witness\", and \"London Dial\", and was an associate editor of \"The Christian World\"."@en , "Satin wedding dress with belt and tulle band, made in Great Britain in early 1869 and worn in Hampstead in 15 June 1869."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d4df35f6-c283-3aeb-863f-820fddb89b6b> , <http://data.silknow.org/image/b29871f1-6166-383e-a0c0-e7b49e707433> ;
        ecrm:P3_has_note               "Silk satin wedding dress with satin belt and tulle band."@en , "Satin wedding dress with belt and tulle band, made in Great Britain in early 1869 and worn in Hampstead in 15 June 1869."@en , "Peter Bayne, M.A., LL.D. (1830-10 February 1896) was a Scottish author and critic who was educated in Marischal College, Aberdeen. He studied theology and philoophy at Edinburgh, and wrote a number of books on Christianity and a historical novel called \"The Days Of Jezebel\". He edited the the \"Glasgow Commonwealth\", \"Edinburgh Witness\", and \"London Dial\", and was an associate editor of \"The Christian World\"."@en ;
        dc:identifier                  "T.64 to B-1973" ;
