        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Furnishing border of brocaded silk satin. The centre of the border (5 inches wide) contains a meandering stem bearing life-size roses and lilac brocaded in pinks, blues, white and four shades of green. Satin ground. Borders woven with a design of fancy arcading containing leaf forms in black silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/705dd98d-21ef-39ad-a46a-2ab079554e2c> .

