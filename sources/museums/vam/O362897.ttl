<http://data.silknow.org/object/4be7e511-3a09-39ca-91ed-0da214af7439>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Heavy white twilled silk centre with borders applied so as to be worn as a triangular ‘turn-over' shawl. Borders on a white twilled silk ground, pattern in wools of deep red and dark blue with some blue-green, pale blue, cream and buff. The lower edge of the border is a continuous between each wave is a single 'shawl flower'. Above is a meander bearing bunches and sprays of marked off by an edging of red and white stripes. There is an applied plain white silk fringe on all four sides. Ground warp and weft are used to make a white outline round the flowers inside the 'waves'."@en , "Woven shawl, Scotland, 1820-1835"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b46eb285-3a01-3ed6-9a37-50152b6f94fd> , <http://data.silknow.org/image/2fd0a361-2b4a-3b21-ae0b-9a11b2e69e0e> , <http://data.silknow.org/image/80ef8704-1782-3f3c-9f05-7c720539e2ec> , <http://data.silknow.org/image/72caf12a-f1c0-3831-9242-d29cdf0bf228> ;
        ecrm:P3_has_note               "Woven shawl, Scotland, 1820-1835"@en , "Heavy white twilled silk centre with borders applied so as to be worn as a triangular ‘turn-over' shawl. Borders on a white twilled silk ground, pattern in wools of deep red and dark blue with some blue-green, pale blue, cream and buff. The lower edge of the border is a continuous between each wave is a single 'shawl flower'. Above is a meander bearing bunches and sprays of marked off by an edging of red and white stripes. There is an applied plain white silk fringe on all four sides. Ground warp and weft are used to make a white outline round the flowers inside the 'waves'."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4be7e511-3a09-39ca-91ed-0da214af7439/dimension/3> , <http://data.silknow.org/object/4be7e511-3a09-39ca-91ed-0da214af7439/dimension/1> , <http://data.silknow.org/object/4be7e511-3a09-39ca-91ed-0da214af7439/dimension/2> ;
        dc:identifier                  "T.17-1975" ;
