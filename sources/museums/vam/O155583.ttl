<http://data.silknow.org/object/5399c6ab-a61d-3b39-81b7-9b18e3759c34>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Bag, cotton embroidered with silk and metal thread in straight stitch, buttonhole, needleweaving and pulled thread work.\nDisplayed behind glass.\nThere is a border around 4 sides; it is needlewoven with dark blue silk X-motifs alternating with stepped diamonds worked in silver metal thread. There is a pink line above and below this.  The main area is worked in pulled thread using white silk, the pattern has large and small roundels linked vertically, horizontally and diagonally.  Unworked ground fabric can be seen along the bottom fold of the bag.  The sides have been stitched together.  There is a blue cord around the opening."@en , "embroidered, 1770-1850, Persian"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/26334546-5a7f-3537-8ef2-ffafd76c96b9> , <http://data.silknow.org/image/3c09d65a-5954-3343-888c-cd05b5aa19d0> ;
        ecrm:P3_has_note               "embroidered, 1770-1850, Persian"@en , "Bag, cotton embroidered with silk and metal thread in straight stitch, buttonhole, needleweaving and pulled thread work.\nDisplayed behind glass.\nThere is a border around 4 sides; it is needlewoven with dark blue silk X-motifs alternating with stepped diamonds worked in silver metal thread. There is a pink line above and below this.  The main area is worked in pulled thread using white silk, the pattern has large and small roundels linked vertically, horizontally and diagonally.  Unworked ground fabric can be seen along the bottom fold of the bag.  The sides have been stitched together.  There is a blue cord around the opening."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/5399c6ab-a61d-3b39-81b7-9b18e3759c34/dimension/1> , <http://data.silknow.org/object/5399c6ab-a61d-3b39-81b7-9b18e3759c34/dimension/2> ;
