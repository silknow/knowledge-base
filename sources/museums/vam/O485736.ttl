<http://data.silknow.org/object/9ea96cd5-879b-37a7-8eaf-912a5841cd37>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Woman's robe (<i>changyi</i>), tapesty weave silk (kesi), padded, China, Tongzhi period (1862-74), Qing dynasty"@en , "Woman's robe of bluish green tapestry weave silk (kesi), decorated with chrysanthemums in pinks, yellows, blues, greys, lilacs, with bright green leaves. Details of shading are painted.\n\nA crudely woven braid is applied near the overlapping edge, which is bound with a wide cord of dark blue kesi with flowers and butterflies in white and lighter blue and gold thread.\n\nThe robe is lined with bright pink silk, sewn at intervals through to the front."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/929758ab-4139-3593-b5da-8c57de3b5f94> , <http://data.silknow.org/image/476560f4-f539-36dd-a317-0da9fcaad293> , <http://data.silknow.org/image/507cf66f-b7d6-3ab1-9533-db7b8a40b192> , <http://data.silknow.org/image/8e66a023-d29d-3815-9592-5eecb0e8761a> ;
        ecrm:P3_has_note               "Woman's robe of bluish green tapestry weave silk (kesi), decorated with chrysanthemums in pinks, yellows, blues, greys, lilacs, with bright green leaves. Details of shading are painted.\n\nA crudely woven braid is applied near the overlapping edge, which is bound with a wide cord of dark blue kesi with flowers and butterflies in white and lighter blue and gold thread.\n\nThe robe is lined with bright pink silk, sewn at intervals through to the front."@en , "Woman's robe (<i>changyi</i>), tapesty weave silk (kesi), padded, China, Tongzhi period (1862-74), Qing dynasty"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/9ea96cd5-879b-37a7-8eaf-912a5841cd37/dimension/4> , <http://data.silknow.org/object/9ea96cd5-879b-37a7-8eaf-912a5841cd37/dimension/3> , <http://data.silknow.org/object/9ea96cd5-879b-37a7-8eaf-912a5841cd37/dimension/2> , <http://data.silknow.org/object/9ea96cd5-879b-37a7-8eaf-912a5841cd37/dimension/1> ;
