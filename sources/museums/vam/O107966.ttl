<http://data.silknow.org/event/a748a40a-7857-328c-8cb2-29626a59bfeb>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Given by the descendants of Hannah Downes and part of a collection of needlework executed by four generations of women.  The family tree identifies Hannah Haines, youngest daughter of Hannah Downes, as the maker of this pocket between 1718-1720.\n\nHistorical significance: An example of an early 18th century women's pocket, a separate garment worn tied around the waist under the petticoats.  The small size of this pocket and the short length of its opening suggest that it was made for a young girl."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/91d3f902-b24a-3b32-a537-3142dc10c46d> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by the descendants of Hannah Downes" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/69e2bc86-0d0a-3baa-a1cf-0b3c1b6054ca> ;
        ecrm:P3_has_note               "Given by the descendants of Hannah Downes and part of a collection of needlework executed by four generations of women.  The family tree identifies Hannah Haines, youngest daughter of Hannah Downes, as the maker of this pocket between 1718-1720.\n\nHistorical significance: An example of an early 18th century women's pocket, a separate garment worn tied around the waist under the petticoats.  The small size of this pocket and the short length of its opening suggest that it was made for a young girl."@en .

