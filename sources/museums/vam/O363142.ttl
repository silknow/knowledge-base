<http://data.silknow.org/object/11da7e39-ce48-3cad-8eab-7618cc1d3950>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Shawl, woven, ca. 1854, French; Duché a Duché, Brière & Cie"@en , "The shawl is woven in 3/1 twill in wool and on a wool and silk warp. The warp is dyed a dull maroon red except for the black centre and ends, which are in harsh bright red, black, golden yellow, peacock blue, white, dull pink and emerald green. There are green selvedges. The colours of the ends are those found in the body of the shawl, appearing slightly darker because of the red warp."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c53422bf-2205-3cec-9ee9-ce2c334d37bb> , <http://data.silknow.org/image/2f5b1622-226c-3708-b7f7-05449eaa39dc> ;
        ecrm:P3_has_note               "Shawl, woven, ca. 1854, French; Duché a Duché, Brière & Cie"@en , "The shawl is woven in 3/1 twill in wool and on a wool and silk warp. The warp is dyed a dull maroon red except for the black centre and ends, which are in harsh bright red, black, golden yellow, peacock blue, white, dull pink and emerald green. There are green selvedges. The colours of the ends are those found in the body of the shawl, appearing slightly darker because of the red warp."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/11da7e39-ce48-3cad-8eab-7618cc1d3950/dimension/1> , <http://data.silknow.org/object/11da7e39-ce48-3cad-8eab-7618cc1d3950/dimension/2> , <http://data.silknow.org/object/11da7e39-ce48-3cad-8eab-7618cc1d3950/dimension/3> , <http://data.silknow.org/object/11da7e39-ce48-3cad-8eab-7618cc1d3950/dimension/4> ;
