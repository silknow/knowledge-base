<http://data.silknow.org/object/07cdd085-2b6f-3cfd-b217-6df8d0030a48/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Woman's petticoat of white silk satin lined with glazed undyed wool and wadded with a layer of wool.  It is quilted in running stitch with white silk thread in a pattern of cornucopias with leaves, thistles, roses and strawberries around the hem, and two rows of swags and tassels above. The petticoat is made of 6 panels of silk, with pocket openings in the side seams.  The waist binding and ties have been removed."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/07cdd085-2b6f-3cfd-b217-6df8d0030a48> .

