<http://data.silknow.org/production/b6943f49-c525-31ef-98ec-65740ecf6fca>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/967ba621-545f-3377-bd8e-84a293be9ae6> ;
        ecrm:P126_employed      "Brocaded silk ribbon with silks.\nRibbon ground of gros de tour taffeta weave. The fringe is made of supplementary weft threads which run through the ribbon covering the ground. The fringe threads are untwisted and (originally) pleated. The brocaded flowers are of ten different colours. The design reflects eastern European folk motifs of field flowers."@en ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1850_1859> ;
        ecrm:P8_took_place_on_or_within
                <https://sws.geonames.org/6269131/> .

