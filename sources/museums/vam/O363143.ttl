        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Scarf of white figured silk gauze with scalloped edges bound by a narrow edging. Each scallop is filled by an elaborately shaded flower from the bunches, which form the border of the design. Inside is a continuous stem of large flowers with curling leaves and a clump of flowers of similar design at either end."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/93477e6e-262d-3624-bd35-1d9f62084246> .

