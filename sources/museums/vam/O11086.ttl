<http://data.silknow.org/production/ae0e6fcd-91bd-3b3b-9de5-d10a603e463c>
        a                       ecrm:E12_Production ;
        rdfs:comment            "This embroidery belongs to Group 3 as defined by Jennifer Wearden, 'Azerbaijan Embroideries: A Synthesis of Contrasts', <i>Hali</i> 59 (October 1991) pp. 102-111. Group 3 textiles are characterised by surface darning on the diagonal and date from the middle of the 18th century into the early part of the 19th century." ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/8e2cc59b-16b3-3837-9f87-3a6b0a40a966> ;
        ecrm:P126_employed      "Plainweave cotton embroidered with floss silk in surface darning on the diagonal and runing stitch, to create a twill effect"@en ;
        ecrm:P126_employed      <http://data.silknow.org/vocabulary/617> , <http://data.silknow.org/vocabulary/900> ;
        ecrm:P32_used_general_technique
                <http://data.silknow.org/vocabulary/87> ;
        ecrm:P3_has_note        "This embroidery belongs to Group 3 as defined by Jennifer Wearden, 'Azerbaijan Embroideries: A Synthesis of Contrasts', <i>Hali</i> 59 (October 1991) pp. 102-111. Group 3 textiles are characterised by surface darning on the diagonal and date from the middle of the 18th century into the early part of the 19th century." ;
