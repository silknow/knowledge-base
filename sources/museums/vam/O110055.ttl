<http://data.silknow.org/event/9a1e2dd1-68d7-37bf-808e-779b2612f8d9>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This chair once belonged to Charles Somers, 3rd Earl Somers, (1819 - 1883) of Eastnor Castle, Herefordshire. Somers was a great collector of Italian Art.\n\nThe chair was reupholstered, using crimson velvet with red and gold fringe, in 1977 by Heather Taylor (Gilbey). See her report with photos and samples in Red Upholstery box.\nFDC 17/07/2006"@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/7f7af71c-2583-3fb6-9d14-e24933b86f41> ;
        ecrm:P3_has_note               "This chair once belonged to Charles Somers, 3rd Earl Somers, (1819 - 1883) of Eastnor Castle, Herefordshire. Somers was a great collector of Italian Art.\n\nThe chair was reupholstered, using crimson velvet with red and gold fringe, in 1977 by Heather Taylor (Gilbey). See her report with photos and samples in Red Upholstery box.\nFDC 17/07/2006"@en .

