<http://data.silknow.org/object/3fc96e84-e452-3f51-8f76-a9ba2d57cc3b>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O231055" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/127a20ab-8049-3fa0-a7dd-28366f4bf722> , <http://data.silknow.org/object/cf1f7241-77b0-3202-a1a4-c30c57d506f6/domain/1> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/cf1f7241-77b0-3202-a1a4-c30c57d506f6/observation/1> , <http://data.silknow.org/image/19444ba0-d084-3831-80b0-f919d1a4dd53> , <http://data.silknow.org/object/cf1f7241-77b0-3202-a1a4-c30c57d506f6> , <http://data.silknow.org/image/7702333c-3df3-3453-b8ac-3dedb444d3d4> , <http://data.silknow.org/object/752daaf7-2313-3e83-a1a0-07f0580891db> , <http://data.silknow.org/production/1311db37-6684-3713-a1b4-25c243f663b5> ;
