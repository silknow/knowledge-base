<http://data.silknow.org/object/c993557d-6f20-3d29-b598-dd8efb36653d>
        a                       ecrm:E22_Man-Made_Object ;
        rdfs:comment            "Shawl of silk damask, England, ca. 1812-1815"@en , "Shawl of silk damask. Woven with a floral design in yellow on a white ground. There is a narrow border and a short fringe around the shawl, and the central field is filled by large floral motifs growing from the corners. The shawl is woven in damask with a white warp and a yellow weft. The design is woven in 4/1 twill on a satin of 5 ground."@en ;
        ecrm:P3_has_note        "Shawl of silk damask, England, ca. 1812-1815"@en , "Shawl of silk damask. Woven with a floral design in yellow on a white ground. There is a narrow border and a short fringe around the shawl, and the central field is filled by large floral motifs growing from the corners. The shawl is woven in damask with a white warp and a yellow weft. The design is woven in 4/1 twill on a satin of 5 ground."@en ;
        ecrm:P43_has_dimension  <http://data.silknow.org/object/c993557d-6f20-3d29-b598-dd8efb36653d/dimension/2> , <http://data.silknow.org/object/c993557d-6f20-3d29-b598-dd8efb36653d/dimension/1> ;
