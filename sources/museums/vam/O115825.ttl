<http://data.silknow.org/event/bbd40422-31eb-3b05-99b2-072d2e7ce5f2>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Edwin Izod was a British corset manufacturer whose factory was located in Hampshire in the late 19th century. According to the record of his baptism, Izod was born on 25th of December 1826 and baptised in the parish of St. Leonard's in Shoreditch in 1829. The 1881 Census recorded that Edwin Izod's business employed a workforce of 23 males and 337 females. According to the National Probate Calendar Izod died at Stanfield House, Southampton, in 1887.\nRF FILE 60/1259."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/8b205098-4107-3322-9bb3-76162103f16d> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Miss Benjamin" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/1c939aa2-05d4-31e7-8783-ec9cd2c0b2c3> ;
        ecrm:P3_has_note               "Edwin Izod was a British corset manufacturer whose factory was located in Hampshire in the late 19th century. According to the record of his baptism, Izod was born on 25th of December 1826 and baptised in the parish of St. Leonard's in Shoreditch in 1829. The 1881 Census recorded that Edwin Izod's business employed a workforce of 23 males and 337 females. According to the National Probate Calendar Izod died at Stanfield House, Southampton, in 1887.\nRF FILE 60/1259."@en .

<http://data.silknow.org/object/1c939aa2-05d4-31e7-8783-ec9cd2c0b2c3/domain/8>
