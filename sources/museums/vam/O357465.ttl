        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Flag bag of embroidered silk. Round-ended bag of dove-grey silk lined with fine cream silk. The draw-strip top is threaded with pale blue satin ribbons and the edges are decorated with blonde bobbin lace. The two sides of the bag are embroidered. On one side is a large spray of flowers, and on the other is a delicate wreath of flowers."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/6ff60e53-8edf-3843-bff6-e642e9bec6a5> .

