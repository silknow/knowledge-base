<http://data.silknow.org/object/b546ee9f-b0d7-39f3-b324-5eeda3bfd92c>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O152297" ;
        ecrm:P129_is_about  <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/7527c1b5-86e6-3046-9617-cdd80baf1b82> , <http://data.silknow.org/object/f6d36520-dbf7-3598-a285-7360c4ca0841> , <http://data.silknow.org/object/7527c1b5-86e6-3046-9617-cdd80baf1b82/observation/3> , <http://data.silknow.org/object/7527c1b5-86e6-3046-9617-cdd80baf1b82/observation/1> , <http://data.silknow.org/object/7527c1b5-86e6-3046-9617-cdd80baf1b82/observation/2> , <http://data.silknow.org/image/eabbbafb-52f0-3018-a05a-ae797e702611> , <http://data.silknow.org/production/70a52bc2-5bcd-30f0-b3c7-9ce9ef668cbf> , <http://data.silknow.org/event/6f273687-c319-3c3c-bdc4-04fdca0fc94d> ;
