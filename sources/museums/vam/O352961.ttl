<http://data.silknow.org/object/eb7b195c-6c21-38df-b2de-3afb78d28423/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Man's sock made of machine-knitted cream silk fashioned at the toe and ankle with seams at the back and on either side of the foot joined on the loom. The tops are turned down and knitted in.\n\nThe sock reach to just below the calf and are embroidered down the front with rose sprays in brown and white silk and up the back of the ankle with four rows of leaves divided by a spot pattern. Written in ink on the right side of the top is 'CH 5-39'."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/eb7b195c-6c21-38df-b2de-3afb78d28423> .

