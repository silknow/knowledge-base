<http://data.silknow.org/object/d6693667-e9ae-391c-a042-8e46380eb266>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects. In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. Eleanor Speed made this sampler in 1783-1784. She dated it carefully so that we know it took her a little under five months to complete. The Christian texts she has chosen include the Ten Commandments."@en , "Embroidered sampler"@en , "Linen sampler by Eleanor Speed, embroidered with silk; English; dated 1784."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9753c6c8-b629-3ec7-b0d0-f5aeaef78cdd> , <http://data.silknow.org/image/68b24840-8f5c-354d-bf23-dfc83d57b125> , <http://data.silknow.org/image/caa2d6a5-4159-32cf-81d7-7de3d770782b> , <http://data.silknow.org/image/8eae570f-b490-37c6-8c30-c1b32afb9a1c> , <http://data.silknow.org/image/fbe0ccd4-0e89-3798-be0d-046e37940e65> , <http://data.silknow.org/image/9e0794ad-7f90-3302-aec5-93a45187377c> ;
        ecrm:P3_has_note               "Linen sampler by Eleanor Speed, embroidered with silk; English; dated 1784."@en , "Embroidered sampler"@en , "The earliest samplers were reference works for embroiderers. They showed 'samples' of patterns and stitches and recorded how to achieve particular effects. In Europe in the 17th century samplers provided instruction and practice for girls learning needlework. Eleanor Speed made this sampler in 1783-1784. She dated it carefully so that we know it took her a little under five months to complete. The Christian texts she has chosen include the Ten Commandments."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/d6693667-e9ae-391c-a042-8e46380eb266/dimension/1> , <http://data.silknow.org/object/d6693667-e9ae-391c-a042-8e46380eb266/dimension/2> ;
