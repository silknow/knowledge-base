<http://data.silknow.org/event/e56bb216-9474-3999-978a-8d21c098eb02>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This is associated with the wedding of Elizabeth Wroughton Richards to the Reverend Andrew Nugee on 8th August 1854, but may be more likely to be connected to their son's wedding in 1887, when artifical flowers such as this were extremely popular for trimmings, wreaths and favours."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/224d8d70-0244-3f4f-b50a-5c415aa6d240> ;
