        ecrm:P129_is_about  <http://data.silknow.org/object/87b54720-4ad3-3200-9581-08a77b7f7d92> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Illustrated in 'Iranian Textiles' by Jennifer Wearden and Patricia L Baker, V&A Publishing, 2010, fig. 3 page 13.\np.64\nTim Stanley (ed.), with Mariam Rosser-Owen and Stephen Vernoit, <i>Palace and Mosque: Islamic Art from the Middle East</i>, London, V&A Publications, 2004"@en .

