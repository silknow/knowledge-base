        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Woven silk and metal thread twill brocaded with metal thread.\nDisplayed behind glass.\nWarp: Z-twisted pink silk\nWeft: gilt strip S-wound on orange silk core.\nBrocading weft: silver strip S-wound on dark blue silk core.\n1/5 twill.\nPink and gold ground with a lobed lozenge containing an inscription and date in silver thread, which has worn to reveal the blue core."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/72661c96-c7f4-33f2-9c84-639bab7cdf60> .

