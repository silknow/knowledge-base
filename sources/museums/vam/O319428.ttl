<http://data.silknow.org/object/d4d24a05-509c-3823-bbb0-878ece880669/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This silk textile has a design that was traditionally used for tomb covers. The religious inscriptions are worked in white and arranged in a zigzag pattern on a red ground. The denser text within each V-shape of the zigzag quotes the Muslim creed, or statement of belief. This states, 'There is no god but God. Muhammad is the messenger of God'. The inscriptions that make up the narrower bands vary."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d4d24a05-509c-3823-bbb0-878ece880669> .

