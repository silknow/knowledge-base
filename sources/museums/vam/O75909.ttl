<http://data.silknow.org/object/7dc6a13e-41c6-31fb-89c0-769145f4c4d1>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Pair of women's ankle length boots, side-laced with flat heel"@en , "This pair of  side-laced, ankle-length boots of watered silk has a flat heel and square toe. As skirts increased in width and shortened in length, attention became focused on the foot and ankle. Brightly coloured silk boots or shoes would complement the richness of the gown. Sometimes they were chosen to match the sash or silk ribbons worn with the hat."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/08f955c0-ea89-3ca5-b8ca-81d3cf004045> , <http://data.silknow.org/image/2d7dc065-0592-30b7-839b-8b0b8ff22db0> , <http://data.silknow.org/image/2966a93b-10f4-3c31-8494-7516a84ec20d> , <http://data.silknow.org/image/09676b82-e31e-3368-bccf-9da4d72e6cda> , <http://data.silknow.org/image/2c7891f7-d16f-3206-9d77-bc5b97be8e08> , <http://data.silknow.org/image/9a5832e6-123e-3d46-be7e-e1111ba8102b> ;
        ecrm:P3_has_note               "This pair of  side-laced, ankle-length boots of watered silk has a flat heel and square toe. As skirts increased in width and shortened in length, attention became focused on the foot and ankle. Brightly coloured silk boots or shoes would complement the richness of the gown. Sometimes they were chosen to match the sash or silk ribbons worn with the hat."@en , "Pair of women's ankle length boots, side-laced with flat heel"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/7dc6a13e-41c6-31fb-89c0-769145f4c4d1/dimension/3> , <http://data.silknow.org/object/7dc6a13e-41c6-31fb-89c0-769145f4c4d1/dimension/1> , <http://data.silknow.org/object/7dc6a13e-41c6-31fb-89c0-769145f4c4d1/dimension/2> ;
