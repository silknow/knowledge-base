<http://data.silknow.org/event/4bfd2940-e0f6-3c5b-bba0-2adae14c5373>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This skirt cloth was presented to the India Museum in 1855 by King Mongkut of Thailand (r. 1851-1868), Rama IV, who is best known outside Thailand as the King in the 1956 musical film <i>The King and I</i>, an adaptation of Margaret of Landon's novel, <i>Anna and the King of Siam</i>, inspired by the diaries of Anna Leonowens, a British governess in the Thai court during 1860s.\n\n[1880 slip book: Presented by the King of Siam. Received from Singapore in 1855.]"@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/0d9a1fff-994b-3b3f-a67a-0af09f5ed9bc> ;
        ecrm:P3_has_note               "This skirt cloth was presented to the India Museum in 1855 by King Mongkut of Thailand (r. 1851-1868), Rama IV, who is best known outside Thailand as the King in the 1956 musical film <i>The King and I</i>, an adaptation of Margaret of Landon's novel, <i>Anna and the King of Siam</i>, inspired by the diaries of Anna Leonowens, a British governess in the Thai court during 1860s.\n\n[1880 slip book: Presented by the King of Siam. Received from Singapore in 1855.]"@en .

