        ecrm:P108_has_produced  <http://data.silknow.org/object/a46a2cfd-e5f8-3566-93e7-3e8141088ea3> ;
        ecrm:P126_employed      "Needle lace worked in linen thread, and mounted on silk"@en , "silk (textile)"@en , "linen"@en ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1670_1695> ;
        ecrm:P8_took_place_on_or_within
                <https://sws.geonames.org/3164603/> .

