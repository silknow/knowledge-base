<http://data.silknow.org/object/a305ece2-2449-35e9-9f32-33a5fd0cf47e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Rectangular, with flat-topped pyramidal lid. At each side are three, and at each end two, archways with opaque white caryatids in the spandrels. Within the arches are various scenes, with figures in costumes of the period. The lid is divided into panels, inlaid with blue glass and gold and white rosettes. The interior is fitted with compartments and mirrors."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a305ece2-2449-35e9-9f32-33a5fd0cf47e> .

