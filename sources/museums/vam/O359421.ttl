<http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Small cylindrical muff of red silk, lined with heavy linen canvas and embroidered with silver thread, strip and purl in laid and couched-work. It is partially worked over parchment strips and partially over padding threads. There are some decorative fillings and tufts of looped strip. The cuff has pairs of cuffs attached at either end. They are edged with a narrow, scalloped bobbin lace bit of silver thread. The back and back cuffs are of bright rose pink taffeta lined with coarse linen canvas. The central cylinder is lined with printed linen."@en , "Muff of embroidered silk, England, 1700-1730."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/854ccd6d-5047-3112-ba1d-8b310426cfa4> , <http://data.silknow.org/image/3771d2c3-ce6c-36a7-8e6e-7e6dd570b0ed> , <http://data.silknow.org/image/186a27fe-63fa-38b2-b53c-a348db2712df> , <http://data.silknow.org/image/10bf6fe0-87f1-3dcf-91ee-6877d6ba5029> ;
        ecrm:P3_has_note               "Muff of embroidered silk, England, 1700-1730."@en , "Small cylindrical muff of red silk, lined with heavy linen canvas and embroidered with silver thread, strip and purl in laid and couched-work. It is partially worked over parchment strips and partially over padding threads. There are some decorative fillings and tufts of looped strip. The cuff has pairs of cuffs attached at either end. They are edged with a narrow, scalloped bobbin lace bit of silver thread. The back and back cuffs are of bright rose pink taffeta lined with coarse linen canvas. The central cylinder is lined with printed linen."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/4> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/3> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/7> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/1> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/5> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/8> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/2> , <http://data.silknow.org/object/70e70a17-ffba-3cd0-9557-be221a0e25be/dimension/6> ;
