<http://data.silknow.org/object/4ca76c60-7097-3a86-8b41-ac1afdbbe5cc>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Two halves of a man’s waistcoat made of cream ribbed silk, lined with linen and faced with dark green silk sarsenet.. It has a round neck and short skirts reaching to the top of the thigh. It is lined and backed with coarse, unbleached linen. Green silk ribbon, ⅞-inch (2.2 cm) wide, edged the neck, fronts, hem, pockets and outlines the pockets.  The waistcoat is tamboured with coloured silks in a floral pattern."@en , "Two halves of a man's waistcoat, 1775-1785, British; Cream ribbed silk, tamboured, green ribbon trim, left"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/afd178c8-ea7f-3af6-9466-01122421f5c8> , <http://data.silknow.org/image/d0139171-5d40-3808-9d9b-8a1211a2197a> , <http://data.silknow.org/image/4bd6e888-4158-36d2-8a7f-194656abbca6> , <http://data.silknow.org/image/fdaec7ea-34b7-33b3-b7e6-29126b66ea7f> , <http://data.silknow.org/image/10a113b2-828d-32ed-9feb-aaecfa0cc59a> , <http://data.silknow.org/image/2a354a54-6db8-3202-948d-579cd856a8bb> , <http://data.silknow.org/image/890d9f64-3f57-3667-85ea-52f0e350ba69> , <http://data.silknow.org/image/38ec4133-4313-3246-b1a6-51e8ea0eeeae> , <http://data.silknow.org/image/7b0acf7c-6924-3064-97cf-777553e79aae> , <http://data.silknow.org/image/101cf87b-6381-38b7-98a9-25402b85e485> , <http://data.silknow.org/image/763793f9-5c88-333b-aa20-1ac3042c874f> ;
        ecrm:P3_has_note               "Two halves of a man's waistcoat, 1775-1785, British; Cream ribbed silk, tamboured, green ribbon trim, left"@en , "Two halves of a man’s waistcoat made of cream ribbed silk, lined with linen and faced with dark green silk sarsenet.. It has a round neck and short skirts reaching to the top of the thigh. It is lined and backed with coarse, unbleached linen. Green silk ribbon, ⅞-inch (2.2 cm) wide, edged the neck, fronts, hem, pockets and outlines the pockets.  The waistcoat is tamboured with coloured silks in a floral pattern."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/4ca76c60-7097-3a86-8b41-ac1afdbbe5cc/dimension/4> , <http://data.silknow.org/object/4ca76c60-7097-3a86-8b41-ac1afdbbe5cc/dimension/1> , <http://data.silknow.org/object/4ca76c60-7097-3a86-8b41-ac1afdbbe5cc/dimension/3> , <http://data.silknow.org/object/4ca76c60-7097-3a86-8b41-ac1afdbbe5cc/dimension/2> ;
