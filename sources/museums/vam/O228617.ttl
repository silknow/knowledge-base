        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Description: Lacis, silk net darned with cotton.\nLong rectangular panel with an inner and outer border in which two lines of square blocks are offset.  The main border has stepped lozenges alternating with solid X-shaped motifs.  The central panel is filled with small flower heads worked in white cotton.  Each flowerhead has four petals."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/11cec281-92e8-3132-b2aa-dbb52ff5db54> .

