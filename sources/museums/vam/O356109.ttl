        ecrm:P138i_has_representation  <http://data.silknow.org/image/7c5e2c0a-c100-3a80-8159-ede78ce58994> , <http://data.silknow.org/image/48171282-afc7-3f2a-bf0a-7edff60f01da> , <http://data.silknow.org/image/d5d0f955-6ea4-3f92-9f1f-a91dea65396c> , <http://data.silknow.org/image/283e3c65-4774-3fb1-851b-614775f76dc0> , <http://data.silknow.org/image/7125f7a2-8e33-38c9-8b6f-82a9f92df3ee> , <http://data.silknow.org/image/52d98d87-4b37-3c0e-a028-79615209c3e6> , <http://data.silknow.org/image/4617e6fd-9e72-3ed6-a1a0-56ccc91cd55b> ;
