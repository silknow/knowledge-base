        ecrm:P129_is_about  <http://data.silknow.org/object/2c223987-9892-31d7-a991-6cb75fb39214/observation/1> , <http://data.silknow.org/object/2c223987-9892-31d7-a991-6cb75fb39214> , <http://data.silknow.org/event/4237b0ab-f952-37c8-b34b-87caef12adb2> , <http://data.silknow.org/production/58ae7553-6c89-3e33-9c6f-ee4b4dba0e71> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/2c223987-9892-31d7-a991-6cb75fb39214/domain/1> , <http://data.silknow.org/object/2c223987-9892-31d7-a991-6cb75fb39214/observation/2> , <http://data.silknow.org/image/db1c4338-a702-392e-b6a8-264a966bae16> ;
