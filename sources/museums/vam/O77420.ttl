<http://data.silknow.org/object/c213822f-2e6b-3db1-a60d-ec7ec794b4c2>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O77420" ;
        ecrm:P129_is_about  <http://data.silknow.org/production/a66d51b5-c5ee-3437-a996-1d8285fdf782> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3> , <http://data.silknow.org/event/8d85b630-daf3-3b6a-a861-03cb2eed471d> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3/observation/2> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3/observation/1> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3/observation/4> , <http://data.silknow.org/image/87bb3679-7636-3d0d-923b-c09b443502da> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3/observation/3> , <http://data.silknow.org/object/b65ee575-acf9-3ed9-85ae-6f4e393271f3/domain/1> ;
