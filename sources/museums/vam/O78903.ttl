<http://data.silknow.org/object/debb7048-8829-3877-ae96-17699fb626a0/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nAt the end of the century there was a wide range of overcoats to choose from. This style was ideal for smart city wear. It was cut like a normal frock coat with a waist seam and long skirts. The tight fit meant that it would not have been worn with a coat underneath. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/debb7048-8829-3877-ae96-17699fb626a0> .

<http://data.silknow.org/event/73658dbe-bc3b-3045-8533-155b96c0c04b>
        a                              ecrm:E8_Acquisition ;
