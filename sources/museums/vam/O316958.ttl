<http://data.silknow.org/object/f0816a31-c43e-32a0-9870-e88ab6a00694>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Stocking purse of knitted cream silk and coloured beads. The central part of the purse has blue flowers with pink centres and five green leaves on a white ground. A wreath of red and blue flowers are on either side. The shaped ends of the purse are worked in red beads with a tiny flower pattern in green and pink. At either end is a knob made of yellow beads. The slip opening is bordered by flowers and leaves worked in red, yellow and green."@en , "Stocking purse of knitted silk and coloured beads, England, 19th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/68b0b0b0-028c-39c4-b6b4-fe1882ea9b51> , <http://data.silknow.org/image/a695f58a-f77d-3d71-a76d-528140523066> , <http://data.silknow.org/image/fb68e528-ea6e-30dd-8498-5681ee59fd68> , <http://data.silknow.org/image/4083eff1-0736-3d23-b8d1-7af929bb7447> , <http://data.silknow.org/image/19d32e70-8651-3f67-8138-0d05245ad3c0> , <http://data.silknow.org/image/e7e36885-b015-3c78-a778-4f1be1173c52> , <http://data.silknow.org/image/4c1438ff-0bcf-325d-8abd-f5f16f1fc23c> ;
        ecrm:P3_has_note               "Stocking purse of knitted silk and coloured beads, England, 19th century"@en , "Stocking purse of knitted cream silk and coloured beads. The central part of the purse has blue flowers with pink centres and five green leaves on a white ground. A wreath of red and blue flowers are on either side. The shaped ends of the purse are worked in red beads with a tiny flower pattern in green and pink. At either end is a knob made of yellow beads. The slip opening is bordered by flowers and leaves worked in red, yellow and green."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f0816a31-c43e-32a0-9870-e88ab6a00694/dimension/1> , <http://data.silknow.org/object/f0816a31-c43e-32a0-9870-e88ab6a00694/dimension/2> ;
