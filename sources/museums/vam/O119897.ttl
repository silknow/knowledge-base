        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Gift cover (fukusa) of tapestry woven silk depicting cranes. Silk with a navy blue ground on which are four cranes woven with grey, white and blue feathers, and picked out with gold thread. There is a plain strip of white at the top and bottom of the panel. Sewn to one corner is a paper tab with an inscription in Japanese."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/55c5be5b-7c2e-367f-8cac-0a81937d0172> .

