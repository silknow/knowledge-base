<http://data.silknow.org/event/452903f3-1f37-37d9-9b65-22f759f58f64>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This textile was part of a gift, presented to the museum by Dudley B. Meyers. \n\nSimilar to 678-1896, with variations.\n\nNeg. 77774\n\nSee also Enera Collection d'Anciennes Etoffes, No. 103. On two sides there is a fringe of blue and brown linen and silver-gilt thread."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/a6b03dbe-4e2c-39ff-8ab8-9e41d4a1581a> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by Dudley B. Myers, esq." ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/55b5d2e4-ad8f-30aa-9530-7d3ab89c599c> ;
        ecrm:P3_has_note               "This textile was part of a gift, presented to the museum by Dudley B. Meyers. \n\nSimilar to 678-1896, with variations.\n\nNeg. 77774\n\nSee also Enera Collection d'Anciennes Etoffes, No. 103. On two sides there is a fringe of blue and brown linen and silver-gilt thread."@en .

