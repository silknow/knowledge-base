        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Satin textile. Woven in red, yellow and white on a green ground. The pattern consists of a floral stem, from the base of which spring two long leaves curving upwards and meeting at the top; the compartment thus formed encloses two rampant lions."@en ;
