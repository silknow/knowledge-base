<http://data.silknow.org/object/55bc04e2-0489-3b4a-8d39-47684ee11e13>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Mourning dress, woman's, black silk satin trimmed with braid and ruched trim, British, 1845-1850"@en , "Lustreless black silk satin dress trimmed down the front of the skirt with ruching and black braid.  Bodice lined with cotton.  The bodice ends in a long point at the front and is fastened at the back with hooks and eyes.  It is supported with fan-shaped boning.  The skirt is trimmed at the hem with woollen braid and gathered at the waist with cartridge pleats."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/ab8aea2e-86b9-3b99-ae7b-a3f3ed0e23ce> ;
        ecrm:P3_has_note               "Mourning dress, woman's, black silk satin trimmed with braid and ruched trim, British, 1845-1850"@en , "Lustreless black silk satin dress trimmed down the front of the skirt with ruching and black braid.  Bodice lined with cotton.  The bodice ends in a long point at the front and is fastened at the back with hooks and eyes.  It is supported with fan-shaped boning.  The skirt is trimmed at the hem with woollen braid and gathered at the waist with cartridge pleats."@en ;
