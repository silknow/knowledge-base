<http://data.silknow.org/object/e4882b4a-3fd4-394b-8c06-57c6fb750e74/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Under Medea's approving gaze, a triumphant Jason cuts down the golden fleece, one foot resting on the sleeping dragon, which is under Medea's spell. Behind Medea are the masts of the Argonauts' waiting ship, preparing for the return journey to Greece."@en ;
