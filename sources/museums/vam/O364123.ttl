        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Apron of cream-coloured silk, embroidered with coloured silks. Parts of the pattern are outlined with green silk cord. In the middle and at each corner is a plant with slender scrolling stems bearing flowers and ornamental leaves. Along three sides is a wavy stem; the edge is scalloped."@en ;
