<http://data.silknow.org/object/447f96d3-44fa-32b3-91cc-f50513f458d6>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Silk brocade textile, Varanasi, 19th Century."@en , "Brocade is a rich silk fabric with patterns in gold and silver thread.  This piece has a conventional floral design in gold, silver and coloured silks on a twilled gold ground."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f2db63aa-926f-3681-898e-010316ccb43f> ;
        ecrm:P3_has_note               "Silk brocade textile, Varanasi, 19th Century."@en , "Brocade is a rich silk fabric with patterns in gold and silver thread.  This piece has a conventional floral design in gold, silver and coloured silks on a twilled gold ground."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/447f96d3-44fa-32b3-91cc-f50513f458d6/dimension/2> , <http://data.silknow.org/object/447f96d3-44fa-32b3-91cc-f50513f458d6/dimension/1> ;
