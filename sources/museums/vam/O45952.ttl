<http://data.silknow.org/production/51a9458e-f12c-3b9d-93da-21e31b6ae651>
        a                       ecrm:E12_Production ;
        rdfs:comment            "1975 Note: From Chichicastenango. L M O'Neale's Textiles of Highland Guatemala (Carnegie Institute of Washington, 1945) illustrates several 'old style' tzutes from this village.  See figs. 108a-d.  This one is especially similar to 108b." ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/58530617-87f5-31f2-b7e8-7922830c0283> ;
        ecrm:P126_employed      "cotton (textile)"@en , "cotton thread"@en , "Warp-faced plain weave cotton, brocaded with cotton and floss silk"@en , "floss silk"@en , "red dyed cotton"@en ;
        ecrm:P32_used_general_technique
                <http://data.silknow.org/vocabulary/192> ;
        ecrm:P3_has_note        "1975 Note: From Chichicastenango. L M O'Neale's Textiles of Highland Guatemala (Carnegie Institute of Washington, 1945) illustrates several 'old style' tzutes from this village.  See figs. 108a-d.  This one is especially similar to 108b." ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1875_1890> ;
