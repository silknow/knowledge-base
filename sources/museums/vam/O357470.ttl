        ecrm:P129_is_about  <http://data.silknow.org/image/4a6f2c46-5741-3c3f-a7af-ce183d62b349> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/domain/3> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/domain/4> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/domain/2> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/domain/5> , <http://data.silknow.org/event/1573ac1d-fa87-343f-92f1-3c0970765d29> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/observation/2> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/domain/1> , <http://data.silknow.org/production/c1f566e4-9c9f-351d-8c00-5d002dfc7b09> , <http://data.silknow.org/object/ab6c2833-2d5b-3cf3-8ef4-eaebe481b1b0/observation/1> ;
