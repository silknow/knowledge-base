<http://data.silknow.org/object/cbed557f-5886-301d-9ae5-25231642b2d6/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of gloves of white leather with gauntlet tapestry woven in silk and gold on woollen warps. 33 warp threads per in (13 per cm). With a pattern of trees, floral sprigs, strawberries with peacocks, parrots, owl and other birds. Trimmed with metal bobbin lace, vandyked and with spangles."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cbed557f-5886-301d-9ae5-25231642b2d6> .

