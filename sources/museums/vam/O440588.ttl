        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Fragments of a sari, dark pink silk brocaded with gold-wrapped and silver-wrapped thread in floral squares, containing stylised flower heads with coloured silk centres. The ends have a deep band of gold-wrapped thread with bands of scrolling plants in gold-wrapped thread on a red ground, the side borders have bands of silver-wrapped and gold-wrapped thread in a lattice pattern."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d340264b-2bc5-3351-a1f7-5a1f1d83d4a8> .

