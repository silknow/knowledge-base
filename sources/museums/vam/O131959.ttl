<http://data.silknow.org/object/9ba620dc-ea3d-3859-a69e-b09197b71380>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Ajmar-Wollheim, Marta and Flora Dennis, <i>At Home in Renaissance Italy</i>, London: V&A Publishing, 2006."@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/651e351e-59b6-30f0-8e44-0af0ae0e981a> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
