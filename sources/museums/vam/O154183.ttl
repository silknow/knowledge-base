        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Dress fabric of woven silk and metal thread.\n\nWarp: pink silk,\nWeft: white, dark blue, green, beige, red silk.\nMetal thread: silver strip open S-wound on yellow silk.\nThree pieces joined together. metal thread ground with an elongated and flattened complex 4-petalled rosette delineated in dark blue and white, containing simple flower heads in red or pink with touches of green. Selvedge is 2 cotton threads."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ed3bf0da-3f8c-323c-b9b8-ec439466b49e> .

