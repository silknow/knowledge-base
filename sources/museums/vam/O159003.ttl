<http://data.silknow.org/object/11821026-ba61-32db-9a2e-399e23559cb8/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A kidskin right glove decorated at cuff with couched silver-gilt thread and silver purl in a stylized floral patter.  The glove is lined with pink silk.  The cuff is edged with pink silk ribbon and silver fringe."@en ;
