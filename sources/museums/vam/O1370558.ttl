<http://data.silknow.org/event/0f685e71-5833-3443-ae98-4406eed427f9>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "This silk programme was produced for the Royal Command performance of <i>The Mikado</i> at Balmoral Castle on 4th September 1891. The D'Oyly Carte Opera Company, transferred from Her Majesty's Theatre, Aberdeen, was managed Mr. E. H. Beresford, stage managed by Mr. J. C. Scanlan and conducted by P. W. Halton. The cast was led by Mr. Thomas Redmond as the Mikado and Mr. Richard Clarke as Nanki-Poo.\n\nThe programme was given to the British Theatre Museum Association by Mr E.H. Priest in November 1967."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/26584080-ad41-3051-93d6-c84e1614c05f> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by the British Theatre Museum Association" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/37986a93-db96-322f-9cd6-517422f8420d> ;
        ecrm:P3_has_note               "This silk programme was produced for the Royal Command performance of <i>The Mikado</i> at Balmoral Castle on 4th September 1891. The D'Oyly Carte Opera Company, transferred from Her Majesty's Theatre, Aberdeen, was managed Mr. E. H. Beresford, stage managed by Mr. J. C. Scanlan and conducted by P. W. Halton. The cast was led by Mr. Thomas Redmond as the Mikado and Mr. Richard Clarke as Nanki-Poo.\n\nThe programme was given to the British Theatre Museum Association by Mr E.H. Priest in November 1967."@en .

