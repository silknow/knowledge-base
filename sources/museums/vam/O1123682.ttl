<http://data.silknow.org/object/9f3f2515-a238-3920-8bab-c81f020f0c13/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Girl's dress and cape of white silk, trimmed with laid and couched silk braid.\n\nThe dress is lined with white cotton which fastens at the back with brass hooks and eyes with a tape through the back waist. \n\nThe cape is silk, lined and edged with fringe. It fastens at the neck with a brass hook eye."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9f3f2515-a238-3920-8bab-c81f020f0c13> .

