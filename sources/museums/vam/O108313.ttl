<http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3>
        a                          ecrm:E78_Collection ;
        rdfs:label                 "Textiles and Fashion Collection" ;
        ecrm:P106_is_composed_of   <http://data.silknow.org/object/8f228e87-8b87-3619-88ae-3339ec8f6433> ;
