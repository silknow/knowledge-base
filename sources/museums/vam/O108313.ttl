<http://data.silknow.org/object/8f228e87-8b87-3619-88ae-3339ec8f6433/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "This decorative pincushion was knitted on fine steel needles. It is made from cream silk and silver gilt thread in patterned stocking stitch. The initials 'EW' appear on one side, with the date '1733' on the other. The formal and symmetrical decoration includes flower and bird motifs.  \n\nThe pincushion was knitted in two pieces. The person who made it then sewed the pieces together and covered the seams with braid."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8f228e87-8b87-3619-88ae-3339ec8f6433> .

