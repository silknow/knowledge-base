<http://data.silknow.org/event/874060eb-14f1-32bd-8c1c-2faa5024f339>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Purchased from a sale at Christies on 14 July 1992 from a Collection of Costume, Property of a Gentleman, cat. 2, p. 4. Registered File number 1992/1253. Original description of coat and waistcoat attributed the former to the Netherlands and the latter to France. There is no documentation to corroborate this split provenance, nor any internal evidence within the objects themselves."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/3ed39219-d13a-3bfa-8c8a-1fd47159511e> ;
        ecrm:P3_has_note               "Purchased from a sale at Christies on 14 July 1992 from a Collection of Costume, Property of a Gentleman, cat. 2, p. 4. Registered File number 1992/1253. Original description of coat and waistcoat attributed the former to the Netherlands and the latter to France. There is no documentation to corroborate this split provenance, nor any internal evidence within the objects themselves."@en .

<http://data.silknow.org/object/3ed39219-d13a-3bfa-8c8a-1fd47159511e/observation/1>
