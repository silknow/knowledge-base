<http://data.silknow.org/object/c0f5a45a-49b4-35e5-ba40-080bd68d1999/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Children from samurai families would wear garments similar in patterning to those of adults. The scene on this girl's garment relates to a chapter in the celebrated 11th-century Tale of Genji.\n [29/02/2020]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/c0f5a45a-49b4-35e5-ba40-080bd68d1999> .

<http://data.silknow.org/object/c0f5a45a-49b4-35e5-ba40-080bd68d1999>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Children from samurai families would wear garments similar in patterning to those of adults. The scene on this girl's garment relates to a chapter in the celebrated 11th-century Tale of Genji.\n [29/02/2020]"@en , "Kimono for a girl, plain weave silk with freehand paste-resist dyed (<i>yūzen</i>), Kyoto, 1800-50"@en , "Kimono for a girl of the samurai class to be worn on very formal occasions. The garment is decorated overall with a detailed landscape scene of flowers, flowing water and detail of a palatial veranda. This has been executed using a freehand paste-resist technique (<i><i>yūzen)</i></i>, with the background being dyed a deep blue. Some of the undyed areas have been left without further embellishment to create a particular design effect known as shiroage, or 'finishing off in white'"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9de344e4-6961-31fc-b1a9-a63649a99344> , <http://data.silknow.org/image/c7fa60bb-a401-324e-8e26-6605389fcf99> , <http://data.silknow.org/image/ff08b29f-742b-30a2-b6aa-9384b815bda0> , <http://data.silknow.org/image/8840c08d-8939-3d8f-83d6-8b57e544a1c0> ;
        ecrm:P3_has_note               "Children from samurai families would wear garments similar in patterning to those of adults. The scene on this girl's garment relates to a chapter in the celebrated 11th-century Tale of Genji.\n [29/02/2020]"@en , "Kimono for a girl, plain weave silk with freehand paste-resist dyed (<i>yūzen</i>), Kyoto, 1800-50"@en , "Kimono for a girl of the samurai class to be worn on very formal occasions. The garment is decorated overall with a detailed landscape scene of flowers, flowing water and detail of a palatial veranda. This has been executed using a freehand paste-resist technique (<i><i>yūzen)</i></i>, with the background being dyed a deep blue. Some of the undyed areas have been left without further embellishment to create a particular design effect known as shiroage, or 'finishing off in white'"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/c0f5a45a-49b4-35e5-ba40-080bd68d1999/dimension/1> , <http://data.silknow.org/object/c0f5a45a-49b4-35e5-ba40-080bd68d1999/dimension/2> ;
        dc:identifier                  "FE.191-2018" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O1428070> .

