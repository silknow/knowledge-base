<http://data.silknow.org/object/b0cff0e5-a66f-354d-bfb5-4bcb394f12b6/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A piece made up of four and a half  repeats of various weft acheik (horizontal wave) patterns with checkered end borders in a subtle variation of tones including deep pink, gold colour, two shades of green, maroon and white.\n\nThis length would have formed half a pah-soe."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b0cff0e5-a66f-354d-bfb5-4bcb394f12b6> .

