<http://data.silknow.org/object/d5a0d3f0-5d18-3cfd-a9a6-83a4ba13fe4e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Towel or napkin of linen with silk stripes and silk weft embroidered with silk in double running stitch variations, combinations, mushabak and with metal thread in half cross stitch. There is a narrow enclosed border along both ends in which a fine horizontal line runs through the middle of alternating yellow and red circular blossoms, in between which are two pairs of green leaves. The main border contains four repeated motifs - a bowl from which grows a tree with three large vine-shaped leafs and these alternate red and brown outlined in a darker colour."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d5a0d3f0-5d18-3cfd-a9a6-83a4ba13fe4e> .

