<http://data.silknow.org/object/f3d54a9d-4149-3e2e-b1fe-0d952636d091/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Short, white, drawn in at the waist and flaring over the hips, with long tight sleeves; it is open in front, and the bands down either side terminate in triangular-headed pendants. The pattern mainly consists of rows of wavy bands interspersed with conventional floral and foliate devices."@en ;
