<http://data.silknow.org/object/39824b8e-219f-3c56-8142-8742c61db41c/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "<i>Obi </i>of yellow cut silk velvet with designs embroidered on both sides in shades of green, orange, purple and gold metallic thread. The flowers depicted are peonies, paulownia and wisteria and within each floral grouping there is a lozenge and ox-cart wheel motif."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/39824b8e-219f-3c56-8142-8742c61db41c> .

