<http://data.silknow.org/object/22b836bf-4a29-33b8-8a2f-af9c438980c1/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nThis casket may have held medicines and perfumes in small containers. Carved English alabaster had long been associated with high status. It was smooth and fine-grained and had been used for luxury objects of all sizes since Medieval times. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/22b836bf-4a29-33b8-8a2f-af9c438980c1> .

<http://data.silknow.org/collection/78c6b75d-315c-3134-82a9-482f79d64517>
        a                          ecrm:E78_Collection ;
        rdfs:label                 "Metalwork Collection" ;
        ecrm:P106_is_composed_of   <http://data.silknow.org/object/22b836bf-4a29-33b8-8a2f-af9c438980c1> ;
