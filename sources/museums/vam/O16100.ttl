<http://data.silknow.org/vam>
        ecrm:P106_is_composed_of  <http://data.silknow.org/object/eea4da51-4788-3f1c-8776-f0ef5adb3945> .

<http://data.silknow.org/object/2b03a268-fb71-3be2-9c36-32c456462302/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Daoist priests were very important people, and the sumptuousness of their costumes reflects this.  This garment is lavishly embroidered with nearly 350 Daoist figures of immortals and higher gods.\n\nThe design consists of a large central panel of terracotta coloured satin embroidered with the Daoist heaven in coloured silks and gold thread. \nThe panel is framed in a wide border of yellow satin, embroidered with Daoist sages among clouds in coloured silks and gold thread."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/2b03a268-fb71-3be2-9c36-32c456462302> .

