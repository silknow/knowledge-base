<http://data.silknow.org/production/b7f04222-38d4-3989-b942-c0e2bc869904>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/9e920de9-dd28-30af-8ec7-934ec864d32d> ;
        ecrm:P126_employed      "Light, monochrome (brown) silk taffeta is decorated after weaving by woodblock printing. The printing matter has a characteristic, silvery glow, hence the term \"silvered\", that appears in the old records of the textile."@en ;
