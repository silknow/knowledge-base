<http://data.silknow.org/object/77e70b30-7e40-3ffa-b287-9c64cf16d295>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Illustrated in Bags by Claire Wilcox, V&A Publications, 1999"@en ;
        ecrm:P129_is_about  <http://data.silknow.org/object/95a415e9-e6ee-3eac-899f-8f7f06911005> ;
