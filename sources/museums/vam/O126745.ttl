<http://data.silknow.org/object/506f3bba-fa54-3e07-bab4-74e261118286/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The fabric used to make this kimono is of a kind known as rinzu, a monochrome patterned silk the weaving technique for which was introduced to Japan from China in the16th century.  Like most rinzu it is woven with a small key-fret and flower pattern known as sayagata. The flower and hexagon pattern was created using stencils and embroidery."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/506f3bba-fa54-3e07-bab4-74e261118286> .

