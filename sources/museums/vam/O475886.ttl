<http://data.silknow.org/event/b9bde128-7d88-3db3-a338-f7e806939129>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Exhibited with the silver bird cage for which it was designed at the London International Exhibition of 1872. Acquired by the Indian Museum in October 1877; transferred from the India Museum to South Kensington in 1879. Original owner the Raja of Nabha. \n\nIndia Museum slip book entry 2474: 'Toy Bird in Silver Cage / Exh. 1872 / Rajah of Nabha / Oct.1877 / Original nos. 3133.771 / A bell shaped cover for the cage made of gold & silver Kincob accompanied the article'."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/dbaf23f1-4fbc-3182-ab19-970b6f3f9bbc> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Presented by the Raja of Nabha, October 1877." ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/5eacf332-ba62-35f0-89d8-feb406edac0b> ;
        ecrm:P3_has_note               "Exhibited with the silver bird cage for which it was designed at the London International Exhibition of 1872. Acquired by the Indian Museum in October 1877; transferred from the India Museum to South Kensington in 1879. Original owner the Raja of Nabha. \n\nIndia Museum slip book entry 2474: 'Toy Bird in Silver Cage / Exh. 1872 / Rajah of Nabha / Oct.1877 / Original nos. 3133.771 / A bell shaped cover for the cage made of gold & silver Kincob accompanied the article'."@en .

