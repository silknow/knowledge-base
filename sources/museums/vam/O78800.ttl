<http://data.silknow.org/object/28931c2e-ee63-3bb0-882f-ccbd4dc53bbc/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Purse of brown glass beads on a ground of netted silk. With a diamond diaper pattern in blue and white beads with clusters of green and blue beads at the intersections. In each diamond a letter 'S' in dark blue beads is surrounded by white and yellow beads. Lined with leather and buff silk. Two tassels of buff silk ribbon at the bottom."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/28931c2e-ee63-3bb0-882f-ccbd4dc53bbc> .

