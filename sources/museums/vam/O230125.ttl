<http://data.silknow.org/object/8c0a6fda-965a-3ec9-b972-e59146536c3a>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Woman's cap, English, ca. 1840 - ca. 1845"@en , "Woman's cap, possibly for a wedding, made from wide cream silk satin ribbon and net, tied under the chin with satin ribbon. The cap is trimmed with bands of eau de nile, satin ribbon and strings of the same. It is scuttle shaped, curving foward to cover the ears where it is trimmed with blonde lace and small clumps of artificial flowers made of silk"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/863d2b20-7430-3cd4-a16d-42daaacc3c1c> , <http://data.silknow.org/image/2a13a76d-d0a6-3963-af2b-8a4229685bba> ;
        ecrm:P3_has_note               "Woman's cap, English, ca. 1840 - ca. 1845"@en , "Woman's cap, possibly for a wedding, made from wide cream silk satin ribbon and net, tied under the chin with satin ribbon. The cap is trimmed with bands of eau de nile, satin ribbon and strings of the same. It is scuttle shaped, curving foward to cover the ears where it is trimmed with blonde lace and small clumps of artificial flowers made of silk"@en ;
        dc:identifier                  "T.120-1963" ;
