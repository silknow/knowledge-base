        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "One end of a sari, plain-woven brick-red cotton with brocaded motifs in metal-wrapped silk thread; the side borders of black cotton with geometric designs in metal-wrapped thread. End border with a row of stylised trees, horizontal gold bands, gold chevrons and rows of stylised floral motifs. The field has staggered rows of circular brocaded motifs. One end complete, the other cut."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b4dcfd3f-de21-39f6-b3b4-22e7a9a67f76> .

