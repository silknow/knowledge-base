<http://data.silknow.org/object/0fec2f38-3863-3e1e-a945-2988b57e868f/observation/4>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "British Galleries:\nSTOCKINGS KNITTED FOR THE GREAT EXHIBITION<br>\nThe exhibiting hosiery companies offered a range of patterns, both in colours and stitches. Some entries were concerned with technological innovation, others demonstrated new fashions in design. These examples were especially knitted to include the exhibition date and appropriate mottoes. [27/03/2003]"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0fec2f38-3863-3e1e-a945-2988b57e868f> .

