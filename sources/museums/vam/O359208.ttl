        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/aab959d7-0b34-3aee-9e35-d3395f8a0a8f> .

<http://data.silknow.org/object/aab959d7-0b34-3aee-9e35-d3395f8a0a8f>
        a                              ecrm:E22_Man-Made_Object ;
