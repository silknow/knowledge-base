        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Semi-circular opera cloak of cashmere, with a pointed hood of silk. There is a broad scarlet border around both the cloak and the hood, the middle is white. The hood is also white, is pleated, and has two tassels which hang from its point. It is padded with cotton wool, and lined with cream-coloured silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4fa24db4-8072-3567-b0e0-124c91620f9d> .

