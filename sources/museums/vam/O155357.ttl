        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O155357" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/1c521d09-0e55-36fd-945b-dbd31b1b67b0> , <http://data.silknow.org/image/f02219fa-fc1a-3193-9b6b-c85b01191745> , <http://data.silknow.org/object/2e2cbcd8-89e8-39d9-9d3a-8d16a7895e1f/domain/1> , <http://data.silknow.org/object/2e2cbcd8-89e8-39d9-9d3a-8d16a7895e1f/observation/2> , <http://data.silknow.org/object/2e2cbcd8-89e8-39d9-9d3a-8d16a7895e1f> , <http://data.silknow.org/object/2e2cbcd8-89e8-39d9-9d3a-8d16a7895e1f/observation/1> , <http://data.silknow.org/production/f40a8c8b-2cd4-3454-9e4b-605e61518cd1> , <http://data.silknow.org/image/497049d8-8e66-3ca9-b0eb-0e74b55315c4> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/image/8279b9b6-2116-3379-85a0-c9480ae7bbad> , <http://data.silknow.org/event/9a7d5eba-dd98-3798-961b-552761bc6acb> ;
