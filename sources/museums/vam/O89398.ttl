        ecrm:P129_is_about  <http://data.silknow.org/object/12a824ed-7815-3ab4-ab87-bf8c2489384f> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
        ecrm:P3_has_note    "Parry, Linda, ed. <font -u>William Morris</font>. London: Philip Wilson Publishers Limited, 1996. 384 p., ill. ISBN 0856674419"@en .

