<http://data.silknow.org/object/cc8ec885-1524-38e1-b719-cb1e9d1be0a9/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A knitting needle case made of ivory silk figured with pink and silver stripes, gold, pink and maroon flowers.  It is lined with chamois and is edged with silver-gilt braid.  The case closes with a silver snap-hance."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cc8ec885-1524-38e1-b719-cb1e9d1be0a9> .

