<http://data.silknow.org/object/d6414f0f-6986-3ca8-9a30-dfdcca4daee1/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Pair of uncut mandarin square rank badges embroidered with coloured silks in satin, stem, long and short and chain stitches, and couched gold thread.\n\nOn each square is embroidered a white crane, the insignia of a civil official of the first rank, with a background of water, waves, rocks, clouds and miscellaneous symbols."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d6414f0f-6986-3ca8-9a30-dfdcca4daee1> .

