<http://data.silknow.org/object/cb909bf6-0311-37fd-9f2a-c40958bdc2fe>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "brocaded, 1800s, Persian; Flowers and stripes"@en , "Dress fabric, woven silk and cotton brocaded with silk and metal thread.\nDisplayed behind glass. \nWarp: blue silk\nWeft: Z-spun blue cotton\nBrocading wefts: pink, red, green, purple silk and gilt metal strip Z-wound on yellow silk core.\nStripes:\n[1] blue ground with isolated gold lobed circles each containing an almost circular arrangement of leaves in gold, pink and green, pink and purple, red and green and red and purple.\n[2] blue ground hardly visible beneath a sinuous gold stem decorated with small red, pink, green and purple dots.  To either side of the stem are large gold floral shapes with details in the same colours."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0d0702e8-5bd6-3cd4-a7ec-bc10d0c448cf> , <http://data.silknow.org/image/b0446095-3f8a-31d6-9085-59b51aea927e> ;
        ecrm:P3_has_note               "Dress fabric, woven silk and cotton brocaded with silk and metal thread.\nDisplayed behind glass. \nWarp: blue silk\nWeft: Z-spun blue cotton\nBrocading wefts: pink, red, green, purple silk and gilt metal strip Z-wound on yellow silk core.\nStripes:\n[1] blue ground with isolated gold lobed circles each containing an almost circular arrangement of leaves in gold, pink and green, pink and purple, red and green and red and purple.\n[2] blue ground hardly visible beneath a sinuous gold stem decorated with small red, pink, green and purple dots.  To either side of the stem are large gold floral shapes with details in the same colours."@en , "brocaded, 1800s, Persian; Flowers and stripes"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/cb909bf6-0311-37fd-9f2a-c40958bdc2fe/dimension/2> , <http://data.silknow.org/object/cb909bf6-0311-37fd-9f2a-c40958bdc2fe/dimension/1> ;
