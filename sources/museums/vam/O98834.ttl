<http://data.silknow.org/object/2ddad331-5313-367b-97dd-04763f76be05>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O98834" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/6ff97b24-d429-3882-b830-a3f14c0c964d> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698/observation/3> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698/observation/2> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698> , <http://data.silknow.org/production/915a001e-d1b4-3536-a49e-e81276346760> , <http://data.silknow.org/event/aaf8fe65-a706-322c-85d8-7dd735251baa> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698/observation/4> , <http://data.silknow.org/image/2e46b7a4-c52b-3219-bb7c-b736d77b62c1> , <http://data.silknow.org/image/1c535ede-6059-32fb-967f-a468da7a38c4> , <http://data.silknow.org/collection/f1b581d5-f5db-3fdb-a086-5aac64d11a10> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698/observation/1> , <http://data.silknow.org/object/db0d0eaa-a90b-3acd-8396-f39c71dd9c20> , <http://data.silknow.org/object/1feca2b6-63c9-301f-a34f-0ce07ab07698/domain/1> ;
