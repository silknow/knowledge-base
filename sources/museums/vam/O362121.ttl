        ecrm:P138i_has_representation  <http://data.silknow.org/image/e143265d-4e31-363c-b024-061813228a4d> , <http://data.silknow.org/image/fca79938-c1eb-3dc5-8170-4900c0ee67b7> , <http://data.silknow.org/image/d0dc9421-f61b-3eb0-a542-4d76f5d7c186> , <http://data.silknow.org/image/6280328e-5e26-3173-ad8f-034cf3c82592> ;
