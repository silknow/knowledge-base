        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "A rectangular panel of woven silk <i>k'o ssu</i> depicting a four-clawed dragon in profile against a cloud-filled background and above waves and rocks. The panel is evidently cut from a larger piece as only the tips of the stylised rocks and the spray from the waves is now visible.\nThe panel is woven with light and dark blue, red, pale green, tan, ochre, pink and white silks and gilt thread. The degree of fading may be measured by comparing the front side with the reverse."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677> .

