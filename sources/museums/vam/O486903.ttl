<http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "A rectangular panel of woven silk <i>k'o ssu</i> depicting a four-clawed dragon in profile against a cloud-filled background and above waves and rocks. The panel is evidently cut from a larger piece as only the tips of the stylised rocks and the spray from the waves is now visible.\nThe panel is woven with light and dark blue, red, pale green, tan, ochre, pink and white silks and gilt thread. The degree of fading may be measured by comparing the front side with the reverse."@en , "Tapestry panel, coloured woven silk with gilt thread, China, Ming dynasty, 17th century"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c7c3ee59-dcd3-31a8-a5bf-ba1c21f9f089> ;
        ecrm:P3_has_note               "Tapestry panel, coloured woven silk with gilt thread, China, Ming dynasty, 17th century"@en , "A rectangular panel of woven silk <i>k'o ssu</i> depicting a four-clawed dragon in profile against a cloud-filled background and above waves and rocks. The panel is evidently cut from a larger piece as only the tips of the stylised rocks and the spray from the waves is now visible.\nThe panel is woven with light and dark blue, red, pale green, tan, ochre, pink and white silks and gilt thread. The degree of fading may be measured by comparing the front side with the reverse."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677/dimension/1> , <http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677/dimension/3> , <http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677/dimension/2> , <http://data.silknow.org/object/9564b0c1-f8ea-3579-a4af-c774b4513677/dimension/4> ;
        dc:identifier                  "FE.133-1978" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O486903> .

