<http://data.silknow.org/event/03853d5e-c711-3675-90fe-4b6fecae2aa1>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "The Oxburgh Hangings. Hanging with applied panels of embroidery, formerly at Oxburgh Hall, Norfolk."@en ;
