<http://data.silknow.org/object/f63ea9ff-78e8-3785-a3e2-fb18aaa3f023/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Cream silk programme with applied cream silk fringe on each side, printed in black ink with the royal crest, the name of the company, the venue, date, the performance and scene designer"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f63ea9ff-78e8-3785-a3e2-fb18aaa3f023> .

<http://data.silknow.org/event/fa39c23e-be9f-3508-b583-94cae114790a>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Souvenir programmes such as this would have been treasured by many of those in attendance. The audience provided with them would have been the royal party and courtiers, but members of the company from Coven Garden may also have been given them. The performers of <i>Philémon and Baucis</i> were Charles Bonnard, Pol Plançon, Amand Castelmary and Sigrid Arnoldson. It was conducted by Enrico Bevignani. The performers of <i>La Navarraise</i> were Albert Alvarez, Pol Plançon, Charles Gilibert (misprinted on the programme as Gillibert), Claude Bonnard, Eugène Dufriche and Emma Calvé. It was conducted by Philippe Flon."@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/234ca1e5-40a5-34f0-8297-91eb56ca7ae2> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Gabrielle Enthoven Collection" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/f63ea9ff-78e8-3785-a3e2-fb18aaa3f023> ;
        ecrm:P3_has_note               "Souvenir programmes such as this would have been treasured by many of those in attendance. The audience provided with them would have been the royal party and courtiers, but members of the company from Coven Garden may also have been given them. The performers of <i>Philémon and Baucis</i> were Charles Bonnard, Pol Plançon, Amand Castelmary and Sigrid Arnoldson. It was conducted by Enrico Bevignani. The performers of <i>La Navarraise</i> were Albert Alvarez, Pol Plançon, Charles Gilibert (misprinted on the programme as Gillibert), Claude Bonnard, Eugène Dufriche and Emma Calvé. It was conducted by Philippe Flon."@en .

