<http://data.silknow.org/object/83a49078-bb13-3ef0-bee0-d898ad7c229c>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Spherical silver tape measure container with engraved decoration holding a silk ribbon, Europe, 1700-1750."@en , "Silver-coloured sphere with a central spindle inside.  A yard measure of pink silk ribbon with green edges, which emerges through a slit on one side of the sphere, is wound round the spindle.  The ends of the spindle are visible on the outside of the sphere, but lack terminals.  The border of the slit, and the two holes over the ends of the spindle, are decorated with a simple engraved pattern of stylised petals."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/b90feb4f-896c-369a-a4eb-f66646f6dfed> , <http://data.silknow.org/image/57714ead-2ba4-3524-bf8f-61400492734d> , <http://data.silknow.org/image/14e80200-94aa-3323-88ca-d9b044e02dd1> ;
        ecrm:P3_has_note               "Spherical silver tape measure container with engraved decoration holding a silk ribbon, Europe, 1700-1750."@en , "Silver-coloured sphere with a central spindle inside.  A yard measure of pink silk ribbon with green edges, which emerges through a slit on one side of the sphere, is wound round the spindle.  The ends of the spindle are visible on the outside of the sphere, but lack terminals.  The border of the slit, and the two holes over the ends of the spindle, are decorated with a simple engraved pattern of stylised petals."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/83a49078-bb13-3ef0-bee0-d898ad7c229c/dimension/1> ;
        dc:identifier                  "821-1864" ;
        <http://www.w3.org/2002/07/owl#sameAs>
