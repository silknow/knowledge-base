<http://data.silknow.org/object/6618b9d3-0c7d-36f6-b61b-ea7d2d88a027>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Tapestry hanging woven in wool and silk."@en , "These four Brussels tapestries are from a series depicting the story of Venus and Adonis, designed by the tapestry artist Jan van Orly using scenes from paintings by Francesco Albani. The same visual source was used for a series by the English tapestry weaver John Vanderbank. The Houghton tapestries are the only Brussels Venus and Adonis set remaining in England. They were located in the Green Bedchamber at Houghton at least as early as 1743. \n\nOn loan to Houghton Hall."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/7e24f0fe-6f46-3cea-9537-c02ad3eff16d> , <http://data.silknow.org/image/edb7128c-7dab-3f41-a9f7-cd98de91e870> ;
        ecrm:P3_has_note               "These four Brussels tapestries are from a series depicting the story of Venus and Adonis, designed by the tapestry artist Jan van Orly using scenes from paintings by Francesco Albani. The same visual source was used for a series by the English tapestry weaver John Vanderbank. The Houghton tapestries are the only Brussels Venus and Adonis set remaining in England. They were located in the Green Bedchamber at Houghton at least as early as 1743. \n\nOn loan to Houghton Hall."@en , "Tapestry hanging woven in wool and silk."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/6618b9d3-0c7d-36f6-b61b-ea7d2d88a027/dimension/1> ;
        dc:identifier                  "T.74-2002" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.vam.ac.uk/item/O69887> .

