<http://data.silknow.org/object/7ed3ea13-922d-3209-8925-665a1e74c21e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Silk programme on cream silk with narrow cream fringe attached, printed in black typography in landscape format, headed CRITERION THEATRE, Lessee and Manager Mr. Alex Henderson, advertising  the forthcoming second morning performance of <i>The Pink Dominos</i> at the Criterion Theatre, 12 May 1877, and giving details of <i>The Porter's Knot</i> by John Oxenford followed by <i>The Pink Dominos</i> by Charles Albery, starring Charles Wyndham as Charles Greythorne of Manchester."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7ed3ea13-922d-3209-8925-665a1e74c21e> .

<http://data.silknow.org/object/7ed3ea13-922d-3209-8925-665a1e74c21e>
        a                              ecrm:E22_Man-Made_Object ;
