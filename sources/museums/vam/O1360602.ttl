        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "1 book cover ornamented with metal plates repoussé with various subjects which have left their impression on the velvet. In the centre of the front is the Crucifixion, and at the corners are the four Evangelists; on the back is a seated figure of Our Lord in glory, surrounded by cherubs; the corners contain half-length figures of David, Solomon (?), Jeremiah (?) and Isaiah."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5a04832a-8422-3728-8da9-2158d2586559> .

