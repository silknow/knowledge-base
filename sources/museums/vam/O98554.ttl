<http://data.silknow.org/object/1e1359fd-7468-3120-836b-2aa1536096b2/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Sack and petticoat of painted Chinese export silk satin trimmed with silk braid. Painted with exotic flowers. The sack has elbow-length sleeves and sleeve ruffles of the same material. The front is decorated with ruched wavy bands of the same material, edged with chenille. With an open front.\n\nThe petticoat has small paniers. The front is decorated with ruched wavy bands of the same material decorated with chenille."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1e1359fd-7468-3120-836b-2aa1536096b2> .

