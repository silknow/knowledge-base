<http://data.silknow.org/object/f05a3e3b-e8f7-3112-bc32-2b314023b54b>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dome shaped parasol in royal blue watered silk, with silk satin stripes. The lining is white silk and there is a deep fringe in blue at the outside rosette and cover edge. The stick, handle, ferrule, tips and tip stopper are turned ivory. The stick is hinged to allow the carrier to fold the parasol down to half height when not in use, with a metal stopper that slides over the hinge."@en , "Folding parasol of royal blue watered silk with white silk lining and ivory stick; English, 1840-50"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/eddbfe16-e27b-3b9f-b3c7-356acd6db308> , <http://data.silknow.org/image/87c62af8-c48e-3bc5-9978-6eccd99a585e> , <http://data.silknow.org/image/4d8c2dd4-d5bb-3b31-9e62-75d56a36a0c2> , <http://data.silknow.org/image/1caff69d-3053-34fb-a386-593208048ba7> , <http://data.silknow.org/image/346fdf24-2b9c-3f65-bad4-4b7f9132555b> , <http://data.silknow.org/image/034c2361-b32f-37ad-9426-7a6b1592a5e1> ;
        ecrm:P3_has_note               "Folding parasol of royal blue watered silk with white silk lining and ivory stick; English, 1840-50"@en , "Dome shaped parasol in royal blue watered silk, with silk satin stripes. The lining is white silk and there is a deep fringe in blue at the outside rosette and cover edge. The stick, handle, ferrule, tips and tip stopper are turned ivory. The stick is hinged to allow the carrier to fold the parasol down to half height when not in use, with a metal stopper that slides over the hinge."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f05a3e3b-e8f7-3112-bc32-2b314023b54b/dimension/1> , <http://data.silknow.org/object/f05a3e3b-e8f7-3112-bc32-2b314023b54b/dimension/3> , <http://data.silknow.org/object/f05a3e3b-e8f7-3112-bc32-2b314023b54b/dimension/2> ;
