        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "White silk satin shoes with slightly waisted heel and satin bow at toe. Insole of white kid, rest lined white cotton."@en ;
