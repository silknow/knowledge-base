<http://data.silknow.org/object/d3e5528d-3692-3b4b-b701-604561b345c1>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O166891" ;
        ecrm:P129_is_about  <http://data.silknow.org/production/e40b55c1-02ca-3d8e-9120-c3087ea9cc29> , <http://data.silknow.org/event/c17d8fc2-0766-3df5-9fae-8be919d4b3cd> , <http://data.silknow.org/image/96d2a7e2-9e6a-3e74-bba0-3b8106588157> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/domain/3> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/observation/4> , <http://data.silknow.org/image/fa305cbe-17d1-3b5f-bfa3-9fd18d8ee8cb> , <http://data.silknow.org/image/ce64c780-f2e8-36a1-ad3c-da1644649c27> , <http://data.silknow.org/image/c303728c-e39f-3c04-b80e-2770b33d8c49> , <http://data.silknow.org/image/ad78013c-47d1-3110-9906-6bfec214453b> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/domain/2> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/observation/2> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/observation/3> , <http://data.silknow.org/image/27306129-94a1-3df2-8613-eb2e164b4979> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/domain/4> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe> , <http://data.silknow.org/image/a95f5e95-687f-3f67-b974-d4224b441cc7> , <http://data.silknow.org/image/ee893b71-96c6-3b99-aae0-28298c07acaa> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/domain/1> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/observation/1> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/domain/5> , <http://data.silknow.org/object/7b04ba3f-82fe-340f-9e8f-d3f4c4334dfe/observation/5> , <http://data.silknow.org/object/9bbd1417-abfc-3609-b0fb-78c2345ab011> ;
