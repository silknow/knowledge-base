        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Silk programme on cream silk in blue typography with integral fringe at top and bottom. Produced for 'State Visit to the Opera in honour of His Majesty the Shah, K.G.', including Rossini's 'Guglielmo Tell', scenes from 'Lucia Di Lammermoor', 'Faust', 'Mefistofele' and a short concert, Royal Opera Covent Garden, 2nd July 1889."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5b94e674-3784-3e07-9eba-da01998e4cab> .

