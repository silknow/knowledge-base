<http://data.silknow.org/event/724445a3-f805-3227-949c-0ff54fea9ad2>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Acquired from H.Pratt 37 Clifton Road, Dunstable, Bedfordshire with funds from the Murray Bequest. The chair was inherited through several generations by the owner whose forbears lived in a Tudor farmhouse on the outskirts of Dunstable, which was sold by the family in the early 1930's before the chair was acquired by the Museum."@en ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/8778ef85-2c01-3d31-bf7d-51bcbe9122c5> ;
        ecrm:P3_has_note               "Acquired from H.Pratt 37 Clifton Road, Dunstable, Bedfordshire with funds from the Murray Bequest. The chair was inherited through several generations by the owner whose forbears lived in a Tudor farmhouse on the outskirts of Dunstable, which was sold by the family in the early 1930's before the chair was acquired by the Museum."@en .

