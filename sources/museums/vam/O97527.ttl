<http://data.silknow.org/object/be0d250f-4f27-3735-80ba-d12ca866ae0d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Rectangular tent hanging made up of two panels stitched together, with an outer border enclosing both panels. Each panel has a ground fabric of cotton, which is embroidered with a gold background and floss silk, and decorated with pink rose flowers with green and yellow leaves within a cusped arch. The outer border has a floral meander design."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/be0d250f-4f27-3735-80ba-d12ca866ae0d> .

<http://data.silknow.org/object/be0d250f-4f27-3735-80ba-d12ca866ae0d/domain/3>
