<http://data.silknow.org/object/a831e085-0d9c-3936-948d-31961af998b6>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Man's waistcoat, 1785-95, British; Cream silk taffeta, tamboured silk, silver thread, spangles, pastes"@en , "Man's waistcoat with a round neckline, revers, welted pockets, straight fronts and hems, reaching to the hip.  The fronts, collar, pocket welts and revers are made of cream silk taffeta, the back of white worsted twill.  The waistcoat is lined with linen; the fronts faced with cream silk taffeta. The waistcoat is tamboured-to-shape with green, pink and red silk thread, silver filé, spangles, purl and glass pastes, in a pattern of floral bouquets with tassels and bows, on the revers, collar and pocket welts, along the front edges and hems.  There are 7 worked buttonholes on the left front and 7 embroidered buttons on the right front edge."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c5d608a7-70c4-3dfb-8f38-d5442fbca4e0> , <http://data.silknow.org/image/528a5815-8773-3c0b-a448-2c3cd95cb178> , <http://data.silknow.org/image/de9b6699-6104-3f67-bd49-53d5b92ec98e> , <http://data.silknow.org/image/ba4b74f3-0416-358b-9709-5827568fee28> ;
        ecrm:P3_has_note               "Man's waistcoat, 1785-95, British; Cream silk taffeta, tamboured silk, silver thread, spangles, pastes"@en , "Man's waistcoat with a round neckline, revers, welted pockets, straight fronts and hems, reaching to the hip.  The fronts, collar, pocket welts and revers are made of cream silk taffeta, the back of white worsted twill.  The waistcoat is lined with linen; the fronts faced with cream silk taffeta. The waistcoat is tamboured-to-shape with green, pink and red silk thread, silver filé, spangles, purl and glass pastes, in a pattern of floral bouquets with tassels and bows, on the revers, collar and pocket welts, along the front edges and hems.  There are 7 worked buttonholes on the left front and 7 embroidered buttons on the right front edge."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/a831e085-0d9c-3936-948d-31961af998b6/dimension/4> , <http://data.silknow.org/object/a831e085-0d9c-3936-948d-31961af998b6/dimension/2> , <http://data.silknow.org/object/a831e085-0d9c-3936-948d-31961af998b6/dimension/3> , <http://data.silknow.org/object/a831e085-0d9c-3936-948d-31961af998b6/dimension/1> ;
