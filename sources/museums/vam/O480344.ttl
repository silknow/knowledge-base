        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Man's silk robe (choga) brocaded in silver. Yellow ground with a repeating pattern of large and small rosettes. The large ones are silver with red-purple centres and the small ones are silver outlined wither red-purple and green. Broad border of silver brocade round the edges of the robe."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8b1e2dd7-73a9-3fce-8bfa-c7f80bca2b52> .

