<http://data.silknow.org/object/5afd826a-b2c0-3e75-a67c-1cfff4e183e7/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Panel of paper embroidered with a little silver thread and silk in shades of yellow, orange, green, red, pink, blue and cream. It is worked in double sided satin, long and short, and stem stitches with a little double running stitch.\n\nThe face of Christ has been painted onto the embroidery silk. An elaborate roccoco cartouche is formed from in twined roses and exotic flowers."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5afd826a-b2c0-3e75-a67c-1cfff4e183e7> .

<http://data.silknow.org/object/5afd826a-b2c0-3e75-a67c-1cfff4e183e7>
