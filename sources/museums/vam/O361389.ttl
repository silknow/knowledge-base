        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Case cover, bound at the edges with white silk ribbon and with a ribbon rosette at the upper corners.\n\nThe white cotton ground is printed with stems of flowers; poppy, lily of the valley, rose, passion flower, fritillary and sweet William, in full chintz colours of purple, red, pink, blue, yellow, orange and green."@en ;
