        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "In their earliest form, samplers were put together as personal reference works for embroiderers. They were trials of patterns and stitches that had been copied from others, and records of particular effects achieved that could be recreated again. This sampler includes a range of repeating patterns suitable for the decoration of linen."@en ;
