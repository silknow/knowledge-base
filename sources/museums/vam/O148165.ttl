<http://data.silknow.org/event/c62e3dc0-6f76-3f54-8e3e-d48b05a11ecb>
        a                              ecrm:E8_Acquisition ;
        rdfs:comment                   "Gordon Craig, in a letter of Sept 25 1923, to Martin Hardie, Keeper of the Dept of EID.: \"The poster design 'Hamlet' was made for and from me. I was to play Hamlet for the first time, and got the management of my strolling players to write to the Beggarstaffs. The thing was hand-stencilled, and it was pasted up in Hereford town and other provincial places\""@en ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/125d847d-e9c4-3951-a916-4a10dc50a3e1> ;
        ecrm:P22_transferred_title_to  <http://data.silknow.org/actor/f0577f91-f887-3019-bf88-f9e5ba019390> ;
        ecrm:P23_transferred_title_from
                "Given by an anonymous donor. © Desmond Banks" ;
        ecrm:P24_transferred_title_of  <http://data.silknow.org/object/742c5f83-3e81-3d03-8328-62a622c0c3d5> ;
        ecrm:P3_has_note               "Gordon Craig, in a letter of Sept 25 1923, to Martin Hardie, Keeper of the Dept of EID.: \"The poster design 'Hamlet' was made for and from me. I was to play Hamlet for the first time, and got the management of my strolling players to write to the Beggarstaffs. The thing was hand-stencilled, and it was pasted up in Hereford town and other provincial places\""@en .

