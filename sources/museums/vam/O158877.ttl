<http://data.silknow.org/object/cdc34045-8646-397c-933f-e567292983bc/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Flat and square bag of kidskin leather covered with red silk at the top and beaded in a repeating pattern of an abstract floral motif with maroon, blue, yellow and white glass beads. The bag is lined with brown silk and has a drawstring of plaited pink and green silk thread, and with beaded finials."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cdc34045-8646-397c-933f-e567292983bc> .

