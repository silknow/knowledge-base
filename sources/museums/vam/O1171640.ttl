<http://data.silknow.org/object/488f9afe-923c-3fa0-875b-8491b5ae3ca9/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Woman's waistband of blue silk moire, embroidered with silver thread and trimmed with a narrow scalloped border of silver lace, and at the end of each lappet is a conventional tree in applied sliver braid and tinsel. The Breton word for this waistband is <i>ceinturen</i>."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/488f9afe-923c-3fa0-875b-8491b5ae3ca9> .

