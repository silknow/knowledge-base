        dc:identifier      "2010EB5313" ;
        schema:contentUrl  <https://silknow.org/silknow/media/vam/O316394_6.jpg> , <http://media.vam.ac.uk/media/thira/collection_images/2010EB/2010EB5313.jpg> .

<http://data.silknow.org/object/e2eabc21-cb07-3188-8eef-5306dbec7a87/domain/2>
