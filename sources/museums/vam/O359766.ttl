        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record O359766" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/observation/1> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/observation/3> , <http://data.silknow.org/event/a8ddb107-6c3f-3cb7-8594-5f21e27b1e1b> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/observation/2> , <http://data.silknow.org/production/c0db86ed-fe78-3d16-ae44-d80de55fc0d8> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/domain/2> , <http://data.silknow.org/image/3afa2cef-23a7-3af1-95a1-a50c8a5a3ee2> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/observation/4> , <http://data.silknow.org/object/211e895f-1fb2-37db-ae3c-666b0b9e980a/domain/1> , <http://data.silknow.org/collection/461f5c7a-9b6a-38ab-ab63-fe453c1336b3> ;
