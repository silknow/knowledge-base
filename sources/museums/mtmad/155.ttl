<http://data.silknow.org/object/e430a019-4a95-3da9-95fa-14b0188d099e>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record 155" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/96b8a5fa-69e7-3d40-802b-7485376d9232> , <http://data.silknow.org/image/f19315ec-f00b-3b1e-94f7-5a7e9dbbb371> , <http://data.silknow.org/object/9d9a2004-735c-3198-800e-03ed228124a2> , <http://data.silknow.org/event/7a5eca54-f3fd-3dbb-b915-901269f6cebb> , <http://data.silknow.org/event/8092a90a-16ba-3021-bdd9-deccd46b0212> , <http://data.silknow.org/object/8234ba3e-d850-372d-9734-8379638e6e26> , <http://data.silknow.org/object/2348f647-5220-324c-b39b-5be2a34ff7a6/observation/1> , <http://data.silknow.org/production/0a8ee2aa-3f4b-39e9-8d9b-7da3d6d4c085> , <http://data.silknow.org/object/2348f647-5220-324c-b39b-5be2a34ff7a6> ;
