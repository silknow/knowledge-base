<http://data.silknow.org/object/4c8f378a-229d-39f7-ab33-d9c5328fd80e>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record 59299" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/d04c155c-f53a-325c-9b7a-e015716a9475> , <http://data.silknow.org/image/b68af5dd-414c-3927-9ca4-7bf1a7e81cd3> , <http://data.silknow.org/image/ba937f09-82ed-3c58-acf6-33e327adff20> , <http://data.silknow.org/image/9c1d6818-0e98-3024-b382-d5eff153b1e1> , <http://data.silknow.org/object/ca22b1ac-999c-3ed8-b961-36e1d6ac29f4> , <http://data.silknow.org/production/72893df3-9c10-3617-87e9-b4c9f1d9717c> , <http://data.silknow.org/image/22789cef-781d-3cf8-82d6-29c800a39351> , <http://data.silknow.org/object/b447e014-b9fd-335d-b98f-3e72e9afb9c7> , <http://data.silknow.org/event/879ea1ef-bd8e-3bed-b74d-d08c623e2a0d> , <http://data.silknow.org/image/6e0d84da-70e2-3be0-a378-09a415d06086> , <http://data.silknow.org/object/0dcffd90-1ddb-3725-922b-33d34dc7e5fc> , <http://data.silknow.org/object/0dcffd90-1ddb-3725-922b-33d34dc7e5fc/observation/1> ;
