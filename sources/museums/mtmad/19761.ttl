        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record 19761" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/25e7baf2-132d-37cf-9412-a92027543f00> , <http://data.silknow.org/object/4755a63a-ec86-3075-a643-c1e57bd7c9d0> , <http://data.silknow.org/image/b613f82e-954a-3e3f-9af9-a6c45b678d3e> , <http://data.silknow.org/object/4755a63a-ec86-3075-a643-c1e57bd7c9d0/observation/1> , <http://data.silknow.org/object/e05c443f-52b3-33ba-81e9-b09a00653bc5> , <http://data.silknow.org/event/165f2550-c8b0-366d-9810-585fc3160b4b> , <http://data.silknow.org/object/cc56685a-12c6-3a2b-bc69-f5bcf6ca5223> , <http://data.silknow.org/production/c84b2402-860d-3f01-89af-c1256c7d93fe> , <http://data.silknow.org/event/92461ef5-bbda-31a2-8abf-b5d06f2b7265> , <http://data.silknow.org/object/f81704c0-f9f4-3ff8-8f25-da84d9b4426c> , <http://data.silknow.org/image/f4c873ee-007e-3af4-9d8d-0ef45018f27d> ;
