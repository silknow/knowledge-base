        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Antinoe cent’anni dopoAntinoé, à la vie, à la mode. Visions d'élégance dans les solitudes, Florence, Palazzo Medici-Riccardi, 1998, n° 231, p. 192 ; , Lyon, musée des Tissus, 2013, n° 15, p. 84-87"@fr ;
        ecrm:P129_is_about  <http://data.silknow.org/object/2ee25e4c-3fb3-3ab5-a870-a9a1ad823970> ;
