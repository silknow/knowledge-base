        ecrm:P129_is_about  <http://data.silknow.org/object/d7f83d25-3b06-3e4b-8ad2-e515894209f1/domain/2> , <http://data.silknow.org/object/d7f83d25-3b06-3e4b-8ad2-e515894209f1> , <http://data.silknow.org/object/b7ca436f-934a-3f8a-a3e7-b5d920bbf1f4> , <http://data.silknow.org/object/d7f83d25-3b06-3e4b-8ad2-e515894209f1/observation/1> , <http://data.silknow.org/object/d7f83d25-3b06-3e4b-8ad2-e515894209f1/category/1> , <http://data.silknow.org/object/d7f83d25-3b06-3e4b-8ad2-e515894209f1/domain/1> , <http://data.silknow.org/production/94d5a0c7-c146-3b45-b28c-bdce215b41d0> ;
