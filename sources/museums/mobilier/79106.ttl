        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Elément de tenture en gros de Tours blanc broché, lampas broché, fond taffetas. Dessin nué et arabesques : bouquet central d'où se déploient des tiges en volutes colorées.\n\nHistorique :\nCommandé auprès de la fabrique lyonnaise de Marie-Olivier Desfarges, pour la chambre du roi, à Saint-Cloud.\nCf. GMTC 507 (autre partie de la tenture) et GMMP 1660/17 (bordure)."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/e2187741-12bf-3b02-956a-a4c413cfc626> .

