<http://data.silknow.org/object/57411876-d2d0-3a80-911d-9a7f35cabc03>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Etoffe pour tenture. Damas jaune sur jaune, dessin d'ornements et de feuilles d'acanthe. \n\nHistorique :\nEtoffe fournie par Darrac pour l'ameublement du Palais de Monte Cavallo. Il le destinait au Premier Salon du Grand Appartement de réception de l'Impératrice. En raison des évènements, la confection n'a pas été réalisée malgré l'accepttaion de la soumission par Desmazis. Mais les étoffes avaient été livrées par Darrac le 21 mai 1814 et enregistrées au Journal. Elles seront alors utilisées pour le Palais d'Orléans, puis en 1823 aux Tuileries, en 1842 pour le Service des magasins,  en 1844 pour Versailles par le tapissier Joubert et enfin en 1849 par le tapissier Ternisien pour l'Élysée."@fr ;
        rdfs:label                     "Tenture destinée au Premier Salon des Grands Appartements de l'Impératrice Marie-Louise à Monte Cavallo"@fr ;
        ecrm:P102_has_title            "Tenture destinée au Premier Salon des Grands Appartements de l'Impératrice Marie-Louise à Monte Cavallo"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/96cf7c87-7c8e-37d0-95c1-56f41e4a0d89> , <http://data.silknow.org/image/cb359df6-baea-3e65-9648-400d594b7fea> , <http://data.silknow.org/image/e6ac5731-c9e5-3eb8-99b5-ade9529011d4> , <http://data.silknow.org/image/b6ffd39c-a6b7-3008-844e-c6b88aa816a4> , <http://data.silknow.org/image/3ce08ff6-f031-3910-8458-dadb02d1166d> , <http://data.silknow.org/image/eb8a5dea-9dad-32ea-aa28-af150db38f88> , <http://data.silknow.org/image/3ef743e0-652c-32fa-9f0a-fa09e88f2996> , <http://data.silknow.org/image/be5bf230-7f98-3054-8459-b300b820cafb> , <http://data.silknow.org/image/00b831a7-5fd8-3700-9b8c-d7fa4eee9ce1> ;
        ecrm:P3_has_note               "Etoffe pour tenture. Damas jaune sur jaune, dessin d'ornements et de feuilles d'acanthe. \n\nHistorique :\nEtoffe fournie par Darrac pour l'ameublement du Palais de Monte Cavallo. Il le destinait au Premier Salon du Grand Appartement de réception de l'Impératrice. En raison des évènements, la confection n'a pas été réalisée malgré l'accepttaion de la soumission par Desmazis. Mais les étoffes avaient été livrées par Darrac le 21 mai 1814 et enregistrées au Journal. Elles seront alors utilisées pour le Palais d'Orléans, puis en 1823 aux Tuileries, en 1842 pour le Service des magasins,  en 1844 pour Versailles par le tapissier Joubert et enfin en 1849 par le tapissier Ternisien pour l'Élysée."@fr ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/57411876-d2d0-3a80-911d-9a7f35cabc03/dimension/1> , <http://data.silknow.org/object/57411876-d2d0-3a80-911d-9a7f35cabc03/dimension/2> ;
