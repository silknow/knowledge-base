        ecrm:P129_is_about  <http://data.silknow.org/object/a8248324-8b7a-3591-abcb-50dbace84c40> , <http://data.silknow.org/object/085f2907-0bf1-3f44-8f79-3ab17e865d9d/domain/1> , <http://data.silknow.org/object/085f2907-0bf1-3f44-8f79-3ab17e865d9d/domain/2> , <http://data.silknow.org/object/085f2907-0bf1-3f44-8f79-3ab17e865d9d/category/1> , <http://data.silknow.org/production/e71f63a6-f329-3297-9b24-8890223cadf4> , <http://data.silknow.org/object/085f2907-0bf1-3f44-8f79-3ab17e865d9d> , <http://data.silknow.org/object/085f2907-0bf1-3f44-8f79-3ab17e865d9d/observation/1> ;
