<http://data.silknow.org/object/d3be1997-6f24-342f-b76b-9e1e976dcd69>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record GMMP-1282-000" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/9de4563e-0fec-3fc5-8bbd-8616129f3ac3/category/1> , <http://data.silknow.org/object/9de4563e-0fec-3fc5-8bbd-8616129f3ac3/domain/1> , <http://data.silknow.org/production/55ac60b7-8c5d-31b7-8461-b76ce2ed3291> , <http://data.silknow.org/image/e2849e7c-8695-3736-94cc-8ed8c9b6735e> , <http://data.silknow.org/image/397547b0-dcb2-326a-a8aa-8d1e05a081a6> , <http://data.silknow.org/object/eb2441e7-fe74-3b7f-b661-f6c9e6c8f3e8> , <http://data.silknow.org/object/9de4563e-0fec-3fc5-8bbd-8616129f3ac3/observation/1> , <http://data.silknow.org/object/9de4563e-0fec-3fc5-8bbd-8616129f3ac3/domain/2> , <http://data.silknow.org/object/9de4563e-0fec-3fc5-8bbd-8616129f3ac3> , <http://data.silknow.org/image/0829bb0b-ac92-3f60-84fe-2a73117c432e> ;
