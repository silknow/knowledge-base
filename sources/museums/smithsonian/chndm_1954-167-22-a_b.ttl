        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Reddish-brown satin with a large-scale design of vaguely chinoiserie character. Horizontal row of motifs formed by: groups of vases, trunks filled with scrolls and fabric swags, rocaille forms with dragons, Chinese pavilions, mirrors, and shield-forms with rooster heads."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a1c68a5f-91be-3aa0-b0d7-74d0fc8616c1> .

