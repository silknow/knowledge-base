<http://data.silknow.org/object/ffef5727-f95a-3671-9d86-87be97cbe5ca/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Sash to be worn with blouse (1977-77-1) with same block printed floral pattern in rust red with green on off-white fabric. Three panels of equal length joined by a figure-8 stitch using rust red silk. Running stitch using the same silk decorates hems on four sides."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ffef5727-f95a-3671-9d86-87be97cbe5ca> .

