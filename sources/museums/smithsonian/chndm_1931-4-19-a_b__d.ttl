        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Bedspread made in 19th century from old fabric and two fragments of same material. White ribbed silk with vertical taffeta stripes. Brocaded design, in polychrome silks and rose and red chenille, of serpentine rose vines (over taffeta areas) and scattered floral sprays."@en ;
