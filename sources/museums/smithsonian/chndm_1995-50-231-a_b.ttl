<http://data.silknow.org/object/ed42ceff-c4c1-3835-9d76-eceb7c2e93ea/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Two shaped valances made of the same fabric. The width differs on each of them but the height is the same. The pattern is a polychrome design of fruits and flowers on a white background. The valances are interlined, lined with linen plain weave and bound with woven green silk tape. The original glaze is on the fabric."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ed42ceff-c4c1-3835-9d76-eceb7c2e93ea> .

