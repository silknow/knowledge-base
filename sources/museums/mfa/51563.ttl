        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Rectangular fragment, part of a curtain. Weft twill ground fabric with linen warp and cotton weft. Pattern, embroidered with polychrome crewels, in a variety of filling and knotted stitches, shows undulating branches from which grow large scale leaves and red, orange or blue blossoms. At center, a bird with red, yellow and blue plumage perches on a leaf. Ground much patched and darned."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/1b3fcb97-5423-3042-b144-b9868c3e7ea7> .

