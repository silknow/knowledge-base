        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Hanging consisting of 2 loom widths intended to be sewn together thereby creating central field with border running along 2 sides and bottom. Design of field: large yellow tulips with green intertwining stems and leaves against orange ground; rows of upright tulips alternating with rows of downward hanging tulips. Border: small yellow buds with long spiralling green stems. Band of white silk along lower edge. Condition very good except for tears along top and bottom.  Designed for G.P. & J. Baker"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/34acc404-24d6-3f8b-8205-b7d29be3b917> .

