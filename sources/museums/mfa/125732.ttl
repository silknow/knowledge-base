<http://data.silknow.org/object/d34b9f80-d0a0-3fe2-9a57-3469234f3665/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Woodblock print on cotton in red, greens, pink and salmon on white ground. Design of meandering flowers on vine, lesser flora in lighter shade fills out background; 2 1/2 repeats. Marked on selveges: \"Reg-Morris and Company, 449 Oxford Street, London W.\" Originally designed as wallpaper, known as \"Flora\". Designed for Morris and Co. printed at Merton Abbey."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d34b9f80-d0a0-3fe2-9a57-3469234f3665> .

