        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Rectangular panel, patched in upper left corner. Crimson velvet ground; pattern in flat and loop brocaded gold yarns. Design shows symmetrical arrangements of leafy branches bearing pomegranate and flowers; oval medallions or elaborate fleurs-de-lys at the intersections. Partial selvedge along one side: green warp twill with single gold colored stripe. Gold yarns much worn and breaking away from ground.  Church of La Fava, about 1520."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9160240a-c6e6-32d7-92fb-97d837edd5ee> .

