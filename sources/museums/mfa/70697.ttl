        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The design consists of circles joined by discs containing a conventional leaf.  In each circle is a clown sitting on a rope and tossing balls into the air.  Between the circles are dragons.  The cotton is printed with red, yellow, black, white and dark violet."@en ;
