        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Box with scene of Judgement of Solomon on top. Lion and deer on front, canvas work scenes on each side, purl work flowers on back. Silk yarns, purl, coral and seed pearls embroidered on white silk, raised work, metal trim and feet, metal side carrying handles. Top open, mirror and writing compartments inside, inside tray lifts out. Good condition, top soiled."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/5ffe37f1-4fa5-378b-83d8-abbd9b547a69> .

