        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "White satin ground solidly covered with silver metal threads and tinsel forming symmetrical large-scale design of conventionalized curving leaves and sprays of roses of several varieties, against background of minute broken lines. Design outlined with short floats of white silk weft which produces the effect of relief in the pattern. Actual piece rectangular."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e81d37a3-4465-323c-b614-0a988028adbf> .

