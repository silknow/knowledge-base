        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fine linen plain weave embroidered with silk and metallic thread; squares of polychrome canvaswork at bottom, alphabet and numbers above with floral wreath enclosing the initials MBM and the date 1738 in the center surrounded by flowers with pascal lamb below; edged with buttonhole stitch.  Across the bottom is a double row of rectangles each filled with a small geometric pattern.  Stitches: Cretan, cross, Florentine, gobelin, hem, knot, rice, rococo, satin, stem, and tent."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7313580d-25e0-3dd2-8e29-6de3bbea9104> .

