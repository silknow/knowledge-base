<http://data.silknow.org/object/0eb21214-d182-3328-8bb6-8c080a73feec/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "A rectangular cotton cover, white (now much yellowed and stained) ground; narrow border on two long sides of serpentine formed by broken branch and leaf motives, deep border design on two short ends, symmetrically arranged central fountain flanked by scrolling acanthus branches with rampant lions, griffons, and peacocks; embroidery worked in great variety of flat stitches with polychrome silks, gold, and silver metal thread; edges finished with narrow gold bobbin lace."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0eb21214-d182-3328-8bb6-8c080a73feec> .

<http://data.silknow.org/object/0eb21214-d182-3328-8bb6-8c080a73feec>
