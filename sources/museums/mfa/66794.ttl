<http://data.silknow.org/event/62c914ab-bf8f-3c15-94ce-e94704e66ed1>
        a                              ecrm:E8_Acquisition ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/c0a72392-dc2f-3058-8cd5-966d841be731> ;
