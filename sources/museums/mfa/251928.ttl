        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The countries, surrounding islalnds and neighboring coastlines, are labelled and outlined in a different color. Border with a continuous slim stalk having naturalistic blossom and leaves openly spaced. Edged with pink silk ribbon. Mounted on tan linen. The ground is missing and broken in several areas.  Stitches: back, couching, running, satin, shaded satin, trellis."@en ;
