<http://data.silknow.org/object/a4cf5774-f7eb-32bc-b796-46e4503b7df3/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Natural color cotton warp and weft. Printed with wood blocks in neutral red. Pattern shows pair of wide stripes composed of oval sections showing birds and flowers, between these are large bouquets and vignettes showing pairs of eagles by rocky crags. Selvedge on left edge. Slightly soiled and discolored; a few small stains, one break."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a4cf5774-f7eb-32bc-b796-46e4503b7df3> .

