        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "White cotton panel printed with blue, red, and yellow Moorish-inspired design of stylized quatrefoil rosettes in the inner field with side borders of continuous strapwork pattern. Design based in part on elements found in Owen Jones \"Grammar of Ornament\" (Plate XLII, Moresque Section No. 4) from 1856.  Two edges have selvedge, third edge is hemmed, last edge  pressed under, but not sewn."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a105e21a-f1de-340a-9127-4734a1dbde72> .

