        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Two pieces of white cotton dimity; pattern of wide stripes of weft twill, wide stripes formed by narrow stripes of equal widths alternately warp and weft twill, and broad stripes separating a series of very narrow evenly spaced stripes of alternately warp and weft twill; material never used; one selvedge present on each piece."@en ;
