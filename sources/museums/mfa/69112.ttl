        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Wide border on each end of punto-greco with a design of triangles grouped to form rampant animals and plants (?) growing in pots.  On the edges is narrow bobbin lace with tassels.  See note on T.2283.  Tela tagliata (ad ago) e merletto a fuselli.  Francesca Amari, 1907."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/081b983f-58ea-3b1b-90b6-3628ea65de1b> .

