        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Narrow panel made up of two similar but not identical pieces seamed horizontally.  Ground: cream colored silk twill.  Design: long slender leaves, in green satin, and shorter leaves brocaded in brown, symmetrically arranged to suggest architectural columns, supporting an elongated pseudo-Ionic capital, brocaded in brown, and brown and white flowers and fruit with green and white flowers and fruit with green foliage growing form column.  Narrow cream and blue selvedge, partly intact.  Condition very good."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d7029940-5c84-37a8-a15f-78262d1b4ce4> .

