<http://data.silknow.org/object/dc40c120-cf9b-3c8d-bcc9-4d61a726d499/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Various independent motifs including several birds, butterflies, floral designs, cornucopiae, a house and a temple.  All within a floral vine border. Ground worked with translucent and opaque beads affixed with tan silk yarns.  Ground and beads worn; some holes; two corners frayed."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/dc40c120-cf9b-3c8d-bcc9-4d61a726d499> .

