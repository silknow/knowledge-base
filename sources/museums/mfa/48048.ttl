<http://data.silknow.org/object/8f49add5-8898-3473-b8a6-ab42b225616c/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Imitation batik cloth with Javanese-inspired design of birds and floral medallions on a repeating pattern of small interlocking ovals in brown, dark blue and beige.  There is a narrow floral border along each selvedge and a narrow hand-stitched hem along each crosswise edge."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/8f49add5-8898-3473-b8a6-ab42b225616c> .

