<http://data.silknow.org/object/233f0a45-b92a-33a5-a1bc-675e19614667/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ground: cotton and linen, four pieces sewn together.  Design: scalloped lower edge embroidered with scrolling bands inhabited with flowers; scallops divide valance into five compartments; outer ones filled with fruit baskets with birds and butterflies, inner ones with flowering branches bearing fruit, and a central one with large exotic bird.  Worked with polychrome wools in chain stitch with a few details in French knots.\n\nSimilar to 43.266"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/233f0a45-b92a-33a5-a1bc-675e19614667> .

<http://data.silknow.org/object/233f0a45-b92a-33a5-a1bc-675e19614667>
