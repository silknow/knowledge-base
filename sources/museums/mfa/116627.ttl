<http://data.silknow.org/object/dbdd950a-c30f-3b8f-acca-a248403efa6d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Embroidered primarily in satin and stem stitches. Field shows pair of tablets, inscribed with Ten Commandments, surmounted by pairs of carnation and rosette plants flanking an angel's head. Below, in center; \"Sarah/Thomas In The 7 Year/of My age December 7 1728\". Outer border at bottom and sides shows undulating floral vine. Soiled and worn; many holes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/dbdd950a-c30f-3b8f-acca-a248403efa6d> .

