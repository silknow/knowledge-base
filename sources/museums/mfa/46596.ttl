<http://data.silknow.org/object/711a9e6b-d956-3d5f-a7f2-e9f4bcbe1261/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Loosely woven linen completely covered with embroidery.  Flowers, architectural ornament and scrolls and two armorial shields surmounted by a crown are worked in gros point and petit point with brilliant colored wools and silks (reds, blues, yellows, greens, etc.) on a ground couched with silver thread.  The couching stitches are taken through firm linen lining, as well as loosely woven linen.  Said to come from Polish church.\nBelongs with 38.1050-1052.\nSee note."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/711a9e6b-d956-3d5f-a7f2-e9f4bcbe1261> .

