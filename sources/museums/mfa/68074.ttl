<http://data.silknow.org/object/135e1572-b2a4-3a6a-b129-4fab60517117/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The ground is woven of white silk and silver thread.  The design, of which only a small part appears in each piece, is composed of undulating ribbons and sprays of flowers woven with pink, blue and black silk, pink and blue chenille, and gold and silver thread.  Lined with yellow cotton and edged with yellow fringe.  Louis XV period"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/135e1572-b2a4-3a6a-b129-4fab60517117> .

