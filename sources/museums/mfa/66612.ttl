<http://data.silknow.org/object/f03f377b-4918-3463-86aa-dfe004018e16/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ground: linen. Design: woman's figure with bird perched on wrist. The face has entirely disappeared; outlines drawn on linen indicate arm, hand and neck. Headdress, bird, and woman's skirt worked with green, red, yellow and dark blue silk in split and outline stitch, and couched gold thread (metal wound on yellow silk). Very ragged, many holes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f03f377b-4918-3463-86aa-dfe004018e16> .

