        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Embroidered with cross, chain and several other canvas stitches; frame of angular serpentine flowering vine, rest of design arranged in horizontal rows composed of stylized plants, flowers, birds and flower filled urns, in lower center a memorial urn reading: \"In memory of M. Furler who died March 11, 1811\", in lower center framed by laurel wreath; \"Rebca Furler Her Work Aged 8 Years 1811;\" a number of small holes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/26d70aea-d524-3835-b18b-a97c391a1ff9> .

