        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Cream satin, backed wtih linen, embroidered with polychrome twisted silk yarns in satin stitch. In the center, a horn form which issue a carnation, roses and a tulip. A tulip in each lower corner; clusters of stems with four-petaled blossoms in each upper corner. Stitches pass through both the satin and linen. Satin soiled and broken in several places; several small stains."@en ;
