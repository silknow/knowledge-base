        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Seven fragments of silk samite found in Egypt. What can be seen of the design consists of goats in round or oval medallions and palmette-like forms. The colors are red, blue, white and pale yellow. The design is apparently arranged in stripes."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/34404df0-ad13-3d89-a91a-289d3b4b856c> .

