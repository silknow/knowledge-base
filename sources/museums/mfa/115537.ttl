        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Undyed wool ground, satin weave. Cherry red and dark chrome green cut pile, all wool fiber. Pattern shows a formal bouquet of roses, carnations and chrysanthemums in urns with dragon handles on pedestals hung with lambrequins and flanked by paired birds holding berries in beaks. Each length shows barely one repeat. Slightly faded and worn in places; ground shows slight brown stains."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/28ae84e6-2022-3cab-8aa4-bdf51f507b4e> .

