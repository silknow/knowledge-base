        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ground:  white cotton.  Design:  Paris, as a shepherd seated at the entrance of a hut, over the door of which is a band inscribed LA DITCHA Y SOL E DAD (happiness and solitude);  he offers an apple to Venus, who stands between Minerva and Juno;  printed in reddish purple from a copper-plate."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/dcad48f3-8f17-359c-b9ce-7fb91baebb34> .

