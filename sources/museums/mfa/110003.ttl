        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Irregularly-shaped piece of fine white silk taffeta (now yellowed and stained in places), probably from skirt of a dress; design of angular serpentines formed of wild roses, pansies, and other small flowers with figure, in Chinese costume standing under a bush, in interspaces; outlines printed in black with woodblock; colors painted directly on silk by hand; much of the black rotting out; right selvedge present."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/07a20f2c-5657-3007-867c-be7565b24e16> .

