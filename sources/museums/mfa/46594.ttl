<http://data.silknow.org/object/9c5a02af-fff4-320c-9db2-8cfbaebca42e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Loosely woven linen completely covered with embroidery.  Flowers, architectural ornament and scrolls are worked in gros point and petit point with brilliant colored wools and silks (reds, blues, yellows, greens, etc.) on a ground couched with silver thread.  The couching stitches are taken through firm linen lining as welll as loosely woven linen.  Said to come from Polish church.  \nBelongs with 38.1050-1051, 38.1053.\nSee note."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/9c5a02af-fff4-320c-9db2-8cfbaebca42e> .

