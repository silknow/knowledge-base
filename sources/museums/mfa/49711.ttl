        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Christening pillow case and liner. Case: white lawn field edged in lace, band of lace inset near edge of field, family crest in center (swagged draperies caught back with tassled cord; crown surmounts center of swag; under drawn draperies is oval containing Greek cross, crescent and two crossd, leaping fish). Liner: white silk organdy. Used by Prince Constantin Belosselsky-Belozersky in Russia, 1843.  (Cf. 48.1239-44)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/2cfbcdf7-8364-3ec3-a2e4-0310835832cb> .

