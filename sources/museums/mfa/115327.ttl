<http://data.silknow.org/object/4f938517-fba6-3e37-9836-bec6dcc4b48e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Coarse linen twill covered with alternating bands of red and brown broadcloth over which heavy plied silk cords have been couched. Bands show scrolling motifs, stars and conventional plants in shades of green, blue, red, yellow and white. Heavier yellow, pink and blue cord handle. Soiled at bottom, where also dyes have run."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4f938517-fba6-3e37-9836-bec6dcc4b48e> .

