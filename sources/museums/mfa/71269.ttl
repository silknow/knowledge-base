<http://data.silknow.org/object/4afe6827-43fa-3264-8b0b-bfdbe7daafdb/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Punto in aria.  The design consists of a row of squares filled by sprays of seed vessels and leaves, set diagonally.  The long bars are of bobbin made braid.  Made to be used with 95.917.  95.916 and 95.917 were valued together by the donor at 200 francs.  Only part of the lace is shown in the photograph."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4afe6827-43fa-3264-8b0b-bfdbe7daafdb> .

