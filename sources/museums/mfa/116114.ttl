        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "In pieces. See matching set of bed curtains (63.1023-.1026) and chair seat covers (63.1028-. 1034). Red, orange, brown and shades of yellow crewels worked with a variety of stitches on a linen-and-cotton weft twill ground fabric. Design shows bizarre flowers, exotic fruits and tree islands. Condition good."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/ea5b6ea8-5322-389c-8ee6-d66e3201e8c2> .

