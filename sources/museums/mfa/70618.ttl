        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Crimson silk ground on which is woven with red silk a design of stems bearing heart-shaped leaves, crowns, and large conventional bud forms. The design is the same as that on the Doges' robes, in the Museo Civico, Venice. Similar in design to 97.596 and 04.1618.  Much worn."@en ;
