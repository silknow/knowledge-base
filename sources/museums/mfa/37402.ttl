<http://data.silknow.org/event/b97cdb15-4673-3655-97e3-9a7467e83e65>
        a                              ecrm:E8_Acquisition ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/1b4fc4f6-1122-3f17-8f04-230eda547edb> ;
