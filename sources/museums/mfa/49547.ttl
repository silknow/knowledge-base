        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Brocaded in polychrome silks on a white silk satin ground.  Chinoiserie design with several scenes: two figures in a rowboat; a figure standing on a bridge between a small house and a rocky garden; a larger house with a porch from which a man appears to be feeding two swans.  In the interspaces, clouds, birds, etc.  Both pieces worn and stained.  The back (a) is composed of one large piece and two fragments added, one to each side, at the top.  Holes on the seat (b)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/29b4be6c-db45-3a2f-b281-c79d8fd947f7> .

