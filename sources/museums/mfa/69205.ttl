<http://data.silknow.org/object/84e7826b-08c5-3025-b39d-b8e1dce34eb4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Gray-blue silk corded ground, on which is a design of the same shade of satin.  The conventional floral forms are brought out in places with silver and gold thread.  On each end is a deep band of gold lace;  on the sides are narrower pieces of gold lace.  Lined with white silk."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/84e7826b-08c5-3025-b39d-b8e1dce34eb4> .

