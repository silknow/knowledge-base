<http://data.silknow.org/object/25181e3b-3704-3990-8176-9c0f345e3ac4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Brocaded in polychrome silks on a gold compound satin ground. Symmetrical pattern. Confronted Chinese figures with birds perched on their hands. Floral vines and palm trees. Birds standing on quivers of arrows. Selvedge on both sides of five cords and a wide stripe. Soiled, worn, with holes.  (Early Ming dynasty)"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/25181e3b-3704-3990-8176-9c0f345e3ac4> .

