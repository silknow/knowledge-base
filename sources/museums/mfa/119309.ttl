        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Rectangular piece, made of two fragments sewn together. Fine natural cotton tabby ground, printed with woodblocks in polychrome colors. Pattern shows row of large-scale baskets containing roses, poppies, honeysuckle, etc.; blue ribbon tied into a bow through handle. Lilacs and other small blossoms in interspaces. Selvedge remains at left; contains two blue threads. Soiled and stained."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/44fceea0-2aac-3f07-9e84-d176be1db088> .

