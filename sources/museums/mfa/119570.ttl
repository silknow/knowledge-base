        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "White cotton plain weave ground worked with white cotton yarns in a variety of stitches and drawnwork. Horizontal rows, one above the other, of stylized and naturalistic floral vines. One row with drawnwork squares. Scalloped edges. Slightly stained.  Stitches: buttonhole, chain, double faggot, French knot; pulled work, single faggot."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/77ee7fce-5716-3cec-9cee-f3e0aa58dc6c> ;
