<http://data.silknow.org/object/5ee3d06f-b82e-33f6-a157-72deed5bd54a>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Scarf with bird's-eye view of the Festival of Britain grounds with thin black pen-like outlines of buildings colored with rough-shaped blocks of saturated color: bright fuscia, blue, turquiose, and acid green / yellow. Border is of creamy white. Some buildings are marked with capital letters that refer to a map key on the lower mid-right. \"FESTIVAL OF BRITAIN 1951\" is repeated between map and white border three times per side. A black-bordered placard-shaped label in the lower right on white border reads \"'Souvenir' by Adrien\" and in smaller text below that, \"MADE IN ENGLAND\"."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/bdcdce90-0acb-303e-9d19-5152f625587e> ;
        ecrm:P3_has_note               "Scarf with bird's-eye view of the Festival of Britain grounds with thin black pen-like outlines of buildings colored with rough-shaped blocks of saturated color: bright fuscia, blue, turquiose, and acid green / yellow. Border is of creamy white. Some buildings are marked with capital letters that refer to a map key on the lower mid-right. \"FESTIVAL OF BRITAIN 1951\" is repeated between map and white border three times per side. A black-bordered placard-shaped label in the lower right on white border reads \"'Souvenir' by Adrien\" and in smaller text below that, \"MADE IN ENGLAND\"."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/5ee3d06f-b82e-33f6-a157-72deed5bd54a/dimension/2> , <http://data.silknow.org/object/5ee3d06f-b82e-33f6-a157-72deed5bd54a/dimension/1> ;
