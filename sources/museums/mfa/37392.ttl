<http://data.silknow.org/event/0e4dc419-3742-36af-abb8-8dd62be3446f>
        a                              ecrm:E8_Acquisition ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/4f1c7725-6c5b-393a-997d-b66a282788e6> ;
