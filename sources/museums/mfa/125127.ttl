        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Roller printed in two shades of red, yellow, blue, green (yellow over-printed with blue), and two shades of brown with tan blotch ground. Design shows Corinthian columns interrupted by bouquets of large blossoms. Two loom widths sewn together. Original glazing. Excellent condition. Similar to 27.546."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e5ed9d18-c107-3767-a0a5-d6c31de3681e> .

