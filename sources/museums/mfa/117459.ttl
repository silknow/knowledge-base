        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Large rectangle of tabby-woven cotton, printed in brilliant colors on a red ground. Field shows a great pointed tree rising from a pedestal flanked by peacocks; top of field scrolled to suggest a mihrab. Side borders show leafy vine on white ground; lower and upper borders show single palmette leaves in a band of rectangles. Tape loops sewn to upper corners."@en ;
