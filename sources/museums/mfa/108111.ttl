<http://data.silknow.org/object/50eebf5c-5cf5-3a45-bf05-1eaf49fda9e3/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "A band of cream colored linen drawn-work, traditional design of row paired unicorns facing each other, with stylized plant forms between them, below band serpentine wave pattern, above narrow border of geometric forms, threads have been drawn out through design and background, matching linen thread darned through design, background whipped with rust colored linen to form rectangular mesh, bobbin lace, Genoese type, sewed to lower edge, up one side, other end plain."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/50eebf5c-5cf5-3a45-bf05-1eaf49fda9e3> .

