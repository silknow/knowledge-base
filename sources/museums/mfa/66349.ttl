        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ground: light neutral linen. Design: large pomegranate detailed by conventionalized flowers, surrounded by two long leaves detailed in the same manner, framed by narrow rectangular dentate border, points turned in, conventionalized flowers filling each corner, worked in herring-bone stitch with pinkish red, neutral yellow, bluish green, green, cream white and a little black silk. Worn, black silk rotted."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d2e0967a-5f22-384f-bd98-4c2614e628e7> .

