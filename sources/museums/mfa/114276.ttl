        a                    silk:T35 ;
        silk:L1              "Bedspread: Robinson CrusoeQuilt" ;
        ecrm:P41_classified  <http://data.silknow.org/object/7d70c9c3-2e80-35f3-aa70-2e93e15f4142> .

<http://data.silknow.org/object/7d70c9c3-2e80-35f3-aa70-2e93e15f4142/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Quilted chintz bedspread \"Robinson Crusoe\". Natural cotton tabby-woven ground, printed with copper plate in mauve. Shows four scenes: Crusoe on raft, Crusoe at table, Crusoe watching one negro carrying another, Crusoe looking at footprints on ground. Bedspread shaped with pillow cover, scalloped side valances and foot valance. Plain cottom sewn to top. A few brown stains. Two holes. Chintz signed: \"F. Pieters\"."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/7d70c9c3-2e80-35f3-aa70-2e93e15f4142> .

