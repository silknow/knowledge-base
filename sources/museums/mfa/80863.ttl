        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Loosely woven linen ground embroidered with cream colored silk in vertical needlepoint stitch, design of medallion with an oval inclosing infant Christ child held by a saint with delicate rococo scrolls, flowers, foliage, and insects, worked in tent stitch with several shades of yellow, orange, pink, blue, green, and some tarnished metal thread, central motive has been cut out and replaced by a piece of sheer cotton, ragged edges, no lining or trimming."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/4da80d5c-7649-3aeb-95d7-e75218d48c98> .

