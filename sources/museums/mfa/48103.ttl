<http://data.silknow.org/object/c54bcf9a-22cb-3374-9f30-17191a184e6f/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Framed long narrow wool sampler embroidered with silk. Verse at the top: \"Jesus the only thought of thee with sweetness fills my breast but sweeter far it is to see and on thy beauty feast. No sound no harmony so can art or music frame no thoughts can reach no words can say. The sweets of thy name\".  Below verse a country house with sheep is embroidered in cross stitch. Signed at bottom, \"Elizabeth Regans work finished in the year 1829\"."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/c54bcf9a-22cb-3374-9f30-17191a184e6f> .

