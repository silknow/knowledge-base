<http://data.silknow.org/object/55659799-4e0e-31cf-bf6c-4c8885002ecb>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Rectangular embroidered panel (unpicked workbag); twill ground with linen warps cotton wefts (fustian), symmetrical design of flowering tree on a mound, top half reflects lower half but flowers, leaves and stems embroidered in different colors and, occasionally, different stitches; \"1705\" in red and \"MB\" in blue satin stitches at opposite ends; pieced at corners where later embroidery continues pattern; mostly dense satin stitch for blossoms and leaves with bullion, satin, knot and other stitches at centers; wider stems in two pink and brown rows of satin stitch; small worn areas where stem used later to fill in"@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6aefa1c6-a007-3d4b-a79c-e19b5a8e1905> , <http://data.silknow.org/image/e1015d7c-42de-3943-b8af-832adf29b8f9> , <http://data.silknow.org/image/47ea1659-b136-3398-acf3-14f11f41713c> ;
        ecrm:P3_has_note               "Rectangular embroidered panel (unpicked workbag); twill ground with linen warps cotton wefts (fustian), symmetrical design of flowering tree on a mound, top half reflects lower half but flowers, leaves and stems embroidered in different colors and, occasionally, different stitches; \"1705\" in red and \"MB\" in blue satin stitches at opposite ends; pieced at corners where later embroidery continues pattern; mostly dense satin stitch for blossoms and leaves with bullion, satin, knot and other stitches at centers; wider stems in two pink and brown rows of satin stitch; small worn areas where stem used later to fill in"@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/55659799-4e0e-31cf-bf6c-4c8885002ecb/dimension/2> , <http://data.silknow.org/object/55659799-4e0e-31cf-bf6c-4c8885002ecb/dimension/1> ;
