        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Compound satin weave in white silk.  Main body of piece has overall pattern of small sprigs of leaves.  At the bottom, a border of two undulating floral vines and below them a band of twill weave.  Selvedge on both sides.  At middle top, a seam.  Selvedge has many slits."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/659e06fc-bb10-3410-82e4-e4668102b633> .

