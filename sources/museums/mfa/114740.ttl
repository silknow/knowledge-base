        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Natural colored linen warp and weft. Central field shows lozenge lattice work formed of slender pointed leaves. In center of each lozenge a floral sprig. Wide border on four sides shows interlaced, undulating ribbon and floral vine. Initials R F in blue silk cross stitch in upper left corner. Hemmed at each end. Selvedges complete. Linen browned, particularly along folds. Four small holes in upper right corner, darned."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/d0ff6395-092e-3f29-baf5-79a9661e2f9b> .

