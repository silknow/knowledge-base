        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Cream-colored ribbed and figured silk ground, brocaded with polychrome silks and a variety of gold and silver yarns and wires. Undulating stripe formed of fantastic feathery plants and leaves; intertwined with these, and filling the interspaces, are floral sprigs bearing green berries and lilac-like blossoms. Ground darkened and soiled; metals tarnished and worn. Holes and breaks, patched."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f6872232-2783-3091-ada6-89bedb80fce0> .

