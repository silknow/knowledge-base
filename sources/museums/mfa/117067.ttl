        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Natural cotton tabby-woven ground, emroidered in tent and cross stitches. Each face has a border on three sides showing alternating blue, brown and greenish-yellow conventionalized plants set at an angle. Edges show narrow lines of stitches in same colors plus yellow-orange. Brown stains; a few white wax stains. Linen browned."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/a5209e4d-2d2f-384e-b436-a267e3e48f91> .

