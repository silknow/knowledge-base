        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Broad white and brownish-black stripes.  On the white stripes are red roses with blue leaves and buds.  The white stripe is covered with black dots and has an undulating band dividing it into hexagons by white lines, and large red and black leaves.  Part of the white ground was strong yellow originally.  Pieced."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/724114ad-a6be-3523-b8bf-cb9d8cdf5e02> .

