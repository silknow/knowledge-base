<http://data.silknow.org/object/0ac1bbb0-d57e-3a54-9f34-855395960f1a/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Embroidered with cross stitches; border on all four sides of minute strawberry vine, ground divided into 3 horizontal bands, in upper one: \"The Lord is about my path and about my bed and spreft out all my ways\", in center band stylized trees, paired birds, strawberries, dogs, and plants in urns, lower band stylized plants in urns, crowns and inscription: \"Martha Phillcox aged 9 years 1843;\" several small holes and breaks."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0ac1bbb0-d57e-3a54-9f34-855395960f1a> .

