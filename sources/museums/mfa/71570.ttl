        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Two pieces seamed.  White linen \"goose-eye\" ground, showing bands of conventionalized birds or birds flanking trees, stars and geometrical ornamnents.  Pattern defined by secondary blue cotton wefts in overshot weave, reversible.  Narrow white cotton bands between plain blue bands.  Letter \"P\" marked in blue cross stitch in one corner.  A few stains.  Some blue yarns worn off."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/3e61db89-c17c-3fcd-b592-957469735920> .

