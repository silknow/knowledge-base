        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "General Winfield Scott, scene from the Mexican war. Two pieces stitched at center.  Ground: white cotton.  Design: printed in colors from engraved roller; Generat Scott mounted on a white horse leads American cavalry against the Mexicans; blue mountains (?) in distance, flowers and foliage in foreground, and separating scenes.  Colors: brown, green, reddish orange, blue and yellow.  Glazed. Pieced."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/99f1fe4a-dc19-3b3c-9c09-c30c49793a33> .

