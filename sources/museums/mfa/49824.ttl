        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Woodblock printed cotton by Favre, Petitpierre et Cie.  showing the Toilette of Venus under a neoclassic canopy and with a corinthian tholos in the background; this scene is alternated with scenes of the Merchant of Love.  Secondary subjects include a fishing scene, a grist mill, a courting couple in the 18th century dress and a peasant with a castle in the background.  Polychrome; pieced."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/45c45c47-593b-34a8-b260-c1aa126d87b3> .

