<http://data.silknow.org/object/652e5e62-f160-3cc7-ada7-83de38cdadcf>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "The name of the maker appears in the middle of lower part \"Harriet Thresher Aged 12 years. 1808\", worked in cross stitch with light bown silk, framed with dark green. On the right a shepherd with his dog, on the left a bird on a fence near a gate. Above framed by a wave or fret pattern worked with brown silk is the 13th verse of the 58th chapter of Isaiah, to which is added \"May this be my motto\", worked in cross stitch with pale neutral lavender silk. Above, worked with blue silk is the 15th verse, 1st chapter of Timothy. On each side a stag between two pointed trees, worked with light brown and dark green silk. Above this five horizontal rows with letters of the alphabet and numerals worked with wool and silk, in red, light neutral orange, neutral yellow, brown, green, and blue. Frame of red cross stitch around edge."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/4b3dc00e-bfc2-3bc4-8674-88e97bdf9a5b> ;
        ecrm:P3_has_note               "The name of the maker appears in the middle of lower part \"Harriet Thresher Aged 12 years. 1808\", worked in cross stitch with light bown silk, framed with dark green. On the right a shepherd with his dog, on the left a bird on a fence near a gate. Above framed by a wave or fret pattern worked with brown silk is the 13th verse of the 58th chapter of Isaiah, to which is added \"May this be my motto\", worked in cross stitch with pale neutral lavender silk. Above, worked with blue silk is the 15th verse, 1st chapter of Timothy. On each side a stag between two pointed trees, worked with light brown and dark green silk. Above this five horizontal rows with letters of the alphabet and numerals worked with wool and silk, in red, light neutral orange, neutral yellow, brown, green, and blue. Frame of red cross stitch around edge."@en ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/652e5e62-f160-3cc7-ada7-83de38cdadcf/dimension/2> , <http://data.silknow.org/object/652e5e62-f160-3cc7-ada7-83de38cdadcf/dimension/1> ;
