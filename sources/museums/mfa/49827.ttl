        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Natural cotton ground, block-printed in black, red, blue, mauve and neutral yellow.  Small section of a repeat showing gnarled flowering branches on which are perched two birds.  Ground covered with powder of a black motif straight sides and scalloped side bound with natural linen tape.  Lined with coarse natural linen and quilted in wool.  Soiled; one ragged edge."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/e8b17bc1-dac8-397a-8d18-24f7cb761024> .

