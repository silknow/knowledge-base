<http://data.silknow.org/object/cbccdd4a-2827-300a-a553-30f3943a05d6/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Three pieces: one irregular (a) with right selvedge; two rectangular (b, c) with both selvedges.  Brick red on natural ground.  Three pieces matched do not show complete repeat, but each shows part of the pattern of slender undulating branches bearing carnations, roses, dahlias, zinnias, bellflowers, forget-me-nots, spotted lilies and other blossoms.  Various birds perch among the branches.  Cotton of all pieces browned, fox-marked; small dark brown stain on (a)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/cbccdd4a-2827-300a-a553-30f3943a05d6> .

<http://data.silknow.org/object/cbccdd4a-2827-300a-a553-30f3943a05d6>
