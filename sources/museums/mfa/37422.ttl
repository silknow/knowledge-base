<http://data.silknow.org/event/81dc4b7d-89c3-38a7-81ac-bb7fa5ef2110>
        a                              ecrm:E8_Acquisition ;
        ecrm:P14_carried_out_by        <http://data.silknow.org/actor/6c50c94c-12b6-3fc1-b6c6-5c7d64c00d2d> ;
