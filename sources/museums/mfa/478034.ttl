<http://data.silknow.org/object/021b7b90-ecc4-331a-a91e-4dc7eda637a4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Beige napkin with a field sprigged with shamrocks with an image of the Great Seal of the United States, with 20 stars. Around its head are 20 stars, with flowers above. The motifs in the wide border are oak branches with leaves and acorns. The lower border has a checked pattern and the inscription \"IWWI Coulson Manufactes Lisburn Ireland.\" Marked in ink, upper left corner: \"F(?) S Dabney - 56\""@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/021b7b90-ecc4-331a-a91e-4dc7eda637a4> .

