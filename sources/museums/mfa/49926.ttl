<http://data.silknow.org/object/f8fcbc35-503d-379c-a474-b2942ed8d575/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tabby-woven ground: linen warp, cotton weft.  Block-printed in pinkish red, blue, yellow ochre and black.  Wide red stripes on which appear cartouches showing a Chinese in a cart, a tree and birds.  Cartouches surrounded by floral garlands.  Narrow, decorated white stripes between red stripes, overlaid by large sprigs.  A few small holes and tears.  Complete width of design, but selvedge at right side only."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/f8fcbc35-503d-379c-a474-b2942ed8d575> .

<http://data.silknow.org/object/f8fcbc35-503d-379c-a474-b2942ed8d575>
        a                              ecrm:E22_Man-Made_Object ;
