        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "One of a set of seven. Red, orange, brown and shades of yellow crewels worked with a variety of stitches, including stem, seed, buttonhole, lattice work, French knots, bullion, etc., on a linen-and-cotton weft twill ground fabric. The design shows a central tree island with bizarre flowers and exotic fruits. Condition: Good."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/15d4c0fb-e485-32ef-9e3d-d62e30e6f81e> .

