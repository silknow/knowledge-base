<http://data.silknow.org/object/3355ee5d-e8f3-3beb-8e0d-cb7c83fc339b>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Chinoiserie.  Piece, long rectangle, with another piece, possibly from a different print, sewn into lower left corner.  Blue copperplate print on white ground.  Main section shows Chinese man piping while child dances; trees, insects and a pagoda-like parasol surround this group.  Inset piece shows Chinese man kneeling in front of a seated figure in a draped pagoda; parts of tree and rock surround this.  Faded, worn, three holes; smaller section in better condition."@en ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d5db9dba-c51b-39aa-bef0-5ff89795a423> ;
