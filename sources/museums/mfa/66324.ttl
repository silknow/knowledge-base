        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Square cover.  Material: two thicknesses of white cotton.  Upper thin, lower coarse, paired warps and wefts.  Design: elaborate rococo pattern with floral forms, birds, nymphs, etc., worked in white linen thread with heavy quilted outlines, laid work and French knots, with drawn work, and worked on thin material, under which coarse material has been cut away.  In the corners these words appear \"Begonnen, Den 19, January, 1750.\"  See Symonds-Needlework through the Ages, plate 52 .1"@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/66c650b6-6796-3e9a-8151-1459b5aea535> .

