        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Various naturalistic motives arranged in open rows including bucolic and a chinoiserie scene, a cat, floral grouping and a row of geometric designs. In the center are the initials, in Gothic letters, \"ML\" and the date (possibly altered) 1752.  The ground is entirely covered by white wool yarns. Slightly soiled.  Stitches:  canvas work including cross, Florentine, plush, reverse tent, tent."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/b330753b-8a66-3093-b82a-df709199ec8a> .

