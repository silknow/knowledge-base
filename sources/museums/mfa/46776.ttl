<http://data.silknow.org/object/37b2ae73-7cf5-37d4-8606-d713f30ef3b5/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Linen worked in white with designs for drawn-work and flat embroidery.  In the middle are sections of four flower patterns, around the edge rectangles filled with small geometric figures.  In the center the initials M A M and the date 1761 are worked in white;  lined with pink linen and edged with pink ribbon."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/37b2ae73-7cf5-37d4-8606-d713f30ef3b5> .

