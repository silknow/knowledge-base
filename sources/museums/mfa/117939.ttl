        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record 65.1033" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/359b2dbf-57d8-3e5d-a7be-b65102d8168a/observation/1> , <http://data.silknow.org/object/359b2dbf-57d8-3e5d-a7be-b65102d8168a> , <http://data.silknow.org/event/76a1796e-f712-3020-87a0-50341fe4977d> , <http://data.silknow.org/object/359b2dbf-57d8-3e5d-a7be-b65102d8168a/category/1> , <http://data.silknow.org/image/9033b1cb-b42b-3f82-b431-084a712d3d34> , <http://data.silknow.org/event/377cd51e-4a82-3115-9b66-202d20291e17> , <http://data.silknow.org/production/c8e710c0-0f50-349a-a7bb-fc7997e29706> , <http://data.silknow.org/collection/ea88f538-91f9-3d9f-aa56-b191ba89e918> , <http://data.silknow.org/object/359b2dbf-57d8-3e5d-a7be-b65102d8168a/domain/1> ;
