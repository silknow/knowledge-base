<http://data.silknow.org/object/50ade1f4-e407-3996-a257-fd32e367a0d0/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Cream colored satin ground, worked with light polychrome silks in satin, knot, couching, stem, and long and short stitches, narrow border striped blue and white, scene showing Christ with two apostles seated at table; lower center embroidered coat of arms flanked by inked inscription: \"Dedicato al Signor Giovanni Michielli\", below bottom border inked inscription: \"Nostro Signore con li Due Appostali in Enemeus in Venezia Del 1793\", several holes in satin touched up with paint."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/50ade1f4-e407-3996-a257-fd32e367a0d0> .

