        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "In the center foreground, a richly dressed man stands on the bow of a sailing vessel.  He is identified as Ulysses by the scarf across his breast inscribed with FACVDVS VLIXES (\"Resourceful Ulysses).  He holds a pole in his right hand and rests his left hand on the shoulder of a leopard.  Behind him, at the left, two sailors sound trumpets; two others handle rigging lines at the right.  \n\nNOTE:  it is believed that the armorial shields represented in this set of tapestries refer to the families allied with that of Ferry de Clugny."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0e98f220-f0ca-3d8a-9417-e7a97781a1c1> .

