        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "The ground is faded orange satin.  The design, which consists of a repetition of the scene in the garden when Christ appears to Mary Magdalene, is woven with linen thread wound with gilded gold-beaters skin;  the faces and hands are woven with white silk and the ground with green silk."@en ;
