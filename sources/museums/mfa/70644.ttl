<http://data.silknow.org/object/83e989a9-5949-37a9-ae95-b1b3294207f8/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "White woolen cloth closely embroidered with a design of conventional animals, flowers, women and birds.  The ground is worked with dark red wool; the design with blue, green, yellow and black wool and white cotton.  Of the same type as the embroidered Spanish rugs.  Worn and moth-eaten.  (See note on 96.109)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/83e989a9-5949-37a9-ae95-b1b3294207f8> .

