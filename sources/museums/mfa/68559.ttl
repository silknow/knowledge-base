        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Two pieces of lace, one a narrow insertion made with white linen thread and a zig-zag design, the other a white edging made with white linen and light blue silk and with a close design of leaf-like forms.  Between these pieces of lace is a piece of white linen on which is laid-work embroidery worked with white silk and white cotton.  Like 11.83."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/13e68f16-fb06-30c4-8dc4-fcacfc854c81> .

