        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Ground:  cream colored linen.  Design: a variety of small conventional figures across the top including a ship, a cray-fish and the date 1788 with six rows of letters and numerals, and below this the tree of knowledge with the serpent, a peacock, the crucifixion, and the date 1787, worked in cross stitch with colored silk (several shades of pale blue, green, yellow, neutral pink and violet with a little crimson)."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0a39232d-b786-393a-8a5e-add677298616> .

