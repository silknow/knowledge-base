<http://data.silknow.org/object/0fabbf6a-2fc4-3bf9-9552-a20c0393705d/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Pongee colored silk, on which is printed with bright green, blue, yellow, red and black, a design of long leaves, heart-shaped leaves, crowns and irregular forms. On one side is a border of scattered flower forms. This piece was designed, it is said by Alma-Tadema or Walter Crane. There are several yards of this which have been put in the duplicate collection."@en ;
        crmsci:O8_observed  <http://data.silknow.org/object/0fabbf6a-2fc4-3bf9-9552-a20c0393705d> .

