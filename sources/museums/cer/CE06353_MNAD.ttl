<http://data.silknow.org/object/e14cdbab-e10c-3ed4-8876-6797ea92f862/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Terciopelo de seda verde, cortada con perfiles rizados sobre fondo ocre. El tema es una composición vegetal de hojas, frutos y roleos, todo enlazado, sin poder apreciar la composición por la estrechez del ejemplar. Rematada en sus extremos con estrecho fleco de seda blanca, amarilla y roja muy perdida con galón dorado. Cruces en el centro y extremos."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/e14cdbab-e10c-3ed4-8876-6797ea92f862> .

