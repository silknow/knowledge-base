<http://data.silknow.org/image/2db76e05-9ac7-35c9-990a-9107bad058ec>
        a                 ecrm:E36_Visual_Item ;
        rdfs:comment      "Fuente: Flores;   En el centro de la cara del país: Escena galante"@es ;
