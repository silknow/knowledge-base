<http://data.silknow.org/object/bbd67e9e-dd94-3af6-8a2b-bd2c6c2560f7/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Escabel de Virgen. Forma de rectángulo ondulado del mismo estilo del trono con el que hace juego. Grandes faldones y patas cortas adornadas con tallas en forma de hojas de acanto y palmas; sobre ellas, seis cabezas de angelotes que rodean el escabel. Tapicería en terciopelo rojo con guirnaldas bordadas con hilo de plata. El bordado en el centro. Hace pareja con el sillón con el nº de inventario CE05438."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/bbd67e9e-dd94-3af6-8a2b-bd2c6c2560f7> .

