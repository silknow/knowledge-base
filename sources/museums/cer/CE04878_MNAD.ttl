<http://data.silknow.org/object/79a787dc-f614-39d7-974f-ca08a9c5bde6/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Bibliografía comparada:  \n-ARMSTRONG, Nancy: A Collector´s History of  Fans, London, 1974, Studio Vista, 1974,  p. 173,  nº 116.  \n-EZQUERRA DEL BAYO, Joaquín: Exposición de El abanico en España. Catálogo General Ilustrado, Madrid, Sociedad Española de Amigos del Arte,1920, cat. 199  \n-FILIPPINI SACHETTO, Amalia; TESTONI SASSI, Lidia: Un soffio di vanità. Ventagli da collezione private italiane, Padova,  De Luca Edizioni d´Arte, 1989, p. 89, nº  55.   \n-GRAY BENNETT, Anna: Unfolding beauty. The art of the fan, Boston,Thames and Hudson, 1988, p.251, nº 43.2098.  \n-GOSTELOW, Mary.: The fan, Dublín, 1976, p. 86, nº 68.  \n-PERTHUIS de, Françoise; MEYLAN, Vincent : Éventails, París, 1989, Hermé, p. 122."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/79a787dc-f614-39d7-974f-ca08a9c5bde6> .

<http://data.silknow.org/event/d5f7b04b-ea3e-3bbe-b6ab-4a1dad2b50a7>
        a                             ecrm:E10_Transfer_of_Custody ;
        ecrm:P29_custody_received_by  <http://data.silknow.org/actor/cd33bfdf-4ad1-3bf2-9bb0-625185eb7e0a> ;
