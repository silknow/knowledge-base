<http://data.silknow.org/object/7f731ccd-8fc0-3910-91a9-ec56ffae7d80/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Álbum en el que se representan mujeres de distinta edades, clases sociales y en diferentes actitudes, sin policromía. Encuadernado en papel cartón, tiene una portada original que representa a un hombre con cabeza de ratón grabado con texto y coloreado en azul y rosado. Sus cantos van pegados en papel, tela roja y cosidos con cordón de seda roja."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/7f731ccd-8fc0-3910-91a9-ec56ffae7d80> .

<http://data.silknow.org/object/7f731ccd-8fc0-3910-91a9-ec56ffae7d80>
