        schema:contentUrl  <https://silknow.org/silknow/media/ceres-mcu/CE18315_MNAD_0.jpg> , <http://ceres.mcu.es/pages/Viewer?accion=42&AMuseo=MNAD&Ninv=CE18315&txt_id_imagen=1> .

<http://data.silknow.org/object/f10d647b-e321-3545-a956-dc5cf29afbb9/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Carné de baile de marfil. En óvalo, ocupando casi toda la tapa, jarrón con diversas flores finamente talladas. Lomo de terciopelo azul celeste. Lapicero de marfil con la punta de plomo. Forro de moaré gris. El libro de notas editado por Courtois, tiene un grabado. Representa caballero y dama escuchando a otra que toca la mandolina. En el semanario, los nombres de los días en francés orlados de flores. El calendario, de 1854, está adornado con dos grabados, representando, por un lado, tres jóvenes en una lancha, y por el otro, en fondo de paisaje, grupo formado por caballero, dama y niña."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/f10d647b-e321-3545-a956-dc5cf29afbb9> .

