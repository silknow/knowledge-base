        rdfs:label          "Record CE24122" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/3866f062-f905-3ed8-8ba2-3dc48397a88c> , <http://data.silknow.org/image/14aeefe0-a1e1-3b2a-940b-b755da829758> , <http://data.silknow.org/image/58cd0ebe-f4db-3078-9ce8-55dddbc53e77> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb/observation/3> , <http://data.silknow.org/image/aeb72372-8c43-3ab5-b8b0-0e1c3c4e0863> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb/domain/1> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb/observation/2> , <http://data.silknow.org/event/835486ab-69d1-3432-a38b-be6da528514f> , <http://data.silknow.org/image/ce78bff6-9b1a-386f-8425-50512cb34d2b> , <http://data.silknow.org/image/8683328d-225a-366e-9a64-3ecb10b267f6> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb/observation/1> , <http://data.silknow.org/image/932e833d-2c01-3d27-85a9-52f1906fb4e5> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb> , <http://data.silknow.org/production/939af9f1-6dae-3f2d-8539-b25597925ce5> , <http://data.silknow.org/object/8dab5bb6-5509-3127-a56d-e67aff0aaceb/category/1> , <http://data.silknow.org/image/f217051b-8132-3ff6-b1d3-248393da533b> , <http://data.silknow.org/image/1584135d-2629-3eaa-84a2-33ca58205b2b> , <http://data.silknow.org/image/77d1ad59-062d-3ead-bb59-95b9469d30e6> ;
