        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE01402" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8/domain/1> , <http://data.silknow.org/object/bd5452fe-8b39-34ae-858a-be35a22072c9> , <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8/observation/1> , <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8/category/1> , <http://data.silknow.org/image/b2331e58-d94a-3a91-8b16-27add05adc3c> , <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8/domain/2> , <http://data.silknow.org/event/1db18822-c90a-3372-932e-8363ab7dd22c> , <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8/observation/2> , <http://data.silknow.org/object/819ff6e7-1c32-3bda-8166-9282409e85c8> , <http://data.silknow.org/image/3ccaf515-36a4-343f-a9fb-20f2820e500a> , <http://data.silknow.org/image/994f7140-17a9-33d3-9e6b-e59b2eed21a2> , <http://data.silknow.org/production/a6f6c0d4-0ac5-3ec7-8ab2-e0a44e30cf52> , <http://data.silknow.org/event/05f7d6ab-16a2-3561-9e7c-56e885f480cb> ;
