<http://data.silknow.org/object/6a9722fe-031f-353b-9513-4780ccee2b5d/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Sofá de dos plazas con respaldo recto y tapicería de seda de color crudo.   \nEl mueble apoya sobre patas rectas. El asiento, el respaldo y los brazos están tapizados en seda de color crudo con motivos vegetales. La parte inferior delantera, así como un fragmento de la parte inferior de los laterales, están decorados con flecos de un color un poco más oscuro que el del tapizado."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/6a9722fe-031f-353b-9513-4780ccee2b5d> .

