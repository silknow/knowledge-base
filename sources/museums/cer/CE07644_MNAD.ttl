        ecrm:P108_has_produced  <http://data.silknow.org/object/ae34eca4-2d15-32e5-94e8-32be054080f8> ;
        ecrm:P126_employed      "Seda [beige muy torsionada]  Seda blanco"@es , "Seda verde [hilo metálico dorado arrollado a seda verde muy torsionada]  Seda beige"@es , "Seda salmón"@es ;
        ecrm:P32_used_general_technique
