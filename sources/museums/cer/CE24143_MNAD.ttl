        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento textil rectangular de seda espolinada con fondo de seda en su color natural con ligamento de tafetán. Orillo en los dos laterales en su color natural.  Con motivos florales como decoración. Dispuesta en bandas horizontales repetitivas, y en el centro un ramillete compuesto de diferentes flores. Colores: marrón, azul, salmón, verde"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/eac65dd7-e429-3727-812a-84453a30873e> .

