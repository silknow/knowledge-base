<http://data.silknow.org/object/e33b8e45-0ce5-3c45-85ce-67ad8bcc791c/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Cubrecáliz realizado con seis piezas de tejido Pequín en el que se combinan bandas verticales de motivos de dirección contrapuesta en terciopelo cortado y tramas de lamé de plata, que se separan entre sí por estrechas hileras de sarga de seda de color marfil. La decoración alterna diminutos y esquemáticos ramitos florales con motivos geométricos en V. El interior está forrado con tejido de tafetán de seda de color marfil."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/e33b8e45-0ce5-3c45-85ce-67ad8bcc791c> .

