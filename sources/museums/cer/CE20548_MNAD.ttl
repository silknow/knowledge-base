        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Mantón cuadrangular con fondo en blanco marfil. Posee decoración floral bordada en rosa, púrpura, amarillo, azul y verde. Cenefa de peonías en distribución rítmica de colores, acompañadas de hojas, otras flores y capullos. Crisantemos también se intercalan hojas y otras flores. La cenefa enmarca un cuadrado formado por peonías en los ángulos. Remate en el borde con flecos en el mismo tono que la base."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/683dd79f-5c5b-3c14-bcaa-f8ec569dbe75> .

