<http://data.silknow.org/object/41115f1f-8c43-3ba3-9036-d6c04e4a8101/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Libro de diseños decorativos. Colección de tres volúmenes con el mismo tipo de encuadernación con papel doble estampado. Esquinas pegadas con papel de tela verde y atados con cordón de seda morado y con la misma cartela en portada. Predominio de formas geométricas, vegetales estilizados. Gama de colores variados, con predominio de los colores marrón, verde y plateado.  \nVolumen I: Portada en marrón con elementos vegetales en blanco. Diseños ordenados de derecha a izquierda, del 1 al 20, con las páginas de la 1a la 4 realizadas en papel  de seda simple de color naranja con grafía estampada al igual que en la contraportada."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/41115f1f-8c43-3ba3-9036-d6c04e4a8101> .

<http://data.silknow.org/object/41115f1f-8c43-3ba3-9036-d6c04e4a8101/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/historical-observation> ;
        ecrm:P3_has_note    "Arte Japonés"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/41115f1f-8c43-3ba3-9036-d6c04e4a8101> .

<http://data.silknow.org/object/41115f1f-8c43-3ba3-9036-d6c04e4a8101>
