        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tapete bordado en seda color marrón. La banda central se decora con un pájaro rodeado de ramas y tallos enroscados. Esta banda, está delimitada por dos grecas con \"eses\" paralelas e inclinadas y en el exterior grecas con bordado corrido de realce. Rematado por puntilla formando ondas de filtiré.  Un pájaro como motivo principal, rodeado de elementos geométricos."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/7de0c6ea-e43c-32ae-a1c6-c075522e1251> .

