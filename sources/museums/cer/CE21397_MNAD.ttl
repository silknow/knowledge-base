        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Moderna"@es , "Tejido compuesto por dos fragmentos. Damasco azul y amarillo con dos orillas amarillas. Motivo decorativo muy grande, incompleto a lo largo y a lo ancho. Combina raso por trama y raso por urdimbre. El camino está dividido en dos espacios; uno circular cortado por las orillas y el otro romboidal, en el que se inscribe un gran jarrón central y marco lobulado con triángulos contrapeados.  En el espacio circular, cinta con ajedrezado, cenefa vegetal estilizada, cinta lobulada apuntada con triángulos contrapeados y florón central."@es , "Para el jarrón ver: BUNT. Spanish Silks. Figura 50."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/691e60ef-aa2d-3410-a2af-ea653a808192> ;
        ecrm:P3_has_note               "Para el jarrón ver: BUNT. Spanish Silks. Figura 50."@es , "Tejido compuesto por dos fragmentos. Damasco azul y amarillo con dos orillas amarillas. Motivo decorativo muy grande, incompleto a lo largo y a lo ancho. Combina raso por trama y raso por urdimbre. El camino está dividido en dos espacios; uno circular cortado por las orillas y el otro romboidal, en el que se inscribe un gran jarrón central y marco lobulado con triángulos contrapeados.  En el espacio circular, cinta con ajedrezado, cenefa vegetal estilizada, cinta lobulada apuntada con triángulos contrapeados y florón central."@es , "Edad Moderna"@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/image/65cc7a08-839e-3b0d-8c02-98dd30961105> ;
        dc:identifier                  "CE21397" .

