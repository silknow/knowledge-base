<http://data.silknow.org/object/be6040a3-73ae-3a39-a31b-cf951fe5c941/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Dos fragmentos que formaban parte de una casulla. Sobre un fondo beige se dispone una decoración de motivos florales y vegetales de gran tamaño contrapeados, ordenados en registros verticales, realizados en seda de distintos colores (verde, azul, marrón, morado, amarillo...). Tiene varias costuras y forro de algodón en su color. La otra mitad de esta casulla tiene número de inventario CE24976.  \n  \nLigamentos:  \n- Raso por urdimbre  \n-Tramas espolinadas que ligan en sarga  \n-Chenilla  \n-Acanalados"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/be6040a3-73ae-3a39-a31b-cf951fe5c941> .

<http://data.silknow.org/actor/cd33bfdf-4ad1-3bf2-9bb0-625185eb7e0a>
