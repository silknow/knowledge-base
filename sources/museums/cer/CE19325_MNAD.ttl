<http://data.silknow.org/object/c3061d18-f3fa-3492-a980-be0e4113588f/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Frontal de altar de terciopelo cortado y bucleado, con decoraciones de bordado de aplicación. Las decoraciones del terciopelo están silueteadas con punto de cadeneta. En los laterales, en la parte inferior, escudo nobiliario de los Enríquez."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/c3061d18-f3fa-3492-a980-be0e4113588f> .

