        ecrm:P2_has_type    <http://data.silknow.org/observation/historical-observation> ;
        ecrm:P3_has_note    "Época Luis XIV   Edad Moderna   Barroco"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/4ed7bf29-9b9a-32bd-8789-695267a37f7c> .

<http://data.silknow.org/production/4e6a4798-cdfa-36a4-b361-7d332733c64b>
        a                       ecrm:E12_Production ;
        ecrm:P108_has_produced  <http://data.silknow.org/object/4ed7bf29-9b9a-32bd-8789-695267a37f7c> ;
        ecrm:P126_employed      "Hilo metálico [plateado arrollado a alma de seda muy torsionada]  Hilo metálico plateado [arrollado a alma de seda]  Seda beige"@es , "Seda marrón"@es , "Seda rosa"@es ;
