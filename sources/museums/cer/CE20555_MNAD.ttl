<http://data.silknow.org/object/006a826b-5db7-3d59-afd8-75627c640e25>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Contemporánea"@es , "Mantón de Manila cuadrangular de color salmón con decoración bordada. Cenefa perimetral, formada por pequeñas ramas de cerezo, flores, espigas y racimos de uvas. Bordado igual en sus cuatro ángulos formando un cuadrado de escenas figurativas. Cuatro personajes masculinos pescando, adornando la escena peonías, árbol de la pimienta, un almendro y un cerezo, cangrejos, pájaros, mariposas y elementos arquitectónicos. El centro del mantón se resuelve con flores, ramas, mariposas, pequeños elementos arquitectónicos sueltos y una pequeña peonía central. Fleco de color dorado."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/0eacfa89-45b1-3ccd-911e-06fc47c06c86> ;
        ecrm:P3_has_note               "Edad Contemporánea"@es , "Mantón de Manila cuadrangular de color salmón con decoración bordada. Cenefa perimetral, formada por pequeñas ramas de cerezo, flores, espigas y racimos de uvas. Bordado igual en sus cuatro ángulos formando un cuadrado de escenas figurativas. Cuatro personajes masculinos pescando, adornando la escena peonías, árbol de la pimienta, un almendro y un cerezo, cangrejos, pájaros, mariposas y elementos arquitectónicos. El centro del mantón se resuelve con flores, ramas, mariposas, pequeños elementos arquitectónicos sueltos y una pequeña peonía central. Fleco de color dorado."@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/image/cece03ca-20ac-3e67-b324-cd1f7d4929c9> ;
        dc:identifier                  "CE20555" .

<http://data.silknow.org/production/a5178624-6cf8-37cd-b76c-1e4252baa161>
