        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Dos fragmentos textiles. Bordado sobre tejido de color azul. Son dos fragmentos iguales cosidos a repulgo. La decoración de motivos florales con movimiento ascendente y un motivo similar a una rocalla. Hilos de seda lasa de diversos tonos verdes, rojizos y morados y punto de matiz. Hilos y láminas de plata tendidos y en relieve. Con lentejuelas."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/caecf31a-946c-36ef-983a-cbf50aa6fb73> .

