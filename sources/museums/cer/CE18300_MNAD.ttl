<http://data.silknow.org/object/6c1365a0-1462-36e9-9646-be4cff7c519f/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Aunque no se ha podido identificar al autor, cuya marca aparece en otras agendas de esta colección, por contraste de fechas y otors punzones que acompañan al suyo, se sabe que tuvo actividad en París, principalmente durante la tercera y cuarta décad del siglo XIX."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/6c1365a0-1462-36e9-9646-be4cff7c519f> .

<http://data.silknow.org/event/dd19d80b-3209-36df-8829-5022276daefa>
        a                             ecrm:E10_Transfer_of_Custody ;
        ecrm:P29_custody_received_by  <http://data.silknow.org/actor/cd33bfdf-4ad1-3bf2-9bb0-625185eb7e0a> ;
