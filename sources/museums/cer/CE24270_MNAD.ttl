        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE24270" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98/observation/1> , <http://data.silknow.org/image/0ecde464-2e6c-3fab-8e91-b894398227bd> , <http://data.silknow.org/production/0ef9e809-621c-301a-aedb-ed397d0dde1b> , <http://data.silknow.org/event/4686872c-7143-3645-936b-ed9e8c36dc4a> , <http://data.silknow.org/image/4d50b28b-fce8-3b4b-88c7-69405221698a> , <http://data.silknow.org/image/1a31d425-c010-34a0-ae81-1cdb0437b0cf> , <http://data.silknow.org/image/8e6f8ef0-c037-37b9-a66b-067e27875716> , <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98/domain/1> , <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98> , <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98/observation/3> , <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98/category/1> , <http://data.silknow.org/event/8ae9f680-c0f2-368a-8441-416de051c332> , <http://data.silknow.org/object/b97220cd-f441-3fac-95c9-cb3f4e597c98/observation/2> , <http://data.silknow.org/image/7b5f7d02-3bed-3982-8e80-9a88aa8c4bd8> ;
