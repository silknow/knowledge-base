<http://data.silknow.org/object/9fc55cbf-8575-359e-b61f-fd8218416418/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "La composición del jarrón central entre cartelas y hojarasca es un trazado clásico del siglo XVII"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/9fc55cbf-8575-359e-b61f-fd8218416418> .

<http://data.silknow.org/object/9fc55cbf-8575-359e-b61f-fd8218416418/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Está bordado sobre raso azul con oro y plata mediante una composición de jarrón central florido entre carteles y hojarasca en trazado clásico del siglo XVII. Las técnicas del oro son las clásicas del momento: oro matizado, tendido, enjarado. Y las sedas en cordoncillo y falsa cadeneta matizados dentro de la misma tonalidad. La pieza se remata con un estrecho fleco de cordoncillo de oro."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/9fc55cbf-8575-359e-b61f-fd8218416418> .

