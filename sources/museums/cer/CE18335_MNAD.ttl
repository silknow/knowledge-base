        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Carné de baile con tapas de plata sobredorada y repujada con rocallas. En la tapa anterior, incrustadas, plaquetas troqueladas con escenas pastoriles y cupido en bajorrelieve. En la tapa posterior, las reservas con labor de \"guilloché\". Lomo de terciopelo azul. Forro de moaré blanco. Marcas. Libro de notas con semanario y calendario en francés, del año 1842. Lapicero grabado con retícula."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/09666737-d237-3b62-bcd1-2fa49883b3a1> .

