<http://data.silknow.org/object/142aad2a-6d1d-3391-ab55-5bcb9d1c3d4a/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Asiento de planta trapezoidal, respaldo plano con remate \"de chapeaux\" y motivo de cinta. Patas en forma de estípites acanaladas, con molduras clásicas por arriba y por abajo, y cuatro tacos cúbicos con flores a cada lado. El contorno del respaldo y del asiento están recorridos por sencillas estrías. Tapizado en asiento y respaldo, con fondo rojo, y motivos de acantos y flores sobre fondo beige."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/142aad2a-6d1d-3391-ab55-5bcb9d1c3d4a> .

