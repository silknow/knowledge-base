        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Moderna"@es , "Fragmento de tejido, con una composición de estrellas negras y rombos carmín sobre fondo amarillo, elaborado en tafetán largo utilizando en el derecho los colores necesarios y pasando al envés las tramas no precisas. Las urdimbres son de seda roja sin torcer, igual que las tramas amarillas carmín y negras."@es , "Similar al fragmento del catálogo MAN, p.30, nº 25, INV: 65431. Se compró al mismo vendedor."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/fe96c755-e3e8-3215-a987-72b5598d2ef4> , <http://data.silknow.org/image/33148662-fd92-3662-a914-c122a2402aaf> , <http://data.silknow.org/image/6aaa2c67-85d2-307d-a3e9-793e14dab4f1> , <http://data.silknow.org/image/56dd26ae-a73c-3d33-96e3-063925dfeaf4> , <http://data.silknow.org/image/e5942fc5-e9e8-3adc-8736-0df4df17fdb9> , <http://data.silknow.org/image/746bb54f-2950-367d-b49a-edaa52eb6fd8> , <http://data.silknow.org/image/dd4c50e9-1d7d-3698-a86e-2c21b14fffaf> , <http://data.silknow.org/image/7b9b82c4-532b-306f-b9ef-9b47080bf4f5> , <http://data.silknow.org/image/d0844329-d109-3ee3-b106-4eff96ab9adf> , <http://data.silknow.org/image/98e82f8c-5262-3b4e-aef1-efb9639c90b3> , <http://data.silknow.org/image/dbb670b1-bb2e-3877-bb08-a99195b9904d> ;
