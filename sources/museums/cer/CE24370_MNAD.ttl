<http://data.silknow.org/object/f18b7306-55fd-3f7f-8914-ec79e7ee4b0b/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmentos de estola o manípulo. Bordado de hilos metálicos con puntadas de hilo de seda. El tejido principal son dos trozos unidos. Además de este tejido tiene una tela de fibra vegetal y ligamento de tafetán reforzando el bordado, un forro intermedio de las mismas características y color. También tiene otro forro color salmón de damasco y una última tela de fibra vegetal en color morado con un acabado de cera."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/f18b7306-55fd-3f7f-8914-ec79e7ee4b0b> .

