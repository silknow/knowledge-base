        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE24632" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/d30623ad-f917-3da1-95bf-c8fc1c3d846f> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/observation/2> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/observation/3> , <http://data.silknow.org/event/321153ea-3592-3919-b679-c3d4bdc62d94> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847> , <http://data.silknow.org/production/efbe81ef-0247-3da0-9045-fa8543b3fa18> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/domain/2> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/category/1> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/observation/1> , <http://data.silknow.org/image/6aa07a28-1b16-34e6-a2aa-35e3583ec521> , <http://data.silknow.org/object/2e711f3e-78fe-3fbb-a95c-f7f42a1a3847/domain/1> ;
