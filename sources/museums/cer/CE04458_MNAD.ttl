<http://data.silknow.org/object/a44a9af3-53a8-30bc-8905-1802ec4db5f1/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Respaldo ovalado, disminuido por la parte inferior de los lados. Asiento casi circular; como el respaldo, va henchido y tapizado en seda beige floreada. Ménsulas formadas por dos animales fantásticos, cuyo pecho va adornado con guirnaldas de hojas y flores, en madera dorada,  imitando bronce, del mismo tipo que las que adornan el copete del respaldo, el faldón delantero del asiento y la parte superior de las patas, molduradas."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/a44a9af3-53a8-30bc-8905-1802ec4db5f1> .

