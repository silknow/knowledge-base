<http://data.silknow.org/object/e088fb1c-f8fe-3837-8e11-09ecdaf1d702/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Mantón de Manila cuadrangular en color marfil con bordados iguales dos a dos en diagonal presentando motivos florales y zoomorfos. Posee varias cenefas perimetrales con bordados de flores, personajes y arquitecturas chinas, una exterior de pequeño tamaño e interior de mayor tamaño. En la parte central de la pieza pequeñas flores, insectos y aves."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/e088fb1c-f8fe-3837-8e11-09ecdaf1d702> .

