        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Silla de madera pintada de verde claro con tallas doradas en el respaldo y una ligera decoración de temas vegetales y un ave que parece ser un flamenco, también en dorado. El respaldo es alto, calado, con pala central. El copete está decorado por una talla en forma de concha y tallas de temas vegetales a ambos lados. Asiento trapezoidal, patas delanteras cabriolé, chambranas en \"H\". Tapicería rayada gris claro."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/a8844c0e-f73c-3fe0-9d0b-5ceb14139022> .

