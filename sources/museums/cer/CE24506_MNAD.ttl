        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE24506" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/0db48d03-afe8-3181-a9d1-5caa7d74793d> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/domain/1> , <http://data.silknow.org/image/31f5efbc-2c33-3319-8dfa-2657d5b0c581> , <http://data.silknow.org/image/71fd5971-2513-3050-b84e-28cda2345143> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/domain/2> , <http://data.silknow.org/image/313701de-6d25-3c99-943a-0956376af450> , <http://data.silknow.org/event/8c471987-feb6-371b-b5ff-e87a52176949> , <http://data.silknow.org/production/3a36ba47-df12-3f64-8b83-45bf19f7667e> , <http://data.silknow.org/image/c78ccc19-0798-320d-95f9-ebdb5d0af3c1> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/category/1> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/observation/1> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/observation/2> , <http://data.silknow.org/image/abb36dd5-fb99-3b6a-8408-a41d578145e2> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011/observation/3> , <http://data.silknow.org/object/e095dbdc-796e-3dfd-a1c6-1e96a7ce8011> , <http://data.silknow.org/image/7d89235e-aec7-381d-819d-67743be4be5d> ;
