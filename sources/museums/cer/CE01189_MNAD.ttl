        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE01189" ;
        ecrm:P129_is_about  <http://data.silknow.org/production/f42a286c-f735-3daf-bcf4-27e8eadbde2d> , <http://data.silknow.org/image/80afa24c-7266-36d7-8832-adcb5e820f00> , <http://data.silknow.org/event/edfe3b82-2b5c-3fed-add8-3ae16ff51fa5> , <http://data.silknow.org/image/504b0a93-5c85-3649-ab7d-ea27488b9c98> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/observation/3> , <http://data.silknow.org/image/98dcc936-524d-3ac2-b4b6-038630c778f2> , <http://data.silknow.org/image/4c417ba5-8720-3942-b1f2-5f5c7dc9031b> , <http://data.silknow.org/image/cdecfd34-ac5b-3f0c-8119-3bd84723a826> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/domain/1> , <http://data.silknow.org/image/57b02b3d-bb78-3f8c-a1fa-62e15eab55f7> , <http://data.silknow.org/image/f3d6632c-a1f4-34f2-8ca6-d4bdb544e962> , <http://data.silknow.org/image/8867d992-917b-31ea-a1d0-ec3ecc839b20> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/observation/2> , <http://data.silknow.org/image/ae8d3fd0-6480-3eaa-9b6a-3558a6270928> , <http://data.silknow.org/image/9e97313e-fc01-3083-be1f-f610637b9a40> , <http://data.silknow.org/event/6898c0c6-c027-367c-b8ee-2317f3134daa> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/category/1> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/domain/2> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b> , <http://data.silknow.org/image/e1ffb0c7-ff5e-39ad-b92f-df2fa6ba807b> , <http://data.silknow.org/image/1cd51ebf-b4b4-3fae-953a-ce74705aed48> , <http://data.silknow.org/object/5e91a329-aef3-3842-b33e-0dc5daf4080c> , <http://data.silknow.org/object/928c8a71-365f-324c-b1b2-73a79354587b/observation/1> , <http://data.silknow.org/image/8a29376e-8fcc-30e4-bfb4-8d2979c137ed> , <http://data.silknow.org/image/1cdc8b14-74b1-362c-8065-5c9fc210463d> ;
