<http://data.silknow.org/object/00c6ee93-8302-33ce-8220-12fc46fbfefa/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tejido labrado de seda rectangular, con fondo de raso de color granate y orillo con ligamento de tafetán en color rojo, amarillo, blanco y azul. Representa motivos vegetales y un águila coronada, de alas explayadas, que coge con las garras flechas que se hunden en un jarrón."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/00c6ee93-8302-33ce-8220-12fc46fbfefa> .

