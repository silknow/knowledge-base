<http://data.silknow.org/object/d46b209b-ce85-30bb-aa2c-63cf964b26e0>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Moderna   Renacimiento"@es , "Tapiz con la parte central presentando a Dios Padre, dentro de un arco iris, sostenido en el cielo por los símbolos alados de los cuatro evangelistas (ángel, león, buey y águila) y flanqueado por dos ángeles que le sostienen los brazos.  Esta compacta composición está rodeada de una gloria con multitud de querubines. El paño se enmarca en una espléndida cenefa con motivos decorativos de trenzados sobre un fondo azul, con el escudo de armas del Papa León X, de la familia de los Médicis, en los cuatro ángulos, sobre un campo dorado. Muchos de los detalles decorativos están realizados con hilos metálicos, además de abudantes tramas de lana y seda."@es ;
        rdfs:label                     "Dios Padre acompañado de los símbolos de los Evangelistas (La Trinidad); Visión de Ezequiel"@es ;
        ecrm:P102_has_title            "Dios Padre acompañado de los símbolos de los Evangelistas (La Trinidad); Visión de Ezequiel"@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/fff64c5d-2c0f-3b99-8c9d-8c12b3231d43> , <http://data.silknow.org/image/bb42983d-5b2c-394e-912b-8288c35705c7> , <http://data.silknow.org/image/28678c0c-853a-3cb2-a7f0-c9a33ffed7c2> , <http://data.silknow.org/image/e66e3843-63c1-3012-865b-f7d45b50e476> , <http://data.silknow.org/image/ff166909-0349-3b82-9790-cb83f7cb12b1> , <http://data.silknow.org/image/bc69e95e-a58f-36f3-8171-eb039fa18d8f> , <http://data.silknow.org/image/22cd7bb6-c6b4-3606-9776-02b97d6293af> , <http://data.silknow.org/image/2ef8c1c0-69d3-3f00-a0d2-dd38f48af089> , <http://data.silknow.org/image/dfbbe733-c87e-32ba-882a-f9074fd2299b> , <http://data.silknow.org/image/d8ac5155-e69b-388e-a1d1-1db48ddcb814> , <http://data.silknow.org/image/15a08a1d-f796-3e1a-b09f-35a414ca81ce> , <http://data.silknow.org/image/bd3e36b1-6db9-384b-85d2-5b84f6e7ff48> , <http://data.silknow.org/image/6fe92495-c607-3e01-bd2c-3e03bda67328> , <http://data.silknow.org/image/6ea3c264-fddc-34c6-8015-efe05e96e98d> , <http://data.silknow.org/image/7e55de79-6bcc-3abb-9672-19e4a13f376e> , <http://data.silknow.org/image/f2c88d0a-3311-325d-91f2-c57cdccd12f4> , <http://data.silknow.org/image/f3e2f18b-89a1-32c7-86c2-250e80bc03ad> , <http://data.silknow.org/image/524f335a-d097-3d39-9694-ba96bdc4da76> , <http://data.silknow.org/image/652dc23f-64fb-32c2-a6e3-5bb9bf478a44> , <http://data.silknow.org/image/f7899c60-6ee9-3713-be97-d068d66ca2f5> , <http://data.silknow.org/image/8360069b-089f-35e4-aaac-5d7039c1b28d> , <http://data.silknow.org/image/cb5c71c7-a4f5-3e21-b35c-a5dfac960bb0> , <http://data.silknow.org/image/0af01c41-32ef-3bf9-88e5-f49257716158> , <http://data.silknow.org/image/c1e97fd2-411b-338e-9412-d824223bc1c7> , <http://data.silknow.org/image/f9cb7d2e-59a7-3a94-99e2-7659c67af005> , <http://data.silknow.org/image/2ad6884b-947d-34f5-b164-ec243222d3b8> , <http://data.silknow.org/image/252c6f20-9375-3b47-b838-8cdb85ec55b1> , <http://data.silknow.org/image/93dbfa1d-2241-31e5-a1c8-51d967b329a6> , <http://data.silknow.org/image/e100ca0f-4b9b-3f3f-8a91-8125f3b95fc1> ;
        ecrm:P3_has_note               "Edad Moderna   Renacimiento"@es , "Tapiz con la parte central presentando a Dios Padre, dentro de un arco iris, sostenido en el cielo por los símbolos alados de los cuatro evangelistas (ángel, león, buey y águila) y flanqueado por dos ángeles que le sostienen los brazos.  Esta compacta composición está rodeada de una gloria con multitud de querubines. El paño se enmarca en una espléndida cenefa con motivos decorativos de trenzados sobre un fondo azul, con el escudo de armas del Papa León X, de la familia de los Médicis, en los cuatro ángulos, sobre un campo dorado. Muchos de los detalles decorativos están realizados con hilos metálicos, además de abudantes tramas de lana y seda."@es ;
