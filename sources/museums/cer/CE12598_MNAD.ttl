<http://data.silknow.org/object/6e0c2081-49a4-39fd-8815-abd333346fe9/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Sombrilla de tela blanca decorada con bandas de raso liso y acanalado sobrepuesto y asido a dicha tela. Alternan bandas de encaje negro con motivos vegetales y bandas de tela negra acanalada. Remata el borde una banda de encaje con decoración en sentido radial. Mango de madera tallada con flor y hojas. Varillas de metal de color negro."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/6e0c2081-49a4-39fd-8815-abd333346fe9> .

<http://data.silknow.org/object/f6ab96a7-b8df-3a5d-8904-ea31f2309e24>
