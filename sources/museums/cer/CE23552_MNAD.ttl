        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Dechado de lino bordado en seda de diversos colores. Rematado en dobladillo. Se trata de un muestrario marcado con grecas geometrizantes (zig zag), clavelinas estilizadas, una greca de deshilado. En uno de los extremos el cuadro principal está formado por un jarrón con flores y curiosamente entre otros motivos está bordada a pespunte azul una mano de Fatima."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/61d6acc7-9027-3675-a563-1db4ca3730f2> .

