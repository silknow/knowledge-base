        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento textil  de forma irregular de seda color melado. Decoración compuesta por   \ngrandes motivos florales y vegetales, espolinado con hilos de seda color amarillo, verde, azul, salmón, rosa, melado e hilos metálicos de color plateado. Rodeado de galón amarillo de seda, con fleco en algunos de sus lados. Tiene varias costuras."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/93af413d-3b23-36fd-b9c4-573626f94a19> .

