<http://data.silknow.org/object/2a6ace15-d177-3772-98ce-2d2cc399db42/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "El trabajo de calado a máquina se puede apreciar en los abanicos valencianos. Ver:  \n-El abanico español: La colección del Marqués de Colomina, cat.exp. Valencia, Ministerio de Cultura,  2008, p.99, nº 42.  \n-RODRIGO ZARZOSA, Carmen. Colección de abanicos en el Museo Nacional de Cerámica. Catálogo - Exposición. Madrid, Ministerio de Educación y Cultura, 2000, p. 112, nº 42.   \n  \nBibliografía comparada:   \n-Aleteos, Colección de abanos do Museo Provincial de Lugo .Lugo. Diputación Provincial de Lugo, 2002, p.179, nº 135."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/2a6ace15-d177-3772-98ce-2d2cc399db42> .

<http://data.silknow.org/event/89d6391b-21f7-397c-aa64-80f40cb317ab>
