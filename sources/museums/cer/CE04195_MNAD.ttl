        schema:contentUrl  <https://silknow.org/silknow/media/ceres-mcu/CE04195_MNAD_0.jpg> , <http://ceres.mcu.es/pages/Viewer?accion=42&AMuseo=MNAD&Ninv=CE04195&txt_id_imagen=1> .

