<http://data.silknow.org/object/d3b67cfc-23ec-3c0b-8bdf-de7857ec5459/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento textil con motivos geométricos y vegetales estilizados. Está realizado en terciopelo de seda cortado en color rojo carmesí. Brocado, mientras las decoraciones con ligamento de base de raso de seda, están tejidas en color dorado con aplicaciones de hilos metálicos, posiblemente de plata."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/d3b67cfc-23ec-3c0b-8bdf-de7857ec5459> .

