        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento de tejido de lino bordado en seda de color naranja. Se remata en tres de las partes en dobladillo y uno de los laterales está cortado. Termina en una puntilla de bolillos alternando naranja y color crema. La greca está bordada con punto de realce y calado. El motivo es continuo y está formado por círculos formados por objetos con elementos florales en el interior, entre los círculos hojas de realce y flores caladas."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/0c9b95cc-3715-3635-87f4-5a7fe9c76ebc> .

