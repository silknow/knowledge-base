        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE17502" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/observation/3> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/category/1> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/observation/2> , <http://data.silknow.org/event/d331a379-ff36-3811-aced-76d768d0358c> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/domain/2> , <http://data.silknow.org/production/9f7f2396-8703-3c05-ab69-4fb7ffb7aaab> , <http://data.silknow.org/image/086bddca-ae87-36db-8b40-7090fc75c3d0> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/observation/1> , <http://data.silknow.org/object/e09da251-3cfa-3ed7-9b7b-efd5bf67bc0c/domain/1> , <http://data.silknow.org/event/9bafb5a0-5feb-339b-a21e-3fe233b79801> ;
