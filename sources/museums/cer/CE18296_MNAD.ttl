        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Carné de baile con tapas de nácar unidas por una armadura de cobre dorado a fuego labrada con flores. Cierre en espiral para colocar lapicero de cobre dorado, forro de seda azul, dieciséis hojas y calendario francés de 1821. En las tapas, grabado de flores y flor esmaltada."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/e45fef60-85b8-3e09-b3f0-37dae0bae0d0> .

