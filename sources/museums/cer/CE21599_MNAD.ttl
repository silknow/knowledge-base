<http://data.silknow.org/object/dadebfa2-f7cb-3f4b-9a40-5a5fe6c6ed91>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE21599" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/observation/2> , <http://data.silknow.org/event/c97692a9-578d-3a13-9424-ed12291ca3b8> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/domain/3> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/observation/1> , <http://data.silknow.org/image/b0a5bdcf-16c9-36dc-8290-2d5961a34e60> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58> , <http://data.silknow.org/event/ee688640-0e39-366d-b1e8-27367fbc04ee> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/domain/1> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/observation/3> , <http://data.silknow.org/production/62b91b47-f18d-3df7-88bb-8a8ab202b77d> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/category/1> , <http://data.silknow.org/object/3ae9bf6e-9287-32ee-8124-9e29adcacf58/domain/2> ;
