        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Toalla de lino bordada en seda de distintos colores: bermellón, blanco, azul y amarillo. Los extremos presentan flecos en su color. En el centro, un águila bicéfala coronada inscrita en un óvalo con lises. Ocho pájaros en las esquinas y dos mariposas. Las cenefas de los extremos, que son cuatro, son elementos florales y clavelinas inclinadas."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/11373015-52b8-3fdd-a883-c702a57edb4b> .

