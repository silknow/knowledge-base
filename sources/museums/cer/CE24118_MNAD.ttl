        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento textil rectangular de seda espolinada con fondo de seda azul con ligamento de tafetán. En los laterales, dos franjas de puntilla.  Dividido en dos bandas, una con motivos florales en colores verde, salmón y rosa y otra banda con pequeños frutos en color verde."@es ;
