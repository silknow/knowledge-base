        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Contemporánea"@es , "Silla de madera espaldo rectangular, curvado hacia atrás, asiento trapezoidal. Patas en forma de prisma curvadas hacia fuera en estípite. Las delanteras rematan en garras de bronce. También lleva aplicaciones de bronce dorado, típicas del estilo Imperio."@es , "Silla época Imperio, en su versión española, es decir época Fernando VII. Gran elegancia, más cercanía al Directorio francés que ala Imperio."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/6b252db9-73be-3b64-93d8-a9d2813741c7> , <http://data.silknow.org/image/a27eebb6-0aaa-319a-8661-2438c18f9f94> , <http://data.silknow.org/image/c40b4467-2f05-31e1-90e0-081c5ed952e2> , <http://data.silknow.org/image/6359616a-8d39-3499-8c41-dce336c4646c> , <http://data.silknow.org/image/ec788cb3-4ad3-3e6f-84b5-ed2ae98bcebe> ;
        ecrm:P3_has_note               "Silla de madera espaldo rectangular, curvado hacia atrás, asiento trapezoidal. Patas en forma de prisma curvadas hacia fuera en estípite. Las delanteras rematan en garras de bronce. También lleva aplicaciones de bronce dorado, típicas del estilo Imperio."@es , "Edad Contemporánea"@es , "Silla época Imperio, en su versión española, es decir época Fernando VII. Gran elegancia, más cercanía al Directorio francés que ala Imperio."@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/image/e7bd6abb-b075-388c-8422-d4fc84522445> ;
        dc:identifier                  "CE05330" .

