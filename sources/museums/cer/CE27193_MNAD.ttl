<http://data.silknow.org/object/b7bfa1e8-6a0c-3779-9a87-a34608cfa202/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Escudo de armas en terciopelo, enmarcado y montado en un tejido de color rojo, con marco moldurado dorado. El escudo está inscrito dentro de un círculo hecho a base de motivos imbricados, delimitado en su parte interior con un contario, también circular."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/b7bfa1e8-6a0c-3779-9a87-a34608cfa202> .

