        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Butaca con montantes y largueros ornamentados con motivos florales y geométricos en forma de ajedrezado y cubos en damero, con respaldo de pala recta rematado con copetes calados y soportes rectos, con ensamblaje de caja y espiga. El asiento, los brazos y ladillos de éstos, y el respaldo, van henchidos y tapizados. La unión de madera y el tapizado se remata con cinta de pasamanería"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/02ed310c-6139-36e2-941d-8490dbaf44bf> .

