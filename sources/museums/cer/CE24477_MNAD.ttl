<http://data.silknow.org/object/c18af799-6977-3175-9c07-0fef306d4825>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Contemporánea"@es , "Fragmento textil de forma rectangular de seda brocada. Decoración en franjas paralelas en sentido vertical alternando con unas anchas rellenas de franjas en sentido horizontal salpicada por ramos de flores de colores verde, marrón, rojo, salmón, azul y seda en su color espolinados. Las franjas más estrechas están decoradas con flores color salmón, verde e hilos metálicos. Fondo de la composición de hilos metálicos dorados y plateados."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/068049a2-629a-3593-a3e1-0110c2e828fc> ;
        ecrm:P3_has_note               "Edad Contemporánea"@es , "Fragmento textil de forma rectangular de seda brocada. Decoración en franjas paralelas en sentido vertical alternando con unas anchas rellenas de franjas en sentido horizontal salpicada por ramos de flores de colores verde, marrón, rojo, salmón, azul y seda en su color espolinados. Las franjas más estrechas están decoradas con flores color salmón, verde e hilos metálicos. Fondo de la composición de hilos metálicos dorados y plateados."@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/vocabulary/743> ;
        dc:identifier                  "CE24477" .

