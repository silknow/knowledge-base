<http://data.silknow.org/image/af3af7e1-5f6f-33a1-9e14-7dbcd5b4cff7>
        a                  ecrm:E38_Image ;
        dc:identifier      "CE07649" ;
        schema:contentUrl  <https://silknow.org/silknow/media/ceres-mcu/CE07649_MNAD_0.jpg> , <http://ceres.mcu.es/pages/Viewer?accion=42&AMuseo=MNAD&Ninv=CE07649&txt_id_imagen=1> .

<http://data.silknow.org/object/2dc2101f-33c1-3ebd-b8a0-95e22af2d45e/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Jubón de pequeño tamaño (tal vez para una imagen vestidera) compuesto por nueve fragmentos. En la parte frontal, se han unido haciendo coincidir la decoración, mientras que en el resto no. Conserva un pequeño fragmento de orillo (6 mm., cinco bandas paralelas en salmón y blanco). Las dimensiones de la pieza impiden conocer las medidas del \"rapport\" y la anchura del telar. Sobre fondo verde, se distribuyen distintos motivos vegetales, florales y geométricos realizados en hilo metálico.  \n  \nLigamentos:  \n- Raso del 5 por urdimbre  [base]  \n- Tramas liseré en verde [decoración]  \n- Tramas espolinadas en hilo metálico dorado y plateado [decoración]"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/2dc2101f-33c1-3ebd-b8a0-95e22af2d45e> .

<http://data.silknow.org/object/2dc2101f-33c1-3ebd-b8a0-95e22af2d45e/observation/1>
