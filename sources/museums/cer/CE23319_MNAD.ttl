<http://data.silknow.org/object/44708b78-ed62-3625-bb56-30332cf62eb1/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento de terciopelo gofrado, color verde, forma rectangular. Los motivos ornamentales se repiten, es una estilización del cuerno de la abundancia."@es ;
