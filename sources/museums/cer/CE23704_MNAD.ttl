<http://data.silknow.org/object/81eb6e5b-e693-3a25-b9c5-11dfefe51121/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Variedad de puntos: lomo, ladrillo y cadena.  \nEn la ficha antigua se alude a una manga de camisa de tipo tradicional de los siglos XVII y XVIII.  \nDatación: Siglo XIX o anterior. La distribución de los motivos clasifica a la pieza como indumentaria más antigua, sin embargo, el motivo bordado en color más claro dentro de otro más oscuro indica que pueda ser más moderna."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/81eb6e5b-e693-3a25-b9c5-11dfefe51121> .

<http://data.silknow.org/event/3323a648-5456-3b0d-966b-59da9dfb1921>
