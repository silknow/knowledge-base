<http://data.silknow.org/object/6eb1306c-76ae-31bc-ae30-43f473047d2a/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Abanico de amplio vuelo de país simple recamado. Varillaje: dieciseis más dos guardas de nácar godlfish dorado y plateado con purpurina. Clavillo de tuerca rematado con falsa esmeralda de talla antigua en caja dorada y anilla con doble cordón retorcido. El abanico pende de un cordón que terrmina en tres madroños."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/6eb1306c-76ae-31bc-ae30-43f473047d2a> .

