<http://data.silknow.org/object/cb3bad5b-1165-35dd-9ab3-edeaf3a99963>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Modernismo   Edad Contemporánea"@es , "Silla con montantes y largueros ornamentados con motivos florales y geométricos en forma de ajedrezado y cubos en damero, con respaldo de pala recta rematado con copetes calados y soportes rectos, con ensamblaje de caja y espiga. El asiento y el respaldo van henchidos y tapizados. La unión de madera y el tapizado se remata con cinta de pasamanería."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/f9c408f0-06a2-30a5-96ce-06261941d630> , <http://data.silknow.org/image/db7cb4a0-1e64-3cb3-9ca0-b0db7d9011a8> , <http://data.silknow.org/image/a5892367-b941-3d2f-9788-655c0713b6f6> , <http://data.silknow.org/image/6de93c89-6f33-3902-931a-7d8365619478> , <http://data.silknow.org/image/4da3c779-de36-32a7-9ef4-b69cb863cd67> , <http://data.silknow.org/image/c316db24-7474-3d31-9a81-c4e48f663ccb> , <http://data.silknow.org/image/de46fd50-d4fa-33fe-8d14-2b98175c4529> , <http://data.silknow.org/image/84cb55c3-0528-3e45-b50e-13a0ac0a5f47> , <http://data.silknow.org/image/8aba7f01-fb7c-3bfe-be0c-7ade846cfbf6> , <http://data.silknow.org/image/122553e9-cb25-328a-8560-0c1b7f3ec51a> , <http://data.silknow.org/image/34b2fa85-d7dd-362b-8da4-738258822529> , <http://data.silknow.org/image/d16afb1b-b85c-3ee4-938d-dd1b691fa9a5> ;
