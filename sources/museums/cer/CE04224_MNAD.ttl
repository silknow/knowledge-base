<http://data.silknow.org/object/ed74b0dc-e54e-339f-927e-36fa6c9f0a18>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Contemporánea"@es , "Medallón ovalado enmarcado por palmas vegetales de madera dorada. Contiene un tejido que representa a una figura masculina de medio cuerpo, sobre fondo liso de color beige, con la cabeza girada hacia la izquierda, vestida con túnica azul y manto amarillo. Presenta las manos sobre el pecho, y en la derecha sujeta dos llaves, una dorada y la otra plateada."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3c08a7fd-bb9a-3fa3-9481-cd93fbcaa933> , <http://data.silknow.org/image/e3a837c7-e4d0-32aa-b5cb-4eaf28578748> ;
        ecrm:P3_has_note               "Edad Contemporánea"@es , "Medallón ovalado enmarcado por palmas vegetales de madera dorada. Contiene un tejido que representa a una figura masculina de medio cuerpo, sobre fondo liso de color beige, con la cabeza girada hacia la izquierda, vestida con túnica azul y manto amarillo. Presenta las manos sobre el pecho, y en la derecha sujeta dos llaves, una dorada y la otra plateada."@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/image/66abbfd2-3712-3789-acc9-4bb77503bb3e> ;
        dc:identifier                  "CE04224" .

