        a                  ecrm:E38_Image ;
        schema:contentUrl  <https://silknow.org/silknow/media/ceres-mcu/CE21449_MNAD_1.jpg> , <http://ceres.mcu.es/pages/Viewer?accion=42&AMuseo=MNAD&Ninv=CE21449&txt_id_imagen=2> .

<http://data.silknow.org/object/a413de80-e8d9-32d0-8af7-3907e11428eb/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Pieza formada por tres fragmentos de tejido, unidos entre sí sin que coincidan los motivos decorativos. Sobre un fondo salmón se dispone una decoración de motivos florales y vegetales y formas geométricas realizadas en seda de colores e hilos metálicos. Las dimensiones de la pieza impiden conocer las medidas del ancho de telar y del \"rapport\". Conserva uno de los orillos (5 mm. anchura, bandas verticales blancas y verdes).  \n  \nLigamentos:  \n-Raso de 3 por urdimbre  \n-Tramas liseré de seda e hilo metálico que ligan en sarga  \n-Tramas espolinadas que ligan en sarga  \n-Briscado"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/a413de80-e8d9-32d0-8af7-3907e11428eb> .

