        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Seda brochada verde con pequeños motivos florales distribuidos en líneas verticales con inclinación alterna. En la espalda la cenefa central es de damasco azul con motivos florales. Falta la cenefa delantera. Galón estrecho y sencillo de seda blanca. Forro de percal verde de la época."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/10026a94-2699-35b3-9270-5fa13ca677db> .

