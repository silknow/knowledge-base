<http://data.silknow.org/object/4fa3714a-bbd5-343b-8b5a-a8bbf013535b>
        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE21520" ;
        ecrm:P129_is_about  <http://data.silknow.org/event/42a70b9a-5af2-3a25-bb00-7d88369e65f1> , <http://data.silknow.org/image/09b5e12c-0ce5-3eb9-9a49-0901b5c7c6c5> , <http://data.silknow.org/image/3063b045-2167-3f40-9a89-f03444f2a25e> , <http://data.silknow.org/image/c2bd2ebb-e5bc-364e-83e0-3aa7775758e1> , <http://data.silknow.org/image/a8922168-f28b-38f5-b695-20e2cbe6811f> , <http://data.silknow.org/image/fc0fb759-7d88-3463-b33a-3ea0ea0f51ca> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/domain/2> , <http://data.silknow.org/event/a90cf961-6439-327c-abce-7a1cf76db462> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/observation/2> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/category/1> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/domain/1> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/observation/1> , <http://data.silknow.org/image/8fdf7c8d-4283-3a53-9229-56e73103fd1d> , <http://data.silknow.org/image/f09d0c07-4a16-3d2c-98c6-7fe1634c3718> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261/observation/3> , <http://data.silknow.org/image/b9a83790-d4c1-3bf3-9f0f-b49b40977870> , <http://data.silknow.org/production/14bc9050-ca9e-3d24-ac44-a9ca214b289d> , <http://data.silknow.org/object/38fdd5f1-d5ef-3542-a35b-6284e5557261> , <http://data.silknow.org/image/31b895c0-015c-300e-9b64-89f6ad968161> ;
