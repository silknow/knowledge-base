<http://data.silknow.org/object/7945a706-56b7-36a9-82ba-91aaaa13c12f/observation/3>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Al parecer difieren mucho la pintura de la cara y la del revés. Podría estar hecho por dos manos diferentes.  \nEl paisaje del revés, recuerda a los paisajes holandeses, por lo que podría estar hecho en Holanda.  \n  \nBibliografía comparada:   \n -MERINO DE CÁCERES, Maruja y GARCÍA LOU, Ana : \" Costumbrismo in Spanish fans of the 19th and early 20th Centuries\" en FANA JOURNAL, New York , Fall 2007,pp.4-14."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/7945a706-56b7-36a9-82ba-91aaaa13c12f> .

