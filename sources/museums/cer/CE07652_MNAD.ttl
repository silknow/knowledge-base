<http://data.silknow.org/object/3308418c-b5e0-3783-881e-471af3563d64>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Contemporánea"@es , "Fragmento de tejido semicircular. Sobre fondo blanco, presenta una decoración floral y vegetal en seda de distintos colores e hilo metálico. Conserva en todo el perímetro exterior un remate de encaje de hilo metálico dorado. La pieza está formada por tres fragmentos. El forro ha sido retirado y se pueden apreciar los orillos que ha conservado la pieza central.   \nLigamentos:  \n-Tafetán [base]  \n-Tramas espolinadas [decoración]"@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/c20a13ad-fef1-3a0e-a464-47bf9415a1e5> ;
        ecrm:P3_has_note               "Edad Contemporánea"@es , "Fragmento de tejido semicircular. Sobre fondo blanco, presenta una decoración floral y vegetal en seda de distintos colores e hilo metálico. Conserva en todo el perímetro exterior un remate de encaje de hilo metálico dorado. La pieza está formada por tres fragmentos. El forro ha sido retirado y se pueden apreciar los orillos que ha conservado la pieza central.   \nLigamentos:  \n-Tafetán [base]  \n-Tramas espolinadas [decoración]"@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/vocabulary/743> ;
        dc:identifier                  "CE07652" .

