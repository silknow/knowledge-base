        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tejido de fondo de color rojo y motivos en blanco. Decoración de motivos: hojas y formas geométricas y vegetales a modo de eses con ganchos, ordenados en losange. Tiene los dos orillos en blanco y amarillo con ligamento de tafetán. Forro de lienzo engomado, de color rojizo."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/89f00d5b-3e2c-3f24-af62-2bfa897c4f8c> .

