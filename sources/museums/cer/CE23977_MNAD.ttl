<http://data.silknow.org/object/d47a1e44-998b-3b76-a70e-02d7e01259f8/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tapete bordado en seda marrón. La banda central se decora con un perro corriendo hacia la derecha con la cabeza vuelta. Está rodeado de ramas y tallos formando espirales.   \nEsta banda está delimitada por dos grecas con \"eses\" paralelas e inclinadas, y, en el exterior, grecas con bordado corrido de realce. Rematado por puntilla formando ondas de filtiré."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/d47a1e44-998b-3b76-a70e-02d7e01259f8> .

