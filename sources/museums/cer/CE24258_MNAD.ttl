        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE24258" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c/observation/3> , <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c/domain/1> , <http://data.silknow.org/event/30ae24c1-5c26-39bb-9640-8690e03e01b5> , <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c/observation/2> , <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c/observation/1> , <http://data.silknow.org/event/8981bfa5-cde7-3035-a5c7-749e402eacb0> , <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c> , <http://data.silknow.org/image/dc142dc7-a821-3180-a6e7-4ba3bdb4b3a5> , <http://data.silknow.org/object/8237e3e9-c4c9-3f9d-9031-b2ac6528e74c/category/1> , <http://data.silknow.org/production/e84376d5-cb0c-3dde-9246-3480058225a4> ;
