<http://data.silknow.org/object/ee4c04ba-242f-3a34-a6dd-0d736eaa51f1/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Cuadro en raso de seda, color beige, decorado en el centro con gran ramo floral bordado al matiz con hilos de seda de colores verde, rosa, ocres y beige. El motivo decorativo está enmarcado por motivos de ángeles con cesto de flores y roleos. Se completa la decoración con inscripciones bordadas a realce y a punto de pasada en hilo metálico dorado. La tela está unida a un soporte de madera mediante cuerdas."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/ee4c04ba-242f-3a34-a6dd-0d736eaa51f1> .

