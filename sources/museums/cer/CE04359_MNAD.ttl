<http://data.silknow.org/object/9fa70f01-21a8-3721-a8e7-4ae4565ff6ad>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Estilo Luis XVI."@es , "Época Luis XVI   Edad Moderna"@es , "Asiento de planta trapezoidal, respaldo plano con remate \"de chapeaux\" y motivo de cinta. Patas en forma de estípites acanaladas, con molduras clásicas por arriba y por abajo, y cuatro tacos cúbicos con flores a cada lado. El contorno del respaldo y del asiento están recorridos por sencillas estrías. Tapizado en asiento y respaldo, con fondo rojo, y motivos de acantos y flores sobre fondo beige."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/35a9ec94-48c9-3c12-8a97-ac90d85b5f6e> , <http://data.silknow.org/image/6f326e63-0ebd-3a87-a7d7-ab680d463be0> , <http://data.silknow.org/image/2441de50-57fe-33ba-a69c-7c25fec46f47> , <http://data.silknow.org/image/c0899be3-4ae3-33e7-8576-0fc9e2c0b51d> , <http://data.silknow.org/image/50912441-20d7-3b28-8024-7f89c53f3c98> ;
        ecrm:P3_has_note               "Época Luis XVI   Edad Moderna"@es , "Asiento de planta trapezoidal, respaldo plano con remate \"de chapeaux\" y motivo de cinta. Patas en forma de estípites acanaladas, con molduras clásicas por arriba y por abajo, y cuatro tacos cúbicos con flores a cada lado. El contorno del respaldo y del asiento están recorridos por sencillas estrías. Tapizado en asiento y respaldo, con fondo rojo, y motivos de acantos y flores sobre fondo beige."@es , "Estilo Luis XVI."@es ;
        ecrm:P65_shows_visual_item     <http://data.silknow.org/vocabulary/743> ;
