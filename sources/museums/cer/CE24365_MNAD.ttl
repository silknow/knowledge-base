<http://data.silknow.org/image/1751f001-6182-39c1-b99d-e782aef95faf>
        a                  ecrm:E38_Image ;
        dc:identifier      "CE24365" ;
        schema:contentUrl  <https://silknow.org/silknow/media/ceres-mcu/CE24365_MNAD_0.jpg> , <http://ceres.mcu.es/pages/Viewer?accion=42&AMuseo=MNAD&Ninv=CE24365&txt_id_imagen=1> .

<http://data.silknow.org/object/05215c23-0144-3708-8f8c-48776390c538/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento de tejido de forma cuadrado, formado por una única pieza. Sobre un fondo blanco se dispone una decoración de carácter vegetal y floral, realizada en seda de distintos colores. Conserva un orillo [5 mm. de anchura, formado por hilos de color verde y blanco]. las medidas de la pieza impiden conocer las dimensiones del ancho de telar y del \"rapport\". Presenta algunas zonas con importantes deterioros, en los que se ha perdido el raso.  \n  \nLigamentos:   \n-Raso de 3 por urdimbre  \n-Tramas liseré verdes  \n-Tramas espolinadas que ligan en sarga  \n-Briscado"@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/05215c23-0144-3708-8f8c-48776390c538> .

