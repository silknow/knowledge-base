<http://data.silknow.org/image/b3548984-7a56-3108-9ab2-3500a3fae620>
        a                 ecrm:E36_Visual_Item ;
        rdfs:comment      "La fuente: Motivos vegetales;   La cara: Escena costumbrista; Guitarra;   De estilo renacentista."@es ;
