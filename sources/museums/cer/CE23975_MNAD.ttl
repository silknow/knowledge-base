<http://data.silknow.org/object/a0e45f33-d17a-3ecf-95a7-6168a188cecd/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Tapete color marfil, de forma rectangular. Decoración con bordado de sobrepuesto, con telas de diferentes colores -amarillo, azul, carmesí y verde-, ribeteado con cordoncillo amarillo. En el centro, una estrella o sol y en las esquinas flores de lis y junto al borde, greca floral.  Está cosido por la parte del reverso sobre una tela arpillera, con papel pegado encima y con hojas de un libro cosido."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/a0e45f33-d17a-3ecf-95a7-6168a188cecd> .

