        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Álbum de diseño de telas, encuadernado en cartón forrado de papel blanco con franjas en relieve como decoración que representan: la inferior, un bosque por el que corre un gamo y un tigre; en la superior aparecen dos figuras humanas rodeadas con una orla decorativa de pájaros y plantas. Cantos pegados con seda verde con dibujos en oro y cosidos con cordón morado."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/94d21919-dc0e-3f8d-9ce3-16b0c0ec25bb> .

<http://data.silknow.org/object/94d21919-dc0e-3f8d-9ce3-16b0c0ec25bb>
