<http://data.silknow.org/object/f2bdbe41-e157-327a-8479-eb62e61051c9>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Moderna"@es , "Dalmática en terciopelo picado verde con la técnica del ferronerie o decoración a reserva de la granada, piña de cardo o alcachofa. Se concentra en ocho paneles con bordados aplicados realizados con raso y tafetán en seda e hilos de seda: dos redropies o paneles rectangulares que se aplicaban a las faldas de la dalmática; dos bocamangas o paneles rectangulares de menor tamaño; dos collarejos o tiras que dibujan el cuello de la pieza; y dos jabastros, que penden de los hombros a manera de tirantes y llegaban hasta los redropies."@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3887b758-537f-3298-afdb-778fac550e6f> ;
        ecrm:P3_has_note               "Edad Moderna"@es , "Dalmática en terciopelo picado verde con la técnica del ferronerie o decoración a reserva de la granada, piña de cardo o alcachofa. Se concentra en ocho paneles con bordados aplicados realizados con raso y tafetán en seda e hilos de seda: dos redropies o paneles rectangulares que se aplicaban a las faldas de la dalmática; dos bocamangas o paneles rectangulares de menor tamaño; dos collarejos o tiras que dibujan el cuello de la pieza; y dos jabastros, que penden de los hombros a manera de tirantes y llegaban hasta los redropies."@es ;
        ecrm:P43_has_dimension         <http://data.silknow.org/object/f2bdbe41-e157-327a-8479-eb62e61051c9/dimension/1> , <http://data.silknow.org/object/f2bdbe41-e157-327a-8479-eb62e61051c9/dimension/2> ;
