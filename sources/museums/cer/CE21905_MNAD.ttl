<http://data.silknow.org/object/daf656dc-b859-3fd9-bbb6-820148f7d7ae/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Libro de diseños decorativos con 20 hojas. Diseños ordenados del 1 al 20 con amplia gama de colores y predominio de los motivos vegetales, estilizados o no, y en menor grado, formas geométricas y algunos animales. Encuadernado con papel doble y estampada la portada con fondo azul marino y un dibujo simulando una cartela naranja con el borde en blanco. Cantos pegados con tela de seda en beige y atados con dos cordones de seda verde."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/daf656dc-b859-3fd9-bbb6-820148f7d7ae> .

<http://data.silknow.org/object/daf656dc-b859-3fd9-bbb6-820148f7d7ae>
