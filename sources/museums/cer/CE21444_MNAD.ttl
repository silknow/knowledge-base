        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Capa realizada a base de pequeñas piezas reaprovechadas. Tejido base de tafetán color marfil. La trama suplementaria de láminas de plata con decoración de cintas sinuosas y parejas de flores blancas y marrones, sobre fondo de color azul. El forro es de seda de color amarillo. Alrededor, una cenefa de hilos metálicos."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/9bee830d-91ba-34a3-b771-2e4f08b3180e> .

