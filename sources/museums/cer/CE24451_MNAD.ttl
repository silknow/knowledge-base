        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Edad Moderna"@es , "Fragmento de seda brocada y recubierto con hilo metálico dorado. Decoración compuesta por una red romboidal realizada con flores, en cuyo interior van pequeños ramos de seda espolinada similar al terciopelo. Conserva un orillo (color salmón y seda en su color).  \n  \nLigamentos:  \n-Tafetán [base]  \n-Tramas espolinadas de seda e hilo metálico [decoración]  \n-Chenilla naranja, granate y morado [decoración]"@es ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/50da6252-d5d6-3256-9dea-d8d8bed8b50b> , <http://data.silknow.org/image/67fbd608-c688-3fff-b294-17572353b0fb> ;
        ecrm:P3_has_note               "Edad Moderna"@es , "Fragmento de seda brocada y recubierto con hilo metálico dorado. Decoración compuesta por una red romboidal realizada con flores, en cuyo interior van pequeños ramos de seda espolinada similar al terciopelo. Conserva un orillo (color salmón y seda en su color).  \n  \nLigamentos:  \n-Tafetán [base]  \n-Tramas espolinadas de seda e hilo metálico [decoración]  \n-Chenilla naranja, granate y morado [decoración]"@es ;
