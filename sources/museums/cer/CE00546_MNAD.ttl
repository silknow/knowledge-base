        rdfs:label          "Record CE00546" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b/observation/2> , <http://data.silknow.org/object/f55490ff-d3ce-30f9-84a2-d60ea2208187> , <http://data.silknow.org/image/b53e1a6d-302b-3d60-a550-b8c2a7d101e3> , <http://data.silknow.org/production/512b2cd2-ce7a-32a1-a2db-d719985f2c13> , <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b/observation/1> , <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b/domain/2> , <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b/category/1> , <http://data.silknow.org/event/c9d47c87-771f-38f0-a83a-4914eaff1aac> , <http://data.silknow.org/event/9e5923a7-dc8c-3898-9853-a5bc5f3639a6> , <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b/domain/1> , <http://data.silknow.org/object/7fefcb1e-aade-3d8d-a85a-66f5f16b4b8b> ;
