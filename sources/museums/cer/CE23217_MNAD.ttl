<http://data.silknow.org/object/01f4634a-24db-3c53-855b-5fe2986a08bd/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Fragmento de terciopelo cortado de seda verde con decoración a reserva; Forma rectangular irregular, recortada en tres lados; en un lado preserva el orillo de tejer con una franja de seda en su color mas otra exterior más ancha de color salmón.  \nUrdimbre de base torsión Z, Trama de base y urdimbre de pelo torsión STA, de seda verde claro; raso.  \nHa perdido gran parte del pelo.  \n  \nNo presenta un motivo completo, reconociéndose el pico superior de un polilóbulo, contorneado por encima por un motivo de cordón."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/01f4634a-24db-3c53-855b-5fe2986a08bd> .

<http://data.silknow.org/object/01f4634a-24db-3c53-855b-5fe2986a08bd/domain/1>
        a                    silk:T19 ;
        silk:L4              <http://data.silknow.org/category/1> ;
        ecrm:P41_classified  <http://data.silknow.org/object/01f4634a-24db-3c53-855b-5fe2986a08bd> .

