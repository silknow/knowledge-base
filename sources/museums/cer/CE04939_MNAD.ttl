        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE04939" ;
        ecrm:P129_is_about  <http://data.silknow.org/image/5b24dfbf-e973-349a-85f4-2fd6c46862dc> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/observation/2> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/observation/1> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/domain/1> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/category/1> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389> , <http://data.silknow.org/event/3501d3b4-ffb7-351c-b6a5-5de2468b1138> , <http://data.silknow.org/event/a83c586c-8048-3aba-b682-8fb9375f5b40> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/domain/2> , <http://data.silknow.org/production/f705e69b-7331-3ed7-be35-90339f318b6b> , <http://data.silknow.org/object/5ea54620-6c9c-3f16-a4ad-4cf8838ec389/observation/3> ;
