<http://data.silknow.org/object/da93e445-2e9f-3e84-aa87-ad83dfc227cb/observation/2>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/general-observation> ;
        ecrm:P3_has_note    "Libro de historietas, con escenas de samurais, encuadernado en cartón y forrado en papel gris. La cartela de presentación en la portada con caracteres en verde. Cantos pegados con seda roja y cosidos con cordón blanco.  \nNumerados de derecha a izquierda, del 1 al 29. Estampación monócroma sobre fondo blanco, y narración en caracteres negros en cada página."@es ;
        crmsci:O8_observed  <http://data.silknow.org/object/da93e445-2e9f-3e84-aa87-ad83dfc227cb> .

<http://data.silknow.org/object/da93e445-2e9f-3e84-aa87-ad83dfc227cb>
