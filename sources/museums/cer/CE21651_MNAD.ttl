<http://data.silknow.org/image/ffed59e6-ee9d-38b7-88bc-c7e60dee7b8d>
        a                 ecrm:E36_Visual_Item ;
        rdfs:comment      "Motivos vegetales; Escena figurativa; Decoración arquitectónica; Fondo completo: Escena cortesana"@es ;
