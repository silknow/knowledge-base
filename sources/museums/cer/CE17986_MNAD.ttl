        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE17986" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/category/1> , <http://data.silknow.org/event/f56baa53-3d98-3b31-93c0-fb543405321f> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/domain/1> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/domain/2> , <http://data.silknow.org/production/b5cebf93-5b61-3978-82a2-ca92d8f46163> , <http://data.silknow.org/event/19db87e1-ab10-306e-97ac-681ef28508bc> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/observation/2> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/observation/3> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c> , <http://data.silknow.org/object/10a61d6d-6702-32ba-bb62-4c23bc36ed4c/observation/1> , <http://data.silknow.org/image/d17d6724-f080-38a3-bd53-f913239ab9c4> ;
