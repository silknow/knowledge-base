        a                   crmdig:D1_Digital_Object ;
        rdfs:label          "Record CE24135" ;
        ecrm:P129_is_about  <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/observation/1> , <http://data.silknow.org/image/06c7536d-0543-33e7-919a-8888e7ab49e1> , <http://data.silknow.org/event/dc915fc4-6bc8-3098-a079-fe04f5e57a20> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/domain/1> , <http://data.silknow.org/image/fed324e1-5006-30d2-9a86-2d856cbabdaa> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/observation/3> , <http://data.silknow.org/image/18c3b687-e581-3233-901a-89fbeddfa9ed> , <http://data.silknow.org/event/128fb0e3-38c4-391d-a14d-0d4cf760625e> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/observation/2> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/category/1> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07> , <http://data.silknow.org/production/fbcf0ae5-f0aa-396e-92da-9fe3384f5e79> , <http://data.silknow.org/image/c5b1c362-73a7-316f-b99f-975146b3e80c> , <http://data.silknow.org/object/4df94b63-3736-3780-9f7b-a94978910a07/domain/2> ;
