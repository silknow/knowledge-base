        rdfs:label                     "Tapisserie : scène de l'histoire d'Esther, Vashti refusant l'invitation d'Assuérus"@fr ;
        ecrm:P102_has_title            "Tapisserie : scène de l'histoire d'Esther, Vashti refusant l'invitation d'Assuérus"@fr ;
