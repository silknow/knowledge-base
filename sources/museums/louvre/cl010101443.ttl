<http://data.silknow.org/object/ada40541-133f-3a98-b9f9-02ebcdcce322/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    "Description / Décor" ;
        ecrm:P3_has_note    "Devant un lac sur lequel on aperçoit une barque munie d'un dais et que montent quatre personnages, Vénus est assise ; elle tient l'Amour sur ses genoux, dont Mars, assis à ses pieds, embrasse la main ; derrière eux : deux suivantes ; à gauche, groupe de quatre personnages, au milieu desquels on remarque Diane, vue de dos ; à droite deux femmes jouent de la musique."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/ada40541-133f-3a98-b9f9-02ebcdcce322> .

<http://data.silknow.org/object/ada40541-133f-3a98-b9f9-02ebcdcce322/domain/4>
