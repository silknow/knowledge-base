<http://data.silknow.org/image/833285e9-05fb-3ea3-94c9-408b3aef4ff3>
        a                  ecrm:E38_Image ;
        schema:contentUrl  <https://silknow.org/silknow/media/louvre/cl010099557_23.jpg> , <https://collections.louvre.fr/media/cache/original/0000000021/0000099557/0000180179_OG.JPG> .

<http://data.silknow.org/object/6f540b4f-1798-3c98-bc38-7137bb912976/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    "Description / Décor" ;
        ecrm:P3_has_note    "\"Halte dans la forêt, sur les hauteurs d’Auderghem, d’où l’on aperçoit derrière la crête d’une colline la tour de l’Hôtel de ville et celles de l’église Sainte-Gudule. Tandis que, à gauche, un chasseur lutine une villageoise, des serviteurs préparent un festin. Les uns conduisent ou déchargent des mulets chargés de paniers de provisions ; d’autres, tout à fait à l’arrière-plan, remplissent des pichets à un tonneau. A droite, des rôtisseurs s’affairent autour de broches disposées devant un feu de bois. La nature épanouie cache, parmi le sous-bois du premier plan, de petites fraises sauvages\"."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/6f540b4f-1798-3c98-bc38-7137bb912976> .

