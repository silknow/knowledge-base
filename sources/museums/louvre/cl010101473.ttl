<http://data.silknow.org/object/03df3cab-e0bc-31a3-a7fe-5cca0068f425/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    "Description / Décor" ;
        ecrm:P3_has_note    "Dans un jardin au centre duquel se trouve un palais dont on n'aperçoit qu'une partie, un enfant, à gauche, est en train de bêcher au bord d'une rivière ; un autre, muni d'une faucille, s'apprête à couper des herbes. Même bordure que la tapisserie précédente, à laquelle celle-ci fait pendant."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/03df3cab-e0bc-31a3-a7fe-5cca0068f425> .

