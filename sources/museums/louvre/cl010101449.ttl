<http://data.silknow.org/object/a0f5493b-dac0-3678-ad36-b3a5c4f89fe2>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Paysage chinois aux couleurs vives représentant, à droite, une petite maison de planches, sur les marches de laquelle sont assis deux enfants dont l'un aide l'autre à boire ; plus à gauche, deux personnages, homme et femme, sont attablés sous un parasol ; un enfant leur apporte une tasse, tandis qu'un cuisinier, sur la gauche, près d'un four, prépare le thé. Sans bordure ni lisère."@fr ;
        rdfs:label                     "Le thé, de la Tenture Chinoise"@fr ;
        ecrm:P102_has_title            "Le thé, de la Tenture Chinoise"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/a60b2ff6-e2b0-3a39-a5fc-7da767e1db9c> , <http://data.silknow.org/image/df9a5038-cd85-3e17-a635-dde1a55cf39a> , <http://data.silknow.org/image/aec1f97c-0651-3c31-93ed-2d2fd53f725d> , <http://data.silknow.org/image/7334983d-fcef-31ec-9966-6c9147a518d9> ;
        ecrm:P3_has_note               "Paysage chinois aux couleurs vives représentant, à droite, une petite maison de planches, sur les marches de laquelle sont assis deux enfants dont l'un aide l'autre à boire ; plus à gauche, deux personnages, homme et femme, sont attablés sous un parasol ; un enfant leur apporte une tasse, tandis qu'un cuisinier, sur la gauche, près d'un four, prépare le thé. Sans bordure ni lisère."@fr ;
        dc:identifier                  "Numéro principal : OAR 19" ;
