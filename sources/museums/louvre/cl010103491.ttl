<http://data.silknow.org/object/8e9fe7d9-cc33-3fc5-b1b0-165fa1c52b89>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "\"Debout, tourné vers la droite, Perrault est vêtu d'un habit de velours rouge et d'une culotte foncée, qui se dégagent des plis d'un manteau noir. De sa main droite étendue, il s'appuie ur une canne, tandis que son avant-bras gauche est soutenu par un livre placé debout sur une table, où sont épars des plans, des livres, un compas. Fonds d'architecture.\" (Fernand Calmette, 1912)"@fr ;
        rdfs:label                     "Claude Perrault, architecte, 1613-1688"@fr ;
        ecrm:P102_has_title            "Claude Perrault, architecte, 1613-1688"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/3b6d4440-f772-3d1e-a5e5-2c4180a5ec7c> , <http://data.silknow.org/image/b4df5c96-1ef3-336a-891e-c8678d5a8134> ;
        ecrm:P3_has_note               "\"Debout, tourné vers la droite, Perrault est vêtu d'un habit de velours rouge et d'une culotte foncée, qui se dégagent des plis d'un manteau noir. De sa main droite étendue, il s'appuie ur une canne, tandis que son avant-bras gauche est soutenu par un livre placé debout sur une table, où sont épars des plans, des livres, un compas. Fonds d'architecture.\" (Fernand Calmette, 1912)"@fr ;
