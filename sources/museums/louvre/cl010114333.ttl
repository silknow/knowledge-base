<http://data.silknow.org/object/2a6574d4-85fe-33f8-b86d-6b87afa767ea>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Dans la bordure du bas, six enfants nus, debout ou couchés; au milieu, l'un d'eux joue du flageolet, l'autre lient la musique. Dans le bas de la bordure de droite, un enfant verse dans un vase le vin d'une outre."@fr , "Cette bataille se livre sur une montagne escarpée que l'armée romaine escalade. Au premier plan, au milieu, deux cavaliers au galop. A droite, d'autres cavaliers et les étendards romains."@fr ;
        rdfs:label                     "La bataille sur le plateau, de la tenture de L'Histoire de Scipion"@fr ;
        ecrm:P102_has_title            "La bataille sur le plateau, de la tenture de L'Histoire de Scipion"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/fb7ee88b-01a5-3df2-9290-985a376cd5b0> , <http://data.silknow.org/image/148a94c0-4ba7-32b0-a3a1-ba49c60e542d> , <http://data.silknow.org/image/a0595832-1096-3c1e-88ef-fc874fa81f2b> , <http://data.silknow.org/image/fd91d681-ce16-3ef6-8608-f6ab5da4a15a> , <http://data.silknow.org/image/d234e0e8-be48-3bb2-89e8-82adc7424ba5> , <http://data.silknow.org/image/b6bb4c56-a4cb-3a9d-a43f-80c41e2500c4> , <http://data.silknow.org/image/b5408883-f5d2-3efb-87a4-da9fcd933612> , <http://data.silknow.org/image/ab147b6d-3de4-3304-b416-27f91c2e383c> , <http://data.silknow.org/image/b9af8084-b598-3182-a528-97b9e683045d> , <http://data.silknow.org/image/abd93a72-7686-344f-87ff-473abb319494> , <http://data.silknow.org/image/7ef25ef7-c2ef-3097-bc9a-38c9a0302331> , <http://data.silknow.org/image/a1e1e0f9-b1bf-3ff5-b44f-91e60a2c502d> , <http://data.silknow.org/image/95d355b7-1a75-3293-98ff-64f69d2caac0> , <http://data.silknow.org/image/19dd5343-313c-3bf2-a0b5-efbf29a25332> , <http://data.silknow.org/image/198493af-84a0-34ce-9e48-0b08d2d9e485> ;
