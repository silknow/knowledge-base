<http://data.silknow.org/object/17974318-6bf7-3f6a-bdf2-60e9fff21c02>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "\"Nu-tête, les cheveux retombant en longues boucles châtain, Sarazin porte un pourpoint gris crevé sur les manches et ouvert sur le bouffant de la chemise ; son costume se complète d'un haut-de-chausses jaune brun, de bas rouges et d'un manteau de velours pourpre doublé de jaune clair. Appuyé sur une balustrade, Sarazin tient dans la main droite un maillet et, dans la main gauche, un ciseau. En arrière, au-dessous d'un rideau brun qui pend, s'aperçoit le pavillon central des Tuileries.\" (Fernand Calmettes, 1912)"@fr ;
        rdfs:label                     "Jacques Sarazin, sculpteur, 1590-1660"@fr ;
        ecrm:P102_has_title            "Jacques Sarazin, sculpteur, 1590-1660"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d9471e1c-5213-35de-9e51-fc6371cf5a3e> , <http://data.silknow.org/image/6b02f8af-7340-3240-a707-db5af5c1fc2d> ;
        ecrm:P3_has_note               "\"Nu-tête, les cheveux retombant en longues boucles châtain, Sarazin porte un pourpoint gris crevé sur les manches et ouvert sur le bouffant de la chemise ; son costume se complète d'un haut-de-chausses jaune brun, de bas rouges et d'un manteau de velours pourpre doublé de jaune clair. Appuyé sur une balustrade, Sarazin tient dans la main droite un maillet et, dans la main gauche, un ciseau. En arrière, au-dessous d'un rideau brun qui pend, s'aperçoit le pavillon central des Tuileries.\" (Fernand Calmettes, 1912)"@fr ;
        dc:identifier                  "Numéro principal : SN 679" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.louvre.fr/ark:/53355/cl010103489> .

