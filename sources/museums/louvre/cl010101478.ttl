<http://data.silknow.org/object/01cbbbe6-cb19-305a-9878-05668b5f1ece>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Un homme en armure, une femme et des amours. La femme est assise sous une tente, à gauche, un amour derrière elle ; l'homme, casqué et tenant une pique de la main droite, est debout devant elle ; trois amours, à gauche, jouent avec les gantelets, le bouclier et une autre pièce d'armure. Dominante jaune et verte. Bordure à tresses de grosses fleurs, vases et couronnes stylisés aux angles."@fr ;
        rdfs:label                     "Mars, Vénus et des Amours, ou Didon et Enée ?"@fr ;
        ecrm:P102_has_title            "Mars, Vénus et des Amours, ou Didon et Enée ?"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/d195bef3-194a-3b1f-ae92-584880ebd9fe> , <http://data.silknow.org/image/ba0cfc39-637c-34a6-b09f-b9501d873030> , <http://data.silknow.org/image/be45ea8b-6d54-3762-b491-3cccaf79e60b> , <http://data.silknow.org/image/b0b57a20-b173-3561-b11a-6f0c141e0a97> , <http://data.silknow.org/image/196f2c9f-ee75-330b-9e00-737f1ef1d676> , <http://data.silknow.org/image/d030836d-d584-33ce-a006-aa98ff506d22> , <http://data.silknow.org/image/bf72a56b-dc6d-3a3c-82b4-c9704910c609> , <http://data.silknow.org/image/0ee33b33-dbee-37e7-a6d6-0fc38ce3ca29> , <http://data.silknow.org/image/7a67379d-5f1c-3307-9ebc-1836ed2cc4f3> , <http://data.silknow.org/image/ea61767b-e94e-355c-859b-b30ed4f0f12b> , <http://data.silknow.org/image/7fca2c3b-47a5-34a1-9195-ed37434969af> ;
        ecrm:P3_has_note               "Un homme en armure, une femme et des amours. La femme est assise sous une tente, à gauche, un amour derrière elle ; l'homme, casqué et tenant une pique de la main droite, est debout devant elle ; trois amours, à gauche, jouent avec les gantelets, le bouclier et une autre pièce d'armure. Dominante jaune et verte. Bordure à tresses de grosses fleurs, vases et couronnes stylisés aux angles."@fr ;
