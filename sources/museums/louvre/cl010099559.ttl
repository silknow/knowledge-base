<http://data.silknow.org/object/eed11bc9-944a-3f81-8b48-b64805b8c14c>
        a                   ecrm:E73_Information_Object ;
        rdfs:comment        "Balis, Arnout ; De Jonge, Krista ; Delmarcel, Guy ; Lefébure, Amaury, Les Chasses de Maximilien, Paris, Réunion des Musées Nationaux, 1993,"@fr ;
        ecrm:P129_is_about  <http://data.silknow.org/object/6c555799-b55f-342f-ae94-d44c471aba7b> ;
        ecrm:P2_has_type    <http://data.silknow.org/information/bibliography> ;
