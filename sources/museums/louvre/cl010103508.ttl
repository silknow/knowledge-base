<http://data.silknow.org/object/cab9482b-b8f9-3184-a3aa-af4a5c8a246e>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "\"Coyzevox, dont on orthographie aujourd'hui le nom avec un s, Coysevox, est debout en perruque blonde, le corps tourné vers la droite, la tête se reportant à gauche. Il est vêtu d'un habit de velours rouge et d'un grand manteau gris brun doublé de clair. Sa main droite, appuyée sur une selle où se dresse un buste, tient un maillet ; sa main gauche est relevée. Un rideau vert lui sert de fond.\" (Fernand Calmettes, 1912)"@fr ;
        rdfs:label                     "Antoine Coyzevox, sculpteur, 1640-1720"@fr ;
        ecrm:P102_has_title            "Antoine Coyzevox, sculpteur, 1640-1720"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/9eb9e3d1-cf99-33af-9946-bf6ccbfdb6ab> , <http://data.silknow.org/image/9799a74e-2299-3338-8a6a-05b45579f3de> ;
        ecrm:P3_has_note               "\"Coyzevox, dont on orthographie aujourd'hui le nom avec un s, Coysevox, est debout en perruque blonde, le corps tourné vers la droite, la tête se reportant à gauche. Il est vêtu d'un habit de velours rouge et d'un grand manteau gris brun doublé de clair. Sa main droite, appuyée sur une selle où se dresse un buste, tient un maillet ; sa main gauche est relevée. Un rideau vert lui sert de fond.\" (Fernand Calmettes, 1912)"@fr ;
        dc:identifier                  "Numéro principal : SN 700" ;
        <http://www.w3.org/2002/07/owl#sameAs>
                <https://collections.louvre.fr/ark:/53355/cl010103508> .

