<http://data.silknow.org/object/9d1e7db2-7cff-3410-b726-922316d7dd17/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    "Description / Décor" ;
        ecrm:P3_has_note    "A l'origine d'une seule pièce, cette tapisserie décousue en 2000, se présente actuellement sous la forme de deux fragments distincts (a et b). Fragment A : Au sein d'une nature luxuriante, où l'on devine, au milieu des rochers, des arbres et des fleurs, une fontaine et des animaux, des couples d'hommes et de femmes sauvages, dansent ou s'entretiennent."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/9d1e7db2-7cff-3410-b726-922316d7dd17> .

