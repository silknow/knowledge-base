        ecrm:P108_has_produced  <http://data.silknow.org/object/6394d6b9-a932-3d07-9ef0-a5e1721ffcac> ;
        ecrm:P126_employed      "doublure : bandes larges de toile bisonne ancienne disposées en périphérie et 3 bandes verticales intermédiaires (cousues au point de surjet), système d'accrochage : anneaux jaunes au revers : 5 à gauche 4 à droite, 2 sur le bord inférieur. Ceux du haut ont visiblement été arrachés (retirés)"@fr , "laine (chaines et trames)"@fr , "soie (trames)"@fr , "tapisserie de basse lisse = basse lisse (techniques textile->tapisserie = tapisserie sur métier)"@fr ;
        ecrm:P4_has_time-span   <http://data.silknow.org/timespan/1774> , <http://data.silknow.org/timespan/1700_1800> ;
