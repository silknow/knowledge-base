        a                    silk:T19 ;
        silk:L4              "tapisserie" ;
        ecrm:P41_classified  <http://data.silknow.org/object/6394d6b9-a932-3d07-9ef0-a5e1721ffcac> .

<http://data.silknow.org/object/6394d6b9-a932-3d07-9ef0-a5e1721ffcac/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    "Description / Décor" ;
        ecrm:P3_has_note    "A gauche, deux seigneurs à cheval, dont l'un tient un faucon au poing et une femme dont un valet tient le cheval, poursuivant un cerf qui s'apprête, à droite, à franchir une rivière près de laquelle semble l'attendre un piqueur, debout de trois-quarts vers la gauche ; au centre, un autre piqueur sonne de la trompe et un cavalier se rapproche du cerf, tenant son épée de la main droite. Au fond, un château et, à droite, une ville. Bordure alternée de fleurs et feuilles stylisées sur fond brun ; cartouches aux angles."@fr ;
        crmsci:O8_observed  <http://data.silknow.org/object/6394d6b9-a932-3d07-9ef0-a5e1721ffcac> .

<http://data.silknow.org/object/6394d6b9-a932-3d07-9ef0-a5e1721ffcac/domain/1>
