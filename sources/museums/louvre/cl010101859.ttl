<http://data.silknow.org/object/8abb0f0f-4855-347b-9e64-4fd2b3c9b333>
        a                              ecrm:E22_Man-Made_Object ;
        rdfs:comment                   "Tapisserie représentant sur un fond de paysage (occupé par un moulin et au centre par un pommier) une femme assise donnant des pièces de monnaie à un homme ; derrière eux debout, un homme écrit sur un livre de comptes. En haut à gauche, un jeune paysan fauche le blé. Bordure d'encadrement à frises de grotesque avec mascarons, cartouches et amours ailés."@fr ;
        rdfs:label                     "L'Eté, ou la paie des moissonneurs, de la tenture des Saisons Lucas"@fr ;
        ecrm:P102_has_title            "L'Eté, ou la paie des moissonneurs, de la tenture des Saisons Lucas"@fr ;
        ecrm:P138i_has_representation  <http://data.silknow.org/image/79e83a14-3a14-3681-a009-a237e564c94d> , <http://data.silknow.org/image/2e37aaa1-87f0-3189-930d-37441fffd933> , <http://data.silknow.org/image/a719b4a2-4ca3-30dd-b270-2465ef0f84f0> , <http://data.silknow.org/image/33b98784-a242-3f89-a928-39a7a8520679> , <http://data.silknow.org/image/e585c668-5151-3f25-8c69-cdb1eb9c7061> , <http://data.silknow.org/image/2c75e04e-5616-3ffa-823c-3f22f56e958b> , <http://data.silknow.org/image/3b4e6e7a-b2ff-3416-a775-2e25834ad1f5> ;
        ecrm:P3_has_note               "Tapisserie représentant sur un fond de paysage (occupé par un moulin et au centre par un pommier) une femme assise donnant des pièces de monnaie à un homme ; derrière eux debout, un homme écrit sur un livre de comptes. En haut à gauche, un jeune paysan fauche le blé. Bordure d'encadrement à frises de grotesque avec mascarons, cartouches et amours ailés."@fr ;
