<http://data.silknow.org/object/7bc4ad24-5f83-327c-9b78-cdb9b4cf196e/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Damasco Gros de Tours lanciato broccato. Ordito in seta azzurra e rosa e trama in seta azzurra eseguono il fondo in raso catena e il disegno in Gros de Tours a due fili. Completano il disegno trame broccate in argento filato e riccio (la prima accompagnata da una trama lanciata in seta bianca)."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/7bc4ad24-5f83-327c-9b78-cdb9b4cf196e> .

