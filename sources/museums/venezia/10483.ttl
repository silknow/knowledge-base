<http://data.silknow.org/object/e303a9e1-62c4-3103-994c-d434c3c685ab/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Velluto operato ad un corpo, tagliato e riccio, su fondo in taffetas doubletè. Disegno in verde su fondo chiaro a grandi maglie romboidali quadrifogliate definite da coppie speculari di racemi. All'interno motivo a trionfi fogliacei e floreli disposti in file verticali parallele, sfalsate (modulo del disegno non completo)."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/e303a9e1-62c4-3103-994c-d434c3c685ab> .

