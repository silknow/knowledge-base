<http://data.silknow.org/object/784d586c-33ab-37e1-87cb-51b60b0143e4/observation/1>
        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Armatura di fondo in raso giallo/liserè/trama di legatura in giallo e argento lamellare. Su fondo in seta gialla con disegno  per trame liserèe in giallo minuto modulo floreale solo in parte ricostruibile: racemi fioriti di tulipani,  margherite e foglie elegantemente piegate formano una regolare grata curvilinea."@it ;
        crmsci:O8_observed  <http://data.silknow.org/object/784d586c-33ab-37e1-87cb-51b60b0143e4> .

