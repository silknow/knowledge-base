        a                   crmsci:S4_Observation ;
        ecrm:P2_has_type    <http://data.silknow.org/observation/technical-observation> ;
        ecrm:P3_has_note    "Velluto verde operato ad un corpo, taglilato e riccio, su fondo in taffettas doubletè in verde chiaro.\nSu fondo in seta verde chiaro disegno di maglie romboidali formato da quattro fiori stilizzati ai vertici, in alternanza con quattro foglie disposte simmetricamente. Reca a ricamo in oro un fiore stilizzato"@it ;
