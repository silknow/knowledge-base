QLEVER_PORT=8864
QLEVER_BIND_ADDRESS=127.0.0.1
QLEVER_ACCESS_TOKEN=generate-with-openssl-rand-hex-24
QLEVER_INDEX_MEMORY=2G
QLEVER_MEMORY_FOR_QUERIES=16G
QLEVER_CACHE_MAX_SIZE=2G
QLEVER_QUERY_TIMEOUT=120s

WORKBENCH_PORT=3031
# All interfaces: the edge WAF reaches the workbench through the docker bridge
# gateway (http://10.0.1.1:3031); a loopback-only binding hides it from the
# WAF container.
WORKBENCH_BIND_ADDRESS=0.0.0.0
WORKBENCH_ADMIN_USER=dba
WORKBENCH_ADMIN_PASSWORD=at-least-12-characters
WORKBENCH_URL=https://data.silknow.org
SPARQL_TIMEOUT_MS=120000
DEREFERENCE_PATHS=vocabulary,object,document,image,organization,event,assestment,production,actor,person,place,modification,inscription,garin,collection,category,graph,timespan,assessment,ontology,prediction,statement,assignment,dimension,activity
